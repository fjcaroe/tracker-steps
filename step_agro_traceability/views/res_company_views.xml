<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_phyto" model="ir.ui.view">
        <field name="name">res.company.form.phyto</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="before">
                <group string="Trazabilidad fitosanitaria" name="step_phyto">
                    <field name="step_phyto_policy"/>
                    <field name="step_phyto_criterion"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
