<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_labor_protection" model="ir.module.category">
        <field name="name">Protección Laboral</field>
        <field name="description">Gestión preventiva y casos confidenciales de Ley Karin.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_labor_user" model="res.groups">
        <field name="name">Usuario de prevención</field>
        <field name="category_id" ref="step_labor_protection.module_category_labor_protection"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_labor_manager" model="res.groups">
        <field name="name">Responsable de prevención</field>
        <field name="category_id" ref="step_labor_protection.module_category_labor_protection"/>
        <field name="implied_ids" eval="[(4, ref('step_labor_protection.group_labor_user'))]"/>
    </record>
    <record id="group_labor_confidential" model="res.groups">
        <field name="name">Gestor confidencial Ley Karin</field>
        <field name="category_id" ref="step_labor_protection.module_category_labor_protection"/>
        <field name="implied_ids" eval="[(4, ref('step_labor_protection.group_labor_manager'))]"/>
    </record>

    <record id="rule_labor_protocol_company" model="ir.rule">
        <field name="name">Protocolos por empresa</field>
        <field name="model_id" ref="model_step_labor_protocol"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_labor_protection.group_labor_user')), (4, ref('hr.group_hr_manager'))]"/>
    </record>
    <record id="rule_labor_karin_company" model="ir.rule">
        <field name="name">Casos Ley Karin por empresa</field>
        <field name="model_id" ref="model_step_labor_karin_case"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_labor_protection.group_labor_confidential')), (4, ref('hr.group_hr_manager'))]"/>
    </record>
    <record id="rule_labor_safeguard_company" model="ir.rule">
        <field name="name">Resguardos Ley Karin por empresa</field>
        <field name="model_id" ref="model_step_labor_karin_safeguard"/>
        <field name="domain_force">[('case_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_labor_protection.group_labor_confidential')), (4, ref('hr.group_hr_manager'))]"/>
    </record>
    <record id="rule_labor_event_company" model="ir.rule">
        <field name="name">Bitácora Ley Karin por empresa</field>
        <field name="model_id" ref="model_step_labor_karin_event"/>
        <field name="domain_force">[('case_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_labor_protection.group_labor_confidential')), (4, ref('hr.group_hr_manager'))]"/>
    </record>
</odoo>

