<odoo>
  <record id="purchase_order_branch_form" model="ir.ui.view">
    <field name="name">purchase.order.branch.delivery</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='picking_type_id']" position="before">
        <field name="step_delivery_company_ids" invisible="1"/>
      </xpath>
      <xpath expr="//field[@name='picking_type_id']" position="attributes">
        <attribute name="domain">['|', ('warehouse_id', '=', False), ('warehouse_id.company_id', 'in', step_delivery_company_ids)]</attribute>
      </xpath>
      <xpath expr="//field[@name='picking_type_id']" position="after">
        <field name="step_branch_delivery_address_id" widget="res_partner_many2one" context="{'show_address': 1}" readonly="1" invisible="not step_branch_delivery_address_id"/>
      </xpath>
    </field>
  </record>
</odoo>
