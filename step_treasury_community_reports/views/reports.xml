<odoo>
<record id="view_report_form" model="ir.ui.view"><field name="name">step.treasury.report.form</field><field name="model">step.treasury.report</field><field name="arch" type="xml">
<form string="Informes de Tesorería"><header><button name="action_calculate" type="object" string="Consultar" class="oe_highlight"/><button name="action_export" type="object" string="Exportar CSV"/><button name="action_print" type="object" string="Imprimir PDF"/></header><sheet><group><group><field name="kind"/><field name="company_id" options="{'no_create': True}"/><field name="date_from"/><field name="date_to"/></group><group><field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="journal_ids" widget="many2many_tags" domain="[('company_id','=',company_id)]" options="{'no_create': True}"/></group></group><field name="result_html" nolabel="1"/><field name="export_file" invisible="1"/><field name="export_name" invisible="1"/></sheet></form>
</field></record>
<record id="action_bank" model="ir.actions.act_window"><field name="name">Conciliación bancaria</field><field name="res_model">step.treasury.report</field><field name="view_mode">form</field><field name="target">current</field><field name="context">{'default_kind': 'bank'}</field><field name="groups_id" eval="[(4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/></record>
<record id="action_ledger" model="ir.actions.act_window"><field name="name">Cuentas corrientes</field><field name="res_model">step.treasury.report</field><field name="view_mode">form</field><field name="target">current</field><field name="context">{'default_kind': 'ledger'}</field><field name="groups_id" eval="[(4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/></record>
<record id="action_cash" model="ir.actions.act_window"><field name="name">Estado de flujo de efectivo</field><field name="res_model">step.treasury.report</field><field name="view_mode">form</field><field name="target">current</field><field name="context">{'default_kind': 'cash'}</field><field name="groups_id" eval="[(4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/></record>
<record id="action_receivable" model="ir.actions.act_window"><field name="name">Cuentas por cobrar vencidas</field><field name="res_model">step.treasury.report</field><field name="view_mode">form</field><field name="target">current</field><field name="context">{'default_kind': 'receivable'}</field><field name="groups_id" eval="[(4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/></record>
<record id="action_payable" model="ir.actions.act_window"><field name="name">Cuentas por pagar vencidas</field><field name="res_model">step.treasury.report</field><field name="view_mode">form</field><field name="target">current</field><field name="context">{'default_kind': 'payable'}</field><field name="groups_id" eval="[(4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/></record>
<template id="print_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page"><div t-field="doc.result_html"/></div></t></t></t></template>
<record id="report_print" model="ir.actions.report"><field name="name">Informe de Tesorería</field><field name="model">step.treasury.report</field><field name="report_type">qweb-pdf</field><field name="report_name">step_treasury_community_reports.print_document</field></record>
</odoo>