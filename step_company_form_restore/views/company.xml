<odoo>
    <!-- Explicit specialized actions retain their own views. Generic company
         dialogs must prefer the complete standard view and all its extensions. -->
    <record id="base.view_company_form" model="ir.ui.view"><field name="priority">5</field></record>
    <record id="base.view_company_tree" model="ir.ui.view"><field name="priority">5</field></record>
    <record id="base.action_res_company_form" model="ir.actions.act_window"><field name="view_id" ref="base.view_company_tree"/></record>
</odoo>