<odoo>
  <record id="folio_company_list" model="ir.ui.view">
    <field name="name">export.folio.existing.company.list</field>
    <field name="model">res.company</field>
    <field name="arch" type="xml">
      <list string="Folios de exportación por empresa" create="false" delete="false">
        <field name="name" string="Empresa"/>
        <field name="export_folio_mode"/><field name="export_folio_initial"/>
      </list>
    </field>
  </record>
  <record id="step_export_shipping_design.folio_company_action" model="ir.actions.act_window">
    <field name="context">{'create': False, 'delete': False}</field>
    <field name="view_id" ref="folio_company_list"/>
  </record>
  <record id="folio_company_action_list" model="ir.actions.act_window.view">
    <field name="sequence">1</field><field name="view_mode">list</field>
    <field name="view_id" ref="folio_company_list"/>
    <field name="act_window_id" ref="step_export_shipping_design.folio_company_action"/>
  </record>
</odoo>
