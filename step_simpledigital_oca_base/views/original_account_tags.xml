<odoo>
    <record id="salary_rule_original_account_tags_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.original.account.tags</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="payroll_account.hr_salary_rule_view_form"/>
        <field name="arch" type="xml">
            <field name="account_debit" position="after">
                <field name="debit_tag_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </field>
            <field name="account_credit" position="after">
                <field name="credit_tag_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
