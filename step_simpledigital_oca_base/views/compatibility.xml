<odoo>
    <menuitem id="payroll_reports" name="Informes" parent="payroll.payroll_menu_root" groups="payroll.group_payroll_manager"/>
    <menuitem id="payroll_employees" name="Personal" parent="payroll.payroll_menu_root" groups="payroll.group_payroll_manager"/>
    <template id="report_payslip" inherit_id="payroll.report_payslip" primary="True">
        <xpath expr="//div[@class='page']/h2" position="replace"><h2 t-out="step_report_title(o)"/></xpath>
        <xpath expr="//div[@class='page']" position="inside">
            <div id="worked_days_table" t-if="step_report_days(o)"><table class="table"><tr t-foreach="step_report_days(o)" t-as="day"><td t-field="day.name"/>
                <td t-out="step_report_day_value(day, 'hours') if step_report_day_value(day, 'hours') is not None else ''"/>
                <td t-out="step_report_day_value(day, 'days') if step_report_day_value(day, 'days') is not None else ''"/>
            </tr></table></div>
            <div id="payslip_lines_table"><table class="table"><tr t-foreach="step_report_lines(o)" t-as="line"><td t-field="line.name"/><td><span t-if="step_report_total(line) is not None" t-out="step_report_total(line)"/></td></tr></table></div>
            <div id="to_pay"><span t-if="step_report_net(o) is not None" t-out="step_report_net(o)"/></div>
        </xpath>
        <xpath expr="//div[@id='payslip_lines_table']" position="after">
            <div id="step_other_stored_lines" t-if="step_report_other_lines(o)">
                <h3>Otros conceptos almacenados</h3>
                <table class="table table-sm"><tr t-foreach="step_report_other_lines(o)" t-as="line">
                    <td t-field="line.code"/><td t-field="line.name"/>
                    <td class="text-end"><span t-if="step_report_total(line) is not None" t-out="step_report_total(line)"
                        t-options='{"widget":"monetary","display_currency":o.company_id.currency_id}'/></td>
                </tr></table>
            </div>
        </xpath>
        <xpath expr="//div[@class='page']/table[2]" position="replace"/>
    </template>
    <record id="payroll.action_report_payslip" model="ir.actions.report">
        <field name="report_name">step_simpledigital_oca_base.report_payslip</field>
        <field name="report_file">step_simpledigital_oca_base.report_payslip</field>
    </record>
    <record id="history_protection_view" model="ir.ui.view">
        <field name="name">payroll.history.protection</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside"><field name="step_history_locked" invisible="1"/></xpath>
            <xpath expr="//button[@name='compute_sheet']" position="attributes">
                <attribute name="invisible" add="step_history_locked" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
