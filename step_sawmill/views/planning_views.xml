<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_sawmill_production_stage_list" model="ir.ui.view">
        <field name="name">step.sawmill.production.stage.list</field>
        <field name="model">step.sawmill.production.stage</field>
        <field name="arch" type="xml">
            <list string="Etapas" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
            </list>
        </field>
    </record>
    <record id="action_step_sawmill_production_stage" model="ir.actions.act_window">
        <field name="name">Etapas de orden de producción</field>
        <field name="res_model">step.sawmill.production.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_step_sawmill_production_order_list" model="ir.ui.view">
        <field name="name">step.sawmill.production.order.list</field>
        <field name="model">step.sawmill.production.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de producción">
                <field name="number"/>
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>
    <record id="view_step_sawmill_production_order_kanban" model="ir.ui.view">
        <field name="name">step.sawmill.production.order.kanban</field>
        <field name="model">step.sawmill.production.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="color"/>
                <field name="kanban_state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div class="text-muted"><field name="number"/></div>
                        <div><field name="scheduled_date"/></div>
                        <footer>
                            <field name="priority" widget="boolean_favorite"/>
                            <field name="kanban_state" widget="state_selection" class="ms-auto"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_step_sawmill_production_order_form" model="ir.ui.view">
        <field name="name">step.sawmill.production.order.form</field>
        <field name="model">step.sawmill.production.order</field>
        <field name="arch" type="xml">
            <form string="Orden de producción">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_work_orders" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="work_order_count" widget="statinfo" string="Órdenes de trabajo"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Descripción"/></h1></div>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="value"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                            <field name="kanban_state" widget="state_selection"/>
                            <field name="priority" widget="boolean_favorite"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_step_sawmill_production_order_search" model="ir.ui.view">
        <field name="name">step.sawmill.production.order.search</field>
        <field name="model">step.sawmill.production.order</field>
        <field name="arch" type="xml">
            <search string="Órdenes de producción">
                <field name="name"/>
                <field name="number"/>
                <field name="user_id"/>
                <filter name="mine" string="Mis órdenes" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_stage" string="Etapa" context="{'group_by': 'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_step_sawmill_production_order" model="ir.actions.act_window">
        <field name="name">Órdenes de producción</field>
        <field name="res_model">step.sawmill.production.order</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_step_sawmill_work_order_list" model="ir.ui.view">
        <field name="name">step.sawmill.work.order.list</field>
        <field name="model">step.sawmill.work.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de trabajo">
                <field name="number"/>
                <field name="name"/>
                <field name="production_order_id"/>
                <field name="date"/>
                <field name="kanban_state" widget="state_selection"/>
            </list>
        </field>
    </record>
    <record id="view_step_sawmill_work_order_form" model="ir.ui.view">
        <field name="name">step.sawmill.work.order.form</field>
        <field name="model">step.sawmill.work.order</field>
        <field name="arch" type="xml">
            <form string="Orden de trabajo">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Descripción"/></h1></div>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="production_order_id"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="value"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                            <field name="kanban_state" widget="state_selection"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notas"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_step_sawmill_work_order" model="ir.actions.act_window">
        <field name="name">Órdenes de trabajo</field>
        <field name="res_model">step.sawmill.work.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_step_sawmill_crew_list" model="ir.ui.view">
        <field name="name">step.sawmill.crew.list</field>
        <field name="model">step.sawmill.crew</field>
        <field name="arch" type="xml">
            <list string="Cuadrillas">
                <field name="name"/>
                <field name="folio"/>
                <field name="date"/>
                <field name="crew_type"/>
                <field name="contractor_id"/>
                <field name="supervisor_id"/>
                <field name="headcount"/>
            </list>
        </field>
    </record>
    <record id="view_step_sawmill_crew_form" model="ir.ui.view">
        <field name="name">step.sawmill.crew.form</field>
        <field name="model">step.sawmill.crew</field>
        <field name="arch" type="xml">
            <form string="Cuadrilla">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Descripción"/></h1></div>
                    <group>
                        <group>
                            <field name="folio"/>
                            <field name="date"/>
                            <field name="crew_type"/>
                            <field name="contractor_id" invisible="crew_type != 'contractor'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="supervisor_id"/>
                            <field name="time_in"/>
                            <field name="time_out"/>
                            <field name="headcount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Trabajadores" name="members">
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="nip_code"/>
                                    <field name="time_in"/>
                                    <field name="time_out"/>
                                    <field name="hours" sum="Total horas"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_step_sawmill_crew" model="ir.actions.act_window">
        <field name="name">Cuadrillas</field>
        <field name="res_model">step.sawmill.crew</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_step_sawmill_working_days_list" model="ir.ui.view">
        <field name="name">step.sawmill.working.days.list</field>
        <field name="model">step.sawmill.working.days</field>
        <field name="arch" type="xml">
            <list string="Días y horas hábiles" editable="bottom">
                <field name="name"/>
                <field name="month"/>
                <field name="working_days"/>
                <field name="working_hours"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_step_sawmill_working_days" model="ir.actions.act_window">
        <field name="name">Días y horas hábiles por mes</field>
        <field name="res_model">step.sawmill.working.days</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
