<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_sawmill_elaboration_list" model="ir.ui.view">
        <field name="name">step.sawmill.elaboration.list</field>
        <field name="model">step.sawmill.elaboration</field>
        <field name="arch" type="xml">
            <list string="Elaboración" decoration-muted="state == 'valued'">
                <field name="name"/>
                <field name="date"/>
                <field name="production_order_id"/>
                <field name="workcenter_id"/>
                <field name="supervisor_id"/>
                <field name="total_hours" sum="Total horas"/>
                <field name="cost_total" sum="Costo total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'authorized'" decoration-success="state == 'valued'"/>
            </list>
        </field>
    </record>
    <record id="view_step_sawmill_elaboration_form" model="ir.ui.view">
        <field name="name">step.sawmill.elaboration.form</field>
        <field name="model">step.sawmill.elaboration</field>
        <field name="arch" type="xml">
            <form string="Elaboración">
            <header>
                <button name="action_authorize" string="Autorizar" type="object" class="oe_highlight" invisible="state not in ('draft')"/>
                <button name="action_value" string="Valorizar" type="object" class="oe_highlight" invisible="state not in ('authorized')"/>
                <button name="action_reset" string="Volver a Ingresada" type="object" invisible="state not in ('authorized', 'valued')"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,authorized,valued"/>
            </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Origen">
                            <field name="date"/>
                            <field name="production_order_id"/>
                            <field name="work_order_id"/>
                            <field name="mrp_production_id"/>
                            <field name="customer_id"/>
                            <field name="company_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Proceso">
                            <field name="process_type_id"/>
                            <field name="process_line_id"/>
                            <field name="workcenter_id"/>
                            <field name="shift_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tiempos y personal">
                            <field name="supervisor_id"/>
                            <field name="operator_id"/>
                            <field name="crew_id"/>
                            <field name="headcount"/>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                            <field name="total_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos obtenidos" name="output">
                            <field name="output_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="pieces"/>
                                    <field name="quantity_m3"/>
                                    <field name="thickness"/>
                                    <field name="width"/>
                                    <field name="quality_id"/>
                                    <field name="grade_id"/>
                                    <field name="product_type_id"/>
                                    <field name="destination_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Materia prima consumida" name="input">
                            <field name="input_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="lot_id"/>
                                    <field name="tarja"/>
                                    <field name="diameter"/>
                                    <field name="quantity"/>
                                    <field name="pieces"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost"/>
                                </list>
                            </field>
                        </page>
                        <page string="Valorización" name="cost">
                            <field name="cost_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="pieces"/>
                                    <field name="cost_raw"/>
                                    <field name="cost_own_labor"/>
                                    <field name="cost_contract_labor"/>
                                    <field name="cost_supplies"/>
                                    <field name="cost_expenses"/>
                                    <field name="cost_machines"/>
                                    <field name="cost_total"/>
                                    <field name="portion"/>
                                    <field name="unit_cost_uom"/>
                                    <field name="unit_cost_piece"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer"><field name="cost_total"/></group>
                        </page>
                        <page string="Notas" name="notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_step_sawmill_elaboration_search" model="ir.ui.view">
        <field name="name">step.sawmill.elaboration.search</field>
        <field name="model">step.sawmill.elaboration</field>
        <field name="arch" type="xml">
            <search string="Elaboración">
                <field name="name"/>
                <field name="production_order_id"/>
                <field name="workcenter_id"/>
                <field name="supervisor_id"/>
                <filter name="draft" string="Ingresadas" domain="[('state', '=', 'draft')]"/>
                <filter name="authorized" string="Autorizadas" domain="[('state', '=', 'authorized')]"/>
                <filter name="valued" string="Valorizadas" domain="[('state', '=', 'valued')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="g_wc" string="Centro de trabajo" context="{'group_by': 'workcenter_id'}"/>
                    <filter name="g_date" string="Fecha" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_step_sawmill_elaboration" model="ir.actions.act_window">
        <field name="name">Elaboración</field>
        <field name="res_model">step.sawmill.elaboration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
