<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_sawmill_grade_list" model="ir.ui.view">
        <field name="name">step.sawmill.grade.list</field>
        <field name="model">step.sawmill.grade</field>
        <field name="arch" type="xml">
            <list string="Grado de madera" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_step_sawmill_grade_form" model="ir.ui.view">
        <field name="name">step.sawmill.grade.form</field>
        <field name="model">step.sawmill.grade</field>
        <field name="arch" type="xml">
            <form string="Grado de madera">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_step_sawmill_grade" model="ir.actions.act_window">
        <field name="name">Grado de madera</field>
        <field name="res_model">step.sawmill.grade</field>
        <field name="view_mode">list,form</field>
    </record>
