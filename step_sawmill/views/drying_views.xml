<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_sawmill_drying_list" model="ir.ui.view">
        <field name="name">step.sawmill.drying.list</field>
        <field name="model">step.sawmill.drying</field>
        <field name="arch" type="xml">
            <list string="Secado">
                <field name="name"/>
                <field name="process_date"/>
                <field name="work_order_id"/>
                <field name="workcenter_id"/>
                <field name="machine"/>
                <field name="cycle"/>
                <field name="real_hours"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_step_sawmill_drying_form" model="ir.ui.view">
        <field name="name">step.sawmill.drying.form</field>
        <field name="model">step.sawmill.drying</field>
        <field name="arch" type="xml">
            <form string="Secado">
            <header>
                <button name="action_done" string="Terminar" type="object" class="oe_highlight" invisible="state not in ('in_process')"/>
                <button name="action_reopen" string="Reabrir" type="object" invisible="state not in ('done')"/>
                <field name="state" widget="statusbar" statusbar_visible="in_process,done"/>
            </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Proceso">
                            <field name="process_date"/>
                            <field name="work_order_id"/>
                            <field name="workcenter_id"/>
                            <field name="machine"/>
                            <field name="cycle"/>
                            <field name="program"/>
                            <field name="orientation"/>
                            <field name="wood_category"/>
                            <field name="quantity_inches"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Tiempos y personal">
                            <field name="supervisor_id"/>
                            <field name="load_operator_id"/>
                            <field name="unload_operator_id"/>
                            <field name="date_start"/>
                            <field name="date_stop"/>
                            <field name="real_hours"/>
                            <field name="estimated_hours"/>
                            <field name="cycle_hours"/>
                            <field name="pause_hours"/>
                            <field name="cooling_hours"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Cargas">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="tarja"/>
                                    <field name="tarja_date"/>
                                    <field name="origin"/>
                                    <field name="wood_category"/>
                                    <field name="product_id"/>
                                    <field name="uom_id"/>
                                    <field name="quality_id"/>
                                    <field name="thickness"/>
                                    <field name="width"/>
                                    <field name="length"/>
                                    <field name="pieces"/>
                                    <field name="quantity_inches"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_step_sawmill_drying_search" model="ir.ui.view">
        <field name="name">step.sawmill.drying.search</field>
        <field name="model">step.sawmill.drying</field>
        <field name="arch" type="xml">
            <search string="Secado">
                <field name="name"/>
                <field name="machine"/>
                <field name="work_order_id"/>
            </search>
        </field>
    </record>
    <record id="action_step_sawmill_drying" model="ir.actions.act_window">
        <field name="name">Secado</field>
        <field name="res_model">step.sawmill.drying</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
