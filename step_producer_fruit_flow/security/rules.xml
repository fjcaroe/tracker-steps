<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_producer_preliquidation_company" model="ir.rule">
        <field name="name">Preliquidación de productores: empresas permitidas</field>
        <field name="model_id" ref="model_step_producer_preliquidation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_producer_preliquidation_line_company" model="ir.rule">
        <field name="name">Etapas de preliquidación: empresas permitidas</field>
        <field name="model_id" ref="model_step_producer_preliquidation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
