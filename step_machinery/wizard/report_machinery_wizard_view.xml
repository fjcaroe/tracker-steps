<odoo>
        <record id="report_machinery_wizard_form" model="ir.ui.view">
            <field name="name">report.machinery.wizard.form</field>
            <field name="model">report.machinery.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="mes_select"/>
                        <field name="anio_select"/>
                    </group>
                    <group string="Resultado" invisible="not file_name">
                        <field name="file_name" invisible="1"/>
                        <field name="file" filename="file_name" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Generar" name="generate_report" type="object" class="oe_highlight" data-hotkey="q"/>
                        <button string="Cancelar" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="report_machinery_wizard_action" model="ir.actions.act_window">
            <field name="name">Generar Costos de Maquinarias en excel</field>
            <field name="res_model">report.machinery.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
</odoo>
