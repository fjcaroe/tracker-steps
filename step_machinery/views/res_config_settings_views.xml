<odoo>

    <record id="res_config_settings_view_form_step_machinery" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.step.machinery</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="75"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="step_machinery" string="Maquinaria" name="step_machinery">
                    <block title="Configuración Contable Maquinaria" name="step_machinery_contable">
                        <setting id="step_id_journal_machinery" title="El diario de contabilidad es un documento contable esencial donde se registran de forma cronológica todas las transacciones financieras" help="El diario de contabilidad es un documento contable esencial donde se registran de forma cronológica todas las transacciones financieras">
                            <field name="step_journal_machinery" class="o_light_label" options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_step_machinery_configuration" model="ir.actions.act_window">
        <field name="name">Configuración</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'step_machinery', 'bin_size': False}</field>
    </record>
</odoo>
