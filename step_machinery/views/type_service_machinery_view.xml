<odoo>
    <record id="view_type_service_machinery_form" model="ir.ui.view">
        <field name="name">type.service.machinery.form</field>
        <field name="model">type.service.machinery</field>
        <field name="arch" type="xml">
            <form string="Tipo servicio Maquinaria">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cod"/>
                            <field name="categ"/>
                            <field name="comment"/>
                        </group>
                        <group>
                            <field name="cargo_account_id"/>
                            <field name="abono_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_type_service_machinery_list" model="ir.ui.view">
        <field name="name">type.service.machinery.list</field>
        <field name="model">type.service.machinery</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="cod" optional="show"/>
                <field name="cargo_account_id" optional="show"/>
                <field name="abono_account_id" optional="show"/>
                <field name="categ" optional="show"/>
                <field name="comment" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_type_service_tracking" model="ir.actions.act_window">
        <field name="name">Tipo servicio Maquinaria</field>
        <field name="res_model">type.service.machinery</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
