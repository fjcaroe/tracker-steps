<odoo>
    <record id="view_step_cost_machinery_form" model="ir.ui.view">
        <field name="name">step.cost.machinery.form</field>
        <field name="model">step.cost.machinery</field>
        <field name="arch" type="xml">
            <form string="Costo Maquinaria">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="fundo_id"/>
                        </group>
                        <group>
                            <field name="responsable_id"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                        </group>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_step_cost_machinery_list" model="ir.ui.view">
        <field name="name">step.cost.machinery.list</field>
        <field name="model">step.cost.machinery</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_step_cost_machinery" model="ir.actions.act_window">
        <field name="name">Costo Maquinaria</field>
        <field name="res_model">step.cost.machinery</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>