<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quant_package_form_fruit_tag" model="ir.ui.view">
        <field name="name">stock.quant.package.form.fruit.tag</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_form"/>
        <field name="arch" type="xml">
            <field name="pack_date" position="after">
                <field name="is_fruit_tag"/>
            </field>
            <separator string="Content" position="before">
                <group string="Tarja de fruta de exportación" invisible="not is_fruit_tag">
                    <group string="Origen">
                        <field name="fundo_id"/>
                        <field name="packing_plant"/>
                        <field name="certificate"/>
                    </group>
                    <group string="Variantes">
                        <field name="especie_id"/>
                        <field name="variedad_id"/>
                        <field name="fruit_caliber_id"/>
                        <field name="fruit_quality_id"/>
                        <field name="fruit_category_id"/>
                        <field name="fruit_class_id"/>
                        <field name="fruit_type"/>
                        <field name="label"/>
                    </group>
                    <group string="Producción">
                        <field name="process_type"/>
                        <field name="process_line"/>
                        <field name="op_folio"/>
                        <field name="ot_proceso"/>
                        <field name="box_count"/>
                        <field name="kilos_total"/>
                    </group>
                </group>
            </separator>
        </field>
    </record>
</odoo>
