<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fruit_quality_list" model="ir.ui.view">
        <field name="name">step.management.fruit.quality.list</field>
        <field name="model">step.management.fruit.quality</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_fruit_quality" model="ir.actions.act_window">
        <field name="name">Calidades de fruta</field>
        <field name="res_model">step.management.fruit.quality</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Se agrega junto a Categorías/Clases/Calibres de fruta, ya
         existentes en step_management_costs > Maestros. -->
    <menuitem id="menu_fruit_quality"
              name="Calidades de fruta"
              action="action_fruit_quality"
              parent="step_management_costs.menu_management_masters"
              sequence="85"/>
</odoo>
