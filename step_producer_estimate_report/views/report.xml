<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="report_gantt" model="ir.ui.view">
    <field name="name">producer.estimate.report.calendar</field>
    <field name="model">step.producer.estimate.report</field>
    <field name="arch" type="xml">
      <calendar string="Estimaciones de cosecha" date_start="week_start" date_stop="week_end" color="producer_id" mode="month" create="false" edit="false" delete="false" quick_create="false" event_open_popup="true">
        <field name="estimate_id" />
        <field name="season_id" />
        <field name="species_id" />
        <field name="variety_id" />
        <field name="delivery_kind" />
        <field name="producer_id" />
        <field name="export_kg" />
        <field name="process_kg" />
        <field name="export_box_qty" />
        <field name="export_pallet_qty" />
        <field name="bin_qty" />
        <field name="amount_usd" />
        <field name="valuation_status" />
        <field name="usd_currency_id" invisible="1" />
      </calendar>
    </field>
    <field name="type">calendar</field>
  </record>
  <record id="report_pivot" model="ir.ui.view">
    <field name="name">producer.estimate.report.pivot</field>
    <field name="model">step.producer.estimate.report</field>
    <field name="arch" type="xml">
      <pivot string="Estimaciones de cosecha">
        <field name="producer_id" type="row" />
        <field name="week_start" type="col" interval="week" />
        <field name="export_kg" type="measure" />
        <field name="process_kg" type="measure" />
        <field name="export_box_qty" type="measure" />
        <field name="export_pallet_qty" type="measure" />
        <field name="bin_qty" type="measure" />
        <field name="amount_usd" type="measure" />
        <field name="unvalued_week_qty" type="measure" />
      </pivot>
    </field>
  </record>
  <record id="report_list" model="ir.ui.view">
    <field name="name">producer.estimate.report.list</field>
    <field name="model">step.producer.estimate.report</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="estimate_id" />
        <field name="week_start" />
        <field name="season_id" />
        <field name="species_id" />
        <field name="variety_id" />
        <field name="delivery_kind" />
        <field name="producer_id" />
        <field name="export_kg" sum="Total" />
        <field name="process_kg" sum="Total" />
        <field name="export_box_qty" sum="Total" />
        <field name="export_pallet_qty" sum="Total" />
        <field name="bin_qty" sum="Total" />
        <field name="price_line_id" optional="hide" />
        <field name="price_usd_per_kg" />
        <field name="usd_currency_id" column_invisible="True" />
        <field name="amount_usd" sum="Valor FOB USD" />
        <field name="valuation_status" />
        <field name="state" />
        <field name="company_id" groups="base.group_multi_company" />
      </list>
    </field>
  </record>
  <record id="report_search" model="ir.ui.view">
    <field name="name">producer.estimate.report.search</field>
    <field name="model">step.producer.estimate.report</field>
    <field name="arch" type="xml">
      <search>
        <field name="season_id" />
        <field name="species_id" />
        <field name="variety_id" />
        <field name="delivery_kind" />
        <field name="producer_id" />
        <field name="estimate_id" />
        <filter name="current" string="Vigentes" domain="[('state','=','current')]" />
        <filter name="drafts" string="Creadas / validadas" domain="[('state','in',['created','validated'])]" />
        <filter name="replaced" string="Historial reemplazado" domain="[('state','=','replaced')]" />
        <filter name="unvalued" string="Sin valorizar" domain="[('valuation_status','!=','valued')]" />
        <filter name="date" string="Fecha" date="week_start" />
        <group>
          <filter name="by_season_id" string="Temporada" context="{'group_by':'season_id'}" />
          <filter name="by_species_id" string="Especie" context="{'group_by':'species_id'}" />
          <filter name="by_variety_id" string="Variedad" context="{'group_by':'variety_id'}" />
          <filter name="by_delivery_kind" string="Delivery Kind" context="{'group_by':'delivery_kind'}" />
          <filter name="by_producer_id" string="Productor" context="{'group_by':'producer_id'}" />
          <filter name="by_week_start:month" string="Mes" context="{'group_by':'week_start:month'}" />
          <filter name="by_week_start:week" string="Semanas" context="{'group_by':'week_start:week'}" />
        </group>
      </search>
    </field>
  </record>
  <record id="report_action" model="ir.actions.act_window">
    <field name="name">Informe estimaciones de cosecha</field>
    <field name="res_model">step.producer.estimate.report</field>
    <field name="view_mode">calendar,pivot,list</field>
    <field name="search_view_id" ref="report_search" />
    <field name="context">{'search_default_current':1}</field>
    <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'calendar','view_id':ref('report_gantt')}),(0,0,{'view_mode':'pivot','view_id':ref('report_pivot')}),(0,0,{'view_mode':'list','view_id':ref('report_list')})]" />
  </record>
  <menuitem id="report_menu" name="Informe estimaciones de cosecha" parent="step_producers.menu_step_producers_planning_group" action="report_action" sequence="20" />
</odoo>
