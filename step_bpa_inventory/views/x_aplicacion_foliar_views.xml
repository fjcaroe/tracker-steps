<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_application_form_inventory" model="ir.ui.view">
        <field name="name">x.aplicacion.foliar.form.bpa.inventory</field>
        <field name="model">x_aplicacion_foliar</field>
        <field name="inherit_id" ref="step_bpa_irrigation.view_application_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_inventory_move" string="Generar movimiento de Inventario"
                        type="object" class="oe_highlight"
                        invisible="state not in ('status3', 'Contabilizado')"/>
            </xpath>
            <xpath expr="//div[hasclass('o_step_bpa_record_intro')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_generate_inventory_move" type="object" class="oe_stat_button"
                            icon="fa-truck" invisible="not inventory_picking_id">
                        <field name="inventory_picking_id" widget="statinfo" string="Movimiento"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='notes']" position="before">
                <group string="Consumo de productos (Inventario)">
                    <field name="consumption_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
