<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="stock_location_bpa" model="stock.location">
        <field name="name">BPA/Stock</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
    </record>

    <record id="stock_location_bpa_production" model="stock.location">
        <field name="name">BPA/Producción</field>
        <field name="usage">production</field>
        <field name="location_id" ref="stock.stock_location_locations_virtual"/>
    </record>

    <record id="sequence_picking_type_bpa_consumption" model="ir.sequence">
        <field name="name">Consumo BPA</field>
        <field name="code">stock.picking.bpa.consumption</field>
        <field name="prefix">BPA-CONS/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="picking_type_bpa_consumption" model="stock.picking.type">
        <field name="name">Consumo BPA</field>
        <field name="code">internal</field>
        <field name="sequence_id" ref="sequence_picking_type_bpa_consumption"/>
        <field name="default_location_src_id" ref="stock_location_bpa"/>
        <field name="default_location_dest_id" ref="stock_location_bpa_production"/>
        <field name="warehouse_id" eval="False"/>
        <field name="sequence_code">BPACONS</field>
    </record>

</odoo>
