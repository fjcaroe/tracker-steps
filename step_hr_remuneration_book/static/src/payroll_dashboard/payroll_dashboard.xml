<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="step_hr_remuneration_book.PayrollDashboard">
        <div class="o_steps_payroll_dashboard">
            <div class="o_steps_payroll_shell">
                <div t-if="state.loading" class="o_steps_payroll_loading">
                    <i class="fa fa-spinner fa-spin"/> Cargando Nómina…
                </div>
                <div t-elif="state.error" class="alert alert-danger" t-esc="state.error"/>
                <t t-elif="state.data">
                    <header class="o_steps_payroll_hero">
                        <div>
                            <div class="o_steps_payroll_brand" role="img" aria-label="Steps Nómina">
                                <span class="o_steps_payroll_brand_mark">
                                    <svg viewBox="0 0 48 48">
                                        <path d="M24 4C13 4 6 12 6 23c0 11 7 19 18 21 11-2 18-10 18-21C42 12 35 4 24 4Z"/>
                                        <path class="leaf" d="M14 28c8-1 14-6 19-15 1 9-3 18-13 22"/>
                                        <path class="stem" d="M18 36c3-8 8-14 15-19"/>
                                    </svg>
                                </span>
                                <span class="o_steps_payroll_brand_text"><strong>Steps</strong><small>Nómina</small></span>
                            </div>
                            <span class="o_steps_payroll_eyebrow">GESTIÓN DE PERSONAS</span>
                            <h1>Nómina</h1>
                            <p><t t-esc="state.data.company"/> · <t t-esc="state.data.period"/></p>
                            <div class="o_steps_payroll_pills">
                                <span><i class="fa fa-cogs"/> <t t-esc="state.data.engine"/></span>
                                <span t-att-class="'is-' + state.data.profile_state">
                                    <i class="fa fa-check-circle"/> <t t-esc="state.data.profile"/>
                                </span>
                            </div>
                        </div>
                        <div class="o_steps_payroll_hero_actions">
                            <button class="btn btn-light" t-on-click="() => this.openAction('hr_payroll.action_hr_payslip_new')">
                                <i class="fa fa-plus me-2"/>Nueva liquidación
                            </button>
                            <button t-if="state.data.can_full_book" class="btn btn-outline-light"
                                    t-on-click="() => this.openAction('step_hr_remuneration_book.action_hr_libro_remuneraciones_wizard_steps')">
                                <i class="fa fa-book me-2"/>Libro de Remuneraciones Steps
                            </button>
                            <button t-else="" class="btn btn-outline-light"
                                    t-on-click="() => this.openAction('step_hr_remuneration_book.action_hr_remuneration_partial_report_steps')">
                                <i class="fa fa-file-text-o me-2"/>Reporte parcial
                            </button>
                        </div>
                    </header>

                    <section class="o_steps_payroll_kpis">
                        <button class="o_steps_payroll_kpi" t-on-click="() => this.openPayslips()">
                            <span class="icon green"><i class="fa fa-files-o"/></span>
                            <span><small>LIQUIDACIONES DEL MES</small><strong t-esc="state.data.total"/></span>
                        </button>
                        <button class="o_steps_payroll_kpi" t-on-click="() => this.openPayslips('verify')">
                            <span class="icon amber"><i class="fa fa-clock-o"/></span>
                            <span><small>POR REVISAR</small><strong t-esc="state.data.states.verify"/></span>
                        </button>
                        <button class="o_steps_payroll_kpi" t-on-click="() => this.openPayslips('done')">
                            <span class="icon blue"><i class="fa fa-check"/></span>
                            <span><small>PROCESADAS</small><strong t-esc="state.data.completed"/></span>
                        </button>
                        <div class="o_steps_payroll_kpi">
                            <span class="icon violet"><i class="fa fa-users"/></span>
                            <span><small>PERSONAS LIQUIDADAS</small><strong t-esc="state.data.employees"/></span>
                        </div>
                    </section>

                    <section class="o_steps_payroll_grid">
                        <article class="o_steps_payroll_panel o_steps_payroll_amounts">
                            <div class="panel_head">
                                <div><span class="o_steps_payroll_eyebrow dark">RESUMEN DEL MES</span><h2>Resultado de nómina</h2></div>
                                <div class="o_steps_payroll_period">
                                    <select class="o_steps_payroll_period_select"
                                            aria-label="Período del resumen"
                                            t-on-change="onPeriodChange">
                                        <option t-foreach="state.data.periods" t-as="option" t-key="option.value"
                                                t-att-value="option.value"
                                                t-att-selected="option.value === state.data.selected_period"
                                                t-esc="option.label"/>
                                    </select>
                                    <span class="currency" t-esc="state.data.currency"/>
                                </div>
                            </div>
                            <div class="o_steps_payroll_amount_table">
                                <div class="amount_table_head"><span>Concepto</span><span>$</span><span>% indicador</span></div>
                                <div class="amount_table_row"><span>Sueldo base</span><strong t-esc="this.formatAmount(state.data.base_salary)"/><strong t-esc="this.formatPercent(state.data.indicators.base_salary)"/></div>
                                <div class="amount_table_row net"><span>Sueldo líquido</span><strong t-esc="this.formatAmount(state.data.net)"/><strong t-esc="this.formatPercent(state.data.indicators.net)"/></div>
                                <div class="amount_table_row"><span>Anticipo y retenciones</span><strong t-esc="this.formatAmount(state.data.advances)"/><strong t-esc="this.formatPercent(state.data.indicators.advances)"/></div>
                                <div class="amount_table_row total"><span>Total haberes</span><strong t-esc="this.formatAmount(state.data.gross)"/><strong>100,0 %</strong></div>
                                <div class="amount_table_separator"/>
                                <div class="amount_table_row"><span>Cotización empresa</span><strong t-esc="this.formatAmount(state.data.contributions.employer)"/><strong t-esc="this.formatPercent(state.data.indicators.employer)"/></div>
                                <div class="amount_table_row"><span>Cotización trabajador</span><strong t-esc="this.formatAmount(state.data.contributions.worker)"/><strong t-esc="this.formatPercent(state.data.indicators.worker)"/></div>
                                <div class="amount_table_row total"><span>Imposiciones pagadas</span><strong t-esc="this.formatAmount(state.data.contributions.paid)"/><strong t-esc="this.formatPercent(state.data.indicators.paid)"/></div>
                            </div>
                            <div t-if="state.data.contributions.available" class="o_steps_payroll_insurance">
                                <span>Costo seguros sobre haberes sin asignación familiar</span>
                                <strong t-esc="this.formatPercent(state.data.indicators.insurance_cost, 2)"/>
                            </div>
                            <div t-else="" class="o_steps_payroll_warning">
                                <i class="fa fa-exclamation-triangle"/>
                                <span>No fue posible obtener las imposiciones desde PreviRed para este período.</span>
                            </div>
                            <div t-if="state.data.missing_identification" class="o_steps_payroll_warning">
                                <i class="fa fa-exclamation-triangle"/>
                                <span><strong t-esc="state.data.missing_identification"/> persona(s) sin identificación; revise antes del Libro.</span>
                            </div>
                            <div t-else="" class="o_steps_payroll_ok"><i class="fa fa-check-circle"/> Identificaciones completas para el período.</div>
                        </article>

                        <article class="o_steps_payroll_panel">
                            <div class="panel_head">
                                <div><span class="o_steps_payroll_eyebrow dark">TRAZABILIDAD</span><h2>Últimos lotes</h2></div>
                                <button class="btn btn-sm btn-link" t-on-click="() => this.openAction('hr_payroll.action_hr_payslip_run_tree')">Ver todos</button>
                            </div>
                            <button t-foreach="state.data.recent_batches" t-as="batch" t-key="batch.id"
                                    class="batch_row" t-on-click="() => this.openBatch(batch.id)">
                                <span class="batch_icon"><i class="fa fa-calendar"/></span>
                                <span class="batch_text"><strong t-esc="batch.name"/><small><t t-esc="batch.date_start"/> — <t t-esc="batch.date_end"/></small></span>
                                <span class="batch_count"><strong t-esc="batch.done"/>/<t t-esc="batch.count"/><small>procesadas</small></span>
                            </button>
                            <div t-if="!state.data.recent_batches.length" class="o_steps_payroll_empty">Los lotes aparecerán aquí.</div>
                        </article>
                    </section>

                    <section class="o_steps_payroll_panel o_steps_payroll_trend">
                        <div class="panel_head"><div><span class="o_steps_payroll_eyebrow dark">6 MESES</span><h2>Volumen procesado</h2></div></div>
                        <div class="trend_bars">
                            <div t-foreach="state.data.trend" t-as="item" t-key="item.label" class="trend_item">
                                <div class="trend_track"><span t-att-style="'height:' + Math.max(item.percent, 3) + '%'"/></div>
                                <strong t-esc="item.count"/><small t-esc="item.label"/>
                            </div>
                        </div>
                    </section>

                    <section class="o_steps_payroll_shortcuts">
                        <button t-on-click="() => this.openAction('hr_payroll.action_hr_payslip_run_tree')"><i class="fa fa-calendar-check-o"/><span>Lotes de nómina</span></button>
                        <button t-on-click="() => this.openAction('hr_payroll.hr_payroll_dashboard_open')"><i class="fa fa-exclamation-circle"/><span>Controles estándar</span></button>
                        <button t-if="state.data.can_full_book" t-on-click="() => this.openAction('step_hr_remuneration_book.action_hr_libro_remuneraciones_wizard_steps')"><i class="fa fa-book"/><span>Libro consolidado Steps</span></button>
                        <button t-on-click="() => this.openAction('step_hr_remuneration_book.action_hr_remuneration_partial_report_steps')"><i class="fa fa-pie-chart"/><span>Reporte parcial</span></button>
                    </section>
                </t>
            </div>
        </div>
    </t>
</templates>
