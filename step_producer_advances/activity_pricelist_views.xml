<odoo>
    <record id="activity_pricelist_form" model="ir.ui.view">
        <field name="name">product.pricelist.activity.form</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="step_hr.step_pricelist_view_inherit"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='item_ids']/form//field[@name='labor_id']" position="attributes">
                <attribute name="required">True</attribute>
                <attribute name="domain">[('is_labor', '=', True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='item_ids']/form//field[@name='uom_id']" position="attributes">
                <attribute name="required">True</attribute>
            </xpath>
            <xpath expr="//field[@name='item_ids']/form//field[@name='tarifa_trato']" position="replace"/>
            <xpath expr="//field[@name='item_ids']/form//field[@name='uom_trato']" position="replace"/>
        </field>
    </record>

    <record id="step_hr.step_product_pricelist_action_propio" model="ir.actions.act_window">
        <field name="view_id" ref="activity_pricelist_form"/>
    </record>
    <record id="step_hr.step_product_pricelist_action_contratista" model="ir.actions.act_window">
        <field name="view_id" ref="activity_pricelist_form"/>
    </record>
</odoo>
