<odoo>
    <record id="rule_advance_prices_companies" model="ir.rule">
        <field name="name">Anticipos: compañías de las listas</field><field name="model_id" ref="product.model_product_pricelist"/>
        <field name="domain_force">['|',('step_advance_price','=',False),('step_advance_company_ids','in',company_ids)]</field>
    </record>
    <record id="rule_advance_price_lines_companies" model="ir.rule">
        <field name="name">Anticipos: compañías de reglas</field><field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="domain_force">['|',('pricelist_id.step_advance_price','=',False),('pricelist_id.step_advance_company_ids','in',company_ids)]</field>
    </record>
    <record id="rule_advance_prices_account" model="ir.rule">
        <field name="name">Contabilidad: editar listas de anticipos</field><field name="model_id" ref="product.model_product_pricelist"/>
        <field name="groups" eval="[(4,ref('account.group_account_user'))]"/>
        <field name="domain_force">[('step_advance_price','=',True)]</field>
        <field name="perm_read" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_advance_lines_account" model="ir.rule">
        <field name="name">Contabilidad: editar reglas de anticipos</field><field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="groups" eval="[(4,ref('account.group_account_user'))]"/>
        <field name="domain_force">[('pricelist_id.step_advance_price','=',True)]</field>
        <field name="perm_read" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <!-- Restore the existing native editor groups when Accounting is also
         present. Group rules are ORed; global company rules still apply. -->
    <record id="rule_preserve_prices_native" model="ir.rule">
        <field name="name">Conservar edición nativa de tarifas</field><field name="model_id" ref="product.model_product_pricelist"/>
        <field name="groups" eval="[(4,ref('product.group_product_manager')),(4,ref('stock.group_stock_manager')),(4,ref('mrp.group_mrp_manager')),(4,ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[(1,'=',1)]</field><field name="perm_read" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_preserve_price_lines_native" model="ir.rule">
        <field name="name">Conservar edición nativa de reglas</field><field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="groups" eval="[(4,ref('product.group_product_manager')),(4,ref('stock.group_stock_manager')),(4,ref('mrp.group_mrp_manager')),(4,ref('sales_team.group_sale_manager')),(4,ref('purchase.group_purchase_manager'))]"/>
        <field name="domain_force">[(1,'=',1)]</field><field name="perm_read" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
</odoo>
