<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_list" model="ir.ui.view">
        <field name="name">step.assistant.knowledge.approval.list</field>
        <field name="model">step.assistant.knowledge.approval</field>
        <field name="arch" type="xml"><list string="Conocimiento aprobado"><field name="article_id"/><field name="published" widget="boolean_toggle"/><field name="company_id"/><field name="group_ids" widget="many2many_tags"/></list></field>
    </record>
    <record id="approval_form" model="ir.ui.view">
        <field name="name">step.assistant.knowledge.approval.form</field>
        <field name="model">step.assistant.knowledge.approval</field>
        <field name="arch" type="xml">
            <form string="Aprobar artículo de Conocimiento"><sheet>
                <div class="alert alert-info" role="status">Seleccione solo documentación verificada de ayuda para usuarios.
                    Aprobar una fuente no concede acceso: el asistente comprobará los permisos del artículo original en cada consulta.
                    El contenido se consulta directamente en Conocimiento y conserva sus actualizaciones.</div>
                <group><field name="article_id" options="{'no_create': True}"/><field name="published"/><field name="active"/><field name="company_id"/><field name="group_ids" widget="many2many_tags"/><field name="keywords"/></group>
            </sheet></form>
        </field>
    </record>
    <record id="action_approvals" model="ir.actions.act_window">
        <field name="name">Conocimiento aprobado</field><field name="res_model">step.assistant.knowledge.approval</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_approvals" name="Conocimiento aprobado" parent="step_support_assistant.menu_assistant_root" action="action_approvals" groups="step_support_assistant.group_assistant_manager" sequence="3"/>
</odoo>
