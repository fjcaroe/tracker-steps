<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_fruit_reception_import_form" model="ir.ui.view">
        <field name="name">step.fruit.reception.import.form</field>
        <field name="model">step.fruit.reception.import</field>
        <field name="arch" type="xml">
            <form string="Importar tarjas desde Excel">
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <div class="text-muted">Columnas: Tarja, Producto (referencia interna), Cantidad, Kilos, Cajas, Peso bruto, Destare. Asigne luego cada paquete a las operaciones de stock antes de validar.</div>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
