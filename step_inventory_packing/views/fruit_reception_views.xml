<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_steps_fruit_reception" model="ir.ui.view">
        <field name="name">stock.picking.form.steps.fruit.reception</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="step_packing.view_picking_form_packing_fruit"/>
        <field name="arch" type="xml">
            <field name="fruit_fundo_id" position="before">
                <field name="step_fruit_reception_kind" invisible="picking_type_code != 'incoming'"/>
            </field>
            <field name="fruit_weighing_type" position="after">
                <field name="step_fruit_weighing_method" invisible="not step_fruit_reception_kind"/>
                <field name="step_scale_profile_id" invisible="not step_fruit_reception_kind or step_fruit_weighing_method != 'scale'"
                       domain="[('company_id', '=', company_id)]"/>
                <field name="step_scale_protocol" invisible="1"/>
                <field name="step_scale_service_uuid" invisible="1"/>
                <field name="step_scale_characteristic_uuid" invisible="1"/>
                <field name="step_scale_serial_service_uuid" invisible="1"/>
                <field name="step_scale_baud_rate" invisible="1"/>
                <field name="step_scale_weight_pattern" invisible="1"/>
                <field name="step_scale_kg_factor" invisible="1"/>
                <field name="step_fruit_weighing_by" invisible="not step_fruit_reception_kind"/>
                <field name="step_fruit_guide_date" invisible="not step_fruit_reception_kind"/>
                <field name="step_fruit_cost_center" invisible="not step_fruit_reception_kind"/>
            </field>
            <field name="fruit_truck_plate" position="after">
                <field name="step_fruit_driver_id" invisible="not step_fruit_reception_kind"/>
                <field name="step_fruit_driver_vat" readonly="1" invisible="not step_fruit_reception_kind"/>
            </field>
            <field name="fruit_tag_line_ids" position="before">
                <button name="action_step_container_return" type="object"
                        string="Registrar envases recibidos" class="btn-secondary"
                        invisible="not step_fruit_reception_kind or state != 'done'"/>
                <field name="step_container_transfer_ids" readonly="1"
                       invisible="not step_fruit_reception_kind">
                    <list><field name="name"/><field name="direction"/>
                          <field name="state"/><field name="picking_id"/></list>
                </field>
                <group string="Pesaje de fruta" invisible="not step_fruit_reception_kind">
                    <field name="step_scale_capture" widget="step_scale_capture"
                           invisible="step_fruit_weighing_method != 'scale' or not step_scale_profile_id or state == 'done'"/>
                    <field name="step_scale_read_at" readonly="1" force_save="1" invisible="not step_scale_read_at"/>
                    <field name="step_scale_read_raw" readonly="1" force_save="1" invisible="not step_scale_read_raw"/>
                    <field name="step_fruit_gross_kg"/>
                    <field name="step_fruit_truck_tare_kg"/>
                    <field name="step_fruit_container_tare_kg"/>
                    <field name="step_fruit_transfer_tare_kg"/>
                    <field name="step_fruit_net_kg" readonly="1"/>
                </group>
                <button name="action_step_import_fruit_tags" type="object"
                        string="Importar tarjas Excel" class="btn-secondary"
                        invisible="not step_fruit_reception_kind or state == 'done'"/>
                <button name="action_prepare_fruit_stock" type="object" string="Preparar stock desde tarjas"
                        class="btn-secondary" invisible="not step_fruit_reception_kind or state in ('done','cancel') or move_ids"/>
            </field>
            <field name="kilos" position="after">
                <field name="package_id"/>
                <field name="product_id"/>
                <field name="stock_lot_id" domain="[('product_id','=',product_id),('company_id','=',parent.company_id)]" optional="hide"/>
                <field name="step_scale_profile_id" column_invisible="True"/>
                <field name="step_scale_protocol" column_invisible="True"/>
                <field name="step_scale_service_uuid" column_invisible="True"/>
                <field name="step_scale_characteristic_uuid" column_invisible="True"/>
                <field name="step_scale_serial_service_uuid" column_invisible="True"/>
                <field name="step_scale_baud_rate" column_invisible="True"/>
                <field name="step_scale_weight_pattern" column_invisible="True"/>
                <field name="step_scale_kg_factor" column_invisible="True"/>
                <field name="gross_kg"/>
                <field name="tare_kg"/>
                <field name="net_kg" readonly="1"/>
                <field name="step_scale_capture" widget="step_scale_capture"
                       invisible="not step_scale_profile_id"/>
                <field name="step_scale_read_at" optional="hide" readonly="1" force_save="1"/>
                <field name="step_scale_read_raw" column_invisible="True" readonly="1" force_save="1"/>
                <field name="box_count"/>
            </field>
        </field>
    </record>

    <record id="action_steps_fruit_process_reception" model="ir.actions.act_window">
        <field name="name">Recepción de fruta a proceso</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_code', '=', 'incoming'), ('step_fruit_reception_kind', '=', 'process')]</field>
        <field name="context">{'default_step_fruit_reception_kind': 'process', 'restricted_picking_type_code': 'incoming'}</field>
    </record>
    <record id="action_steps_fruit_packed_reception" model="ir.actions.act_window">
        <field name="name">Recepción de fruta embalada</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_code', '=', 'incoming'), ('step_fruit_reception_kind', '=', 'packed')]</field>
        <field name="context">{'default_step_fruit_reception_kind': 'packed', 'restricted_picking_type_code': 'incoming'}</field>
    </record>
    <menuitem id="menu_steps_fruit_process_reception" name="Fruta a proceso"
              parent="step_packing.menu_packing_fruta_receptions"
              action="action_steps_fruit_process_reception" sequence="11" groups="stock.group_stock_user"/>
    <menuitem id="menu_steps_fruit_packed_reception" name="Fruta embalada"
              parent="step_packing.menu_packing_fruta_receptions"
              action="action_steps_fruit_packed_reception" sequence="12" groups="stock.group_stock_user"/>
</odoo>
