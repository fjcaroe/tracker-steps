<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quant_package_form_steps_fruit" model="ir.ui.view">
        <field name="name">stock.quant.package.form.steps.fruit</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="step_inventory_fruit_tag.view_quant_package_form_fruit_tag"/>
        <field name="arch" type="xml">
            <field name="fundo_id" position="after">
                <field name="step_producer_id"/>
                <field name="step_producer_code" readonly="1"/>
                <field name="step_sdp_code" readonly="1"/>
            </field>
            <field name="process_type" position="after">
                <field name="packing_plant" position="move"/>
            </field>
            <field name="quant_ids" position="before">
                <group string="Control de tarja" invisible="not is_fruit_tag">
                    <group>
                        <field name="step_tag_kind"/>
                        <field name="step_tag_state"/>
                        <field name="step_filling" readonly="1"/>
                        <field name="step_composition" readonly="1"/>
                        <field name="step_actual_kg" readonly="1"/>
                        <button name="action_step_validate_tag" type="object" string="Validar tarja"
                                class="btn-primary" invisible="step_tag_state != 'created'"/>
                    </group>
                    <group string="Salida / venta">
                        <group>
                        <field name="step_document_company_id" invisible="1"/>
                        <field name="step_export_shipment_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('company_id','=',step_document_company_id)]"/>
                        <field name="step_guide_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('company_id','=',step_document_company_id)]"/>
                        <field name="step_dus_shipment_ids" widget="many2many_tags" options="{'no_create': True}" context="{'step_document_reference':'dus_folio'}" domain="[('id','in',step_export_shipment_ids),('dus_folio','!=',False)]"/>
                        <field name="step_invoice_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('company_id','=',step_document_company_id),('move_type','in',['out_invoice','out_refund'])]"/>
                        <field name="step_bl_shipment_ids" widget="many2many_tags" options="{'no_create': True}" context="{'step_document_reference':'bl_folio'}" domain="[('id','in',step_export_shipment_ids),('bl_folio','!=',False)]"/>
                        </group>
                        <group string="Referencias históricas" invisible="not (step_shipment or step_dispatch_guide or step_dus or step_invoice or step_bl_awb)">
                            <field name="step_shipment" readonly="1"/>
                            <field name="step_dispatch_guide" readonly="1"/>
                            <field name="step_dus" readonly="1"/>
                            <field name="step_invoice" readonly="1"/>
                            <field name="step_bl_awb" readonly="1"/>
                        </group>
                    </group>
                    <field name="step_tag_line_ids">
                        <list editable="bottom">
                            <field name="producer_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="kilos" sum="Kilos"/>
                            <field name="boxes" sum="Cajas"/>
                        </list>
                    </field>
                </group>
            </field>
        </field>
    </record>

    <record id="action_steps_fruit_packages" model="ir.actions.act_window">
        <field name="name">Tarjas de fruta</field>
        <field name="res_model">stock.quant.package</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_fruit_tag', '=', True)]</field>
        <field name="context">{'default_is_fruit_tag': True}</field>
    </record>
    <menuitem id="menu_steps_fruit_packages" name="Tarjas de fruta"
              parent="step_packing.menu_packing_fruta_operations"
              action="action_steps_fruit_packages" sequence="25" groups="stock.group_stock_user"/>
</odoo>
