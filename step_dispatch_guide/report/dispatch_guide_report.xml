<odoo>
    <record id="action_report_dispatch_guide" model="ir.actions.report"><field name="name">Guía de despacho interna</field><field name="model">step.dispatch.guide</field><field name="report_type">qweb-pdf</field><field name="report_name">step_dispatch_guide.report_dispatch_guide</field><field name="report_file">step_dispatch_guide.report_dispatch_guide</field><field name="binding_model_id" ref="model_step_dispatch_guide"/><field name="binding_type">report</field></record>
    <template id="report_dispatch_guide"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><div class="row"><div class="col-8"><h2>GUÍA DE DESPACHO</h2><p><strong t-field="o.company_id.name"/><br/><span t-field="o.company_id.vat"/><br/><span t-field="o.company_id.contact_address"/></p></div><div class="col-4 border text-center"><h3>Folio <span t-field="o.external_folio"/></h3><small>Documento interno no tributario</small></div></div><hr/><div class="row"><div class="col-6"><strong>Receptor:</strong> <span t-field="o.partner_id"/><br/><strong>RUT:</strong> <span t-field="o.partner_id.vat"/><br/><strong>Giro:</strong> <span t-field="o.receiver_activity"/></div><div class="col-6"><strong>Fecha:</strong> <span t-field="o.date"/><br/><strong>Origen:</strong> <span t-field="o.origin_address"/><br/><strong>Destino:</strong> <span t-field="o.destination_address"/><br/><strong>Motivo:</strong> <span t-field="o.transfer_reason"/></div></div><table class="table table-sm mt-3"><thead><tr><th>Código</th><th>Descripción</th><th>UM</th><th class="text-end">Cantidad</th><th class="text-end">Bins</th><th class="text-end">Kilos</th><th class="text-end">Valor</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="l"><td><span t-field="l.product_id.default_code"/></td><td><span t-field="l.description"/></td><td><span t-field="l.product_uom_id"/></td><td class="text-end"><span t-field="l.quantity"/></td><td class="text-end"><span t-field="l.bin_count"/></td><td class="text-end"><span t-field="l.quantity_kg"/></td><td class="text-end"><span t-field="l.subtotal"/></td></tr></tbody></table><div class="row"><div class="col-6"><p><strong>Transportista:</strong> <span t-field="o.carrier_id"/> — <span t-field="o.carrier_id.vat"/><br/><strong>Chofer:</strong> <span t-field="o.driver_id.name"/> — <span t-field="o.driver_id.vat"/><br/><strong>Patente camión:</strong> <span t-field="o.truck_plate"/><br/><strong>Patente carro:</strong> <span t-field="o.trailer_plate"/></p></div><div class="col-6"><p><strong>Total bins:</strong> <span t-field="o.total_bins"/><br/><strong>Total kilos:</strong> <span t-field="o.total_kilos"/><br/><strong>Bins vacíos devolución:</strong> <span t-field="o.empty_bins_return"/></p><p t-if="o.globalgap_certified"><strong>Fruta certificada GLOBALG.A.P.</strong> — GGN <span t-field="o.ggn"/></p><p t-if="o.csg"><strong>CSG:</strong> <span t-field="o.csg"/></p></div></div></div></t></t></t></template>
</odoo>

