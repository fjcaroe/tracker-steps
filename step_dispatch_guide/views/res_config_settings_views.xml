<odoo>
    <record id="res_config_settings_view_form_dispatch" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dispatch.guide</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Guías de despacho" name="step_dispatch_guide">
                    <block title="Documento de despacho">
                        <setting string="Proveedor DTE" help="Tercero usa un folio externo y no emite un documento tributario desde Odoo.">
                            <field name="dispatch_dte_provider"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>

