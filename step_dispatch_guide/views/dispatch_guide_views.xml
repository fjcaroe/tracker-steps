<odoo>
    <record id="view_dispatch_guide_list" model="ir.ui.view">
        <field name="name">step.dispatch.guide.list</field><field name="model">step.dispatch.guide</field>
        <field name="arch" type="xml"><list decoration-muted="state == 'cancelled'" decoration-success="state == 'confirmed'"><field name="name"/><field name="external_folio"/><field name="date"/><field name="partner_id"/><field name="origin_address" optional="hide"/><field name="destination_address"/><field name="total_bins"/><field name="total_kilos"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field>
    </record>
    <record id="view_dispatch_guide_form" model="ir.ui.view">
        <field name="name">step.dispatch.guide.form</field><field name="model">step.dispatch.guide</field>
        <field name="arch" type="xml"><form string="Guía de despacho"><header><button name="action_confirm" type="object" string="Confirmar" class="oe_highlight" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Anular" invisible="state == 'cancelled'"/><button name="action_draft" type="object" string="Volver a borrador" invisible="state != 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/></header><sheet><div class="oe_title"><label for="external_folio"/><h1><field name="external_folio" placeholder="Folio del proveedor DTE"/></h1><h2><field name="name" readonly="1"/></h2></div><group><group><field name="date"/><field name="partner_id"/><field name="receiver_activity"/><field name="reference"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="picking_id"/><field name="freight_order_id"/><field name="currency_id" invisible="1"/></group></group><group string="Traslado"><group><field name="origin_address"/><field name="destination_address"/><field name="transfer_reason"/></group><group><field name="carrier_id"/><field name="driver_id"/><field name="truck_plate"/><field name="trailer_plate"/></group></group><notebook><page string="Detalle"><field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="product_id"/><field name="description"/><field name="product_uom_id"/><field name="quantity"/><field name="bin_count"/><field name="quantity_kg"/><field name="price_unit" optional="hide"/><field name="subtotal" optional="hide"/><field name="currency_id" column_invisible="True"/></list></field><group class="oe_subtotal_footer oe_right"><field name="total_bins"/><field name="total_kilos"/><field name="amount_untaxed"/></group></page><page string="Fruta y certificación"><group><field name="empty_bins_return"/><field name="globalgap_certified"/><field name="ggn" invisible="not globalgap_certified"/><field name="csg"/></group></page><page string="Notas"><field name="note"/></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="action_dispatch_guides" model="ir.actions.act_window"><field name="name">Guías de despacho</field><field name="res_model">step.dispatch.guide</field><field name="view_mode">list,form</field></record>
    <record id="action_dispatch_drivers" model="ir.actions.act_window"><field name="name">Choferes</field><field name="res_model">step.dispatch.driver</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_dispatch_root" name="Guías de despacho" sequence="28" web_icon="stock,static/description/icon.png"/>
    <menuitem id="menu_dispatch_guides" name="Guías" parent="menu_dispatch_root" action="action_dispatch_guides" sequence="10"/>
    <menuitem id="menu_dispatch_configuration" name="Configuración" parent="menu_dispatch_root" sequence="90" groups="stock.group_stock_manager"/>
    <menuitem id="menu_dispatch_drivers" name="Choferes" parent="menu_dispatch_configuration" action="action_dispatch_drivers" sequence="10"/>
</odoo>

