<?xml version='1.0' encoding='utf-8'?>
<odoo><template id="commercial_document">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="doc.with_context(lang='en_US')"/>
            <t t-set="values" t-value="doc._step_export_report_values()"/>
            <div class="page step_export_document">
                <style>
                    .step_export_document {font-family: Arial, sans-serif; font-size: 11px; color: #111;}
                    .step_export_document table {width: 100%; border-collapse: collapse; table-layout: fixed;}
                    .step_export_document td, .step_export_document th {border: 1px solid #aaa; padding: 5px; vertical-align: top; overflow-wrap: break-word;}
                    .step_export_document .identity td {height: 105px; vertical-align: middle;}
                    .step_export_document .identity .company {text-align: center;}
                    .step_export_document .title {text-align: center; font-size: 15px; font-weight: bold;}
                    .step_export_document .lines thead {display: table-header-group;}
                    .step_export_document .lines tr {page-break-inside: avoid;}
                    .step_export_document .lines td {height: 23px;}
                    .step_export_document .num {text-align: right;}
                    .step_export_document .closing {page-break-inside: avoid; margin-top: 10px;}
                    .step_export_document .wire {min-height: 180px;}
                    .step_export_document .totals td {border: 0; padding: 5px 3px;}
                    .step_export_document .muted {color: #666; font-size: 10px;}
                </style>
                <table class="identity"><tr>
                    <td style="width: 25%; text-align: center;"><img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="max-width: 130px; max-height: 90px;"/></td>
                    <td class="company" style="width: 37%;"><strong t-field="doc.company_id.name"/><br/><br/>R.U.T.: <span t-field="doc.company_id.vat"/>
                        <div t-field="doc.company_id.partner_id" t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/></td>
                    <td class="title" style="width: 38%;"><span t-out="'INVOICE' if step_is_invoice else 'PROFORMA'"/><br/><br/>N° <span t-field="doc.export_document_number"/><div style="font-size: 11px; margin-top: 8px;" t-field="doc.currency_id.name"/></td>
                </tr></table>
                <table><tr>
                    <td style="width: 62%;"><strong>Customer: </strong><span t-field="doc.partner_id.name"/><br/><br/>Tax ID: <span t-field="doc.partner_id.vat"/><br/>Address:
                        <div t-field="doc.partner_id" t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"/>
                        <div t-if="doc.client_order_ref">Reference: <span t-field="doc.client_order_ref"/></div></td>
                    <td style="width: 38%;"><strong>DATE: </strong><span t-field="doc.date_order" t-options="{'widget': 'date'}"/><br/>
                        <strong>Incoterm: </strong><span t-if="values['incoterm']" t-out="values['incoterm'].code"/> <span t-field="doc.incoterm_location"/><br/>
                        <strong>Shipment: </strong><span t-field="doc.step_export_shipment_id.shipment_number"/><br/><br/>
                        <strong>Sales note: </strong><span t-field="doc.export_document_number"/></td>
                </tr></table>
                <table class="lines"><thead><tr><th style="width: 50%;">Product details</th><th style="width: 10%;">Net kg</th><th style="width: 10%;">Boxes</th><th style="width: 14%;">Unit price</th><th style="width: 16%;">TOTAL</th></tr></thead><tbody>
                    <t t-foreach="values['lines']" t-as="line"><tr>
                        <td t-if="line.display_type" colspan="5"><strong t-if="line.display_type == 'line_section'" t-field="line.name"/><span t-else="" t-field="line.name"/></td>
                        <t t-else=""><td><span t-field="line.name"/><div class="muted"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom"/><span t-if="line.discount"> · Discount <span t-field="line.discount"/>%</span></div></td>
                            <td class="num"><span t-out="line.step_document_kg if doc.step_box_pricing else line.step_export_kg"/></td><td class="num"><span t-out="line.product_uom_qty if doc.step_box_pricing else line.step_export_boxes"/></td>
                            <td class="num"><span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/><div class="muted" t-if="doc.step_box_pricing" t-out="'per kg' if doc.step_price_kg else 'per box'"/></td>
                            <td class="num"><span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></t>
                    </tr></t>
                    <tr t-foreach="range(max(0, 10 - len(values['lines'])))" t-as="blank"><td> </td><td/><td/><td/><td/></tr>
                </tbody></table>
                <div class="closing">
                    <table><tr><td><strong>Remarks:</strong><div t-field="doc.note"/><div t-if="doc.payment_term_id"><strong>Payment terms: </strong><span t-field="doc.payment_term_id.name"/></div></td></tr></table>
                    <table><tr>
                        <td style="width: 70%;"><div class="wire"><strong>Wire Instructions:</strong><br/><br/>
                            <t t-if="values['bank']"><t t-set="bank" t-value="values['bank']"/>
                                <strong t-field="bank.bank_id.name"/><br/>BANK INFORMATION<br/><span t-field="doc.currency_id.name"/><br/>
                                ADDRESS: <span t-field="bank.bank_id.street"/> <span t-field="bank.bank_id.street2"/> <span t-field="bank.bank_id.city"/> <span t-field="bank.bank_id.country.name"/><br/>
                                ACCOUNT: <span t-field="bank.acc_number"/><br/>SWIFT: <span t-field="bank.bank_id.bic"/><br/>
                                ABA: <span t-field="bank.bank_id.step_aba_routing"/><br/><br/>Beneficiary Name: <span t-out="bank.acc_holder_name or bank.partner_id.name"/>
                            </t><t t-else=""><span class="muted">Bank instructions pending configuration.</span></t>
                        </div><div t-if="doc.signature"><img t-att-src="image_data_uri(doc.signature)" style="max-height: 50px; max-width: 160px;"/><br/><span t-field="doc.signed_by"/></div></td>
                        <td style="width: 30%; vertical-align: bottom;"><table class="totals">
                            <tr><td>Sub total</td><td class="num"><span t-out="values['subtotal']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                            <tr><td>Freight</td><td class="num"><span t-out="values['freight']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                            <tr><td>Insurance</td><td class="num"><span t-out="values['insurance']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                            <tr t-if="doc.amount_tax"><td>Taxes</td><td class="num"><span t-field="doc.amount_tax" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                            <tr style="border-top: 1px solid #aaa;"><td><strong>Total</strong></td><td class="num"><strong t-field="doc.amount_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td></tr>
                        </table></td>
                    </tr></table>
                </div>
            </div>
        </t>
    </template>
<record id="action_commercial_invoice" model="ir.actions.report">
  <field name="name">INVOICE comercial</field><field name="model">sale.order</field><field name="report_type">qweb-pdf</field>
  <field name="report_name">step_export_document_revision.commercial_invoice</field><field name="binding_model_id" ref="sale.model_sale_order"/>
  <field name="binding_type">report</field><field name="paperformat_id" ref="step_sale_export_report.paperformat_export_sale"/>
  <field name="print_report_name">'INVOICE - %s' % object.export_document_number</field>
 </record>
 <template id="commercial_invoice"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-set="step_is_invoice" t-value="True"/><t t-call="step_export_document_revision.commercial_document" t-lang="'en_US'"/></t></t></template>
 <template id="english_proforma" inherit_id="step_sale_export_report.document">
  <xpath expr="//t[@t-call='web.basic_layout']" position="before"><t t-if="step_is_proforma"><t t-set="step_is_invoice" t-value="False"/><t t-call="step_export_document_revision.commercial_document" t-lang="'en_US'"/></t></xpath>
  <xpath expr="//t[@t-call='web.basic_layout']" position="attributes"><attribute name="t-if">not step_is_proforma</attribute></xpath>
  <xpath expr="//span[@t-field='line.step_export_kg']" position="replace"><span t-out="line.step_document_kg if doc.step_box_pricing else line.step_export_kg"/></xpath>
  <xpath expr="//span[@t-field='line.step_export_boxes']" position="replace"><span t-out="line.product_uom_qty if doc.step_box_pricing else line.step_export_boxes"/></xpath>
 </template>
</odoo>
