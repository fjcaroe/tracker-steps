<odoo>
  <record id="rule_contract_holding_read" model="ir.rule">
    <field name="name">Contratos holding: lectura de matriz autorizada</field>
    <field name="model_id" ref="step_producers.model_step_producer_purchase_contract"/>
    <field name="domain_force">[('company_id', 'parent_of', company_ids), ('company_id', 'in', user.company_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
