<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_freight_tariff_code_list" model="ir.ui.view">
        <field name="name">x.tarifa.flete.code.list</field>
        <field name="model">step.freight.tariff</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="freight_carrier_id" />
                <field name="effective_from" />
                <field name="effective_to" />
                <field name="tariff_state" widget="badge" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_freight_tariff_code_form" model="ir.ui.view">
        <field name="name">x.tarifa.flete.code.form</field>
        <field name="model">step.freight.tariff</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="tariff_state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="freight_carrier_id" />
                            <field name="fundo_id" />
                            <field name="company_id" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="effective_from" />
                            <field name="effective_to" />
                            <field name="responsible_id" />
                            <field name="approver_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Tarifas">
                            <field name="tariff_line_ids">
                                <list editable="bottom">
                                    <field name="name" optional="hide" />
                                    <field name="service_product_id" />
                                    <field name="route_id" context="{'form_view_ref': 'step_operations_ui.view_freight_route_form'}" options="{'no_quick_create': True}" />
                                    <field name="km_from" readonly="1" />
                                    <field name="km_to" readonly="1" />
                                    <field name="cold_mode_id" context="{'form_view_ref': 'step_operations_ui.view_freight_cold_mode_form'}" />
                                    <field name="tariff_basis" />
                                    <field name="currency_id" />
                                    <field name="freight_rate" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_freight_order_code_list" model="ir.ui.view">
        <field name="name">x.orden.flete.code.list</field>
        <field name="model">step.freight.order</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date" />
                <field name="freight_carrier_id" />
                <field name="price_list_id" /><field name="cold_mode_id" context="{'form_view_ref': 'step_operations_ui.view_freight_cold_mode_form'}"/>
                <field name="freight_total" sum="Total" />
                <field name="freight_state" widget="badge" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_freight_order_code_form" model="ir.ui.view">
        <field name="name">x.orden.flete.code.form</field>
        <field name="model">step.freight.order</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cost_freight" type="object" string="Calcular costeo" class="oe_highlight" invisible="freight_move_id" />
                    <button name="action_post_freight" type="object" string="Contabilizar" groups="account.group_account_user" invisible="freight_move_id or not cost_ids" />
                    <field name="freight_state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="description" />
                            <field name="date" />
                            <field name="freight_carrier_id" />
                            <field name="price_list_id" /><field name="cold_mode_id" context="{'form_view_ref': 'step_operations_ui.view_freight_cold_mode_form'}"/>
                            <field name="cold_mode_id" context="{'form_view_ref': 'step_operations_ui.view_freight_cold_mode_form'}" />
                        </group>
                        <group>
                            <field name="fundo_id" />
                            <field name="responsible_id" />
                            <field name="sale_order_id" />
                            <field name="purchase_order_id" />
                            <field name="company_id" />
                            <field name="freight_move_id" readonly="1" />
                        </group>
                    </group>
                    <field name="instructions" />
                    <notebook>
                        <page string="Detalles">
                            <field name="detail_ids" readonly="freight_move_id">
                                <list editable="bottom">
                                    <field name="name" optional="hide" />
                                    <field name="vehicle_id" />
                                    <field name="driver_id" />
                                    <field name="route_id" context="{'form_view_ref': 'step_operations_ui.view_freight_route_form'}" options="{'no_quick_create': True}" />
                                    <field name="service_product_id" />
                                    <field name="cargo_description" />
                                    <field name="delivery_reference" />
                                    <field name="uom_id" />
                                    <field name="quantity" />
                                    <field name="unit_rate" />
                                    <field name="freight_value" readonly="1" sum="Total" />
                                </list>
                            </field>
                        </page>
                        <page string="Costeo">
                            <field name="cost_ids" readonly="freight_move_id">
                                <list editable="bottom">
                                    <field name="name" optional="hide" />
                                    <field name="service_product_id" />
                                    <field name="freight_cost" sum="Total" />
                                    <field name="expense_account_id" readonly="1" />
                                                                        <field name="analytic_distribution" widget="analytic_distribution" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer"><field name="freight_total" readonly="1" /></group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_freight_tariff_code_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_freight_tariff_code_list" />
        <field name="act_window_id" ref="step_operations_ui.tarifa_de_fletes_dcc8390a-9e92-4f69-b5cc-2dcb3e27bb2d" />
    </record>
    <record id="action_freight_tariff_code_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_freight_tariff_code_form" />
        <field name="act_window_id" ref="step_operations_ui.tarifa_de_fletes_dcc8390a-9e92-4f69-b5cc-2dcb3e27bb2d" />
    </record>
    <record id="action_freight_order_code_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_freight_order_code_list" />
        <field name="act_window_id" ref="step_operations_ui.orden_de_flete_104802ff-cd72-4d5a-886e-66109a2b7833" />
    </record>
    <record id="action_freight_order_code_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_freight_order_code_form" />
        <field name="act_window_id" ref="step_operations_ui.orden_de_flete_104802ff-cd72-4d5a-886e-66109a2b7833" />
    </record>

    <record id="res_config_settings_view_form_freight" model="ir.ui.view">
        <field name="name">res.config.settings.form.freight</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Fletes" name="step_operations_ui">
                    <block title="Contabilización de fletes">
                        <setting id="freight_provision_journal" string="Diario de provisión" help="Use un diario general cuya cuenta predeterminada sea el pasivo de provisión de fletes.">
                            <field name="freight_provision_journal_id" options="{'no_create': True}" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_freight_settings" model="ir.actions.act_window">
        <field name="name">Ajustes de fletes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'step_operations_ui', 'bin_size': False}</field>
    </record>
    <menuitem id="menu_freight_settings" name="Ajustes" action="action_freight_settings" parent="menu_freight_configuration" sequence="80" groups="account.group_account_manager" />
    <record id="view_partner_form_freight_carrier" model="ir.ui.view">
        <field name="name">res.partner.form.freight.carrier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="is_freight_carrier" />
            </field>
        </field>
    </record>
</odoo>