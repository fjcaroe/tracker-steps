<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_freight_cost_report_list" model="ir.ui.view">
        <field name="name">step.freight.cost.report.list.steps</field>
        <field name="model">step.freight.cost.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="order_date"/>
                <field name="order_id"/>
                <field name="route_id"/>
                <field name="carrier_id"/>
                <field name="product_id"/>
                <field name="account_id"/>
                <field name="amount" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_freight_cost_report_pivot" model="ir.ui.view">
        <field name="name">step.freight.cost.report.pivot.steps</field>
        <field name="model">step.freight.cost.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="order_date" type="row" interval="week"/>
                <field name="product_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_freight_plan_vs_actual_list" model="ir.ui.view">
        <field name="name">step.freight.plan.vs.actual.list.steps</field>
        <field name="model">step.freight.plan.vs.actual</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="week_start"/>
                <field name="product_id"/>
                <field name="planned_amount" sum="Total"/>
                <field name="real_amount" sum="Total"/>
                <field name="diff_amount" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_freight_plan_vs_actual_pivot" model="ir.ui.view">
        <field name="name">step.freight.plan.vs.actual.pivot.steps</field>
        <field name="model">step.freight.plan.vs.actual</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="week_start" type="row"/>
                <field name="product_id" type="col"/>
                <field name="planned_amount" type="measure"/>
                <field name="real_amount" type="measure"/>
                <field name="diff_amount" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
