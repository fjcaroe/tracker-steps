<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_freight_tariff_code_list" model="ir.ui.view">
        <field name="name">x.tarifa.flete.code.list</field>
        <field name="model">x_tarifa_de_fletes</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
                <field name="x_studio_transportista"/>
                <field name="x_studio_vigencia_desde"/>
                <field name="x_studio_vigencia_hasta"/>
                <field name="x_studio_selection_field_8tm_1jhk3i2t3" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_freight_tariff_code_form" model="ir.ui.view">
        <field name="name">x.tarifa.flete.code.form</field>
        <field name="model">x_tarifa_de_fletes</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="x_studio_selection_field_8tm_1jhk3i2t3" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_studio_transportista"/>
                            <field name="x_studio_fundo"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="x_studio_fecha"/>
                            <field name="x_studio_vigencia_desde"/>
                            <field name="x_studio_vigencia_hasta"/>
                            <field name="x_studio_responsable"/>
                            <field name="x_studio_autoriza"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tarifas">
                            <field name="x_studio_one2many_field_61q_1jhk3j03r">
                                <list editable="bottom">
                                    <field name="x_name" optional="hide"/>
                                    <field name="service_product_id"/>
                                    <field name="x_studio_tramo_de_flete"/>
                                    <field name="x_studio_km_desde" readonly="1"/>
                                    <field name="x_studio_km_hasta" readonly="1"/>
                                    <field name="x_studio_modalidad_de_fro"/>
                                    <field name="x_studio_modalidad_de_tarifa"/>
                                    <field name="x_studio_moneda"/>
                                    <field name="x_studio_tarifa_flete"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_freight_order_code_list" model="ir.ui.view">
        <field name="name">x.orden.flete.code.list</field>
        <field name="model">x_orden_de_flete</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
                <field name="x_studio_fecha"/>
                <field name="x_studio_transportista"/>
                <field name="x_studio_lista_de_tarifa_flete"/>
                <field name="freight_total" sum="Total"/>
                <field name="x_studio_selection_field_4ag_1jhk4c7s5" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_freight_order_code_form" model="ir.ui.view">
        <field name="name">x.orden.flete.code.form</field>
        <field name="model">x_orden_de_flete</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cost_freight" type="object" string="Calcular costeo"
                            class="oe_highlight" invisible="freight_move_id"/>
                    <button name="action_post_freight" type="object" string="Contabilizar"
                            groups="account.group_account_user"
                            invisible="freight_move_id or not x_studio_one2many_field_8gj_1jhk6aj15"/>
                    <field name="x_studio_selection_field_4ag_1jhk4c7s5" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_studio_orden_de_flete"/>
                            <field name="x_studio_fecha"/>
                            <field name="x_studio_transportista"/>
                            <field name="x_studio_lista_de_tarifa_flete"/>
                            <field name="cold_mode_id"/>
                        </group>
                        <group>
                            <field name="x_studio_fundo"/>
                            <field name="x_studio_responsable"/>
                            <field name="x_studio_pedido_de_venta"/>
                            <field name="x_studio_orden_de_compra"/>
                            <field name="company_id"/>
                            <field name="freight_move_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="x_studio_instrucciones_del_flete"/>
                    <notebook>
                        <page string="Detalles">
                            <field name="x_studio_one2many_field_9na_1jhk4lspn" readonly="freight_move_id">
                                <list editable="bottom">
                                    <field name="x_name" optional="hide"/>
                                    <field name="x_studio_camin"/>
                                    <field name="x_studio_chofer"/>
                                    <field name="x_studio_tramo"/>
                                    <field name="service_product_id"/>
                                    <field name="x_studio_detalle_carga"/>
                                    <field name="x_studio_gua_referencia"/>
                                    <field name="x_studio_unidad"/>
                                    <field name="x_studio_cantidad"/>
                                    <field name="x_studio_tarifa"/>
                                    <field name="x_studio_valor_del_flete" readonly="1" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Costeo">
                            <field name="x_studio_one2many_field_8gj_1jhk6aj15" readonly="freight_move_id">
                                <list editable="bottom">
                                    <field name="x_name" optional="hide"/>
                                    <field name="x_studio_servicio_flete"/>
                                    <field name="x_studio_costo_flete" sum="Total"/>
                                    <field name="x_studio_cuenta" readonly="1"/>
                                                                        <field name="analytic_distribution" widget="analytic_distribution"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer"><field name="freight_total" readonly="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_freight_tariff_code_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_freight_tariff_code_list"/>
        <field name="act_window_id" ref="step_operations_ui.tarifa_de_fletes_dcc8390a-9e92-4f69-b5cc-2dcb3e27bb2d"/>
    </record>
    <record id="action_freight_tariff_code_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_freight_tariff_code_form"/>
        <field name="act_window_id" ref="step_operations_ui.tarifa_de_fletes_dcc8390a-9e92-4f69-b5cc-2dcb3e27bb2d"/>
    </record>
    <record id="action_freight_order_code_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_freight_order_code_list"/>
        <field name="act_window_id" ref="step_operations_ui.orden_de_flete_104802ff-cd72-4d5a-886e-66109a2b7833"/>
    </record>
    <record id="action_freight_order_code_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_freight_order_code_form"/>
        <field name="act_window_id" ref="step_operations_ui.orden_de_flete_104802ff-cd72-4d5a-886e-66109a2b7833"/>
    </record>

    <record id="res_config_settings_view_form_freight" model="ir.ui.view">
        <field name="name">res.config.settings.form.freight</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Fletes" name="step_operations_ui">
                    <block title="Contabilización de fletes">
                        <setting id="freight_provision_journal" string="Diario de provisión"
                                 help="Use un diario general cuya cuenta predeterminada sea el pasivo de provisión de fletes.">
                            <field name="freight_provision_journal_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_freight_settings" model="ir.actions.act_window">
        <field name="name">Ajustes de fletes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'step_operations_ui', 'bin_size': False}</field>
    </record>
    <menuitem id="menu_freight_settings" name="Ajustes" action="action_freight_settings"
              parent="menu_freight_configuration" sequence="80" groups="account.group_account_manager"/>
    <record id="view_partner_form_freight_carrier" model="ir.ui.view">
        <field name="name">res.partner.form.freight.carrier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="is_freight_carrier"/>
            </field>
        </field>
    </record>
</odoo>
