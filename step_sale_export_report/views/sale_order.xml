<odoo>
    <record id="sale_order_form" model="ir.ui.view">
        <field name="name">sale.order.export.print.quantities</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside"><field name="step_export_sale_format" invisible="1"/></xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="step_export_kg" optional="show" column_invisible="not parent.step_export_sale_format"/>
                <field name="step_export_boxes" optional="show" column_invisible="not parent.step_export_sale_format"/>
                <field name="step_export_charge" optional="show" column_invisible="not parent.step_export_sale_format"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="after">
                <field name="step_export_kg"/>
                <field name="step_export_boxes"/>
                <field name="step_export_charge"/>
            </xpath>
        </field>
    </record>
</odoo>
