<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tracker" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.steps.tracker</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="75"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Steps Tracker" string="Steps Tracker" name="step_tracker_odoo">
                    <block title="Conexión con Web Tracker" name="step_tracker_connection">
                        <setting id="step_tracker_base_url" title="URL del backend de Web Tracker">
                            <field name="step_tracker_base_url" placeholder="https://stepsapp.cl/tracker-steps"/>
                        </setting>
                        <setting id="step_tracker_credentials" title="Cuenta de servicio usada para sincronizar">
                            <field name="step_tracker_username" placeholder="Usuario de servicio"/>
                            <field name="step_tracker_password" password="True" placeholder="Contraseña"/>
                        </setting>
                        <setting id="step_tracker_sync_enabled" title="Sincronización automática cada 15 minutos">
                            <field name="step_tracker_sync_enabled"/>
                        </setting>
                        <setting id="step_tracker_sync_now" title="Probar la conexión y traer datos ahora">
                            <button name="action_step_tracker_sync_now" type="object" string="Sincronizar ahora" class="btn-primary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_step_tracker_configuration" model="ir.actions.act_window">
        <field name="name">Configuración Steps Tracker</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'step_tracker_odoo', 'bin_size': False}</field>
    </record>
</odoo>
