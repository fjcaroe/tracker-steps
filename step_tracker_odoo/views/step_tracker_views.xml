              action="action_step_tracker_work_order_analysis"
              parent="menu_step_tracker_reports"
              sequence="20"/>
    <menuitem id="menu_step_tracker_masters"
              name="Maestros"
              parent="menu_step_tracker_gps_root"
              sequence="30"/>
    <menuitem id="menu_step_tracker_gps_machines"
              name="Máquinas"
              action="action_step_tracker_machine"
              parent="menu_step_tracker_masters"
              sequence="20"/>
    <menuitem id="menu_step_tracker_gps_drivers"
              name="Conductores"
