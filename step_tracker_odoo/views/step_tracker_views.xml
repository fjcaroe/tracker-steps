              sequence="10"/>
    <menuitem id="menu_step_tracker_gps_sessions"
              name="Sesiones"
              action="action_step_tracker_session"
              parent="menu_step_tracker_operation"
              sequence="10"/>
    <menuitem id="menu_step_tracker_gps_work_orders"
              name="Partes diarios"
              action="action_step_tracker_work_order"
              parent="menu_step_tracker_operation"
              sequence="20"/>
    <menuitem id="menu_step_tracker_reports"
              name="Reportes"
              parent="menu_step_tracker_gps_root"
              sequence="20"/>
    <menuitem id="menu_step_tracker_session_analysis"
