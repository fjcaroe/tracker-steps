              sequence="40"/>
    <menuitem id="menu_step_tracker_gps_activities"
              name="Actividades"
              action="action_step_tracker_activity"
              parent="menu_step_tracker_masters"
              sequence="41"/>
    <menuitem id="menu_step_tracker_gps_labors"
              name="Labores"
              action="action_step_tracker_labor"
              parent="menu_step_tracker_masters"
              sequence="42"/>
    <menuitem id="menu_step_tracker_gps_implements"
              name="Implementos"
              action="action_step_tracker_implement"
              parent="menu_step_tracker_masters"
              sequence="43"/>
    <menuitem id="menu_step_tracker_open_web"
              name="Abrir mapa Web Tracker"
              action="action_step_tracker_open_web"
              parent="menu_step_tracker_gps_root"
              sequence="40"/>
    <menuitem id="menu_step_tracker_integration"
              name="Integración"
              parent="menu_step_tracker_gps_root"
              sequence="50"
              groups="base.group_system"/>
    <menuitem id="menu_step_tracker_gps_sync_log"
              name="Sincronizaciones"
              action="action_step_tracker_sync_log"
              parent="menu_step_tracker_integration"
              sequence="50"
              groups="base.group_system"/>
    <menuitem id="menu_step_tracker_gps_settings"
              name="Configuración"
              action="step_tracker_odoo.action_step_tracker_configuration"
              parent="menu_step_tracker_integration"
              sequence="60"
              groups="base.group_system"/>

</odoo>
