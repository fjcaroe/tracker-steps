<odoo>
    <record id="week_gantt" model="ir.ui.view"><field name="name">sales.program.week.gantt</field><field name="model">step.export.sales.program.line</field><field name="arch" type="xml"><gantt string="Programa de ventas por semana" date_start="week_start" date_stop="week_end" default_group_by="program_id" default_scale="month" scales="week,month,year" create="false" edit="false" delete="false"><field name="program_id"/><field name="species_id"/><field name="season_id"/><field name="transport_type"/><field name="container_qty"/><field name="pallet_qty"/><field name="box_qty"/><field name="kg_qty"/><field name="amount_usd"/></gantt></field></record>
    <record id="week_pivot" model="ir.ui.view"><field name="name">sales.program.week.pivot</field><field name="model">step.export.sales.program.line</field><field name="arch" type="xml"><pivot string="Programa de ventas"><field name="program_id" type="row"/><field name="week_start" type="col" interval="week"/><field name="container_qty" type="measure"/><field name="pallet_qty" type="measure"/><field name="box_qty" type="measure"/><field name="kg_qty" type="measure"/><field name="amount_usd" type="measure"/></pivot></field></record>
    <record id="week_list" model="ir.ui.view"><field name="name">sales.program.week.report.list</field><field name="model">step.export.sales.program.line</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="program_id"/><field name="week_start"/><field name="season_id"/><field name="species_id"/><field name="transport_type"/><field name="container_qty" sum="Contenedores"/><field name="pallet_qty" sum="Pallets"/><field name="box_qty" sum="Cajas"/><field name="kg_qty" sum="Kilos"/><field name="usd_currency_id" column_invisible="True"/><field name="amount_usd" sum="Venta USD"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="week_search" model="ir.ui.view"><field name="name">sales.program.week.search</field><field name="model">step.export.sales.program.line</field><field name="arch" type="xml"><search><field name="species_id"/><field name="transport_type"/><field name="program_id"/><field name="season_id"/><filter name="current" string="Vigentes" domain="[('program_state','=','current')]"/><filter name="created" string="Creados / validados" domain="[('program_state','in',['created','validated'])]"/><filter name="replaced" string="Historial reemplazado" domain="[('program_state','=','replaced')]"/><separator/><filter name="date" string="Semana" date="week_start"/><group><filter name="by_season" string="Temporada" context="{'group_by':'season_id'}"/><filter name="by_species" string="Especie" context="{'group_by':'species_id'}"/><filter name="by_transport" string="Tipo de embarque" context="{'group_by':'transport_type'}"/><filter name="by_program" string="Programa" context="{'group_by':'program_id'}"/><filter name="by_month" string="Mes" context="{'group_by':'week_start:month'}"/><filter name="by_week" string="Semanas" context="{'group_by':'week_start:week'}"/></group></search></field></record>
    <record id="program_report" model="ir.actions.act_window"><field name="name">Informe programa de ventas</field><field name="res_model">step.export.sales.program.line</field><field name="view_mode">gantt,pivot,list</field><field name="search_view_id" ref="week_search"/><field name="context">{'search_default_current':1}</field><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'gantt','view_id':ref('week_gantt')}),(0,0,{'view_mode':'pivot','view_id':ref('week_pivot')}),(0,0,{'view_mode':'list','view_id':ref('week_list')})]"/></record>
    <menuitem id="program_report_menu" name="Informe programa de ventas" parent="step_export.menu_step_export_ops" action="program_report" sequence="45"/>
</odoo>
