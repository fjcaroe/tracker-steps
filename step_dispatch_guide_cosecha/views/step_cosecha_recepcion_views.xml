<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_cosecha_recepcion_form_dispatch_guide" model="ir.ui.view">
        <field name="name">step.cosecha.recepcion.form.dispatch.guide</field>
        <field name="model">step.cosecha.recepcion</field>
        <field name="inherit_id" ref="step_cosecha.view_step_cosecha_recepcion_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_dispatch_guide" type="object" string="Crear guía de despacho"
                        class="btn-secondary" groups="stock.group_stock_user"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="dispatch_guide_button_box" invisible="dispatch_guide_count == 0">
                    <button name="action_view_dispatch_guides" type="object" class="oe_stat_button" icon="fa-truck">
                        <field name="dispatch_guide_count" widget="statinfo" string="Guías"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_dispatch_guide_form_cosecha" model="ir.ui.view">
        <field name="name">step.dispatch.guide.form.cosecha</field>
        <field name="model">step.dispatch.guide</field>
        <field name="inherit_id" ref="step_dispatch_guide.view_dispatch_guide_form"/>
        <field name="arch" type="xml">
            <field name="picking_id" position="after">
                <field name="cosecha_recepcion_id"/>
            </field>
        </field>
    </record>
</odoo>
