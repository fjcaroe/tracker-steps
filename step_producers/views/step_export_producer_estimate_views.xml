<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_estimate_t35_list" model="ir.ui.view">
        <field name="name">step.export.estimate.t35.list</field>
        <field name="model">step.export.estimate</field>
        <field name="inherit_id" ref="step_producers.view_step_export_estimate_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="series_code"/>
                <field name="version_number"/>
                <field name="state"/>
                <field name="producer_id"/>
                <field name="export_kg_total" sum="Kilos"/>
            </xpath>
        </field>
    </record>

    <record id="view_step_export_estimate_t35_form" model="ir.ui.view">
        <field name="name">step.export.estimate.t35.form</field>
        <field name="model">step.export.estimate</field>
        <field name="inherit_id" ref="step_producers.view_step_export_estimate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_validate_estimate" type="object" string="Validar" class="btn-primary"
                            invisible="state != 'created'"/>
                    <button name="action_activate_estimate" type="object" string="Hacer vigente" class="btn-primary"
                            invisible="state != 'validated'"/>
                    <button name="action_new_estimate_version" type="object" string="Nueva versión"
                            invisible="state != 'current'"/>
                    <field name="state" widget="statusbar" statusbar_visible="created,validated,current,replaced"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="series_code"/>
                <field name="version_number"/>
                <field name="previous_version_id" invisible="not previous_version_id"/>
                <field name="producer_id" domain="[('is_productor', '=', True)]"
                       readonly="state in ('current', 'replaced')"/>
                <field name="packing_partner_id" domain="[('step_export_packing', '=', True)]"
                       readonly="state in ('current', 'replaced')"/>
                <field name="delivery_start" readonly="state in ('current', 'replaced')"/>
                <field name="delivery_end" readonly="state in ('current', 'replaced')"/>
                <field name="export_kg_total"/>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <notebook>
                    <page name="step_export_estimate_lines" string="Fruta y distribución semanal">
                        <field name="estimate_line_ids" readonly="state in ('current', 'replaced')">
                            <list>
                                <field name="delivery_kind"/>
                                <field name="species_id"/>
                                <field name="variety_group_id"/>
                                <field name="variety_id"/>
                                <field name="product_id"/>
                                <field name="export_kg" sum="Kilos"/>
                                <field name="export_percentage"/>
                                <field name="process_kg" sum="Proceso"/>
                                <field name="export_box_qty" sum="Cajas"/>
                                <field name="export_pallet_qty" sum="Pallets"/>
                            </list>
                            <form string="Fruta estimada">
                                <sheet>
                                    <group>
                                        <field name="delivery_kind"/>
                                        <field name="species_id"/>
                                        <field name="variety_group_id"/>
                                        <field name="variety_id"/>
                                        <field name="product_id" domain="[('is_fruta', '=', True)]"/>
                                        <field name="packaging_id"/>
                                        <field name="package_type_id"/>
                                        <field name="export_kg"/>
                                        <field name="export_percentage" invisible="delivery_kind != 'process'"/>
                                        <field name="kg_per_box"/>
                                        <field name="boxes_per_package"/>
                                        <field name="process_kg" invisible="delivery_kind != 'process'"/>
                                        <field name="harvest_box_qty" invisible="delivery_kind != 'process'"/>
                                        <field name="bin_qty" invisible="delivery_kind != 'process'"/>
                                        <field name="process_pallet_qty" invisible="delivery_kind != 'process'"/>
                                        <field name="export_box_qty"/>
                                        <field name="export_pallet_qty"/>
                                    </group>
                                    <field name="week_line_ids">
                                        <list editable="bottom">
                                            <field name="week_start"/>
                                            <field name="export_kg" sum="Kilos"/>
                                        </list>
                                    </field>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
