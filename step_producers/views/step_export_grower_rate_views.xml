<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_grower_rate_list" model="ir.ui.view">
        <field name="name">step.export.grower.rate.list</field>
        <field name="model">step.export.grower.rate</field>
        <field name="arch" type="xml">
            <list string="Tarifa Productor">
                    <field name="name"/>
                    <field name="season_id"/>
                    <field name="species_id"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_grower_rate_form" model="ir.ui.view">
        <field name="name">step.export.grower.rate.form</field>
        <field name="model">step.export.grower.rate</field>
        <field name="arch" type="xml">
            <form string="Tarifa Productor">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="notes"/>
                        <field name="date"/>
                        <field name="season_id"/>
                        <field name="species_id"/>
                        <field name="discount_item_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_grower_rate" model="ir.actions.act_window">
        <field name="name">Tarifa Productor</field>
        <field name="res_model">step.export.grower.rate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
