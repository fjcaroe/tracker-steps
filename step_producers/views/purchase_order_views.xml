<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_producer_contract" model="ir.ui.view">
        <field name="name">purchase.order.producer.contract</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="step_producer_contract_id" string="Contrato productor"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="step_producer_contract_product_id" string="Producto contratado"
                       domain="[('contract_id', '=', parent.step_producer_contract_id), ('product_id', '=', product_id)]"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
