<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_preliq_price_list" model="ir.ui.view">
        <field name="name">step.producer.preliq.price.list</field>
        <field name="model">step.producer.preliq.price</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="season_id"/>
                <field name="species_id"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="currency_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_preliq_price_form" model="ir.ui.view">
        <field name="name">step.producer.preliq.price.form</field>
        <field name="model">step.producer.preliq.price</field>
        <field name="arch" type="xml">
            <form string="Precios de preliquidación">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="season_id"/>
                        <field name="species_id"/>
                        <field name="valid_from"/>
                        <field name="valid_to"/>
                        <field name="currency_id"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="variety_id"/>
                            <field name="product_id"/>
                            <field name="packaging_id"/>
                            <field name="caliber_id"/>
                            <field name="uom_id"/>
                            <field name="week_number"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="price"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_preliq_price" model="ir.actions.act_window">
        <field name="name">Precios de preliquidación</field>
        <field name="res_model">step.producer.preliq.price</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
