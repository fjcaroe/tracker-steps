<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="rule_step_producer_fundo_company" model="ir.rule">
    <field name="name">Productores: fundos por empresa</field>
    <field name="model_id" ref="step_hr.model_step_fundo" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
  </record>
  <record id="rule_preliq_price_company" model="ir.rule">
    <field name="name">Productores: precios por empresa</field>
    <field name="model_id" ref="model_step_producer_preliq_price" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
  </record>
  <record id="rule_preliq_price_line_company" model="ir.rule">
    <field name="name">Productores: líneas de precio por empresa</field>
    <field name="model_id" ref="model_step_producer_preliq_price_line" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
  </record>
  <record id="rule_step_producer_contract_company" model="ir.rule">
    <field name="name">Contratos productor: empresas permitidas</field>
    <field name="model_id" ref="model_step_producer_purchase_contract" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
  </record>
  <record id="rule_step_producer_contract_product_company" model="ir.rule">
    <field name="name">Productos contrato: empresas permitidas</field>
    <field name="model_id" ref="model_step_producer_purchase_contract_product" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
  </record>
  <record id="rule_step_producer_contract_installment_company" model="ir.rule">
    <field name="name">Cuotas contrato: empresas permitidas</field>
    <field name="model_id" ref="model_step_producer_purchase_contract_installment" />
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
  </record>
  <record id="rule_contract_holding_read" model="ir.rule">
    <field name="name">Contratos holding: lectura de matriz autorizada</field>
    <field name="model_id" ref="model_step_producer_purchase_contract"/>
    <field name="domain_force">[('company_id', 'parent_of', company_ids), ('company_id', 'in', user.company_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
  <record id="rule_contract_product_holding_read" model="ir.rule">
    <field name="name">Contratos holding: lectura de matriz autorizada</field>
    <field name="model_id" ref="model_step_producer_purchase_contract_product"/>
    <field name="domain_force">[('company_id', 'parent_of', company_ids), ('company_id', 'in', user.company_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
  <record id="rule_contract_installment_holding_read" model="ir.rule">
    <field name="name">Contratos holding: lectura de matriz autorizada</field>
    <field name="model_id" ref="model_step_producer_purchase_contract_installment"/>
    <field name="domain_force">[('company_id', 'parent_of', company_ids), ('company_id', 'in', user.company_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>