<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_helpdesk_scope" inherit_id="portal.portal_layout" name="Steps Helpdesk portal scope">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class"/>
            <attribute name="t-attf-class">o_portal_wrap #{'steps-helpdesk-portal' if request.httprequest.path.startswith(('/my/ticket', '/helpdesk/ticket/')) else ''}</attribute>
        </xpath>
    </template>

    <template id="portal_ticket_list_brand" inherit_id="helpdesk.portal_helpdesk_ticket" name="Steps Helpdesk portal list">
        <xpath expr="//t[@t-call='portal.portal_layout']/t[@t-set='breadcrumbs_searchbar']" position="before">
            <section class="steps-helpdesk-portal-hero" aria-label="Centro de soporte">
                <span>STEPS AGRO / SOPORTE</span>
                <h1>Tus solicitudes, en un solo lugar.</h1>
                <p>Consulta el avance y el historial de tus tickets.</p>
                <div class="steps-helpdesk-portal-actions">
                    <a class="btn btn-light" href="/soporte/nueva-solicitud">Crear solicitud <i class="fa fa-arrow-right ms-2" aria-hidden="true"/></a>
                </div>
            </section>
        </xpath>
        <xpath expr="//div[@t-if='not grouped_tickets']" position="replace">
            <div t-if="not grouped_tickets" class="steps-helpdesk-empty" role="status">
                <h2>Aún no tienes solicitudes visibles.</h2>
                <p>Si necesitas ayuda, puedes crear una solicitud. Si ya escribiste al equipo, ingresa con la cuenta de cliente asociada al ticket.</p>
                <a class="btn btn-primary" href="/soporte/nueva-solicitud">Crear solicitud</a>
            </div>
        </xpath>
    </template>

    <template id="portal_ticket_detail_brand" inherit_id="helpdesk.tickets_followup" name="Steps Helpdesk portal detail">
        <xpath expr="//div[hasclass('o_project_portal_sidebar')]" position="before">
            <section class="steps-helpdesk-portal-hero" aria-label="Detalle del ticket">
                <span>STEPS AGRO / SOPORTE</span>
                <h1 t-out="ticket.name"/>
                <p>Revisa el estado, los documentos y la conversación de esta solicitud.</p>
                <div class="steps-helpdesk-portal-actions">
                    <a class="btn btn-light" href="/my/tickets"><i class="fa fa-arrow-left me-2" aria-hidden="true"/> Mis tickets</a>
                    <a class="btn btn-outline-light" href="/soporte/nueva-solicitud">Crear otra solicitud</a>
                </div>
            </section>
        </xpath>
        <xpath expr="//div[@id='ticket_chat']/h3" position="after">
            <t t-if="request.env.user.has_group('helpdesk.group_helpdesk_user') and ticket.with_user(request.env.user).has_access('read')">
                <t t-set="steps_internal_notes" t-value="ticket.message_ids.filtered(lambda message: message.subtype_id == request.env.ref('mail.mt_note')).sorted('date', reverse=True)"/>
                <div class="steps-helpdesk-internal-history" role="note">
                    <p>Como integrante de soporte, también puedes ver aquí las notas internas. La conversación del cliente aparece debajo.</p>
                    <a t-attf-href="/odoo/action-helpdesk.helpdesk_ticket_action_main_tree/#{ticket.id}?menu_id=#{ticket.env.ref('helpdesk.helpdesk_ticket_menu_all').id}">Abrir ficha de gestión <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></a>
                </div>
                <section t-if="steps_internal_notes" class="steps-helpdesk-internal-notes" aria-label="Notas internas">
                    <h4>Notas internas <span t-out="len(steps_internal_notes)"/></h4>
                    <article t-foreach="steps_internal_notes" t-as="message" class="steps-helpdesk-internal-note">
                        <header>
                            <strong t-out="message.author_id.name or 'Equipo de soporte'"/>
                            <time t-field="message.date" t-options='{"widget": "datetime"}'/>
                        </header>
                        <div class="steps-helpdesk-internal-note-body" t-field="message.body"/>
                        <ul t-if="message.attachment_ids" class="steps-helpdesk-internal-attachments">
                            <li t-foreach="message.attachment_ids" t-as="attachment">
                                <a t-att-href="'/web/content/%d?download=1' % attachment.id" t-out="attachment.name"/>
                            </li>
                        </ul>
                    </article>
                </section>
            </t>
        </xpath>
    </template>
</odoo>
