<odoo>
 <record id="type_form" model="ir.ui.view"><field name="name">dispatch.type.recipient</field><field name="model">step.freight.dispatch.type</field><field name="inherit_id" ref="step_packing_ticket_revision.view_dispatch_type_company_form"/><field name="arch" type="xml"><field name="company_ids" position="after"><field name="step_recipient_kind"/></field></field></record>
 <record id="tag_list" model="ir.ui.view"><field name="name">dispatch.available.tag.list</field><field name="model">stock.quant.package</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="step_tag_kind"/><field name="name" string="Número de tarja"/><field name="step_producer_id"/><field name="box_count" sum="Cajas"/><field name="step_actual_kg" sum="Kilos"/><field name="location_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="tag_search" model="ir.ui.view"><field name="name">dispatch.available.tag.search</field><field name="model">stock.quant.package</field><field name="arch" type="xml"><search><field name="name" string="Número de tarja"/><field name="step_tag_kind"/><field name="step_producer_id"/></search></field></record>
 <record id="guide_form" model="ir.ui.view"><field name="name">dispatch.interplant.form</field><field name="model">step.dispatch.guide</field><field name="inherit_id" ref="step_packing_dispatch.guide_form"/><field name="priority">90</field><field name="arch" type="xml">
  <xpath expr="//sheet/group[group/field[@name='partner_id']]" position="before"><group name="interplant_dispatch_type"/></xpath>
  <xpath expr="//group[@name='interplant_dispatch_type']" position="inside"><xpath expr="//field[@name='dispatch_type_id']" position="move"/></xpath>
  <field name="partner_id" position="before"><field name="step_recipient_domain" invisible="1"/><field name="step_recipient_kind" invisible="1"/><field name="step_destination_company_id" invisible="1"/></field>
  <field name="partner_id" position="attributes"><attribute name="domain">step_recipient_domain</attribute></field>
  <field name="partner_id" position="after"><field name="step_source_warehouse_id" readonly="state != 'draft'" invisible="dispatch_instruction_id"/><field name="step_destination_warehouse_id" context="{'allowed_company_ids': [step_destination_company_id] if step_destination_company_id else []}" options="{'no_create': True, 'no_open': True}" invisible="step_recipient_kind != 'interplant'" readonly="state != 'draft'"/><field name="step_destination_picking_id" invisible="not step_destination_picking_id"/></field>
  <button name="action_load_pallet_detail" position="attributes"><attribute name="invisible">state != 'draft' or not load_tag_ids</attribute></button>
  <field name="load_tag_ids" position="attributes"><attribute name="context">{'list_view_ref':'step_packing_interplant.tag_list','search_view_ref':'step_packing_interplant.tag_search'}</attribute></field>
  <xpath expr="//field[@name='load_tag_ids']/list/field[@name='name']" position="before"><field name="step_tag_kind"/></xpath>
  <xpath expr="//field[@name='load_tag_ids']/list/field[@name='name']" position="after"><field name="step_producer_id"/></xpath>
 </field></record>
 <record id="picking_form" model="ir.ui.view"><field name="name">interplant.receipt.form</field><field name="model">stock.picking</field><field name="inherit_id" ref="stock.view_picking_form"/><field name="arch" type="xml">
  <field name="origin" position="after"><field name="step_interplant_guide_id" invisible="not step_interplant_guide_id"/><field name="step_dispatch_origin_guide_id" invisible="not step_dispatch_origin_guide_id"/></field>
  <xpath expr="//notebook" position="inside"><page name="interplant_tags" string="Tarjas interplanta" invisible="not step_interplant_guide_id"><div class="alert alert-info" invisible="state == 'done'">Recepción ingresada, pendiente de validar. Las tarjas estarán disponibles al confirmar la llegada.</div><field name="step_interplant_tag_ids" readonly="1"><list><field name="step_tag_kind"/><field name="name"/><field name="step_producer_id"/><field name="box_count" sum="Cajas"/><field name="step_actual_kg" sum="Kilos"/><field name="step_tag_state"/><field name="step_interplant_origin_tag_id"/></list></field></page></xpath>
 </field></record>
 <record id="receipts" model="ir.actions.act_window"><field name="name">Recepciones interplanta</field><field name="res_model">stock.picking</field><field name="view_mode">list,form</field><field name="domain">[('step_interplant_guide_id','!=',False)]</field><field name="context">{'restricted_picking_type_code':'incoming'}</field></record>
 <menuitem id="receipts_menu" name="Recepciones interplanta" parent="step_packing_operations.menu_packing_operations_receptions" action="receipts" sequence="35" groups="stock.group_stock_user"/>
</odoo>