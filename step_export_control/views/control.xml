<odoo>
  <record id="documents_action" model="ir.actions.client"><field name="name">Panel de documentos</field><field name="tag">step_export_control.documents</field></record>
  <record id="vessels_action" model="ir.actions.client"><field name="name">A dónde va la lancha</field><field name="tag">step_export_control.vessels</field></record>
  <record id="type_list" model="ir.ui.view"><field name="name">export.document.type.list</field><field name="model">step.export.document.type</field><field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="kind"/><field name="customer_days"/><field name="customs_required"/><field name="customs_days" invisible="not customs_required"/><field name="active"/></list></field></record>
  <record id="types_action" model="ir.actions.act_window"><field name="name">Documentos de exportación y plazos</field><field name="res_model">step.export.document.type</field><field name="view_mode">list,form</field></record>
  <record id="settings_list" model="ir.ui.view"><field name="name">export.control.settings.list</field><field name="model">step.export.control.settings</field><field name="arch" type="xml"><list editable="bottom"><field name="company_id"/><field name="near_arrival_days"/><field name="ais_fresh_minutes"/></list></field></record>
  <record id="settings_action" model="ir.actions.act_window"><field name="name">Alertas de naves</field><field name="res_model">step.export.control.settings</field><field name="view_mode">list,form</field></record>
  <record id="route_form" model="ir.ui.view"><field name="name">export.sea.route.form</field><field name="model">step.export.sea.route</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="origin_port_id"/><field name="destination_port_id"/></group><p>Configure los puntos por donde navega la ruta, en orden. La posición teórica se interpola sobre este recorrido; no representa una lectura AIS.</p><field name="waypoint_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="latitude"/><field name="longitude"/></list></field></sheet></form></field></record>
  <record id="routes_action" model="ir.actions.act_window"><field name="name">Rutas marítimas</field><field name="res_model">step.export.sea.route</field><field name="view_mode">list,form</field></record>
  <record id="ports_form" model="ir.ui.view"><field name="name">export.control.port.coordinates</field><field name="model">l10n_cl.customs_port</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="control_coordinates_set"/><field name="control_latitude"/><field name="control_longitude"/></group></sheet></form></field></record>
  <record id="ports_action" model="ir.actions.act_window"><field name="name">Coordenadas de puertos</field><field name="res_model">l10n_cl.customs_port</field><field name="view_mode">list,form</field></record>
  <record id="port_form_action" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">form</field><field name="view_id" ref="ports_form"/><field name="act_window_id" ref="ports_action"/></record>
  <record id="shipment_control" model="ir.ui.view"><field name="name">export.shipment.control</field><field name="model">step.export.export</field><field name="inherit_id" ref="step_export_shipping_design.shipping_form"/><field name="priority">110</field><field name="arch" type="xml">
    <field name="arrival_date" position="after"><field name="transit_time"/><field name="sea_route_id" domain="[('company_id','=',company_id),('origin_port_id','=',origin_port_id),('destination_port_id','=',destination_port_id)]" invisible="transport_type != 'sea'"/></field>
    <xpath expr="//notebook" position="inside"><page string="Control documentos" name="control_documents">
      <p>Enviado (E) requiere una fecha real. El correo del sistema se registra después del envío exitoso con adjuntos. Para envíos externos indique fecha y respaldo manual.</p>
      <button name="action_complete_document_control" type="object" string="Completar documentos faltantes" class="btn-secondary"/>
      <button name="action_prepare_control_email" type="object" string="Preparar correo de documentos" class="btn-primary"/>
      <field name="documentation_ids"><list editable="bottom" create="0" delete="0" decoration-success="control_color == 'ontime'" decoration-warning="control_color == 'today'" decoration-danger="control_color == 'late'">
        <field name="kind" readonly="1"/><field name="control_type_id" optional="hide"/><field name="document_created_on"/><field name="customer_deadline"/><field name="customs_deadline" optional="show"/>
        <field name="received_on" optional="hide"/><field name="sent_on"/><field name="manual_reference"/><field name="effective_sent_on" optional="hide"/><field name="control_status"/><field name="control_color"/>
        <field name="sent_message_id" optional="hide"/><field name="sent_attachment_ids" widget="many2many_tags" optional="hide"/>
      </list></field></page></xpath>
  </field></record>
  <record id="compose_control" model="ir.ui.view"><field name="name">mail.compose.export.control</field><field name="model">mail.compose.message</field><field name="inherit_id" ref="mail.email_compose_message_wizard_form"/><field name="arch" type="xml"><field name="subject" position="after"><field name="export_control_type_ids" widget="many2many_tags" invisible="model not in ['step.export.export','sale.order','account.move']" options="{'no_create': True}"/><p invisible="model not in ['step.export.export','sale.order','account.move']">Seleccione los documentos adjuntos. El panel se actualiza solo cuando el correo sale correctamente; un mensaje interno no acredita envío.</p></field></field></record>
  <record id="sale_control" model="ir.ui.view"><field name="name">sale.order.export.control.mail</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_control_email_proforma" type="object" string="Enviar proforma" invisible="not step_export_sale_context"/><button name="action_control_email_invoice" type="object" string="Enviar Invoice" invisible="not step_export_sale_context"/></xpath></field></record>
  <record id="vessel_control" model="ir.ui.view"><field name="name">export.vessel.ais</field><field name="model">step.export.vessel</field><field name="inherit_id" ref="step_export.view_step_export_vessel_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="AISStream"><field name="mmsi"/><field name="ais_reported_at"/><field name="ais_received_at"/><field name="ais_latitude"/><field name="ais_longitude"/><field name="ais_speed"/><field name="ais_course"/></group></xpath></field></record>
  <menuitem id="control_menu" name="Control" parent="step_export.menu_step_export_root" sequence="45"/>
  <menuitem id="documents_menu" name="Panel de documentos" parent="control_menu" action="documents_action" sequence="10"/>
  <menuitem id="vessels_menu" name="Panel de naves" parent="control_menu" action="vessels_action" sequence="20"/>
  <menuitem id="types_menu" name="Documentos y plazos" parent="control_menu" action="types_action" sequence="30"/>
  <menuitem id="settings_menu" name="Alertas de naves" parent="control_menu" action="settings_action" sequence="40"/>
  <menuitem id="routes_menu" name="Rutas marítimas" parent="control_menu" action="routes_action" sequence="50"/>
  <menuitem id="ports_menu" name="Coordenadas de puertos" parent="control_menu" action="ports_action" groups="base.group_system" sequence="60"/>
  <menuitem id="lancha_app" name="A dónde va la lancha" action="vessels_action" sequence="62" web_icon="step_export,static/description/icon.png"/>
</odoo>
