<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_colacion_settings_form" model="ir.ui.view">
        <field name="name">step.colacion.settings.form</field>
        <field name="model">step.colacion.settings</field>
        <field name="arch" type="xml">
            <form string="Ajustes de Colaciones">
                <sheet>
                    <div class="oe_title">
                        <h1>Aplicación del tótem</h1>
                        <p class="text-muted">
                            Defina desde qué dirección se sirve la aplicación de Colaciones.
                            Los botones <b>Abrir tótem</b> y los códigos de asociación usan
                            este valor.
                        </p>
                    </div>
                    <group>
                        <group string="Publicación">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="pwa_base_url" placeholder="https://colaciones.stepsapp.cl"/>
                            <field name="effective_base_url" readonly="1"/>
                            <field name="sample_totem_url" readonly="1"/>
                        </group>
                        <group string="App móvil">
                            <field name="can_edit_app_versions" invisible="1"/>
                            <field name="min_app_version" readonly="not can_edit_app_versions"/>
                            <field name="recommended_app_version" readonly="not can_edit_app_versions"/>
                        </group>
                    </group>
                    <group string="Costeo y contabilización">
                        <group>
                            <field name="provision_journal_id" options="{'no_create': True}"/>
                            <field name="provision_account_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="accounting_responsible_id" options="{'no_create': True}"/>
                            <div class="text-muted">
                                La cuenta de abono se configura como cuenta predeterminada
                                del diario. La cuenta de cargo se toma del producto y, si
                                está vacía, de su categoría.
                            </div>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Deje la URL vacía para seguir usando la ruta
                        <code>/colaciones/app/</code> del mismo dominio de Odoo.
                        Fuera de un entorno local solo se acepta HTTPS.
                        Cambiar esta dirección <b>no</b> regenera los tokens existentes:
                        los tótems ya asociados siguen funcionando con su token actual.
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Guardar" class="btn-primary"/>
                    <button special="cancel" string="Descartar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_colacion_settings" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">step.colacion.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_colacion_settings_form"/>
        <field name="target">new</field>
    </record>
</odoo>
