<odoo>
  <record id="channel_form" model="ir.ui.view"><field name="name">step.helpdesk.wa.channel.form</field><field name="model">step.helpdesk.wa.channel</field><field name="arch" type="xml"><form>
    <header><button name="action_sync_templates" type="object" string="Sincronizar plantillas" class="btn-primary" invisible="not enabled"/></header>
    <sheet><h1><field name="name"/></h1><group><group><field name="company_id"/><field name="team_id"/><field name="provider"/><field name="enabled"/><field name="pause_outgoing"/></group>
    <group><field name="auto_receipt"/><field name="reception_hours"/><field name="max_media_mb"/><field name="retention_days"/></group></group>
    <group string="Conexión Cloud API" invisible="provider != 'meta_cloud'"><field name="app_id"/><field name="account_id"/><field name="phone_number_id"/><field name="graph_version"/>
      <field name="access_token" password="True" groups="base.group_system"/><field name="app_secret" password="True" groups="base.group_system"/>
      <field name="verify_token" password="True" groups="base.group_system"/><field name="callback_url" widget="url"/>
    </group><div class="alert alert-info">En simulación no se contacta a Meta. Para activar Cloud API complete la cuenta, el número, los secretos y la suscripción del webhook.</div></sheet>
  </form></field></record>
  <record id="channel_list" model="ir.ui.view"><field name="name">step.helpdesk.wa.channel.list</field><field name="model">step.helpdesk.wa.channel</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="team_id"/><field name="provider"/><field name="enabled"/><field name="pause_outgoing"/></list></field></record>
  <record id="message_list" model="ir.ui.view"><field name="name">step.helpdesk.wa.message.list</field><field name="model">step.helpdesk.wa.message</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="occurred_at"/><field name="direction"/><field name="ticket_id"/><field name="conversation_id"/><field name="kind"/><field name="state"/><field name="media_state"/><field name="error"/></list></field></record>
  <record id="message_form" model="ir.ui.view"><field name="name">step.helpdesk.wa.message.form</field><field name="model">step.helpdesk.wa.message</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_assign_ticket" type="object" string="Clasificar / separar caso" invisible="direction != 'incoming'"/></header><sheet><group><field name="channel_id"/><field name="conversation_id"/><field name="ticket_id"/><field name="occurred_at"/><field name="direction"/><field name="kind"/><field name="state"/><field name="media_state"/><field name="requested_by"/><field name="error"/></group><field name="text"/><field name="attachment_id"/></sheet></form></field></record>
  <record id="conversation_form" model="ir.ui.view"><field name="name">step.helpdesk.wa.conversation.form</field><field name="model">step.helpdesk.wa.conversation</field><field name="arch" type="xml"><form create="0" delete="0"><sheet><group><field name="channel_id" readonly="1"/><field name="sender_id" readonly="1"/><field name="partner_id"/><field name="last_incoming"/><field name="consent"/></group></sheet></form></field></record>
  <record id="compose_form" model="ir.ui.view"><field name="name">step.helpdesk.wa.compose.form</field><field name="model">step.helpdesk.wa.compose</field><field name="arch" type="xml"><form><group><field name="ticket_id"/><field name="text"/><field name="template_id" domain="[('approved','=',True)]"/><field name="parameters" invisible="not template_id"/><field name="attachment_id" domain="[('res_model','=','helpdesk.ticket'),('res_id','=',ticket_id),('public','=',False)]"/></group><div class="alert alert-info">El envío de texto libre está permitido durante 24 horas desde el último mensaje del cliente. Después se requiere una plantilla aprobada y consentimiento.</div><footer><button name="action_send" type="object" string="Enviar por WhatsApp" class="btn-primary"/><button special="cancel" string="Cancelar"/></footer></form></field></record>
  <record id="classify_form" model="ir.ui.view"><field name="name">step.helpdesk.wa.classify.form</field><field name="model">step.helpdesk.wa.classify</field><field name="arch" type="xml"><form><group><field name="message_id"/><field name="new_case"/><field name="ticket_id" invisible="new_case"/><field name="identity_verified" invisible="new_case"/></group><footer><button name="action_apply" type="object" string="Asignar" class="btn-primary"/><button special="cancel" string="Cancelar"/></footer></form></field></record>
  <record id="ticket_whatsapp" model="ir.ui.view"><field name="name">helpdesk.ticket.whatsapp</field><field name="model">helpdesk.ticket</field><field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/><field name="arch" type="xml">
    <xpath expr="//header" position="inside"><button name="action_respond_whatsapp" type="object" string="Responder por WhatsApp" invisible="not step_wa_conversation_id"/></xpath>
    <xpath expr="//sheet" position="inside"><group string="Soporte WhatsApp" invisible="not step_wa_conversation_id"><field name="step_wa_conversation_id"/><field name="step_wa_previous_ticket_id"/></group></xpath>
    <xpath expr="//notebook" position="inside"><page string="WhatsApp" invisible="not step_wa_conversation_id"><field name="step_wa_message_ids"/></page></xpath>
  </field></record>
  <record id="channels_action" model="ir.actions.act_window"><field name="name">Canales WhatsApp</field><field name="res_model">step.helpdesk.wa.channel</field><field name="view_mode">list,form</field></record>
  <record id="messages_action" model="ir.actions.act_window"><field name="name">Mensajes WhatsApp</field><field name="res_model">step.helpdesk.wa.message</field><field name="view_mode">list,form</field></record>
  <record id="unclassified_action" model="ir.actions.act_window"><field name="name">WhatsApp por clasificar</field><field name="res_model">step.helpdesk.wa.message</field><field name="view_mode">list,form</field><field name="domain">[('direction','=','incoming'),('ticket_id','=',False)]</field></record>
  <menuitem id="messages_menu" name="Mensajes WhatsApp" parent="helpdesk.menu_helpdesk_root" action="messages_action" sequence="60" groups="helpdesk.group_helpdesk_user"/>
  <menuitem id="unclassified_menu" name="WhatsApp por clasificar" parent="helpdesk.menu_helpdesk_root" action="unclassified_action" sequence="61" groups="helpdesk.group_helpdesk_user"/>
  <menuitem id="channels_menu" name="Canales WhatsApp" parent="helpdesk.menu_helpdesk_root" action="channels_action" sequence="90" groups="base.group_system"/>
</odoo>
