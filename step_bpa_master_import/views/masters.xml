<odoo>
    <record id="action_bpa_products" model="ir.actions.act_window">
        <field name="name">Productos BPA</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_bpa','=',True)]</field>
        <field name="context">{'default_is_bpa': True}</field>
        <field name="view_id" ref="product.product_template_tree_view"/>
    </record>
    <record id="action_active_ingredients" model="ir.actions.act_window">
        <field name="name">Sustancias activas</field>
        <field name="res_model">step.agriculture.active.ingredient</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="step_agriculture_records.view_active_ingredient_list"/>
        <field name="search_view_id" ref="step_agriculture_records.view_active_ingredient_search"/>
        <field name="help" type="html"><p>Cargue su Excel desde Favoritos â†’ Importar registros. Descargue la plantilla, complete sus datos y pruebe la importaciÃ³n antes de importar. Activo acepta True o False. Conserve el ID externo al actualizar registros para evitar duplicados.</p></field>
    </record>
    <record id="step_product_bpa.action_aptitudes" model="ir.actions.act_window">
        <field name="help" type="html"><p>Cargue su Excel desde Favoritos â†’ Importar registros. Descargue la plantilla, complete sus datos y pruebe la importaciÃ³n antes de importar. Conserve el ID externo al actualizar registros para evitar duplicados.</p></field>
    </record>
    <record id="view_active_ingredient_import_list" model="ir.ui.view">
        <field name="name">step.agriculture.active.ingredient.import.list</field>
        <field name="model">step.agriculture.active.ingredient</field>
        <field name="inherit_id" ref="step_agriculture_records.view_active_ingredient_list"/>
        <field name="arch" type="xml">
            <field name="cdigo" position="attributes"><attribute name="optional">show</attribute></field>
            <field name="active" position="attributes"><attribute name="optional">show</attribute></field>
            <field name="cdigo" position="after"><field name="observacin" optional="show"/></field>
        </field>
    </record>
    <record id="view_aptitude_import_list" model="ir.ui.view">
        <field name="name">step.agriculture.pesticide.aptitude.import.list</field>
        <field name="model">step.agriculture.pesticide.aptitude</field>
        <field name="inherit_id" ref="step_product_bpa.view_aptitude_list"/>
        <field name="arch" type="xml"><field name="code" position="after"><field name="notes" optional="show"/></field></field>
    </record>
    <menuitem id="menu_bpa_products" name="Productos" parent="step_bpa_irrigation.menu_bpa_masters" action="action_bpa_products" sequence="30"/>
    <menuitem id="menu_bpa_configuration" name="Configuraciones" parent="step_bpa_irrigation.menu_bpa_root" sequence="40"/>
    <menuitem id="menu_bpa_active_ingredients" name="Sustancias activas" parent="menu_bpa_configuration" action="action_active_ingredients" sequence="10"/>
    <record id="step_product_bpa.menu_aptitudes" model="ir.ui.menu">
        <field name="parent_id" ref="menu_bpa_configuration"/>
        <field name="sequence">20</field>
    </record>
</odoo>
