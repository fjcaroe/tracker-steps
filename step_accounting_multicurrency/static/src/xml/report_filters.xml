<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="account_reports.AccountReportFiltersCustomizable" t-inherit-mode="extension">
        <xpath expr="//div[@id='filter_rounding_unit']" position="before">
            <t t-if="controller.options.step_operational_currency">
                <div id="filter_step_presentation_currency" class="o_step_currency_filter">
                    <button class="btn btn-secondary"
                            t-on-click="stepToggleOperationalCurrency">
                        <i t-att-class="controller.options.step_show_operational_currency ? 'fa fa-check-square-o me-1' : 'fa fa-square-o me-1'"/>
                        <span>Mostrar </span>
                        <t t-out="controller.options.step_operational_currency.name"/>
                    </button>
                </div>
            </t>
        </xpath>
    </t>
</templates>
