<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_multicurrency_steps" model="ir.ui.view">
        <field name="name">account.move.form.multicurrency.steps</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='aml_tab']//list/field[@name='amount_currency']" position="attributes">
                <attribute name="string">Importe en moneda</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list/field[@name='currency_id']" position="attributes">
                <attribute name="string">Moneda</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list/field[@name='debit']" position="attributes">
                <attribute name="string">Débito (moneda compañía)</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list/field[@name='credit']" position="attributes">
                <attribute name="string">Crédito (moneda compañía)</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree_multicurrency_steps" model="ir.ui.view">
        <field name="name">account.move.line.list.multicurrency.steps</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_currency']" position="attributes">
                <attribute name="string">Importe en moneda</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='currency_id'][1]" position="attributes">
                <attribute name="string">Moneda</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='debit']" position="attributes">
                <attribute name="string">Débito (moneda compañía)</attribute>
            </xpath>
            <xpath expr="//field[@name='credit']" position="attributes">
                <attribute name="string">Crédito (moneda compañía)</attribute>
            </xpath>
        </field>
    </record>
</odoo>
