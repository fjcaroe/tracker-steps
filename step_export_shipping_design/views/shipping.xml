<odoo>
  <record id="folio_company_form" model="ir.ui.view"><field name="name">company.export.folios</field><field name="model">res.company</field><field name="arch" type="xml"><form create="false" delete="false" string="Folios de exportación"><sheet><group><field name="name" readonly="1"/><field name="export_folio_mode"/><field name="export_folio_initial" invisible="export_folio_mode != 'shared'"/></group><p>El folio comercial se ingresa manualmente en la nota de venta y se usa en sus documentos vinculados. Los folios anteriores se conservan.</p></sheet></form></field></record>
  <record id="folio_company_action" model="ir.actions.act_window"><field name="name">Folios de exportación</field><field name="res_model">res.company</field><field name="view_mode">list,form</field><field name="domain">[('id','in',allowed_company_ids)]</field></record>
  <record id="folio_company_action_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="folio_company_form"/><field name="act_window_id" ref="folio_company_action"/></record>
  <menuitem id="folio_company_menu" name="Folios de exportación" parent="step_export.menu_step_export_config" action="folio_company_action" groups="base.group_system" sequence="15"/>
  <record id="sale_folio_form" model="ir.ui.view"><field name="name">sale.export.folio</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Folio comercial de exportación" invisible="not step_export_sale_context"><field name="step_export_sale_context" invisible="1"/><field name="export_folio_mode" invisible="1"/><field name="export_folio" readonly="state in ['sale','cancel']"/><field name="export_document_number"/></group></xpath></field></record>
  <record id="invoice_folio_form" model="ir.ui.view"><field name="name">invoice.export.folio</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Folio comercial de exportación" invisible="not step_export_shipment_id and not export_folio_sale_order_id"><field name="export_folio_sale_order_id" readonly="state != 'draft'"/><field name="export_document_number"/></group></xpath></field></record>
  <record id="shipping_form" model="ir.ui.view"><field name="name">shipment.instruction.design</field><field name="model">step.export.export</field><field name="inherit_id" ref="step_export.view_step_export_shipment_form"/><field name="priority">90</field><field name="arch" type="xml">
    <xpath expr="//field[@name='transport_type']" position="after"><field name="booking"/><field name="freight_payment"/></xpath>
    <xpath expr="//field[@name='shipment_number']" position="after"><field name="company_id" invisible="1"/><field name="folio_sale_order_id" domain="[('company_id','=',company_id),('export_folio','&gt;',0)]" readonly="id"/><field name="commercial_folio"/></xpath>
    <xpath expr="//field[@name='line_ids']/list/field[@name='variety_id']" position="attributes"><attribute name="optional">show</attribute></xpath>
    <xpath expr="//field[@name='line_ids']/list/field[@name='caliber_id']" position="attributes"><attribute name="optional">show</attribute></xpath>
    <xpath expr="//field[@name='line_ids']/list/field[@name='label']" position="attributes"><attribute name="optional">show</attribute></xpath>
    <xpath expr="//field[@name='line_ids']/list/field[@name='label']" position="after"><field name="quality_id"/></xpath>
    <xpath expr="//field[@name='line_ids']/list/field[@name='packaging_id']" position="after">
      <xpath expr="//field[@name='line_ids']/list/field[@name='variety_id']" position="move"/>
      <xpath expr="//field[@name='line_ids']/list/field[@name='label']" position="move"/>
      <xpath expr="//field[@name='line_ids']/list/field[@name='caliber_id']" position="move"/>
      <xpath expr="//field[@name='line_ids']/list/field[@name='quality_id']" position="move"/>
    </xpath>
    <xpath expr="//page/field[@name='notes']" position="before">
      <group string="Condiciones de transporte"><group><field name="temperature"/><field name="controlled_atmosphere"/><field name="thermograph_qty"/></group><group><field name="ventilation"/><field name="filters"/></group></group>
      <group string="Coordinación de carga"><group><field name="port_transport_id"/><field name="packing_partner_id"/><field name="consolidation"/><field name="staking"/><field name="logistics_operator_id"/></group><group><field name="loading_datetime"/><field name="counterpart_id"/><field name="counterpart_phone"/><field name="container_reference"/><field name="container_qty"/><field name="gross_kg"/><field name="customs_agent_id"/></group></group>
      <separator string="Observaciones"/>
    </xpath>
    <xpath expr="//notebook" position="inside">
      <page string="Seguimiento" name="documentation"><field name="documentation_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="kind"/><field name="originals"/><field name="copies"/><field name="instructions"/><field name="status"/><field name="date"/><field name="responsible_id"/></list></field></page>
      <page string="Fletes" name="freights"><button name="action_complete_instruction_freights" type="object" string="Completar listado de fletes"/><field name="freight_ids"><list editable="bottom" create="false" delete="false"><field name="sequence" widget="handle"/><field name="concept_id" readonly="1"/><field name="payment"/><field name="notes"/></list></field></page>
    </xpath>
  </field></record>
  <template id="sale_commercial_number" inherit_id="step_sale_export_report.document"><xpath expr="//span[@t-field='doc.name']" position="replace"><span t-field="doc.export_document_number"/></xpath></template>
</odoo>
