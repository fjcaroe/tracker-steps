<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_center_cost_hierarchy" model="ir.ui.view">
        <field name="name">analytic.account.nursery.hierarchy</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form" position="attributes">
                <attribute name="class" add="o_ecoplantas_native_form" separator=" "/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_step_cost_items" type="object" icon="fa-list"
                        class="oe_stat_button" string="Movimientos"
                        invisible="not step_cost_pool and not step_cost_parent_id"/>
            </xpath>
            <xpath expr="//group[@name='main']" position="after">
                <group string="Costos compartidos">
                    <field name="step_cost_pool"/>
                    <field name="step_cost_parent_id" invisible="step_cost_pool"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="cost_labor_drivers" string="Labores y drivers" invisible="not step_cost_pool">
                    <field name="step_cost_rule_ids">
                        <list editable="bottom">
                            <field name="labor_id"/>
                            <field name="driver_id"/>
                        </list>
                    </field>
                </page>
                <page name="cost_children" string="Centros hijos" invisible="not step_cost_pool">
                    <field name="step_cost_child_ids" readonly="1">
                        <list><field name="name"/><field name="plan_id"/><field name="balance"/></list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_analytic_line_cost_metadata" model="ir.ui.view">
        <field name="name">analytic.line.nursery.metadata</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='analytic_item']/field[@name='date']" position="after">
                <field name="step_cost_labor_id" readonly="step_cost_run_id or step_cost_active_run_id"/>
                <field name="step_cost_active_run_id" readonly="1" invisible="not step_cost_active_run_id"/>
                <field name="step_cost_run_id" readonly="1" invisible="not step_cost_run_id"/>
                <field name="step_cost_source_id" readonly="1" invisible="not step_cost_source_id"/>
                <field name="step_cost_is_reversal" readonly="1" invisible="not step_cost_run_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_invoice_cost_labor" model="ir.ui.view">
        <field name="name">account.move.invoice.line.nursery.labor</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="step_cost_labor_id" optional="hide" readonly="parent.state != 'draft'"/>
            </xpath>
        </field>
    </record>
    <record id="view_cost_measure_list" model="ir.ui.view">
        <field name="name">nursery.cost.measure.list</field>
        <field name="model">step.nursery.cost.measure</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="week_start desc,center_id,driver_id">
                <field name="week_start"/>
                <field name="center_id"/>
                <field name="driver_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_cost_driver_list" model="ir.ui.view">
        <field name="name">nursery.cost.driver.list</field>
        <field name="model">step.sawmill.costing.driver</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="uom_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_cost_run_list" model="ir.ui.view">
        <field name="name">nursery.cost.run.list</field>
        <field name="model">step.nursery.cost.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="parent_id"/>
                <field name="week_start"/>
                <field name="week_end"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="cost_total"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-warning="state == 'draft'" decoration-muted="state == 'reversed'"/>
            </list>
        </field>
    </record>
    <record id="view_cost_run_form" model="ir.ui.view">
        <field name="name">nursery.cost.run.form</field>
        <field name="model">step.nursery.cost.run</field>
        <field name="arch" type="xml">
            <form class="o_ecoplantas_native_form">
                <header>
                    <button name="action_preview" type="object" string="Calcular vista previa" class="oe_highlight"
                            invisible="state != 'draft'" groups="account.group_account_manager"/>
                    <button name="action_confirm" type="object" string="Confirmar reparto"
                            invisible="state != 'draft' or not fingerprint" groups="account.group_account_manager"
                            confirm="Se registrarán los movimientos analíticos de esta semana. ¿Confirmar el reparto?"/>
                    <button name="action_reverse" type="object" string="Revertir reparto"
                            invisible="state != 'done'" groups="account.group_account_manager"
                            confirm="Se registrarán los movimientos opuestos en el mismo período. ¿Revertir?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_items" type="object" class="oe_stat_button" icon="fa-list"
                                string="Movimientos" invisible="state == 'draft'"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="fingerprint" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group string="Período de reparto">
                            <field name="parent_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="week_start" readonly="state != 'draft'"/>
                            <field name="week_end"/>
                        </group>
                        <group string="Resumen analítico">
                            <field name="cost_total"/>
                            <field name="confirmed_by_id" invisible="state == 'draft'"/>
                            <field name="confirmed_at" invisible="state == 'draft'"/>
                            <field name="reversed_by_id" invisible="state != 'reversed'"/>
                            <field name="reversed_at" invisible="state != 'reversed'"/>
                        </group>
                    </group>
                    <div class="alert alert-info" invisible="state != 'draft'">
                        Cargue las cantidades semanales y revise el importe de cada centro antes de confirmar.
                    </div>
                    <field name="line_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="source_id"/>
                            <field name="labor_id"/>
                            <field name="driver_id"/>
                            <field name="center_id"/>
                            <field name="quantity"/>
                            <field name="total_quantity"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cost_run" model="ir.actions.act_window">
        <field name="name">Repartos semanales</field>
        <field name="res_model">step.nursery.cost.run</field>
        <field name="view_mode">list,form</field>
        <field name="path">repartos-vivero</field>
        <field name="context">{'steps_greenhouse_stage': 'costs'}</field>
    </record>
    <record id="action_cost_center" model="ir.actions.act_window">
        <field name="name">Centros de costo</field>
        <field name="res_model">account.analytic.account</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'steps_greenhouse_stage': 'centers'}</field>
    </record>
    <record id="action_cost_driver" model="ir.actions.act_window">
        <field name="name">Drivers de costeo</field>
        <field name="res_model">step.sawmill.costing.driver</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cost_driver_list"/>
        <field name="context">{'steps_greenhouse_stage': 'drivers'}</field>
    </record>
    <record id="action_cost_measure" model="ir.actions.act_window">
        <field name="name">Carga semanal de drivers</field>
        <field name="res_model">step.nursery.cost.measure</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'steps_greenhouse_stage': 'measures'}</field>
    </record>
    <menuitem id="menu_summary" name="Resumen" parent="step_ecoplantas_greenhouse.menu_greenhouse"
              action="step_ecoplantas_greenhouse.action_greenhouse" sequence="5"/>
    <menuitem id="menu_cost_root" name="Costos compartidos" parent="step_ecoplantas_greenhouse.menu_greenhouse"
              sequence="20" groups="account.group_account_user,account.group_account_manager"/>
    <menuitem id="menu_cost_run" name="Repartos semanales" parent="menu_cost_root" action="action_cost_run" sequence="10"/>
    <menuitem id="menu_cost_center" name="Centros de costo" parent="menu_cost_root" action="action_cost_center" sequence="20"/>
    <menuitem id="menu_cost_driver" name="Drivers de costeo" parent="menu_cost_root" action="action_cost_driver" sequence="30"/>
    <menuitem id="menu_cost_measure" name="Carga semanal" parent="menu_cost_root" action="action_cost_measure" sequence="40"/>
</odoo>
