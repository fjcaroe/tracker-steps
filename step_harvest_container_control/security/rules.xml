<odoo>
  <record id="rule_harvest_container_order_companies" model="ir.rule">
    <field name="name">Órdenes de envases por empresa</field>
    <field name="model_id" ref="model_step_harvest_container_work_order"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <data noupdate="1">
    <record id="seq_harvest_container_work_order" model="ir.sequence">
      <field name="name">Orden de envases</field>
      <field name="code">step.harvest.container.work.order</field>
      <field name="prefix">OT-ENV/%(year)s/</field>
      <field name="padding">5</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
