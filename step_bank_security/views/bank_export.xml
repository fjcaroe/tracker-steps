<odoo>
    <record id="view_batch_security" model="ir.ui.view">
        <field name="name">account.batch.payment.security</field><field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="step_account_treasury_batch.view_batch_payment_form_treasury_review"/>
        <field name="arch" type="xml">
            <button name="action_export_bancoestado_xlsx" position="after"><button name="action_export_security_xls" type="object" string="Exportar Security (.xls)" invisible="not payment_ids or batch_type != 'outbound' or (approval_required and not approved_by_id)"/></button>
            <xpath expr="//sheet" position="inside"><group string="Nómina Security"><field name="security_description"/><field name="security_export_count" readonly="1"/><div class="text-muted">Excel 97–2003 sin encabezado, con las nueve columnas del formato sin detalles para proveedores y sueldos.</div></group></xpath>
        </field>
    </record>
</odoo>
