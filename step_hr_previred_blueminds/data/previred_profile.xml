        contra este perfil, una actualización del módulo no debe reescribir la
        versión de formato con la que se produjo el histórico. Las versiones
        nuevas de la especificación se añaden como registros nuevos.
    -->
    <data noupdate="1">
        <record id="profile_blueminds_v84" model="step.previred.profile">
            <field name="name">Previred largo variable v84 — Blueminds</field>
            <field name="sequence">10</field>
            <field name="engine">l10n_cl_hr</field>
            <field name="layout">variable</field>
            <field name="spec_version">84</field>
            <field name="spec_date">2025-07</field>
            <field name="effective_from">2025-08</field>
            <field name="effective_to">2026-07</field>
            <field name="eligible_states">done,paid</field>
            <field name="source_url">https://www.previred.com/wp-content/uploads/2025/07/FormatoLargoVariablePorSeparador-Reforma-5.pdf</field>
