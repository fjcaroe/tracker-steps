<odoo>
    <record id="step_pricelist_action_contratista_cosecha" model="ir.actions.act_window">
        <field name="name">Tarifas Contratistas Cosecha</field>
        <field name="res_model">product.pricelist</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="product.product_pricelist_view_search" />
        <field name="domain">[('group_type', '=', 'contratista'), ('cosecha', '=', True)]</field>
        <field name="context">{"default_base":'list_price', 'step_contra_cosecha':1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new pricelist
            </p><p>
            A price is a set of sales prices or rules to compute the price of sales order lines based on products, product categories, dates and ordered quantities.
            This is the perfect tool to handle several pricings, seasonal discounts, etc.
            </p><p>
            You can assign pricelists to your customers or select one when creating a new sales quotation.
            </p>
        </field>
    </record>
    <record id="step_pricelist_action_propio_cosecha" model="ir.actions.act_window">
