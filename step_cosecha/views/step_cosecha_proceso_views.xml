<odoo>
    <record id="view_step_cosecha_proceso_form" model="ir.ui.view">
        <field name="name">step.cosecha.proceso.form</field>
        <field name="model">step.cosecha.proceso</field>
        <field name="arch" type="xml">
            <form string="Proceso de Cosecha" class="o_cosecha_process_form">
                <header>
                    <button name="action_draft" string="Cambiar a Borrador"
                            type="object" class="oe_highlight" title="Con este boton tienes la posibilidad de cambiar de estado a borrador"
                            invisible="state == 'draft'"/>
                    <button name="action_progress" string="En Proceso"
                            type="object" class="oe_highlight" title="Con este boton tienes la posibilidad de cambiar de estado en proceso"
                            invisible="state == 'progress'"/>
                    <button name="action_done" string="Marcar listo"
                            type="object" class="btn-primary" title="Finaliza el proceso"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar" nolabel="1" readonly="1" />
                </header>
                <sheet>
                    <div class="o_cosecha_record_intro"><i class="fa fa-sitemap" title="Proceso"/><div><span>FLUJO POST COSECHA</span><strong>Proceso de cosecha</strong><small>Coordine ubicación, responsables y controles desde el inicio hasta el cierre operacional.</small></div></div>
                    <div class="oe_title">
                        <label for="name" string="Nombre del proceso"/>
                        <h1>
                            <field name="name" required="1" placeholder="Ej.: Selección y enfriado"/>
                        </h1>
                    </div>
                    <group class="o_cosecha_master_sections">
                        <group string="Operación">
                            <field name="date"/>
                            <field name="super_id"/>
                            <field name="cosecha_ubi_id"/>
                        </group>
                        <group string="Responsabilidad">
                            <field name="responsable_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page name='proceso_line' string="Detalles">
                            <field name="proceso_line">
                                <list editable="bottom">
                                    <field name="proceso_id" column_invisible="True"/>
                                    <field name="name" optional="show"/>
                                    <field name="pro_cosecha" optional="show"/>
                                    <field name="num_tarja" optional="show"/>
                                    <field name="date_tarja_init" optional="show"/>
                                    <field name="date_tarja_end" optional="show"/>
                                    <field name="temp" optional="show"/>
                                    <field name="calidad" optional="show"/>
                                    <field name="comment" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_step_cosecha_proceso_list" model="ir.ui.view">
        <field name="name">step.cosecha.proceso.list</field>
        <field name="model">step.cosecha.proceso</field>
        <field name="arch" type="xml">
            <list class="o_cosecha_master_list" decoration-success="state == 'done'" decoration-info="state == 'progress'" default_order="date desc">
                <field name="name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="super_id" optional="show"/>
                <field name="cosecha_ubi_id" optional="show"/>
                <field name="responsable_id" optional="show"/>
                <field name="state" widget="badge" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_step_cosecha_proceso_kanban" model="ir.ui.view">
        <field name="name">step.cosecha.proceso.kanban</field>
        <field name="model">step.cosecha.proceso</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <kanban class="o_cosecha_process_kanban" default_group_by="state" default_order="date desc">
                <field name="name"/><field name="date"/><field name="super_id"/><field name="cosecha_ubi_id"/><field name="responsable_id"/><field name="state"/><field name="proceso_line"/>
                <templates><t t-name="card">
                    <div class="o_cosecha_process_card">
                        <div class="o_cosecha_process_card__top"><span t-att-class="'is-' + record.state.raw_value"><field name="state"/></span><time><field name="date" widget="date"/></time></div>
                        <h3><field name="name"/></h3>
                        <p><i class="fa fa-map-marker" title="Ubicación"/> <field name="cosecha_ubi_id"/></p>
                        <p><i class="fa fa-user" title="Supervisor"/> <field name="super_id"/></p>
                        <footer><i class="fa fa-list" title="Detalles"/> <t t-esc="record.proceso_line.raw_value.length"/> controles registrados</footer>
                    </div>
                </t></templates>
            </kanban>
        </field>
    </record>

    <record id="action_step_cosecha_proceso" model="ir.actions.act_window">
        <field name="name">Procesos de Cosecha</field>
        <field name="res_model">step.cosecha.proceso</field>
        <field name="view_mode">kanban,list,form</field>
    </record>


</odoo>
