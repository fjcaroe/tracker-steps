<odoo>
  <record id="template_form" model="ir.ui.view"><field name="name">budget.template.design.form</field><field name="model">step.management.budget.template</field><field name="inherit_id" ref="step_management_costs.view_budget_template_form"/><field name="arch" type="xml">
    <xpath expr="//header" position="inside"><button name="action_duplicate_template" type="object" string="Duplicar plantilla"/><button name="action_create_periods" type="object" string="Preparar meses de temporada" invisible="state != 'draft' or not season_id"/></xpath>
    <xpath expr="//sheet" position="replace"><sheet><h1><field name="name" readonly="season_id and state != 'draft'"/></h1>
      <group><group><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="season_id" readonly="state != 'draft'"/><field name="budget_version_id" readonly="state != 'draft'"/><field name="species_id" readonly="state != 'draft'"/><field name="variety_id" readonly="state != 'draft'"/><field name="currency_id" readonly="state != 'draft'"/></group>
      <group string="Base de cálculo"><field name="base_hectares" readonly="season_id and state != 'draft'"/><field name="base_plants" readonly="state != 'draft'"/><field name="base_kg" readonly="state != 'draft'"/><field name="expected_yield_kg_ha" readonly="state != 'draft'"/><field name="total_per_ha"/></group></group>
      <notebook>
        <page string="Datos" name="data"><field name="fruit_share_ids" readonly="state != 'draft'"><list editable="bottom"><field name="category_id"/><field name="percentage"/><field name="kg"/></list></field>
          <field name="line_ids" readonly="season_id and state != 'draft'"><list editable="bottom" open_form_view="True"><field name="origin_id"/><field name="group_id"/><field name="activity_id" domain="[('plan_id.name','=','Actividad')]"/><field name="product_id"/><field name="indicator"/><field name="calculation_uom_id"/><field name="yield_quantity"/><field name="unit_price"/><field name="uom_id"/><field name="base_quantity"/><field name="fruit_category_id" optional="hide"/><field name="calculation_quantity"/><field name="calculation_amount"/><field name="calculation_unit_price"/></list>
          <form string="Producto-labor"><group><field name="company_id" invisible="True"/><field name="currency_id" invisible="True"/><field name="indicator"/><field name="origin_id"/><field name="group_id"/><field name="activity_id" domain="[('plan_id.name','=','Actividad')]"/><field name="product_id"/><field name="uom_id"/><field name="calculation_uom_id"/><field name="yield_quantity"/><field name="unit_price"/><field name="base_quantity"/><field name="fruit_category_id"/><field name="calculation_quantity"/><field name="calculation_amount"/><field name="calculation_unit_price"/><field name="machinery_budget_id"/><button name="action_use_machinery_budget" type="object" string="Usar tarifa maquinaria aprobada"/></group><field name="month_ids"><list editable="bottom"><field name="period_date"/><field name="quantity"/><field name="unit_price"/><field name="amount"/><field name="exchange_rate"/><field name="amount_usd"/><field name="rate_available"/></list></field></form>
          </field>
        </page>
        <page string="Distribución cantidad" name="quantities" invisible="not season_id"><field name="period_ids" readonly="state != 'draft'"><list editable="bottom"><field name="line_id" domain="[('template_id','=',parent.id)]"/><field name="period_date"/><field name="quantity" sum="Cantidad"/></list></field></page>
        <page string="Distribución valores" name="values" invisible="not season_id"><field name="period_ids" readonly="True"><list><field name="line_id"/><field name="period_date"/><field name="quantity"/><field name="unit_price"/><field name="amount" sum="Valor"/><field name="exchange_rate"/><field name="amount_usd" sum="USD"/><field name="rate_available"/></list></field></page>
        <page string="Datos históricos" name="legacy"><group><field name="version"/><field name="species" readonly="True"/><field name="notes"/></group><field name="line_ids" invisible="season_id"><list editable="bottom"><field name="indicator"/><field name="category"/><field name="group_id"/><field name="activity"/><field name="base_quantity"/><field name="unit_price"/><field name="may"/><field name="jun"/><field name="jul"/><field name="aug"/><field name="sep"/><field name="oct"/><field name="nov"/><field name="dec"/><field name="jan"/><field name="feb"/><field name="mar"/><field name="apr"/></list></field></page>
      </notebook>
    </sheet></xpath>
  </field></record>
  <record id="operational_form" model="ir.ui.view"><field name="name">budget.operational.design.form</field><field name="model">step.management.operational.budget</field><field name="inherit_id" ref="step_management_costs.view_operational_budget_form"/><field name="arch" type="xml">
    <xpath expr="//field[@name='season']" position="before"><field name="season_id" readonly="state in ('approved','closed','superseded')"/><field name="budget_version_id" readonly="state in ('approved','closed','superseded')"/></xpath>
    <xpath expr="//field[@name='line_ids']/list/field[@name='indicator']" position="after"><field name="origin_id" optional="show"/><field name="activity_id" optional="show"/><field name="calculation_uom_id" optional="hide"/><field name="expected_kg" optional="hide"/></xpath>
    <xpath expr="//field[@name='line_ids']/form//field[@name='indicator']" position="after"><field name="origin_id"/><field name="activity_id" domain="[('plan_id.name','=','Actividad')]"/><field name="calculation_uom_id"/><field name="expected_kg"/></xpath>
    <xpath expr="//field[@name='month_ids']/list/field[@name='month']" position="before"><field name="period_date"/></xpath>
  </field></record>
  <record id="group_form" model="ir.ui.view"><field name="name">budget.group.design.form</field><field name="model">step.management.budget.group</field><field name="inherit_id" ref="step_management_costs.view_budget_group_form"/><field name="arch" type="xml"><xpath expr="//field[@name='flow_type']" position="after"><field name="origin_id"/><field name="phenology_id"/></xpath></field></record>
  <record id="product_form" model="ir.ui.view"><field name="name">product.agricultural.budget.group</field><field name="model">product.template</field><field name="inherit_id" ref="step_hr.step_view_product_template_form"/><field name="arch" type="xml"><xpath expr="//page[@name='agricola']/group" position="inside"><group><field name="management_budget_group_id"/></group></xpath></field></record>
  <record id="import_form" model="ir.ui.view"><field name="name">budget.import.design.form</field><field name="model">step.management.budget.import</field><field name="inherit_id" ref="step_management_costs.view_budget_import_form"/><field name="arch" type="xml"><xpath expr="//field[@name='filename']" position="after"><field name="season_master_id" readonly="state != 'draft'"/><field name="version_master_id" readonly="state != 'draft'"/></xpath></field></record>
  <record id="template_import_form" model="ir.ui.view"><field name="name">template.import.design.form</field><field name="model">step.management.template.import.wizard</field><field name="arch" type="xml"><form string="Cargar plantilla agrícola Excel"><group><field name="company_id" groups="base.group_multi_company"/><field name="name"/><field name="season_id"/><field name="budget_version_id"/><field name="species_id"/><field name="variety_id"/></group><group string="Categorías de la base de cálculo"><field name="export_category_id"/><field name="commercial_category_id"/><field name="industrial_category_id"/><field name="waste_category_id"/></group><group><field name="filename" invisible="True"/><field name="file" filename="filename"/></group><footer><button name="action_import" type="object" string="Cargar y revisar" class="btn-primary"/><button special="cancel" string="Cancelar"/></footer></form></field></record>
  <record id="template_import_action" model="ir.actions.act_window"><field name="name">Cargar plantilla Excel</field><field name="res_model">step.management.template.import.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
  <menuitem id="template_import_menu" name="Cargar plantilla Excel" parent="step_management_costs.menu_management_budget" action="template_import_action" sequence="21"/>
  <record id="origin_list" model="ir.ui.view"><field name="name">budget.origin.list</field><field name="model">step.management.budget.origin</field><field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="category"/><field name="flow_type"/></list></field></record>
  <record id="origin_action" model="ir.actions.act_window"><field name="name">Origen presupuesto</field><field name="res_model">step.management.budget.origin</field><field name="view_mode">list,form</field></record>
  <record id="version_list" model="ir.ui.view"><field name="name">budget.version.list</field><field name="model">step.management.budget.version</field><field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="deadline"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></list></field></record>
  <record id="version_action" model="ir.actions.act_window"><field name="name">Versiones presupuesto</field><field name="res_model">step.management.budget.version</field><field name="view_mode">list,form</field></record>
  <record id="calculation_list" model="ir.ui.view"><field name="name">budget.calculation.uom.list</field><field name="model">step.management.budget.calculation.uom</field><field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="basis"/><field name="product_uom_id"/></list></field></record>
  <record id="calculation_action" model="ir.actions.act_window"><field name="name">UdM cálculo presupuesto</field><field name="res_model">step.management.budget.calculation.uom</field><field name="view_mode">list,form</field></record>
  <menuitem id="origin_menu" name="Origen presupuesto" parent="step_management_costs.menu_management_masters" action="origin_action" sequence="21"/>
  <menuitem id="version_menu" name="Versión presupuesto" parent="step_management_costs.menu_management_masters" action="version_action" sequence="22"/>
  <menuitem id="calculation_menu" name="UdM cálculo presupuesto" parent="step_management_costs.menu_management_masters" action="calculation_action" sequence="23"/>
  <record id="machinery_form" model="ir.ui.view"><field name="name">machinery.budget.form</field><field name="model">step.management.machinery.budget</field><field name="arch" type="xml"><form string="Presupuesto maquinaria"><header><button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'draft'" groups="step_management_costs.group_management_approver"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="season_id" readonly="state != 'draft'"/><field name="budget_version_id" readonly="state != 'draft'"/><field name="vehicle_id" readonly="state != 'draft'"/><field name="labor_id" readonly="state != 'draft'"/></group><notebook><page string="Horas máquina"><field name="month_ids" readonly="state != 'draft'"><list editable="bottom"><field name="period_date"/><field name="hours" sum="Horas"/></list></field></page><page string="Gastos mensuales"><field name="component_ids" readonly="state != 'draft'"><list editable="bottom"><field name="period_date"/><field name="service_type_id"/><field name="activity_id"/><field name="product_id"/><field name="uom_id"/><field name="calculation_mode"/><field name="consumption_per_hour"/><field name="unit_price"/><field name="direct_amount"/><field name="quantity"/><field name="amount" sum="Costo"/><field name="exchange_rate"/><field name="amount_usd" sum="USD"/><field name="rate_available"/></list></field></page></notebook><group><field name="currency_id" invisible="True"/><field name="total_hours"/><field name="total_cost"/><field name="hourly_rate"/><field name="approved_rate"/></group></sheet><chatter/></form></field></record>
  <record id="machinery_action" model="ir.actions.act_window"><field name="name">Presupuesto maquinaria</field><field name="res_model">step.management.machinery.budget</field><field name="view_mode">list,form</field></record>
  <menuitem id="machinery_menu" name="Presupuesto maquinaria" parent="step_management_costs.menu_management_budget" action="machinery_action" sequence="15"/>
  <record id="data_list" model="ir.ui.view"><field name="name">budget.data.report.list</field><field name="model">step.management.budget.data.report</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="budget_version_id"/><field name="season_id"/><field name="period_date"/><field name="company_id" groups="base.group_multi_company"/><field name="farm_id"/><field name="species_id"/><field name="variety_id"/><field name="cost_type"/><field name="center_id"/><field name="origin_id"/><field name="group_id"/><field name="activity_id"/><field name="product_id"/><field name="uom_id"/><field name="quantity" sum="Cantidad"/><field name="amount" sum="Valor"/><field name="exchange_rate"/><field name="amount_usd" sum="USD"/><field name="rate_available"/><field name="budget_id"/><field name="state"/></list></field></record>
  <record id="data_pivot" model="ir.ui.view"><field name="name">budget.data.report.pivot</field><field name="model">step.management.budget.data.report</field><field name="arch" type="xml"><pivot string="Presupuesto por centro y labor"><field name="center_id" type="row"/><field name="product_id" type="row"/><field name="period_date" type="col" interval="month"/><field name="quantity" type="measure"/><field name="amount" type="measure"/><field name="amount_usd" type="measure"/><field name="jornadas" type="measure"/></pivot></field></record>
  <record id="data_search" model="ir.ui.view"><field name="name">budget.data.report.search</field><field name="model">step.management.budget.data.report</field><field name="arch" type="xml"><search><field name="budget_id"/><field name="season_id"/><field name="budget_version_id"/><field name="farm_id"/><field name="species_id"/><field name="variety_id"/><field name="center_id"/><field name="origin_id"/><field name="group_id"/><field name="activity_id"/><field name="product_id"/><filter name="approved" string="Aprobados" domain="[('state','in',['approved','closed'])]"/><separator/><filter name="missing_rate" string="Sin dólar estimado" domain="[('rate_available','=',False)]"/><group><filter name="center" string="Centro costos" context="{'group_by':'center_id'}"/><filter name="product" string="Producto-labor" context="{'group_by':'product_id'}"/><filter name="period" string="Año-mes" context="{'group_by':'period_date:month'}"/></group></search></field></record>
  <record id="data_action" model="ir.actions.act_window"><field name="name">Data presupuesto</field><field name="res_model">step.management.budget.data.report</field><field name="view_mode">list,pivot</field><field name="context">{'search_default_approved':1}</field></record>
  <record id="center_action" model="ir.actions.act_window"><field name="name">Presupuesto CCosto</field><field name="res_model">step.management.budget.data.report</field><field name="view_mode">pivot,list</field><field name="context">{'search_default_approved':1,'pivot_row_groupby':['center_id'],'pivot_measures':['amount','amount_usd']}</field></record>
  <record id="labor_action" model="ir.actions.act_window"><field name="name">Presupuesto labor</field><field name="res_model">step.management.budget.data.report</field><field name="view_mode">pivot,list</field><field name="context">{'search_default_approved':1,'pivot_row_groupby':['product_id'],'pivot_measures':['amount','amount_usd']}</field></record>
  <record id="days_action" model="ir.actions.act_window"><field name="name">Jornadas estimadas</field><field name="res_model">step.management.budget.data.report</field><field name="view_mode">pivot,list</field><field name="domain">[('jornadas','!=',0)]</field><field name="context">{'search_default_approved':1,'pivot_row_groupby':['center_id'],'pivot_measures':['jornadas']}</field></record>
  <record id="summary_list" model="ir.ui.view"><field name="name">budget.summary.report.list</field><field name="model">step.management.budget.summary.report</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="budget_id"/><field name="season_id"/><field name="center_id"/><field name="expected_kg" sum="Kg"/><field name="hectares" sum="Ha"/><field name="income" sum="Ingresos"/><field name="cost" sum="Costos"/><field name="margin" sum="Margen"/><field name="income_per_kg"/><field name="cost_per_kg"/><field name="margin_per_kg"/><field name="cost_per_ha"/><field name="margin_percentage"/></list></field></record>
  <record id="summary_action" model="ir.actions.act_window"><field name="name">Resumen presupuesto</field><field name="res_model">step.management.budget.summary.report</field><field name="view_mode">list</field></record>
  <menuitem id="data_menu" name="Data presupuesto" parent="step_management_costs.menu_management_budget" action="data_action" sequence="50"/>
  <menuitem id="summary_menu" name="Resumen presupuesto" parent="step_management_costs.menu_management_budget" action="summary_action" sequence="51"/>
  <menuitem id="days_menu" name="Jornadas estimadas" parent="step_management_costs.menu_management_budget" action="days_action" sequence="52"/>
  <menuitem id="center_menu" name="Presupuesto CCosto" parent="step_management_costs.menu_management_budget" action="center_action" sequence="53"/>
  <menuitem id="labor_menu" name="Presupuesto labor" parent="step_management_costs.menu_management_budget" action="labor_action" sequence="54"/>
</odoo>
