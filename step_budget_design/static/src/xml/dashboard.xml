<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="step_management_costs.Dashboard">
<main class="o_step_management_dashboard o_mgmt_dashboard_t228">
    <div t-if="state.loading" class="o_mgmt_loading" role="status"><i class="fa fa-circle-o-notch fa-spin"/> Cargando gestión y costos…</div>
    <div t-elif="state.error" class="o_mgmt_loading" role="alert"><strong t-esc="state.error"/><button class="btn btn-primary" t-on-click="() => this.loadDashboard()">Reintentar</button></div>
    <t t-else="">
    <section class="o_mgmt_hero"><div><span>PLANIFICACIÓN Y CONTROL AGRÍCOLA</span><h1>Centro de Gestión y Costos</h1><p>Presupueste por hectárea, planifique operaciones y controle desviaciones.</p></div>
        <div class="o_mgmt_period"><button t-foreach="[30, 90, 365, 0]" t-as="days" t-key="days" t-att-class="state.days === days ? 'active' : ''" t-on-click="() => this.loadDashboard(days)"><t t-esc="days === 0 ? 'Todo' : (days === 365 ? '1 año' : days + ' días')"/></button></div>
    </section>
    <section class="o_mgmt_filters" aria-label="Filtros del panel">
        <label for="mgmt-season">Temporada<select id="mgmt-season" class="form-select" t-on-change="(ev) => this.changeFilter('seasonId', ev)"><option value="0" t-att-selected="!state.seasonId">Todas las temporadas</option><option t-foreach="state.data.filters.seasons" t-as="option" t-key="option.id" t-att-value="option.id" t-att-selected="state.seasonId === option.id" t-esc="option.name"/></select></label>
        <label for="mgmt-species">Especie<select id="mgmt-species" class="form-select" t-on-change="(ev) => this.changeFilter('speciesId', ev)"><option value="0" t-att-selected="!state.speciesId">Todas las especies</option><option t-foreach="state.data.filters.species" t-as="option" t-key="option.id" t-att-value="option.id" t-att-selected="state.speciesId === option.id" t-esc="option.name"/></select></label>
        <label for="mgmt-currency">Moneda<select id="mgmt-currency" class="form-select" t-on-change="(ev) => this.changeFilter('currencyId', ev)"><option t-foreach="state.data.filters.currencies" t-as="option" t-key="option.id" t-att-value="option.id" t-att-selected="state.currencyId === option.id" t-esc="option.name === 'USD' ? 'Dólar (USD)' : 'Peso chileno (CLP)'"/></select></label>
    </section>
    <section class="o_mgmt_actions"><button class="btn btn-primary" t-on-click="() => this.openAction('step_management_costs.action_operational_budget_create')"><i class="fa fa-magic"/> Crear presupuesto desde plantilla</button><button class="btn btn-light" t-on-click="() => this.openAction('step_management_costs.action_budget_template')"><i class="fa fa-copy"/> Plantillas</button><button class="btn btn-light" t-on-click="() => this.openAction('step_management_costs.action_management_plan')"><i class="fa fa-calendar-check-o"/> Planificación</button><button class="btn btn-light" t-on-click="() => this.openAction('step_management_costs.action_historical_cost')"><i class="fa fa-line-chart"/> Presupuesto vs. real</button></section>
    <section class="o_mgmt_kpis">
        <button class="o_mgmt_kpi o_mgmt_kpi--main" t-on-click="() => this.openAction('step_management_costs.action_operational_budget')"><span>Presupuestos</span><strong t-esc="number(state.data.budgets.total)"/><small><b t-esc="number(state.data.budgets.draft)"/> borradores</small></button>
        <article class="o_mgmt_kpi o_mgmt_kpi--money"><span>Monto presupuestado</span><strong t-esc="money(state.data.budgets.amount)"/><small>Operación · <t t-esc="state.data.currencies.selected"/></small></article>
        <article class="o_mgmt_kpi o_mgmt_kpi--investment"><span>Presupuesto de inversión</span><strong t-esc="money(state.data.budgets.investment)"/><small>Inversión y crecimiento · <t t-esc="state.data.currencies.selected"/></small></article>
        <article class="o_mgmt_kpi"><span>Hectáreas presupuestadas</span><strong><t t-esc="number(state.data.budgets.hectares, 1)"/> ha</strong><small><t t-esc="number(state.data.centers.hectares, 1)"/> ha registradas</small></article>
        <button class="o_mgmt_kpi o_mgmt_kpi--purple" t-on-click="() => this.openAction('step_management_costs.action_budget_template')"><span>Plantillas vigentes</span><strong t-esc="number(state.data.templates)"/><small>reutilizables</small></button>
        <button class="o_mgmt_kpi o_mgmt_kpi--orange" t-on-click="() => this.openAction('step_management_costs.action_management_plan')"><span>Planes abiertos</span><strong t-esc="number(state.data.plans.open)"/><small><t t-esc="number(state.data.plans.total)"/> planes en el período</small></button>
    </section>
    <p t-if="state.data.budgets.missing_rates" class="o_mgmt_rate_notice" role="status">Falta tipo de cambio para <t t-esc="number(state.data.budgets.missing_rates)"/> presupuesto(s). Configure el tipo de cambio correspondiente para completar los importes en <t t-esc="state.data.currencies.selected"/>.</p>
    <section class="o_mgmt_grid">
        <article class="o_mgmt_panel o_mgmt_full o_mgmt_projected"><header><div><span>PROYECCIÓN OPERACIONAL</span><h2>Resultado económico proyectado</h2></div><small t-esc="state.data.currencies.selected"/></header>
            <div t-if="!state.data.projected.length" class="o_mgmt_empty">No hay líneas operacionales para los filtros seleccionados.</div>
            <div t-else="" class="o_mgmt_table_scroll"><table class="o_mgmt_table"><thead><tr><th scope="col">Especie</th><th scope="col">Ingresos</th><th scope="col">Costos</th><th scope="col">Resultado</th></tr></thead><tbody><tr t-foreach="state.data.projected" t-as="row" t-key="row.key"><th scope="row" t-esc="row.species"/><td t-esc="money(row.income)"/><td t-esc="money(row.cost)"/><td t-att-class="row.result &lt; 0 ? 'o_mgmt_negative' : ''"><strong t-esc="money(row.result)"/></td></tr></tbody></table></div>
            <p class="o_mgmt_caption">Ingresos menos costos. Excluye centros de inversión y crecimiento.</p>
        </article>
        <article class="o_mgmt_panel o_mgmt_full o_mgmt_recent"><header><div><span>PRESUPUESTOS RECIENTES</span><h2>Seguimiento operacional</h2></div><button t-on-click="() => this.openAction('step_management_costs.action_operational_budget')">Ver todos</button></header>
            <div t-if="!state.data.recent.length" class="o_mgmt_empty">No hay presupuestos para los filtros seleccionados.</div>
            <div t-else="" class="o_mgmt_table_scroll"><table class="o_mgmt_table o_mgmt_budget_table"><thead><tr><th scope="col">Presupuesto</th><th scope="col">Cosecha</th><th scope="col">Mantención</th><th scope="col">Valor total</th><th scope="col">Kilos estimados</th><th scope="col">Costo unitario</th><th scope="col">Costo ha</th></tr></thead><tbody><tr t-foreach="state.data.recent" t-as="budget" t-key="budget.id">
                <th scope="row"><button class="o_mgmt_budget_link" t-on-click="() => this.openRecord(budget.id)"><strong t-esc="budget.description"/><small><t t-esc="budget.name"/> · <t t-esc="budget.season"/></small></button><small class="o_mgmt_budget_meta"><span t-attf-class="o_mgmt_state o_mgmt_state--{{budget.state}}" t-esc="stateLabel(budget.state)"/> · <t t-esc="number(budget.hectares, 1)"/> ha</small></th>
                <td t-esc="money(budget.harvest)"/><td t-esc="money(budget.maintenance)"/><td><strong t-esc="money(budget.amount)"/></td>
                <td><t t-esc="number(budget.estimated_kg, 2)"/><small t-if="budget.estimated_kg === null" class="o_mgmt_missing">Sin estimación vigente</small></td><td t-esc="money(budget.cost_per_kg, 2)"/><td t-esc="money(budget.cost_per_ha, 2)"/>
            </tr></tbody></table></div>
            <p class="o_mgmt_caption">Cosecha: actividad Cosechar. Mantención: demás costos. Valor total = Cosecha + Mantención. Kilos de la estimación validada más reciente de cada centro y temporada; «—» indica un dato faltante o una base de cálculo en cero.</p>
        </article>
        <article class="o_mgmt_panel o_mgmt_compare"><header><div><span>CONTROL</span><h2>Presupuesto versus real</h2></div></header><div><span>Presupuestado<strong t-esc="money(state.data.costs.budget)"/></span><span>Real<strong t-esc="money(state.data.costs.actual)"/></span><span t-att-class="state.data.costs.variance &gt; 0 ? 'danger' : ''">Desviación<strong t-esc="money(state.data.costs.variance)"/></span></div></article>
        <aside class="o_mgmt_panel o_mgmt_shortcuts"><header><div><span>MAESTROS</span><h2>Configuración rápida</h2></div></header><button t-on-click="() => this.openAction('step_management_costs.action_cost_center')"><i class="fa fa-map-marker"/><span><b>Centros de costo</b><small><t t-esc="number(state.data.centers.total)"/> configurados</small></span></button><button t-on-click="() => this.openAction('step_management_costs.action_budget_group')"><i class="fa fa-sitemap"/><span><b>Grupos presupuestarios</b><small>Mano de obra, insumos y servicios</small></span></button><button t-on-click="() => this.openAction('step_management_costs.action_exchange_rate')"><i class="fa fa-dollar"/><span><b>Tipos de cambio estimados</b><small>Dólar y otras monedas por mes</small></span></button><button t-on-click="() => this.openAction('step_management_costs.action_budget_analysis')"><i class="fa fa-bar-chart"/><span><b>Análisis por indicador</b><small>Centros, grupos y categorías</small></span></button></aside>
        <aside class="o_mgmt_panel o_mgmt_full o_mgmt_workflow"><header><div><span>FLUJO RECOMENDADO</span><h2>Presupuesto en 4 pasos</h2></div></header><ol><li><b>Defina la plantilla</b><small>Indicadores, cantidades mensuales y tarifa por hectárea.</small></li><li><b>Seleccione centros</b><small>Puede incluir tantos centros de costo como necesite.</small></li><li><b>Extrapole</b><small>Odoo multiplica automáticamente por las hectáreas de cada centro.</small></li><li><b>Apruebe y controle</b><small>Compare posteriormente el presupuesto con los costos reales.</small></li></ol></aside>
    </section>
    </t>
</main>
</t>
</templates>
