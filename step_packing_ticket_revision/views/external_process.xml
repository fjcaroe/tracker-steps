<odoo>
  <record id="view_external_packing_process_import" model="ir.ui.view">
    <field name="name">step.external.packing.process.import.form</field>
    <field name="model">step.external.packing.process.import</field>
    <field name="arch" type="xml">
      <form string="Importar procesos de Packing">
        <p>El Excel debe incluir Fruta procesada y Fruta embalada. Las tarjas C deben tener su recepción validada. La carga deja la OT abierta para revisión.</p>
        <group>
          <group>
            <field name="company_id"/>
            <field name="template_id" options="{'no_create': True, 'no_open': True}"/>
            <field name="packing_id" options="{'no_create': True}"/>
            <field name="line_id" options="{'no_create': True}"/>
          </group>
          <group>
            <field name="process_type_id" options="{'no_create': True}"/>
            <field name="order_id" options="{'no_create': True}"/>
            <field name="file" filename="filename"/>
            <field name="filename" invisible="1"/>
            <field name="reviewed" invisible="1"/>
          </group>
        </group>
        <group invisible="not reviewed">
          <field name="preview" nolabel="1"/>
        </group>
        <field name="mapping_ids" invisible="not reviewed">
          <list editable="bottom" create="0" delete="0">
            <field name="kind" readonly="1"/>
            <field name="source" readonly="1"/>
            <field name="packaging_id" readonly="kind != 'packaging'" options="{'no_create': True}"/>
            <field name="caliber_id" readonly="kind != 'caliber'" options="{'no_create': True}"/>
          </list>
        </field>
        <footer>
          <button name="action_review" type="object" string="Revisar Excel" class="btn-primary" invisible="reviewed"/>
          <button name="action_import" type="object" string="Crear órdenes de trabajo" class="btn-primary" invisible="not reviewed"/>
          <button name="action_review" type="object" string="Actualizar equivalencias" invisible="not reviewed"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_external_packing_process_import" model="ir.actions.act_window">
    <field name="name">Importar procesos por Excel</field>
    <field name="res_model">step.external.packing.process.import</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_external_packing_process_import"/>
    <field name="target">new</field>
  </record>
  <menuitem id="menu_external_packing_process_import" name="Importar procesos por Excel"
            parent="step_packing_operations.menu_packing_operations_process"
            action="action_external_packing_process_import" groups="stock.group_stock_user" sequence="15"/>
  <record id="view_external_packing_production_reference" model="ir.ui.view">
    <field name="name">step.packing.production.external.reference</field>
    <field name="model">step.packing.production</field>
    <field name="inherit_id" ref="step_packing_operations.view_packing_production_form"/>
    <field name="arch" type="xml">
      <field name="step_packing_line_id" position="after">
        <field name="step_external_process_folio" invisible="not step_external_process_folio"/>
        <field name="step_external_process_line" invisible="not step_external_process_folio"/>
      </field>
    </field>
  </record>
</odoo>
