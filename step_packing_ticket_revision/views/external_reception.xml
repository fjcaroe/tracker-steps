<odoo>
  <record id="view_external_fruit_reception_import_form" model="ir.ui.view">
    <field name="name">step.external.fruit.reception.import.form</field>
    <field name="model">step.external.fruit.reception.import</field>
    <field name="arch" type="xml">
      <form string="Importar recepciones externas">
        <p>Use la primera hoja del Excel externo. Se creará una recepción en borrador por cada folio.</p>
        <group>
          <group>
            <field name="company_id"/>
            <field name="picking_type_id" options="{'no_create': True}"/>
            <field name="packing_id" options="{'no_create': True}"/>
            <field name="season_id" options="{'no_create': True}"/>
          </group>
          <group>
            <field name="product_id" options="{'no_create': True}"/>
            <field name="category_id" options="{'no_create': True}"/>
            <field name="fruit_class_id" options="{'no_create': True}"/>
            <field name="file" filename="filename"/>
            <field name="filename" invisible="1"/>
          </group>
        </group>
        <group string="Equivalencias de nombres externos">
          <field name="fallback_fundo_id" options="{'no_create': True}"/>
          <field name="fallback_packaging_id" options="{'no_create': True}"/>
        </group>
        <footer>
          <button name="action_import" type="object" string="Crear borradores" class="btn-primary"/>
          <button string="Cancelar" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_external_fruit_reception_import" model="ir.actions.act_window">
    <field name="name">Importar recepciones por Excel</field>
    <field name="res_model">step.external.fruit.reception.import</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_external_fruit_reception_import_form"/>
    <field name="target">new</field>
  </record>
  <menuitem id="menu_external_fruit_reception_import" name="Importar recepciones por Excel"
            parent="step_packing.menu_packing_fruta_receptions" action="action_external_fruit_reception_import"
            groups="stock.group_stock_user" sequence="13"/>
  <record id="view_external_reception_detail" model="ir.ui.view">
    <field name="name">stock.picking.external.reception.detail</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="step_packing_reception_revision.view_process_reception_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='fruit_tag_line_ids']/list/field[@name='step_kg_per_box']" position="after">
        <field name="step_fruit_palletized" optional="hide"/>
      </xpath>
    </field>
  </record>
</odoo>
