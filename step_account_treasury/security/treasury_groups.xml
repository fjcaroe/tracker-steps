<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_treasury" model="ir.module.category">
            <field name="name">Steps Tesorería</field>
            <field name="description">Perfiles de acceso a la planificación de caja.</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_treasury_reader" model="res.groups">
            <field name="name">Tesorería: consulta</field>
            <field name="category_id" ref="module_category_treasury"/>
        </record>
        <record id="group_treasury_user" model="res.groups">
            <field name="name">Tesorería: operación</field>
            <field name="category_id" ref="module_category_treasury"/>
            <field name="implied_ids" eval="[(4, ref('group_treasury_reader'))]"/>
        </record>
        <record id="group_treasury_approver" model="res.groups">
            <field name="name">Tesorería: aprobación</field>
            <field name="category_id" ref="module_category_treasury"/>
            <field name="implied_ids" eval="[(4, ref('group_treasury_user'))]"/>
        </record>
        <record id="group_treasury_manager" model="res.groups">
            <field name="name">Tesorería: configuración</field>
            <field name="category_id" ref="module_category_treasury"/>
            <field name="implied_ids" eval="[(4, ref('group_treasury_approver'))]"/>
        </record>
    </data>
</odoo>
