<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treasury_concept_list" model="ir.ui.view">
        <field name="name">step.treasury.concept.list</field>
        <field name="model">step.treasury.concept</field>
        <field name="arch" type="xml">
            <list string="Conceptos de flujo de caja" editable="bottom" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="flow_type"/>
                <field name="account_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="suggested_sheet" optional="show"/>
                <field name="active" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_treasury_concept_form" model="ir.ui.view">
        <field name="name">step.treasury.concept.form</field>
        <field name="model">step.treasury.concept</field>
        <field name="arch" type="xml">
            <form string="Concepto de flujo de caja">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Clientes por cobrar"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="10"/>
                            <field name="flow_type"/>
                            <field name="suggested_sheet"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="legacy_studio_id" invisible="not legacy_studio_id"/>
                        </group>
                    </group>
                    <group string="Cuentas posibles">
                        <field name="account_ids" nolabel="1" widget="many2many_tags"
                               options="{'no_create': True}"
                               context="{'default_company_ids': [company_id]}"/>
                    </group>
                    <group string="Notas">
                        <field name="note" nolabel="1" placeholder="Uso previsto del concepto..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_treasury_concept_search" model="ir.ui.view">
        <field name="name">step.treasury.concept.search</field>
        <field name="model">step.treasury.concept</field>
        <field name="arch" type="xml">
            <search string="Conceptos de flujo">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="account_ids"/>
                <filter name="type_opening" string="Saldo inicial" domain="[('flow_type', '=', 'opening')]"/>
                <filter name="type_inflow" string="Ingresos" domain="[('flow_type', '=', 'inflow')]"/>
                <filter name="type_outflow" string="Egresos" domain="[('flow_type', '=', 'outflow')]"/>
                <separator/>
                <filter name="inactive" string="Archivados" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_type" string="Tipo" context="{'group_by': 'flow_type'}"/>
                    <filter name="group_sheet" string="Hoja sugerida" context="{'group_by': 'suggested_sheet'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_treasury_concept" model="ir.actions.act_window">
        <field name="name">Concepto flujo caja</field>
        <field name="res_model">step.treasury.concept</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_treasury_concept_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el primer concepto de flujo</p>
            <p>Los conceptos clasifican los movimientos del flujo de caja y pueden
               asociarse a varias cuentas contables.</p>
        </field>
    </record>
</odoo>
