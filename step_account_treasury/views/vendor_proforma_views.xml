<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_proforma_list" model="ir.ui.view">
        <field name="name">step.vendor.proforma.list</field>
        <field name="model">step.vendor.proforma</field>
        <field name="arch" type="xml">
            <list string="Proformas de proveedor" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'approved'" decoration-info="state == 'invoiced'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="date_due"/>
                <field name="reference" optional="hide"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_vendor_proforma_form" model="ir.ui.view">
        <field name="name">step.vendor.proforma.form</field>
        <field name="model">step.vendor.proforma</field>
        <field name="arch" type="xml">
            <form string="Proforma de proveedor">
                <header>
                    <button name="action_approve" string="Aprobar" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mark_invoiced" string="Marcar facturada" type="object"
                            invisible="state != 'approved'"/>
                    <button name="action_draft" string="Volver a borrador" type="object"
                            invisible="state not in ('approved', 'cancelled')"/>
                    <button name="action_cancel" string="Anular" type="object"
                            invisible="state in ('invoiced', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="reference" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="date_due"/>
                        </group>
                        <group>
                            <field name="currency_id" readonly="state != 'draft'"
                                   groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="move_id" readonly="1" invisible="not move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Líneas">
                            <field name="line_ids" readonly="state not in ('draft',)">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show"/>
                                    <field name="price_subtotal" sum="Base"/>
                                    <field name="price_total" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page name="notes" string="Notas">
                            <field name="note" placeholder="Observaciones..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vendor_proforma_search" model="ir.ui.view">
        <field name="name">step.vendor.proforma.search</field>
        <field name="model">step.vendor.proforma</field>
        <field name="arch" type="xml">
            <search string="Proformas">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <filter name="pending" string="Pendientes de facturar"
                        domain="[('state', '=', 'approved'), ('move_id', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vendor_proforma" model="ir.actions.act_window">
        <field name="name">Proformas de proveedor</field>
        <field name="res_model">step.vendor.proforma</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vendor_proforma_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre la primera proforma</p>
            <p>Sólo las proformas aprobadas y aún no facturadas se proyectan en el flujo de caja.</p>
        </field>
    </record>
</odoo>
