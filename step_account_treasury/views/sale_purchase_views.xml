<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_treasury" model="ir.ui.view">
        <field name="name">sale.order.form.treasury</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="validity_date" position="after">
                <field name="treasury_due_date"/>
            </field>
        </field>
    </record>

    <record id="view_purchase_order_form_treasury" model="ir.ui.view">
        <field name="name">purchase.order.form.treasury</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="date_planned" position="after">
                <field name="treasury_due_date"/>
            </field>
        </field>
    </record>
</odoo>
