<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Cuatro permisos para cuatro responsabilidades distintas. Se separan
            porque generar un archivo previsional, decidir contra qué versión
            del formato se genera y auditar lo generado no son la misma
            función, y en varias empresas no las hace la misma persona.
        -->

        <record id="group_previred_summary" model="res.groups">
            <field name="name">Previred: consultar resumen</field>
            <field name="category_id" ref="base.module_category_human_resources_payroll"/>
            <field name="comment">Permite abrir el asistente, validar un período
y ver el resumen con el detalle de errores por trabajador. NO permite
descargar el archivo.</field>
        </record>

        <record id="group_previred_generate" model="res.groups">
            <field name="name">Previred: generar exportaciones</field>
            <field name="category_id" ref="base.module_category_human_resources_payroll"/>
            <field name="implied_ids" eval="[(4, ref('step_hr_previred.group_previred_summary')), (4, ref('hr_payroll.group_hr_payroll_manager'))]"/>
            <field name="comment">Permite producir el TXT oficial, el Excel de
revisión y el ZIP. El archivo Previred declara la nómina completa de la
empresa, así que sólo debe otorgarse a quien tiene acceso real a todas las
liquidaciones de la compañía.</field>
        </record>

        <record id="group_previred_technical" model="res.groups">
            <field name="name">Previred: administrar perfiles de formato</field>
            <field name="category_id" ref="base.module_category_human_resources_payroll"/>
            <field name="comment">Permite crear y editar los perfiles que fijan
la versión de la especificación oficial y el motor de nómina. No otorga por sí
solo la generación del archivo: son permisos independientes.</field>
        </record>

        <record id="group_previred_audit" model="res.groups">
            <field name="name">Previred: auditar lotes</field>
            <field name="category_id" ref="base.module_category_human_resources_payroll"/>
            <field name="comment">Permite consultar el historial de lotes
generados, sus conteos y los hashes de cada archivo. Los lotes no guardan RUT,
nombres ni importes por persona.</field>
        </record>

        <!--
            Aislamiento multiempresa. Se aplica en servidor sobre el modelo, no
            ocultando botones: un usuario no puede leer ni el lote ni sus
            archivos de una compañía que no tiene habilitada.
        -->
        <record id="rule_previred_batch_company" model="ir.rule">
            <field name="name">Lote Previred: sólo compañías del usuario</field>
            <field name="model_id" ref="model_step_previred_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_previred_batch_file_company" model="ir.rule">
            <field name="name">Archivo del lote Previred: sólo compañías del usuario</field>
            <field name="model_id" ref="model_step_previred_batch_file"/>
            <field name="domain_force">[('batch_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_previred_profile_company" model="ir.rule">
            <field name="name">Perfil Previred: general o de las compañías del usuario</field>
            <field name="model_id" ref="model_step_previred_profile"/>
            <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
