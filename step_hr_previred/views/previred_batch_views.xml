<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_previred_batch_list" model="ir.ui.view">
        <field name="name">step.previred.batch.list</field>
        <field name="model">step.previred.batch</field>
        <field name="arch" type="xml">
            <list string="Lotes Previred" create="false" delete="false"
                  decoration-danger="result in ('blocked','error')"
                  decoration-muted="result == 'validated'">
                <field name="create_date" string="Fecha"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="period"/>
                <field name="scope"/>
                <field name="output"/>
                <field name="worker_count"/>
                <field name="row_count"/>
                <field name="department_count"/>
                <field name="error_count"/>
                <field name="warning_count"/>
                <field name="result" widget="badge"/>
                <field name="spec_version" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_previred_batch_form" model="ir.ui.view">
        <field name="name">step.previred.batch.form</field>
        <field name="model">step.previred.batch</field>
        <field name="arch" type="xml">
            <form string="Lote Previred" create="false" edit="false">
                <sheet>
                    <div class="alert alert-info" role="status">
                        El lote guarda el contexto de la generación y el hash de
                        cada archivo. <strong>No guarda RUT, nombres ni importes
                        por persona.</strong>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    <group>
                        <group string="Acción">
                            <field name="user_id"/>
                            <field name="create_date" string="Fecha"/>
                            <field name="company_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="result"/>
                        </group>
                        <group string="Formato">
                            <field name="profile_id"/>
                            <field name="engine"/>
                            <field name="spec_version"/>
                            <field name="spec_source" widget="url"/>
                        </group>
                        <group string="Alcance">
                            <field name="scope"/>
                            <field name="output"/>
                            <field name="department_names"/>
                            <field name="allow_without_department"/>
                        </group>
                        <group string="Conteos">
                            <field name="worker_count"/>
                            <field name="principal_count"/>
                            <field name="annex_count"/>
                            <field name="row_count"/>
                            <field name="department_count"/>
                            <field name="without_department_count"/>
                            <field name="error_count"/>
                            <field name="warning_count"/>
                            <field name="issue_codes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Archivos" name="files">
                            <field name="file_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="department"/>
                                    <field name="worker_count"/>
                                    <field name="row_count"/>
                                    <field name="byte_size"/>
                                    <field name="sha256"/>
                                    <field name="is_official"
                                           string="Cargable en Previred"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_previred_batch" model="ir.actions.act_window">
        <field name="name">Lotes Previred</field>
        <field name="res_model">step.previred.batch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
