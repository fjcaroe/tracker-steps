<odoo>
 <record id="shipment_pivot" model="ir.ui.view"><field name="name">step.export.shipment.report.pivot</field><field name="model">step.export.shipment.report</field><field name="arch" type="xml"><pivot string="Informe de embarques" disable_linking="1"><field name="sales_program_id" type="row"/><field name="container_qty" type="measure"/><field name="pallet_qty" type="measure"/><field name="box_qty" type="measure"/><field name="kg_qty" type="measure"/><field name="amount_usd" type="measure"/></pivot></field></record>
 <record id="shipment_graph" model="ir.ui.view"><field name="name">step.export.shipment.report.graph</field><field name="model">step.export.shipment.report</field><field name="arch" type="xml"><graph string="Embarques reales"><field name="sales_program_id"/><field name="kg_qty" type="measure"/></graph></field></record>
 <record id="shipment_list" model="ir.ui.view"><field name="name">step.export.shipment.report.list</field><field name="model">step.export.shipment.report</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="date"/><field name="shipment_id"/><field name="shipment_number"/><field name="sales_program_id"/><field name="receiver_id"/><field name="product_id"/><field name="variety_id"/><field name="label"/><field name="container_qty" sum="Total"/><field name="pallet_qty" sum="Total"/><field name="box_qty" sum="Total"/><field name="kg_qty" sum="Total"/><field name="amount_usd" sum="Total USD"/><field name="usd_currency_id" column_invisible="True"/><field name="allocation_missing"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="shipment_form" model="ir.ui.view"><field name="name">step.export.shipment.report.form</field><field name="model">step.export.shipment.report</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_open_shipment" type="object" string="Ver embarque" class="btn-primary"/></header><sheet><group><field name="shipment_id"/><field name="shipment_number"/><field name="date"/><field name="company_id"/><field name="season_id"/><field name="sales_program_id"/><field name="receiver_id"/><field name="product_id"/><field name="variety_id"/><field name="caliber_id"/><field name="quality_id"/><field name="label"/><field name="kg_qty"/><field name="amount_company"/><field name="company_currency_id"/><field name="amount_usd"/><field name="usd_currency_id"/><field name="allocation_missing"/></group></sheet></form></field></record>
 <record id="shipment_search" model="ir.ui.view"><field name="name">step.export.shipment.report.search</field><field name="model">step.export.shipment.report</field><field name="arch" type="xml"><search string="Informe de embarques">
  <field name="season_id"/><field name="date"/><field name="transport_type"/><field name="shipment_id"/><field name="shipment_number"/><field name="sales_program_id"/><field name="receiver_id"/><field name="sale_mode_id"/><field name="vessel_id"/><field name="destination_country_id"/><field name="destination_port_id"/><field name="product_id"/><field name="variety_id"/><field name="caliber_id"/><field name="quality_id"/><field name="label"/>
  <filter name="period" string="Fecha embarque" date="date"/><filter name="unallocated" string="Sin kilos distribuibles" domain="[('allocation_missing','=',True)]"/>
  <group expand="0" string="Agrupar por"><filter name="season" string="Temporada" context="{'group_by':'season_id'}"/><filter name="year" string="Año" context="{'group_by':'date:year'}"/><filter name="quarter" string="Trimestre" context="{'group_by':'date:quarter'}"/><filter name="month" string="Mes" context="{'group_by':'date:month'}"/><filter name="week" string="Semana" context="{'group_by':'date:week'}"/><filter name="program" string="Programa ventas" context="{'group_by':'sales_program_id'}"/><filter name="product" string="Producto" context="{'group_by':'product_id'}"/><filter name="variety" string="Variedad" context="{'group_by':'variety_id'}"/><filter name="receiver" string="Recibidor" context="{'group_by':'receiver_id'}"/></group>
 </search></field></record>
 <record id="step_export.action_export_shipment_overview" model="ir.actions.act_window"><field name="name">Informe de embarques</field><field name="res_model">step.export.shipment.report</field><field name="view_mode">pivot,graph,list,form</field><field name="view_id" ref="shipment_pivot"/><field name="search_view_id" ref="shipment_search"/><field name="domain">[]</field><field name="context">{'create':False}</field><field name="help" type="html"><p>Embarques reales. Venta neta contabilizada: factura + débito − crédito, distribuida entre líneas en proporción a los kilos. Los contenedores se distribuyen con la misma proporción. Venta USD permite comparar monedas; Venta usa la moneda de cada empresa. Precio total = Venta USD / Kilos.</p></field></record>
 <record id="step_export.menu_step_export_dispatch_order" model="ir.ui.menu"><field name="active" eval="False"/></record>
 <record id="step_export.menu_step_export_stock_reservation" model="ir.ui.menu"><field name="active" eval="False"/></record>
</odoo>
