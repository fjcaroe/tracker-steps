<odoo>
    <record id="view_contract_review" model="ir.ui.view">
        <field name="name">hr.contract.payroll.migration.review</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group invisible="not step_payroll_migration_review"><field name="step_payroll_migration_review"/><button name="action_confirm_payroll_migration" type="object" string="Confirmar parámetros de nómina" groups="hr_payroll.group_hr_payroll_manager" confirm="Confirma que revisó los parámetros previsionales, asignaciones y estructura de Simple Digital del contrato. Las liquidaciones históricas se conservan."/></group></xpath></field>
    </record>
    <record id="view_history_list" model="ir.ui.view">
        <field name="name">step.payroll.legacy.snapshot.list</field>
        <field name="model">step.payroll.legacy.snapshot</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="source_model"/><field name="source_id"/><field name="company_id" groups="base.group_multi_company"/></list></field>
    </record>
    <record id="view_history_form" model="ir.ui.view">
        <field name="name">step.payroll.legacy.snapshot.form</field>
        <field name="model">step.payroll.legacy.snapshot</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="source_model"/><field name="source_id"/><field name="company_id" groups="base.group_multi_company"/></group><field name="payload"/></sheet></form></field>
    </record>
    <record id="action_history" model="ir.actions.act_window"><field name="name">Archivo de nómina anterior</field><field name="res_model">step.payroll.legacy.snapshot</field><field name="view_mode">list,form</field></record>
</odoo>
