<odoo>
    <record id="rule_bank_export_wizard_owner" model="ir.rule">
        <field name="name">Archivos bancarios: asistente propio</field>
        <field name="model_id" ref="model_step_bank_export_wizard"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_bank_export_wizard_company" model="ir.rule">
        <field name="name">Archivos bancarios: empresas activas</field>
        <field name="model_id" ref="model_step_bank_export_wizard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
