<odoo>
    <record id="view_partner_bank_form_bancoestado" model="ir.ui.view">
        <field name="name">res.partner.bank.form.bancoestado</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <field name="bank_id" position="after"><field name="step_bancoestado_payment_method"/></field>
        </field>
    </record>
    <record id="view_partner_bank_security" model="ir.ui.view">
        <field name="name">res.partner.bank.security</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <field name="bank_id" position="after"><field name="step_security_credit_type"/></field>
        </field>
    </record>
</odoo>
