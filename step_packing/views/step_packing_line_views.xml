<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_line_list" model="ir.ui.view">
        <field name="name">step.packing.line.list</field>
        <field name="model">step.packing.line</field>
        <field name="arch" type="xml">
            <list string="Línea de Proceso">
                    <field name="name"/>
                    <field name="species_id"/>
                    <field name="workcenter_id"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_line_form" model="ir.ui.view">
        <field name="name">step.packing.line.form</field>
        <field name="model">step.packing.line</field>
        <field name="arch" type="xml">
            <form string="Línea de Proceso">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="staff_total"/>
                        <field name="containers_per_hour"/>
                        <field name="kg_per_hour"/>
                        <field name="species_id"/>
                        <field name="package_id"/>
                        <field name="workcenter_id"/>
                        <field name="capacity_inches"/>
                        <field name="capacity_m3"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_line" model="ir.actions.act_window">
        <field name="name">Línea de Proceso</field>
        <field name="res_model">step.packing.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
