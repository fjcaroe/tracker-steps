<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_tag_state_list" model="ir.ui.view">
        <field name="name">step.packing.tag.state.list</field>
        <field name="model">step.packing.tag.state</field>
        <field name="arch" type="xml">
            <list string="Estado de Tarja">
                    <field name="name"/>
                    <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_tag_state_form" model="ir.ui.view">
        <field name="name">step.packing.tag.state.form</field>
        <field name="model">step.packing.tag.state</field>
        <field name="arch" type="xml">
            <form string="Estado de Tarja">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_tag_state" model="ir.actions.act_window">
        <field name="name">Estado de Tarja</field>
        <field name="res_model">step.packing.tag.state</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
