<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_stop_reason_list" model="ir.ui.view">
        <field name="name">step.packing.stop.reason.list</field>
        <field name="model">step.packing.stop.reason</field>
        <field name="arch" type="xml">
            <list string="Causa de Detención de Línea">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_stop_reason_form" model="ir.ui.view">
        <field name="name">step.packing.stop.reason.form</field>
        <field name="model">step.packing.stop.reason</field>
        <field name="arch" type="xml">
            <form string="Causa de Detención de Línea">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_stop_reason" model="ir.actions.act_window">
        <field name="name">Causa de Detención de Línea</field>
        <field name="res_model">step.packing.stop.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
