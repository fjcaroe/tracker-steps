<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_temperature_control_list" model="ir.ui.view">
        <field name="name">step.packing.temperature.control.list</field>
        <field name="model">step.packing.temperature.control</field>
        <field name="arch" type="xml">
            <list string="Control de Temperatura">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_temperature_control_form" model="ir.ui.view">
        <field name="name">step.packing.temperature.control.form</field>
        <field name="model">step.packing.temperature.control</field>
        <field name="arch" type="xml">
            <form string="Control de Temperatura">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_temperature_control" model="ir.actions.act_window">
        <field name="name">Control de Temperatura</field>
        <field name="res_model">step.packing.temperature.control</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
