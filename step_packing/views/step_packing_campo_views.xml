<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_campo_list" model="ir.ui.view">
        <field name="name">step.packing.campo.list</field>
        <field name="model">step.packing.campo</field>
        <field name="arch" type="xml">
            <list string="Packing Campo">
                    <field name="name"/>
                    <field name="fundo_id"/>
                    <field name="species_id"/>
                    <field name="date"/>
                    <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_campo_form" model="ir.ui.view">
        <field name="name">step.packing.campo.form</field>
        <field name="model">step.packing.campo</field>
        <field name="arch" type="xml">
            <form string="Packing Campo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="partner_id"/>
                        <field name="partner_phone"/>
                        <field name="partner_email"/>
                        <field name="company_id"/>
                        <field name="notes"/>
                        <field name="date"/>
                        <field name="date_start"/>
                        <field name="date_stop"/>
                        <field name="sequence"/>
                        <field name="stage_id"/>
                        <field name="priority"/>
                        <field name="color"/>
                        <field name="tag_ids"/>
                        <field name="currency_id"/>
                        <field name="value"/>
                        <field name="fundo_id"/>
                        <field name="species_id"/>
                        <field name="process_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_campo" model="ir.actions.act_window">
        <field name="name">Packing Campo</field>
        <field name="res_model">step.packing.campo</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
