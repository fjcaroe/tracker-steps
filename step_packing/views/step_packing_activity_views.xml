<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_activity_list" model="ir.ui.view">
        <field name="name">step.packing.activity.list</field>
        <field name="model">step.packing.activity</field>
        <field name="arch" type="xml">
            <list string="Actividad Agrícola">
                    <field name="name"/>
                    <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_activity_form" model="ir.ui.view">
        <field name="name">step.packing.activity.form</field>
        <field name="model">step.packing.activity</field>
        <field name="arch" type="xml">
            <form string="Actividad Agrícola">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="code"/>
                        <field name="date"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_activity" model="ir.actions.act_window">
        <field name="name">Actividad Agrícola</field>
        <field name="res_model">step.packing.activity</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
