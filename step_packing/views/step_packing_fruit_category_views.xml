<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_fruit_category_list" model="ir.ui.view">
        <field name="name">step.packing.fruit.category.list</field>
        <field name="model">step.packing.fruit.category</field>
        <field name="arch" type="xml">
            <list string="Categoría de Fruta">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_fruit_category_form" model="ir.ui.view">
        <field name="name">step.packing.fruit.category.form</field>
        <field name="model">step.packing.fruit.category</field>
        <field name="arch" type="xml">
            <form string="Categoría de Fruta">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_fruit_category" model="ir.actions.act_window">
        <field name="name">Categoría de Fruta</field>
        <field name="res_model">step.packing.fruit.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
