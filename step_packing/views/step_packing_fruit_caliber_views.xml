<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_fruit_caliber_list" model="ir.ui.view">
        <field name="name">step.packing.fruit.caliber.list</field>
        <field name="model">step.packing.fruit.caliber</field>
        <field name="arch" type="xml">
            <list string="Calibre de Fruta">
                    <field name="name"/>
                    <field name="species_id"/>
                    <field name="caliber_group_id"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_fruit_caliber_form" model="ir.ui.view">
        <field name="name">step.packing.fruit.caliber.form</field>
        <field name="model">step.packing.fruit.caliber</field>
        <field name="arch" type="xml">
            <form string="Calibre de Fruta">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="caliber_name"/>
                        <field name="caliber_range"/>
                        <field name="species_id"/>
                        <field name="fruit_weight_gr"/>
                        <field name="weight_range"/>
                        <field name="units_per_kg"/>
                        <field name="caliber_group_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_fruit_caliber" model="ir.actions.act_window">
        <field name="name">Calibre de Fruta</field>
        <field name="res_model">step.packing.fruit.caliber</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
