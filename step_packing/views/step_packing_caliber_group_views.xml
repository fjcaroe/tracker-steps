<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_caliber_group_list" model="ir.ui.view">
        <field name="name">step.packing.caliber.group.list</field>
        <field name="model">step.packing.caliber.group</field>
        <field name="arch" type="xml">
            <list string="Grupo de Calibre">
                    <field name="name"/>
                    <field name="species_id"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_caliber_group_form" model="ir.ui.view">
        <field name="name">step.packing.caliber.group.form</field>
        <field name="model">step.packing.caliber.group</field>
        <field name="arch" type="xml">
            <form string="Grupo de Calibre">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="caliber_range"/>
                        <field name="weight_range"/>
                        <field name="species_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_caliber_group" model="ir.actions.act_window">
        <field name="name">Grupo de Calibre</field>
        <field name="res_model">step.packing.caliber.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
