<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_process_type_tag_list" model="ir.ui.view">
        <field name="name">step.packing.process.type.tag.list</field>
        <field name="model">step.packing.process.type.tag</field>
        <field name="arch" type="xml">
            <list string="Tipo de Proceso (etiqueta)">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_process_type_tag_form" model="ir.ui.view">
        <field name="name">step.packing.process.type.tag.form</field>
        <field name="model">step.packing.process.type.tag</field>
        <field name="arch" type="xml">
            <form string="Tipo de Proceso (etiqueta)">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_process_type_tag" model="ir.actions.act_window">
        <field name="name">Tipo de Proceso (etiqueta)</field>
        <field name="res_model">step.packing.process.type.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
