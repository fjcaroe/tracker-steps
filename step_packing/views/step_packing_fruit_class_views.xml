<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_packing_fruit_class_list" model="ir.ui.view">
        <field name="name">step.packing.fruit.class.list</field>
        <field name="model">step.packing.fruit.class</field>
        <field name="arch" type="xml">
            <list string="Clase de Fruta">
                    <field name="name"/>
                    <field name="is_cosecha"/>
                    <field name="is_packing"/>
            </list>
        </field>
    </record>

    <record id="view_step_packing_fruit_class_form" model="ir.ui.view">
        <field name="name">step.packing.fruit.class.form</field>
        <field name="model">step.packing.fruit.class</field>
        <field name="arch" type="xml">
            <form string="Clase de Fruta">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="is_cosecha"/>
                        <field name="is_packing"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_packing_fruit_class" model="ir.actions.act_window">
        <field name="name">Clase de Fruta</field>
        <field name="res_model">step.packing.fruit.class</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
