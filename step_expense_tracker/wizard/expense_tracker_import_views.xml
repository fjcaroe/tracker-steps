<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_expense_tracker_import_form" model="ir.ui.view">
        <field name="name">step.expense.tracker.import.form</field>
        <field name="model">step.expense.tracker.import</field>
        <field name="arch" type="xml">
            <form string="Traer desde Tracker">
                <field name="state" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="sheet_employee_id" invisible="1"/>
                <group invisible="state != 'setup'">
                    <group>
                        <field name="sheet_id" readonly="1"/>
                        <field name="vehicle_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="zone_name"/>
                        <field name="use_tracker_sync"/>
                        <field name="allow_reuse"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="state != 'setup'">
                    Buscar no crea gastos: primero verá una vista previa de las sesiones <b>cerradas</b> del vehículo y
                    elegirá cuáles incorporar. Las fechas se interpretan en la zona horaria indicada.
                </div>
                <div invisible="state != 'preview'">
                    <group>
                        <group>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="selected_count"/>
                            <field name="selected_km"/>
                            <field name="coverage_complete" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="coverage_complete or not coverage_message">
                        <field name="coverage_message" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-success" role="alert" invisible="not coverage_complete or not coverage_message">
                        <field name="coverage_message" readonly="1" nolabel="1"/>
                    </div>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0" decoration-muted="not selectable"
                              decoration-warning="issues and selectable">
                            <field name="selectable" column_invisible="1"/>
                            <field name="refill_available" column_invisible="1"/>
                            <field name="hourmeter_available" column_invisible="1"/>
                            <field name="distance_known" column_invisible="1"/>
                            <field name="selected" readonly="not selectable"/>
                            <field name="local_date"/>
                            <field name="started_at" optional="show"/>
                            <field name="ended_at" optional="show"/>
                            <field name="duration_hours" widget="float_time" string="Duración sesión"/>
                            <field name="distance_km" sum="Km" invisible="not distance_known"/>
                            <field name="employee_id"/>
                            <field name="analytic_account_id" optional="show"/>
                            <field name="hourmeter_initial" invisible="not hourmeter_available" optional="hide"/>
                            <field name="hourmeter_final" invisible="not hourmeter_available" optional="hide"/>
                            <field name="refill_liters" invisible="not refill_available" optional="show"/>
                            <field name="use_refill" readonly="not refill_available or not selectable"/>
                            <field name="estimated_fuel_liters" optional="hide"/>
                            <field name="used_in" optional="show"/>
                            <field name="issues"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_preview" type="object" string="Buscar recorridos" class="btn-primary"
                            invisible="state != 'setup'"/>
                    <button name="action_confirm" type="object" string="Incorporar seleccionados" class="btn-primary"
                            invisible="state != 'preview' or selected_count == 0"/>
                    <button name="action_back" type="object" string="Cambiar parámetros" invisible="state != 'preview'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
