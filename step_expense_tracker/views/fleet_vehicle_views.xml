<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_step_expense" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.step.expense</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_step_expenses" type="object" class="oe_stat_button" icon="fa-money"
                        groups="base.group_user">
                    <field name="step_expense_count" widget="statinfo" string="Gastos"/>
                </button>
                <button name="action_open_step_expense_sheets" type="object" class="oe_stat_button" icon="fa-file-text-o"
                        groups="base.group_user">
                    <field name="step_expense_sheet_count" widget="statinfo" string="Rendiciones"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
