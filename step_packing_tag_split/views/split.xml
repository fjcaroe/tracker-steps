<odoo>
    <record id="packing_production_split" model="ir.ui.view">
        <field name="name">step.packing.production.split.input</field>
        <field name="model">step.packing.production</field>
        <field name="inherit_id" ref="step_packing_operations.view_packing_production_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inputs']/field[@name='step_packing_input_tag_ids']" position="before">
                <button name="action_split_input_tag" type="object" string="Dividir tarja C"
                        groups="stock.group_stock_user"
                        invisible="state != 'created' or material_review_state == 'approved' or not step_packing_input_tag_ids"/>
            </xpath>
        </field>
    </record>
    <record id="tag_split_form" model="ir.ui.view">
        <field name="name">step.packing.tag.split.form</field>
        <field name="model">step.packing.tag.split</field>
        <field name="arch" type="xml">
            <form string="Dividir tarja C">
                <group>
                    <field name="production_id"/>
                    <field name="input_tag_ids" invisible="1"/>
                    <field name="source_id" domain="[('id', 'in', input_tag_ids)]" options="{'no_create': True}"/>
                    <field name="source_boxes"/>
                    <field name="source_kg"/>
                    <field name="process_boxes"/>
                    <field name="process_kg"/>
                    <field name="remaining_boxes"/>
                    <field name="remaining_kg"/>
                </group>
                <footer>
                    <button name="action_split" type="object" string="Dividir y conservar saldo" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
