<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_payroll_allowance_days" model="ir.ui.view">
        <field name="name">res.company.form.payroll.allowance.days</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="payroll_allowance_days" string="Bonos mensuales" groups="base.group_system">
                    <group string="Días enteros">
                        <field name="payroll_whole_days_meal"/>
                        <field name="payroll_whole_days_transport"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
