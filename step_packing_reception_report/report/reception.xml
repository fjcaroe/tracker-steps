<odoo>
  <template id="operations">
    <style>
      .step_receipt_operations, .step_receipt_pallets {border:0 !important; border-collapse:collapse;}
      .step_receipt_operations th, .step_receipt_operations td,
      .step_receipt_pallets th, .step_receipt_pallets td {
        padding:4px 6px !important; border:0 !important; vertical-align:top;
        white-space:normal !important; word-wrap:break-word;
      }
      .step_receipt_operations thead th, .step_receipt_pallets thead th {border-bottom:1px solid #7c8792 !important;}
      .step_receipt_operations tbody td, .step_receipt_pallets tbody td {border-bottom:1px solid #e4e7eb !important;}
      .step_receipt_operations tfoot td, .step_receipt_pallets tfoot td {border-top:1px solid #7c8792 !important;}
    </style>
    <t t-set="totals" t-value="o._step_receipt_totals()"/>
    <table class="table table-sm table-borderless step_receipt_operations" style="font-size:10px;table-layout:fixed;width:100%;">
      <thead style="display:table-header-group;"><tr>
        <th style="width:24%;">Producto</th><th style="width:12%;">Tipo pallet</th>
        <th class="text-end" style="width:9%;">Cantidad pallets</th><th style="width:15%;">Empaquetado</th>
        <th class="text-end" style="width:10%;">Cantidad envases</th><th style="width:7%;">Unidad</th>
        <th class="text-end" style="width:11%;">Demanda</th><th class="text-end" style="width:12%;">Cantidad</th>
      </tr></thead>
      <tbody>
        <tr t-foreach="o._step_receipt_operations()" t-as="move" style="page-break-inside:avoid;">
          <td style="word-wrap:break-word;"><span t-field="move.product_id"/></td>
          <td><span t-field="move.step_fruit_pallet_type_id"/></td>
          <td class="text-end"><span t-field="move.step_fruit_pallet_qty" t-options="{'widget':'float','precision':2}"/></td>
          <td style="word-wrap:break-word;"><span t-field="move.product_packaging_id"/></td>
          <td class="text-end"><span t-field="move.step_fruit_packaging_qty" t-options="{'widget':'float','precision':2}"/></td>
          <td><span t-field="move.product_uom"/></td>
          <td class="text-end"><span t-field="move.product_uom_qty" t-options="{'widget':'float','precision':2}"/></td>
          <td class="text-end"><span t-field="move.quantity" t-options="{'widget':'float','precision':2}"/></td>
        </tr>
      </tbody>
      <tfoot style="display:table-row-group;">
        <tr t-foreach="totals['units']" t-as="unit" style="font-weight:bold;page-break-inside:avoid;">
          <td>Total</td><td/>
          <td class="text-end"><span t-if="unit_first" t-out="totals['pallets']" t-options="{'widget':'float','precision':2}"/></td><td/>
          <td class="text-end"><span t-if="unit_first" t-out="totals['containers']" t-options="{'widget':'float','precision':2}"/></td>
          <td><span t-out="unit['uom'].display_name"/></td>
          <td class="text-end"><span t-out="unit['ordered']" t-options="{'widget':'float','precision':2}"/></td>
          <td class="text-end"><span t-out="unit['received']" t-options="{'widget':'float','precision':2}"/></td>
        </tr>
      </tfoot>
    </table>
    <h4 style="font-size:13px;margin-top:16px;">Detalle de pallets</h4>
    <table class="table table-sm table-borderless step_receipt_pallets" style="font-size:10px;table-layout:fixed;width:100%;">
      <thead style="display:table-header-group;"><tr>
        <th style="width:12%;">Folio pallet</th><th style="width:13%;">Especie</th><th style="width:16%;">Variedad</th>
        <th class="text-end" style="width:9%;">Cajas</th><th class="text-end" style="width:13%;">Kilos bruto</th>
        <th class="text-end" style="width:10%;">Tara</th><th class="text-end" style="width:13%;">Kilos netos</th>
        <th class="text-end" style="width:14%;">Peso promedio kg/caja</th>
      </tr></thead>
      <tbody>
        <tr t-foreach="o.fruit_tag_line_ids.sorted(lambda l: (l.sequence,l.id))" t-as="line" style="page-break-inside:avoid;">
          <td style="word-wrap:break-word;"><span t-out="line.tag_number or line.package_id.name or ''"/></td>
          <td><span t-field="o.fruit_species_id"/></td><td><span t-field="o.fruit_variety_id"/></td>
          <td class="text-end"><span t-field="line.quantity" t-options="{'widget':'float','precision':2}"/></td>
          <td class="text-end"><span t-field="line.gross_kg" t-options="{'widget':'float','precision':2}"/></td>
          <td class="text-end"><span t-field="line.tare_kg" t-options="{'widget':'float','precision':2}"/></td>
          <td class="text-end"><span t-field="line.kilos" t-options="{'widget':'float','precision':2}"/></td>
          <td class="text-end"><span t-out="line.kilos / line.quantity if line.quantity else 0.0" t-options="{'widget':'float','precision':2}"/></td>
        </tr>
      </tbody>
      <tfoot style="display:table-row-group;"><tr style="font-weight:bold;page-break-inside:avoid;">
        <td colspan="3">Totales</td>
        <td class="text-end"><span t-out="totals['boxes']" t-options="{'widget':'float','precision':2}"/></td>
        <td class="text-end"><span t-out="totals['gross']" t-options="{'widget':'float','precision':2}"/></td>
        <td class="text-end"><span t-out="totals['tare']" t-options="{'widget':'float','precision':2}"/></td>
        <td class="text-end"><span t-out="totals['net']" t-options="{'widget':'float','precision':2}"/></td>
        <td class="text-end"><span t-out="totals['average']" t-options="{'widget':'float','precision':2}"/></td>
      </tr></tfoot>
    </table>
    <table class="table table-sm table-borderless step_receipt_transport" style="font-size:11px;margin-top:20px;page-break-inside:avoid;">
      <tr><td style="width:15%;"><strong>Transportista</strong></td><td style="width:45%;"><span t-field="o.fruit_carrier_id"/></td>
          <td style="width:15%;"><strong>Patente</strong></td><td style="width:25%;"><span t-field="o.fruit_truck_plate"/></td></tr>
      <tr><td><strong>Chofer</strong></td><td><span t-field="o.step_fruit_driver_id"/></td>
          <td><strong>RUT chofer</strong></td><td><span t-field="o.step_fruit_driver_vat"/></td></tr>
    </table>
  </template>
  <template id="delivery_receipt" inherit_id="stock.report_delivery_document" priority="90">
    <xpath expr="//div[@class='page']/h2" position="replace">
      <h2><t t-if="o._step_is_fruit_receipt()">RECIBO DE RECEPCIÓN N° </t><span t-field="o.name"/></h2>
    </xpath>
    <xpath expr="//div[@id='informations']" position="after">
      <table t-if="o._step_is_fruit_receipt()" class="table table-sm table-borderless step_receipt_metadata" style="font-size:12px;margin-bottom:18px;">
        <tr><td style="width:15%;"><strong>Número guía</strong></td><td style="width:35%;"><span t-field="o.fruit_guide_number"/></td>
            <td style="width:15%;"><strong>Tipo fruta</strong></td><td style="width:35%;"><span t-if="o.step_fruit_type" t-field="o.step_fruit_type"/><span t-else="" t-field="o.fruit_type"/></td></tr>
        <tr><td><strong>Clase de fruta</strong></td><td><span t-field="o.step_fruit_origin_class_id"/></td>
            <td><strong>Lote</strong></td><td><span t-field="o.name"/></td></tr>
      </table>
    </xpath>
    <xpath expr="//table[@name='stock_move_table']" position="before">
      <t t-if="o._step_is_fruit_receipt()" t-call="step_packing_reception_report.operations"/>
    </xpath>
    <xpath expr="//table[@name='stock_move_table']" position="attributes"><attribute name="t-if">not o._step_is_fruit_receipt() and o.state != 'done'</attribute></xpath>
    <xpath expr="//table[@name='stock_move_line_table']" position="attributes"><attribute name="t-elif"/><attribute name="t-if">not o._step_is_fruit_receipt() and o.move_line_ids and o.state == 'done'</attribute></xpath>
  </template>
</odoo>
