<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="contract_form" model="ir.ui.view">
        <field name="name">contract.account.form</field>
        <field name="model">step.management.purchase.contract</field>
        <field name="inherit_id" ref="step_management_costs.view_purchase_contract_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_post_contract" type="object" string="Contabilizar contrato" invisible="state != 'confirmed' or is_superseded" groups="account.group_account_user" />
            </xpath>
            <field name="reference" position="after">
                <field name="journal_id" />
                <field name="accounting_date" />
                <field name="analytic_distribution" widget="analytic_distribution" />
            </field>
            <xpath expr="//field[@name='installment_ids']/list/field[@name='state']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='installment_ids']/list/field[@name='state']" position="after">
                <field name="move_id" optional="show" />
                <field name="reversal_move_id" optional="hide" />
                <field name="amount_paid" optional="show" />
                <field name="amount_pending" optional="show" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Comprobantes">
                    <field name="move_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="name" />
                            <field name="date" />
                            <field name="ref" />
                            <field name="state" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="journal_form" model="ir.ui.view">
        <field name="name">journal.contract.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <field name="default_account_id" position="after">
                <field name="contract_provision_account_id" invisible="type not in ['general', 'purchase']" />
            </field>
        </field>
    </record>
    <record id="purchase_form" model="ir.ui.view">
        <field name="name">purchase.contract.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="purchase_contract_id" readonly="state not in ['draft','sent']" />
            </field>
        </field>
    </record>
    <record id="picking_form" model="ir.ui.view">
        <field name="name">picking.purchase.contract.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="purchase_contract_id" invisible="not purchase_contract_id" />
            </field>
        </field>
    </record>
    <record id="payment_form" model="ir.ui.view">
        <field name="name">payment.purchase.contract.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="purchase_contract_installment_id" readonly="state != 'draft'" domain="[('company_id', '=', company_id), ('state', '=', 'posted'), ('active', '=', True)]" />
            </field>
        </field>
    </record>
</odoo>