<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aislamiento por compañía. Reglas GLOBALES (sin grupos): se intersectan con cualquier otra.
         Los espejos step.tracker.* existían sin reglas de registro y ahora alimentan cantidades
         para costos y rendiciones. Los XML IDs de modelo son los de step_tracker_odoo. -->
    <record id="rule_step_tracker_machine_company" model="ir.rule">
        <field name="name">Tracker máquinas: compañías permitidas</field>
        <field name="model_id" ref="step_tracker_odoo.model_step_tracker_machine"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
