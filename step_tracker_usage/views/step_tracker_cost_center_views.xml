<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_tracker_cost_center_list" model="ir.ui.view">
        <field name="name">step.tracker.cost_center.list</field>
        <field name="model">step.tracker.cost_center</field>
        <field name="arch" type="xml">
            <list create="0" edit="1">
                <field name="name" readonly="1"/>
                <field name="external_id" readonly="1"/>
                <field name="analytic_account_id"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                <field name="last_sync" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_step_tracker_cost_center_form" model="ir.ui.view">
        <field name="name">step.tracker.cost_center.form</field>
        <field name="model">step.tracker.cost_center</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Datos sincronizados">
                            <field name="tracker_id" readonly="1"/>
                            <field name="external_id" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                        </group>
                        <group string="Integración con Odoo">
                            <field name="company_id" readonly="1"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_tracker_cost_center" model="ir.actions.act_window">
        <field name="name">Centros de costo Web Tracker</field>
        <field name="res_model">step.tracker.cost_center</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_step_tracker_cost_centers"
              name="Centros de costo"
              action="action_step_tracker_cost_center"
              parent="step_tracker_odoo.menu_step_tracker_masters"
              sequence="35"/>
</odoo>
