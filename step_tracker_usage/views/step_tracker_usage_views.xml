<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_tracker_usage_list" model="ir.ui.view">
        <field name="name">step.tracker.usage.list</field>
        <field name="model">step.tracker.usage</field>
        <field name="arch" type="xml">
            <list default_order="started_at desc" create="0" edit="0">
                <field name="started_at"/>
                <field name="vehicle_id"/>
                <field name="machine_id" optional="hide"/>
                <field name="employee_id"/>
                <field name="analytic_account_id"/>
                <field name="duration_hours" widget="float_time" string="Duración sesión"/>
                <field name="distance_km" sum="Km" invisible="not distance_known"/>
                <field name="distance_known" optional="hide"/>
                <field name="hourmeter_known" optional="hide"/>
                <field name="unresolved_reason" optional="hide"/>
                <field name="status" widget="badge" decoration-success="status == 'closed'" decoration-info="status == 'open'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_step_tracker_usage_search" model="ir.ui.view">
        <field name="name">step.tracker.usage.search</field>
        <field name="model">step.tracker.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="machine_id"/>
                <field name="employee_id"/>
                <field name="analytic_account_id"/>
                <field name="session_uuid"/>
                <filter name="closed" string="Cerrados válidos" domain="[('is_closed_fact', '=', True)]"/>
                <filter name="open" string="Abiertos" domain="[('status', '=', 'open')]"/>
                <filter name="unresolved" string="Con vínculos sin resolver" domain="[('unresolved_reason', '!=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_vehicle" string="Vehículo" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_employee" string="Conductor" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_analytic" string="Cuenta analítica" context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'started_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_step_tracker_usage_form" model="ir.ui.view">
        <field name="name">step.tracker.usage.form</field>
        <field name="model">step.tracker.usage</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_title"><h1><field name="session_uuid"/></h1></div>
                    <group>
                        <group string="Quién y dónde">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="vehicle_id"/>
                            <field name="machine_id"/>
                            <field name="driver_id"/>
                            <field name="employee_id"/>
                            <field name="cost_center_id"/>
                            <field name="analytic_account_id"/>
                            <field name="unresolved_reason"/>
                        </group>
                        <group string="Cuánto">
                            <field name="status"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                            <field name="duration_hours" widget="float_time" string="Duración de la sesión"/>
                            <field name="distance_known"/>
                            <field name="distance_km" invisible="not distance_known"/>
                            <field name="points_count"/>
                        </group>
                        <group string="Parte diario (lecturas registradas)">
                            <field name="work_order_code"/>
                            <field name="work_order_session_count"/>
                            <field name="hourmeter_known"/>
                            <field name="hourmeter_initial" invisible="not hourmeter_known"/>
                            <field name="hourmeter_final" invisible="not hourmeter_known"/>
                            <field name="fuel_refill_known"/>
                            <field name="fuel_refill_liters" invisible="not fuel_refill_known"/>
                        </group>
                        <group string="Estimación (no es un dato medido)">
                            <field name="estimated_fuel_liters"/>
                            <field name="synced_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_tracker_usage" model="ir.actions.act_window">
        <field name="name">Uso de vehículos (Tracker)</field>
        <field name="res_model">step.tracker.usage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_step_tracker_usage_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay usos importados desde Tracker.</p>
            <p>Se cargan al traer recorridos desde una rendición de gastos o al consultar costos por vehículo.</p>
        </field>
    </record>

    <menuitem id="menu_step_tracker_usage"
              name="Uso de vehículos"
              action="action_step_tracker_usage"
              parent="step_tracker_odoo.menu_step_tracker_operation"
              sequence="30"/>
</odoo>
