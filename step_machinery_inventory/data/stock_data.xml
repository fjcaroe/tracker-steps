<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="stock_location_machinery" model="stock.location">
        <field name="name">MQ/Stock</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
    </record>

    <record id="sequence_picking_type_machinery_consumption" model="ir.sequence">
        <field name="name">Consumo de Maquinaria</field>
        <field name="code">stock.picking.machinery.consumption</field>
        <field name="prefix">MQ-CONS/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="picking_type_machinery_consumption" model="stock.picking.type">
        <field name="name">Consumo de Maquinaria</field>
        <field name="code">internal</field>
        <field name="sequence_id" ref="sequence_picking_type_machinery_consumption"/>
        <field name="default_location_src_id" ref="stock_location_machinery"/>
        <field name="default_location_dest_id" ref="stock.location_production"/>
        <field name="warehouse_id" eval="False"/>
        <field name="sequence_code">MQCONS</field>
    </record>

</odoo>
