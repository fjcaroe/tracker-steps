<odoo>
    <menuitem id="menu_season_statement" name="Consolidados de temporada" parent="step_producers.menu_step_producers_settlement_group" action="action_season_statement" sequence="52"/>
    <menuitem id="menu_season_generate" name="Generar consolidados" parent="step_producers.menu_step_producers_settlement_group" action="action_season_statement_generate" sequence="53" groups="account.group_account_user"/>
    <menuitem id="menu_producer_export_products" name="Productos exportables" parent="step_producers.menu_step_producers_masters_group" action="action_step_export_product_templates" sequence="20"/>
    <record id="action_producer_packaging_materials" model="ir.actions.act_window">
        <field name="name">Materiales de embalajes</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bom_line_ids.bom_id.step_export_fruit', '=', True)]</field>
    </record>
    <record id="action_producer_packaging_materials_category" model="ir.actions.server">
        <field name="name">Materiales de embalajes</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">action = env['product.product'].action_producer_packaging_materials()</field>
    </record>
    <menuitem id="menu_producer_packaging_materials" name="Materiales de embalajes" parent="step_producers.menu_step_producers_masters_group" action="action_producer_packaging_materials_category" sequence="30"/>
    <menuitem id="menu_producer_fruit_bom" name="Lista de materiales" parent="step_producers.menu_step_producers_masters_group" action="action_export_fruit_bom" sequence="40" groups="mrp.group_mrp_user"/>
</odoo>
