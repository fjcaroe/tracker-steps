<odoo>
  <record id="view_step_export_partner_form" model="ir.ui.view">
    <field name="name">step.export.partner.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="step_producers.view_step_producer_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='agri']//field[@name='step_export']" position="replace" />
      <xpath expr="//page[@name='agri']" position="after">
        <page name="step_export_partner" string="Exportación">
          <group>
            <field name="step_export" />
            <field name="step_export_receiver" />
          </group>
        </page>
      </xpath>
    </field>
  </record>
  <record id="view_step_export_product_template_form" model="ir.ui.view">
    <field name="name">step.export.product.template.form</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="step_hr.step_view_product_template_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='agricola']" position="inside">
        <group string="Exportación">
          <field name="step_export_budget_cost" />
          <field name="step_export_enabled" invisible="not is_fruta" />
          <field name="step_export_fruit_category_id" invisible="not is_fruta" />
          <field name="step_export_base_product_id" invisible="not is_fruta" />
          <field name="step_export_species_id" invisible="not is_fruta" />
          <field name="step_export_payment_concept_id" invisible="not is_fruta" />
        </group>
      </xpath>
    </field>
  </record>
  <record id="action_step_export_product_templates" model="ir.actions.act_window">
    <field name="name">Productos exportables</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('step_export_enabled', '=', True)]</field>
    <field name="context">{'default_is_fruta': True, 'default_step_export_enabled': True}</field>
  </record>
  <record id="action_step_export_contacts" model="ir.actions.act_window">
    <field name="name">Contactos de exportación</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">['|', ('step_export', '=', True), ('step_export_receiver', '=', True)]</field>
    <field name="context">{'default_step_export': True}</field>
  </record>
</odoo>