<odoo>
    <record id="view_export_packaging_program_list" model="ir.ui.view">
        <field name="name">step.export.packaging.program.list</field>
        <field name="model">step.export.packaging.program</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="sales_program_id"/>
            <field name="season_id"/><field name="species_id"/><field name="kg_qty"/>
            <field name="standard_cost_usd"/><field name="state"/></list></field>
    </record>
    <record id="view_export_packaging_program_form" model="ir.ui.view">
        <field name="name">step.export.packaging.program.form</field>
        <field name="model">step.export.packaging.program</field>
        <field name="arch" type="xml"><form><header>
            <button name="action_validate" type="object" string="Validar" class="btn-primary" invisible="state != 'draft'"/>
            <button name="action_value" type="object" string="Valorizar" class="btn-primary" invisible="state != 'validated'"/>
            <field name="state" widget="statusbar"/>
        </header><sheet><group><group><field name="name"/><field name="sales_program_id" domain="[('state','=','current')]"/>
            <field name="bom_id"/><field name="company_id"/><field name="usd_currency_id" invisible="1"/></group>
            <group><field name="season_id"/><field name="species_id"/><field name="product_id"/>
                <field name="kg_qty"/><field name="box_qty"/><field name="pallet_qty"/></group></group>
            <notebook><page string="Servicios y costos"><field name="cost_line_ids" readonly="state == 'valued'">
                <list editable="bottom"><field name="concept_id"/><field name="amount_usd"/></list>
            </field></page>
            <page string="Materiales"><field name="material_line_ids" readonly="1">
                <list><field name="product_id"/><field name="box_consumption"/><field name="pallet_consumption"/>
                    <field name="standard_consumption"/><field name="available_qty"/>
                    <field name="shortage_qty"/><field name="amount_usd"/>
                    <button name="action_purchase" type="object" string="Generar pedido"/></list>
            </field></page></notebook>
            <group><field name="standard_cost_usd"/></group>
        </sheet><chatter/></form></field>
    </record>
    <record id="action_export_packaging_program" model="ir.actions.act_window">
        <field name="name">Programas de embalajes</field><field name="res_model">step.export.packaging.program</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_export_fruit_bom_form" model="ir.ui.view">
        <field name="name">mrp.bom.export.fruit.form</field><field name="model">mrp.bom</field>
        <field name="arch" type="xml"><form><sheet><group><field name="product_tmpl_id"/>
            <field name="product_id"/><field name="product_qty"/>
            <field name="step_export_fruit"/><field name="step_export_boxes_per_pallet"/>
            <field name="step_export_packaging_category_id" invisible="1"/></group>
            <field name="bom_line_ids"><list editable="bottom"><field name="product_id"
                domain="[('categ_id', 'child_of', parent.step_export_packaging_category_id)]"/>
                <field name="product_qty"/><field name="step_export_qty_per_pallet"/></list></field>
        </sheet></form></field>
    </record>
    <record id="action_export_fruit_bom" model="ir.actions.act_window">
        <field name="name">Listas de materiales de fruta</field><field name="res_model">mrp.bom</field>
        <field name="view_mode">list,form</field><field name="domain">[('step_export_fruit','=',True)]</field>
        <field name="context">{'default_step_export_fruit': True}</field>
    </record>
    <record id="action_export_fruit_bom_form_view" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">form</field>
        <field name="view_id" ref="view_export_fruit_bom_form"/>
        <field name="act_window_id" ref="action_export_fruit_bom"/>
    </record>
    <record id="view_export_payment_concept_t35" model="ir.ui.view">
        <field name="name">step.export.payment.concept.t35.form</field>
        <field name="model">step.export.payment.concept</field>
        <field name="inherit_id" ref="view_step_export_payment_concept_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='name']" position="after">
            <field name="standard_cost_per_kg"/><field name="standard_cost_per_box"/>
            <field name="standard_cost_per_pallet"/>
        </xpath></field>
    </record>
</odoo>
