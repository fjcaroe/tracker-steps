<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_sale_mode_tag_list" model="ir.ui.view">
        <field name="name">step.export.sale.mode.tag.list</field>
        <field name="model">step.export.sale.mode.tag</field>
        <field name="arch" type="xml">
            <list string="Modalidad de Venta (etiqueta)">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_sale_mode_tag_form" model="ir.ui.view">
        <field name="name">step.export.sale.mode.tag.form</field>
        <field name="model">step.export.sale.mode.tag</field>
        <field name="arch" type="xml">
            <form string="Modalidad de Venta (etiqueta)">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_sale_mode_tag" model="ir.actions.act_window">
        <field name="name">Modalidad de Venta (etiqueta)</field>
        <field name="res_model">step.export.sale.mode.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
