<odoo>
    <record id="view_export_exterior_expense_concept_list" model="ir.ui.view">
        <field name="name">step.export.exterior.expense.concept.list</field>
        <field name="model">step.export.exterior.expense.concept</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="company_id"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_export_exterior_expense_concept_form" model="ir.ui.view">
        <field name="name">step.export.exterior.expense.concept.form</field>
        <field name="model">step.export.exterior.expense.concept</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="company_id"/><field name="active"/></group></sheet></form>
        </field>
    </record>
    <record id="action_step_export_exterior_expense_concept" model="ir.actions.act_window">
        <field name="name">Conceptos de gastos en exterior</field>
        <field name="res_model">step.export.exterior.expense.concept</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
