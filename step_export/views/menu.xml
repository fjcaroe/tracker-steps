    <field name="name">Notas de venta y proformas</field>
    <field name="res_model">sale.order</field>
    <field name="view_mode">list,form</field>
    <field name="domain">['|','|',('step_export_sale','=',True),('step_export_shipment_id','!=',False),('step_export_sales_program_id','!=',False)]</field>
