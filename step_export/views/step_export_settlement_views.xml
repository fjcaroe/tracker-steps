<odoo>
    <record id="view_export_receiver_settlement_list" model="ir.ui.view">
        <field name="name">step.export.receiver.settlement.list</field>
        <field name="model">step.export.receiver.settlement</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="receiver_id"/>
            <field name="sales_program_id"/><field name="date"/><field name="total_fob_usd"/>
            <field name="total_difference_usd"/><field name="state"/></list></field>
    </record>
    <record id="view_export_receiver_settlement_form" model="ir.ui.view">
        <field name="name">step.export.receiver.settlement.form</field>
        <field name="model">step.export.receiver.settlement</field>
        <field name="arch" type="xml"><form><header>
            <button name="action_validate" type="object" string="Validar" class="btn-primary" invisible="state != 'draft'"/>
            <button name="action_prepare_grade_lines" type="object" string="Distribuir por calibre" invisible="state != 'draft'"/>
            <button name="action_account" type="object" string="Contabilizar notas" class="btn-primary" invisible="state != 'validated'"/>
            <field name="state" widget="statusbar"/>
        </header><sheet><group><group><field name="name"/><field name="receiver_id"/>
            <field name="sales_program_id"/><field name="season_id"/><field name="species_id"/>
            <field name="receiver_reference"/></group>
            <group><field name="date"/><field name="currency_id"/><field name="rate_to_usd"/>
                <field name="producer_price_mode" readonly="state != 'draft'"/>
                <field name="usd_currency_id" invisible="1"/><field name="company_id"/></group></group>
            <notebook><page string="Embarques"><field name="line_ids" readonly="state != 'draft'">
                <list editable="bottom"><field name="shipment_id"/><field name="invoice_id"/>
                    <field name="sales_amount"/><field name="sales_usd"/>
                    <field name="claim_usd"/><field name="expenses_usd"/><field name="exterior_expenses_usd"/><field name="calculated_expenses_usd"/>
                    <field name="commission_rate"/><field name="commission_usd"/>
                    <field name="fob_usd"/><field name="initial_invoice_usd"/>
                    <field name="difference_usd"/><field name="external_adjustment_folio"/>
                    <field name="use_grade_detail"/></list>
                <form><sheet><group><field name="shipment_id"/><field name="invoice_id"/>
                    <field name="sales_amount"/><field name="expenses_usd"/>
                    <field name="commission_rate"/><field name="use_grade_detail"/>
                    <field name="external_adjustment_folio"/></group>
                    <field name="grade_line_ids" invisible="not use_grade_detail">
                        <list editable="bottom"><field name="category_id"/><field name="caliber_id"/>
                            <field name="tag_ids" widget="many2many_tags"/><field name="kg_qty"/>
                            <field name="sales_amount"/><field name="sales_usd"/>
                            <field name="expense_per_kg_usd"/><field name="expenses_usd"/>
                            <field name="commission_rate"/><field name="commission_usd"/>
                            <field name="fob_usd"/></list>
                    </field>
                    <field name="exterior_expense_line_ids">
                        <list editable="bottom"><field name="concept_id"/><field name="amount_usd"/></list>
                    </field>
                    <group><field name="claim_usd"/><field name="fob_usd"/>
                        <field name="initial_invoice_usd"/><field name="difference_usd"/></group>
                </sheet></form></field></page>
                <page string="Productores"><field name="producer_settlement_ids"/></page>
                <page string="Notas de ajuste"><field name="adjustment_move_ids"/></page>
            </notebook><group><field name="total_sales_usd"/><field name="total_fob_usd"/>
                <field name="total_difference_usd"/></group></sheet><chatter/></form></field>
    </record>
    <record id="action_export_receiver_settlement" model="ir.actions.act_window">
        <field name="name">Liquidaciones de recibidores</field>
        <field name="res_model">step.export.receiver.settlement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
