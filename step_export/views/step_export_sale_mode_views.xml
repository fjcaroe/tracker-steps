<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_sale_mode_list" model="ir.ui.view">
        <field name="name">step.export.sale.mode.list</field>
        <field name="model">step.export.sale.mode</field>
        <field name="arch" type="xml">
            <list string="Modalidad de Venta">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_sale_mode_form" model="ir.ui.view">
        <field name="name">step.export.sale.mode.form</field>
        <field name="model">step.export.sale.mode</field>
        <field name="arch" type="xml">
            <form string="Modalidad de Venta">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="has_price_adjustment"/>
                        <field name="has_customer_claim"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_sale_mode" model="ir.actions.act_window">
        <field name="name">Modalidad de Venta</field>
        <field name="res_model">step.export.sale.mode</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
