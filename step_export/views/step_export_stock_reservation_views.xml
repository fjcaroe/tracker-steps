<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_stock_reservation_list" model="ir.ui.view">
        <field name="name">step.export.stock.reservation.list</field>
        <field name="model">step.export.stock.reservation</field>
        <field name="arch" type="xml">
            <list string="Reserva de Stock">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_stock_reservation_form" model="ir.ui.view">
        <field name="name">step.export.stock.reservation.form</field>
        <field name="model">step.export.stock.reservation</field>
        <field name="arch" type="xml">
            <form string="Reserva de Stock">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_stock_reservation" model="ir.actions.act_window">
        <field name="name">Reserva de Stock</field>
        <field name="res_model">step.export.stock.reservation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
