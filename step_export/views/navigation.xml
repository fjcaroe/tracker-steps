<odoo>
  <record id="action_export_shipping_instructions" model="ir.actions.act_window">
    <field name="name">Instructivo de embarque</field>
    <field name="res_model">step.export.export</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state', 'in', ['draft', 'validated'])]</field>
    <field name="context">{'default_state': 'draft'}</field>
  </record>
  <record id="action_export_clients" model="ir.actions.act_window">
    <field name="name">Clientes de exportación</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('step_export_receiver','=',True)]</field>
    <field name="context">{'default_step_export_receiver': True}</field>
  </record>
  <record id="action_export_shipment_overview" model="ir.actions.act_window">
    <field name="name">Informe embarques</field>
    <field name="res_model">step.export.export</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False}</field>
    <field name="domain">[('state','not in',['draft','validated'])]</field>
  </record>
  <record id="view_export_traceability_list" model="ir.ui.view">
    <field name="name">step.export.traceability.list</field>
    <field name="model">step.export.export</field>
    <field name="arch" type="xml">
      <list create="false" edit="false">
        <field name="shipment_number" />
        <field name="name" />
        <field name="receiver_id" />
        <field name="season_id" />
        <field name="species_id" />
        <field name="tag_ids" widget="many2many_tags" />
        <field name="dispatch_guide_ids" widget="many2many_tags" />
        <field name="state" />
      </list>
    </field>
  </record>
  <record id="action_export_traceability" model="ir.actions.act_window">
    <field name="name">Trazabilidad de embarques</field>
    <field name="res_model">step.export.export</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_export_traceability_list" />
    <field name="domain">[('tag_ids','!=',False)]</field>
    <field name="context">{'create': False}</field>
  </record>
  <record id="action_export_shipment_expenses" model="ir.actions.act_window">
    <field name="name">Gastos por embarques</field>
    <field name="res_model">account.move.line</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('move_id.step_export_shipment_id','!=',False),('account_id.account_type','in',['expense','expense_direct_cost'])]</field>
    <field name="context">{'create': False, 'group_by': 'move_id'}</field>
  </record>
  <record id="view_export_concept_expenses_list" model="ir.ui.view">
    <field name="name">step.export.concept.expenses.list</field>
    <field name="model">step.export.exterior.expense.line</field>
    <field name="arch" type="xml">
      <list create="false" edit="false">
        <field name="settlement_line_id" />
        <field name="concept_id" />
        <field name="amount_usd" sum="Total USD" />
        <field name="usd_currency_id" column_invisible="True" />
        <field name="company_id" groups="base.group_multi_company" />
      </list>
    </field>
  </record>
  <record id="view_export_concept_expenses_form" model="ir.ui.view">
    <field name="name">step.export.concept.expenses.form</field>
    <field name="model">step.export.exterior.expense.line</field>
    <field name="arch" type="xml">
      <form create="false" edit="false">
        <sheet>
          <group>
            <field name="settlement_line_id" />
            <field name="concept_id" />
            <field name="amount_usd" />
            <field name="usd_currency_id" invisible="True" />
            <field name="company_id" groups="base.group_multi_company" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_export_concept_expenses" model="ir.actions.act_window">
    <field name="name">Gastos por conceptos</field>
    <field name="res_model">step.export.exterior.expense.line</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'create': False, 'group_by': 'concept_id'}</field>
  </record>
  <record id="action_export_payment_terms" model="ir.actions.act_window">
    <field name="name">Términos de pago</field>
    <field name="res_model">account.payment.term</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_export_incoterms" model="ir.actions.act_window">
    <field name="name">Incoterms</field>
    <field name="res_model">account.incoterms</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_export_currencies" model="ir.actions.act_window">
    <field name="name">Monedas</field>
    <field name="res_model">res.currency</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
