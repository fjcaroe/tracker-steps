<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_export_list" model="ir.ui.view">
        <field name="name">step.export.export.list</field>
        <field name="model">step.export.export</field>
        <field name="arch" type="xml">
            <list string="Exportación">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_export_form" model="ir.ui.view">
        <field name="name">step.export.export.form</field>
        <field name="model">step.export.export</field>
        <field name="arch" type="xml">
            <form string="Exportación">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="partner_id"/>
                        <field name="partner_phone"/>
                        <field name="partner_email"/>
                        <field name="company_id"/>
                        <field name="notes"/>
                        <field name="date"/>
                        <field name="date_start"/>
                        <field name="date_stop"/>
                        <field name="sequence"/>
                        <field name="stage_id"/>
                        <field name="priority"/>
                        <field name="color"/>
                        <field name="tag_ids"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_export" model="ir.actions.act_window">
        <field name="name">Exportación</field>
        <field name="res_model">step.export.export</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
