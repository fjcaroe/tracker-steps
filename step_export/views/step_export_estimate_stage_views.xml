<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_estimate_stage_list" model="ir.ui.view">
        <field name="name">step.export.estimate.stage.list</field>
        <field name="model">step.export.estimate.stage</field>
        <field name="arch" type="xml">
            <list string="Estimación de Cosecha (etapa)">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_estimate_stage_form" model="ir.ui.view">
        <field name="name">step.export.estimate.stage.form</field>
        <field name="model">step.export.estimate.stage</field>
        <field name="arch" type="xml">
            <form string="Estimación de Cosecha (etapa)">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_estimate_stage" model="ir.actions.act_window">
        <field name="name">Estimación de Cosecha (etapa)</field>
        <field name="res_model">step.export.estimate.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
