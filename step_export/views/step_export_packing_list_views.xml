<odoo>
    <record id="view_export_packing_list_list" model="ir.ui.view">
        <field name="name">step.export.packing.list.list</field><field name="model">step.export.packing.list</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="shipment_id"/>
            <field name="guide_id"/><field name="date"/><field name="container_number"/>
            <field name="box_qty"/><field name="kg_qty"/></list></field>
    </record>
    <record id="view_export_packing_list_form" model="ir.ui.view">
        <field name="name">step.export.packing.list.form</field><field name="model">step.export.packing.list</field>
        <field name="arch" type="xml"><form><header>
            <button name="action_print" type="object" string="Print Packing List" class="btn-primary"/>
        </header><sheet><group><field name="name"/>
            <field name="container_number"/><field name="seal_number"/>
            <field name="shipment_id"/><field name="shipment_number"/>
            <field name="available_guide_ids" invisible="1"/>
            <field name="guide_id" domain="[('id', 'in', available_guide_ids)]" options="{'no_create': True}"/><field name="date"/>
            <field name="tag_ids" widget="many2many_tags"/><field name="box_qty"/>
            <field name="kg_qty"/></group></sheet><chatter/></form></field>
    </record>
    <record id="view_dispatch_guide_form_export" model="ir.ui.view">
        <field name="name">step.dispatch.guide.form.export</field>
        <field name="model">step.dispatch.guide</field>
        <field name="inherit_id" ref="step_dispatch_guide.view_dispatch_guide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='date']" position="after">
                <field name="step_export_shipment_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="action_export_packing_list" model="ir.actions.act_window">
        <field name="name">Packing Lists</field><field name="res_model">step.export.packing.list</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
