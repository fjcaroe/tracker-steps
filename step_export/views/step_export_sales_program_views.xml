<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_sales_program_list" model="ir.ui.view">
        <field name="name">step.export.sales.program.list</field>
        <field name="model">step.export.sales.program</field>
        <field name="arch" type="xml">
            <list string="Programas de ventas" decoration-success="state == 'current'"
                  decoration-muted="state == 'replaced'">
                <field name="series_code"/>
                <field name="name"/>
                <field name="version"/>
                <field name="state"/>
                <field name="partner_id"/>
                <field name="season_id"/>
                <field name="species_id"/>
                <field name="product_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="container_qty" sum="Contenedores"/>
                <field name="pallet_qty" sum="Pallets"/>
                <field name="box_qty" sum="Cajas"/>
                <field name="kg_qty" sum="Kilos"/>
                <field name="amount_currency" sum="Venta"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_sales_program_form" model="ir.ui.view">
        <field name="name">step.export.sales.program.form</field>
        <field name="model">step.export.sales.program</field>
        <field name="arch" type="xml">
            <form string="Programa de ventas">
                <header>
                    <button name="action_validate" type="object" string="Validar" class="btn-primary"
                            invisible="state != 'created'"/>
                    <button name="action_activate" type="object" string="Hacer vigente" class="btn-primary"
                            invisible="state != 'validated'"/>
                    <button name="action_new_version" type="object" string="Nueva versión"
                            invisible="state != 'current'"/>
                    <field name="state" widget="statusbar" statusbar_visible="created,validated,current,replaced"/>
                </header>
                <group string="Restricciones para Packing">
                    <field name="forbidden_producer_ids" widget="many2many_tags" readonly="state in ('current','replaced')"/>
                    <field name="forbidden_variety_ids" widget="many2many_tags" readonly="state in ('current','replaced')"/>
                </group>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="state in ('current', 'replaced')"/></h1></div>
                    <group>
                        <group>
                            <field name="series_code"/>
                            <field name="version"/>
                            <field name="previous_version_id" invisible="not previous_version_id"/>
                            <field name="partner_id" domain="[('step_export_receiver', '=', True)]"
                                   readonly="state in ('current', 'replaced')"/>
                            <field name="season_id" readonly="state in ('current', 'replaced')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state in ('current', 'replaced')"/>
                            <field name="date_end" readonly="state in ('current', 'replaced')"/>
                            <field name="species_id" readonly="state in ('current', 'replaced')"/>
                            <field name="variety_group_id" readonly="state in ('current', 'replaced')"/>
                            <field name="variety_id" readonly="state in ('current', 'replaced')"/>
                            <field name="fruit_type" readonly="state in ('current', 'replaced')"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="product_id" domain="[('step_export_enabled', '=', True)]"
                                   readonly="state in ('current', 'replaced')"/>
                            <field name="packaging_id" readonly="state in ('current', 'replaced')"/>
                            <field name="package_type_id" readonly="state in ('current', 'replaced')"/>
                            <field name="container_size" readonly="state in ('current', 'replaced')"/>
                            <field name="caliber_range" readonly="state in ('current', 'replaced')"/>
                            <field name="quality" readonly="state in ('current', 'replaced')"/>
                            <field name="label" readonly="state in ('current', 'replaced')"/>
                        </group>
                        <group>
                            <field name="pallets_per_container" readonly="state in ('current', 'replaced')"/>
                            <field name="boxes_per_pallet" readonly="state in ('current', 'replaced')"/>
                            <field name="kg_per_box" readonly="state in ('current', 'replaced')"/>
                            <field name="currency_id" readonly="state in ('current', 'replaced')"/>
                            <field name="rate_to_usd" readonly="state in ('current', 'replaced')"/>
                            <field name="usd_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Distribución semanal">
                            <field name="line_ids" readonly="state in ('current', 'replaced')">
                                <list editable="bottom">
                                    <field name="week_start"/>
                                    <field name="container_qty" sum="Contenedores"/>
                                    <field name="pallet_qty" sum="Pallets"/>
                                    <field name="box_qty" sum="Cajas"/>
                                    <field name="kg_qty" sum="Kilos"/>
                                    <field name="price_per_kg"/>
                                    <field name="amount_currency" sum="Venta"/>
                                    <field name="amount_usd" sum="USD"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="usd_currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Totales">
                        <field name="container_qty"/>
                        <field name="pallet_qty"/>
                        <field name="box_qty"/>
                        <field name="kg_qty"/>
                        <field name="amount_currency"/>
                        <field name="amount_usd"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_step_export_sales_program_search" model="ir.ui.view">
        <field name="name">step.export.sales.program.search</field>
        <field name="model">step.export.sales.program</field>
        <field name="arch" type="xml">
            <search string="Programas de ventas">
                <field name="name"/>
                <field name="series_code"/>
                <field name="partner_id"/>
                <field name="season_id"/>
                <field name="species_id"/>
                <field name="product_id"/>
                <filter name="current" string="Vigentes" domain="[('state', '=', 'current')]"/>
                <filter name="validated" string="Validados" domain="[('state', '=', 'validated')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_partner" string="Recibidor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_season" string="Temporada" context="{'group_by': 'season_id'}"/>
                    <filter name="group_species" string="Especie" context="{'group_by': 'species_id'}"/>
                    <filter name="group_week" string="Inicio" context="{'group_by': 'date_start:week'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_step_export_sales_program" model="ir.actions.act_window">
        <field name="name">Programas de ventas</field>
        <field name="res_model">step.export.sales.program</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_step_export_sales_program_search"/>
        <field name="context">{'search_default_current': 1}</field>
    </record>
    <record id="action_step_export_sales_program_all" model="ir.actions.act_window">
        <field name="name">Historial de programas</field>
        <field name="res_model">step.export.sales.program</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_step_export_sales_program_search"/>
    </record>
</odoo>
