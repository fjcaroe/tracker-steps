<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_dispatch_order_list" model="ir.ui.view">
        <field name="name">step.export.dispatch.order.list</field>
        <field name="model">step.export.dispatch.order</field>
        <field name="arch" type="xml">
            <list string="Orden de Despacho">
                    <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_dispatch_order_form" model="ir.ui.view">
        <field name="name">step.export.dispatch.order.form</field>
        <field name="model">step.export.dispatch.order</field>
        <field name="arch" type="xml">
            <form string="Orden de Despacho">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_dispatch_order" model="ir.actions.act_window">
        <field name="name">Orden de Despacho</field>
        <field name="res_model">step.export.dispatch.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
