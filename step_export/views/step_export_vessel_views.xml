<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_vessel_list" model="ir.ui.view">
        <field name="name">step.export.vessel.list</field>
        <field name="model">step.export.vessel</field>
        <field name="arch" type="xml">
            <list string="Nave">
                    <field name="name"/>
                    <field name="carrier_id"/>
                    <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_vessel_form" model="ir.ui.view">
        <field name="name">step.export.vessel.form</field>
        <field name="model">step.export.vessel</field>
        <field name="arch" type="xml">
            <form string="Nave">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="carrier_id"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_vessel" model="ir.actions.act_window">
        <field name="name">Nave</field>
        <field name="res_model">step.export.vessel</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
