<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_export_grower_discount_list" model="ir.ui.view">
        <field name="name">step.export.grower.discount.list</field>
        <field name="model">step.export.grower.discount</field>
        <field name="arch" type="xml">
            <list string="Ítem Productor (Descuento Liquidación)">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="view_step_export_grower_discount_form" model="ir.ui.view">
        <field name="name">step.export.grower.discount.form</field>
        <field name="model">step.export.grower.discount</field>
        <field name="arch" type="xml">
            <form string="Ítem Productor (Descuento Liquidación)">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="sequence"/>
                        <field name="tag_ids"/>
                        <field name="code"/>
                        <field name="account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_export_grower_discount" model="ir.actions.act_window">
        <field name="name">Ítem Productor (Descuento Liquidación)</field>
        <field name="res_model">step.export.grower.discount</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
