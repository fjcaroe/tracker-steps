<odoo>
    <record id="view_export_receivables_list" model="ir.ui.view">
        <field name="name">account.move.line.export.receivables.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml"><list create="0" edit="0">
            <field name="partner_id"/><field name="move_id"/>
            <field name="date"/><field name="date_maturity"/>
            <field name="currency_id"/><field name="amount_residual"/>
        </list></field>
    </record>
    <record id="view_export_receivables_search" model="ir.ui.view">
        <field name="name">account.move.line.export.receivables.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml"><search><field name="partner_id"/>
            <filter name="overdue" string="Vencidas" domain="[('date_maturity','&lt;',context_today())]"/>
            <filter name="group_partner" string="Por recibidor" context="{'group_by':'partner_id'}"/>
        </search></field>
    </record>
    <record id="action_export_receivables" model="ir.actions.act_window">
        <field name="name">Cuenta corriente recibidores</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_export_receivables_list"/>
        <field name="search_view_id" ref="view_export_receivables_search"/>
        <field name="domain">[('partner_id.step_export_receiver','=',True),('account_id.account_type','=','asset_receivable'),('parent_state','=','posted'),('reconciled','=',False)]</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>
</odoo>
