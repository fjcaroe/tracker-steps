<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treasury_batch_approval_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.treasury.batch.approval</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Aprobación de lotes de pago">
                <group>
                    <field name="treasury_batch_approval_threshold"/>
                    <field name="treasury_batch_approver_id"/>
                </group>
                <footer>
                    <button string="Guardar" type="object" name="execute" class="btn-primary"/>
                    <button string="Descartar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_treasury_batch_approval_settings" model="ir.actions.act_window">
        <field name="name">Aprobación de lotes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_treasury_batch_approval_settings_form"/>
        <field name="target">new</field>
    </record>
</odoo>
