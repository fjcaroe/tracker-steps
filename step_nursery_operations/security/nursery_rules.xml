<odoo>
    <record id="group_nursery_operator" model="res.groups">
        <field name="name">Operación de vivero</field>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="group_nursery_manager" model="res.groups">
        <field name="name">Administración de vivero</field>
        <field name="implied_ids" eval="[(4, ref('group_nursery_operator'))]"/>
    </record>
    <record id="rule_nursery_cycle_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada (cycle)</field>
        <field name="model_id" ref="model_step_nursery_cycle"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_plan_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada (plan)</field>
        <field name="model_id" ref="model_step_nursery_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_slot_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada (slot)</field>
        <field name="model_id" ref="model_step_nursery_slot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_event_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada (event)</field>
        <field name="model_id" ref="model_step_nursery_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_delivery_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada (delivery)</field>
        <field name="model_id" ref="model_step_nursery_delivery"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_tray_loan_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada (tray_loan)</field>
        <field name="model_id" ref="model_step_nursery_tray_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_delivery_sale_own" model="ir.rule">
        <field name="name">Vivero: cuotas de ventas propias</field>
        <field name="model_id" ref="model_step_nursery_delivery"/>
        <field name="domain_force">['|', ('line_id.order_id.user_id', '=', user.id), ('line_id.order_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_nursery_delivery_sale_all" model="ir.rule">
        <field name="name">Vivero: cuotas de todas las ventas autorizadas</field>
        <field name="model_id" ref="model_step_nursery_delivery"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
    <record id="rule_nursery_batch_allocation_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada para costo (allocation)</field>
        <field name="model_id" ref="model_step_nursery_batch_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_batch_allocation_line_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada para costo (allocation_line)</field>
        <field name="model_id" ref="model_step_nursery_batch_allocation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_custody_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada (custody)</field>
        <field name="model_id" ref="model_step_nursery_custody"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_nursery_service_bill_company" model="ir.rule">
        <field name="name">Vivero: empresa autorizada (service_bill)</field>
        <field name="model_id" ref="model_step_nursery_service_bill"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>