<odoo>
    <record id="view_batch_payment_list" model="ir.ui.view">
        <field name="name">account.batch.payment.community.list</field>
        <field name="model">account.batch.payment</field>
        <field name="arch" type="xml">
            <list string="Grupos de pagos en borrador">
                <field name="name"/><field name="date"/><field name="journal_id"/>
                <field name="batch_type"/><field name="payment_method_id"/>
                <field name="amount"/><field name="currency_id"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_batch_payment_form" model="ir.ui.view">
        <field name="name">account.batch.payment.community.form</field>
        <field name="model">account.batch.payment</field>
        <field name="arch" type="xml">
            <form string="Grupo de pagos existentes">
                <header><button name="action_check_group" type="object" string="Comprobar grupo"/>
                    <button name="action_post_draft_payments" type="object" string="Publicar pagos en contabilidad"
                        groups="account.group_account_invoice" invisible="not id"
                        confirm="Se publicarán sólo pagos nuevos en borrador. El lote no se valida, envía ni concilia."/>
                    <button name="action_post_apply_linked_invoices" type="object" string="Publicar y aplicar documentos vinculados"
                        groups="account.group_account_user" invisible="not id"
                        confirm="Se publicarán sólo borradores nuevos y se aplicarán a las facturas guardadas en sus pagos. No se envía ni concilia el banco."/>
                    <field name="state" widget="statusbar"/></header>
                <sheet>
                    <div class="alert alert-warning" role="alert">Puede publicar pagos nuevos en contabilidad. El grupo sigue en borrador: la validación bancaria, envío y conciliación de lotes siguen pendientes. Este formulario no envía pagos.</div>
                    <group><group><field name="name"/><field name="date"/>
                        <field name="journal_id" readonly="id" domain="[('type','=','bank')]"/>
                        <field name="batch_type" readonly="id"/>
                        <field name="payment_method_id" readonly="id"/></group>
                        <group><field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/><field name="amount"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group></group>
                    <field name="payment_ids_domain" invisible="1"/>
                    <field name="payment_ids" widget="many2many" domain="payment_ids_domain"
                        context="{'create': False}" options="{'no_create': True, 'no_create_edit': True}">
                        <list create="0" edit="0"><field name="date"/><field name="name"/>
                            <field name="partner_id"/><field name="amount"/><field name="currency_id"/>
                            <field name="payment_method_line_id"/><field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_batch_payment_groups" model="ir.actions.act_window">
        <field name="name">Grupos de pagos en borrador</field>
        <field name="res_model">account.batch.payment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Seleccione pagos existentes. Puede publicar sus borradores en contabilidad; el grupo no se valida ni envía y no sustituye todavía la conciliación bancaria.</p></field>
    </record>
    <menuitem id="menu_batch_payment_groups" name="Grupos de pagos en borrador" parent="account.menu_finance_payables"
        action="action_batch_payment_groups" groups="account.group_account_invoice" sequence="60"/>
    <record id="view_payment_linked_documents" model="ir.ui.view">
        <field name="name">account.payment.community.linked.documents</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']" position="inside">
                <field name="batch_payment_id" invisible="1"/>
                <field name="invoice_ids" string="Documentos para aplicación contable" widget="many2many_tags"
                    options="{'no_create': True, 'no_create_edit': True}"
                    readonly="state != 'draft' or batch_payment_id"
                    domain="[('state','=','posted'),('move_type','in',['in_invoice','out_invoice']),('company_id','=',company_id),('partner_id','=',partner_id),('currency_id','=',currency_id),('payment_state','=','not_paid')]"/>
            </xpath>
        </field>
    </record>
</odoo>
