  </record>
  <record id="packing_manager" model="res.groups">
    <field name="name">Administración</field>
    <field name="category_id" ref="packing_category"/>
    <field name="implied_ids" eval="[(4,ref('packing_operation')),(4,ref('stock.group_stock_manager'))]"/>
  </record>
