    <field name="sequence">65</field>
  </record>
  <record id="packing_read" model="res.groups">
    <field name="name">Consulta</field>
    <field name="category_id" ref="packing_category"/>
    <field name="implied_ids" eval="[(4,ref('stock.group_stock_user'))]"/>
  </record>
  <record id="packing_operation" model="res.groups">
    <field name="name">Operación</field>
    <field name="category_id" ref="packing_category"/>
