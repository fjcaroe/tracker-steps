<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_greenhouse" model="ir.actions.client">
        <field name="name">Invernadero</field>
        <field name="tag">step_ecoplantas_greenhouse.dashboard</field>
        <field name="path">invernadero</field>
    </record>
    <menuitem id="menu_greenhouse" name="Invernadero" sequence="1"
              action="action_greenhouse" groups="step_ecoplantas_greenhouse.group_greenhouse"
              web_icon="fa-leaf,#173f33,#ddf592"/>
