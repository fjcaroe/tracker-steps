<odoo>
  <record id="country_market_form" model="ir.ui.view">
    <field name="name">country.export.market.form</field><field name="model">res.country</field>
    <field name="inherit_id" ref="base.view_country_form"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='code']" position="after">
      <field name="fruit_market_id"/>
    </xpath></field>
  </record>
  <record id="country_market_list" model="ir.ui.view">
    <field name="name">country.export.market.list</field><field name="model">res.country</field>
    <field name="inherit_id" ref="base.view_country_tree"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='code']" position="after">
      <field name="fruit_market_id"/>
    </xpath></field>
  </record>
  <record id="port_form" model="ir.ui.view">
    <field name="name">export.native.customs.port.form</field>
    <field name="model">l10n_cl.customs_port</field><field name="priority">90</field>
    <field name="arch" type="xml"><form string="Puerto Aduana"><sheet><group>
      <field name="name"/><field name="code"/><field name="country_id"/>
    </group></sheet></form></field>
  </record>
  <record id="ports_action" model="ir.actions.act_window">
    <field name="name">Puertos Aduana</field><field name="res_model">l10n_cl.customs_port</field>
    <field name="view_mode">list,form</field>
    <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('l10n_cl_edi_exports.customs_port_tree_view')}),(0,0,{'view_mode':'form','view_id':ref('port_form')})]"/>
  </record>
  <menuitem id="countries_menu" name="Países" parent="step_export.menu_step_export_config_export"
    action="base.action_country" sequence="5"/>
  <menuitem id="ports_menu" name="Puertos Aduana" parent="step_export.menu_step_export_config_export"
    action="ports_action" sequence="6"/>
</odoo>
