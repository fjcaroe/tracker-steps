<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Weighted variety prices use twelve stored decimals. Ordinary purchase
         forms retain their previous two-decimal presentation. Proformas use
         their separate form and are not changed by this inherited view. -->
    <record id="view_regular_purchase_price_precision" model="ir.ui.view">
        <field name="name">purchase.order.fruit.proforma.regular.precision</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban//field[@name='price_unit']" position="attributes">
                <attribute name="digits">[16, 2]</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_vendor_bill_price_precision" model="ir.ui.view">
        <field name="name">account.move.fruit.proforma.precision</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//sheet)[1]" position="inside">
                <field name="step_fruit_proforma_id" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="replace">
                <field name="price_unit" string="Price" digits="[24, 12]"
                       column_invisible="not parent.step_fruit_proforma_id"/>
                <field name="price_unit" string="Price" digits="[16, 2]"
                       column_invisible="parent.step_fruit_proforma_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="replace">
                <field name="price_unit" digits="[24, 12]" invisible="not parent.step_fruit_proforma_id"/>
                <field name="price_unit" digits="[16, 2]" invisible="parent.step_fruit_proforma_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/kanban" position="inside">
                <field name="step_fruit_proforma_id"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/kanban//field[@name='price_unit']" position="replace">
                <field name="price_unit" digits="[24, 12]" t-if="record.step_fruit_proforma_id.raw_value"/>
                <field name="price_unit" digits="[16, 2]" t-if="!record.step_fruit_proforma_id.raw_value"/>
            </xpath>
        </field>
    </record>

    <template id="report_native_purchase_price_precision" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-options">{'widget': 'float', 'precision': 6 if o.step_fruit_proforma else 2}</attribute>
        </xpath>
    </template>
    <template id="report_native_invoice_price_precision" inherit_id="account.report_invoice_document">
        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-options">{'widget': 'float', 'precision': 6 if o.step_fruit_proforma_id else 2}</attribute>
        </xpath>
    </template>
    <!-- Chile already formats ordinary prices explicitly at two decimals.
         For a fruit bill, print its native six-decimal DTE unit price while
         keeping the same native currency conversion and line amounts. -->
    <template id="report_cl_fruit_invoice_price_precision" inherit_id="l10n_cl.report_invoice_document">
        <xpath expr="//td[@name='td_price_unit']/span[@t-out]" position="attributes">
            <attribute name="t-out">line_amounts['price_item'] if o.step_fruit_proforma_id else line_amounts['price_item_document']</attribute>
            <attribute name="t-options">{'widget': 'float', 'precision': 6 if o.step_fruit_proforma_id else 2}</attribute>
        </xpath>
    </template>
</odoo>
