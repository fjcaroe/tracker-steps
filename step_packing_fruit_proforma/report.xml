<odoo>
    <record id="fruit_proforma_paperformat" model="report.paperformat">
        <field name="name">Proforma de fruta con anexo</field><field name="format">A4</field>
        <field name="orientation">Landscape</field><field name="margin_top">35</field>
        <field name="margin_bottom">18</field><field name="margin_left">12</field><field name="margin_right">12</field>
        <field name="header_spacing">10</field><field name="dpi">90</field>
    </record>
    <record id="action_report_fruit_proforma" model="ir.actions.report">
        <field name="name">Proforma de compra de fruta</field><field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">step_packing_fruit_proforma.report_fruit_proforma</field>
        <field name="report_file">step_packing_fruit_proforma.report_fruit_proforma</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/><field name="binding_type">report</field>
        <field name="paperformat_id" ref="fruit_proforma_paperformat"/>
        <field name="print_report_name">'Proforma - %s' % object.name</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <record id="action_report_fruit_proforma_preview" model="ir.actions.report">
        <field name="name">Vista previa de proforma</field><field name="model">purchase.order</field>
        <field name="report_type">qweb-html</field><field name="report_name">step_packing_fruit_proforma.report_fruit_proforma</field>
        <field name="report_file">step_packing_fruit_proforma.report_fruit_proforma</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <template id="fruit_report_layout">
        <div t-attf-class="header o_company_#{company.id}_layout" style="font-size: 10px;">
            <div class="row" style="border-bottom: 1px solid #536c65; padding-bottom: 6px;">
                <div class="col-5"><img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                    alt="Logo" style="max-height: 34px; max-width: 170px;"/></div>
                <div class="col-7 text-end"><strong t-field="company.name"/>
                    <div t-if="company.vat">RUT: <span t-field="company.vat"/></div>
                </div>
            </div>
        </div>
        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
             t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id" t-att-data-oe-lang="doc.env.lang">
            <t t-out="0"/>
        </div>
        <div t-attf-class="footer o_company_#{company.id}_layout" style="font-size: 9px;">
            <div class="row" style="border-top: 1px solid #536c65; padding-top: 5px;">
                <div class="col-8">Proforma mensual de fruta · Documento sin emisión fiscal</div>
                <div class="col-4 text-end">Página <span class="page"/> / <span class="topage"/></div>
            </div>
        </div>
    </template>
    <template id="report_fruit_proforma">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/><t t-set="company" t-value="doc.company_id"/>
                <t t-call="step_packing_fruit_proforma.fruit_report_layout">
                    <div class="page">
                        <style>
                            .fruit-proforma { font-size: 11px; }
                            .fruit-proforma th { font-weight: 600; }
                            .fruit-proforma .notice { padding: 8px 10px; border: 1px solid #536c65; margin: 10px 0 16px; }
                            .fruit-proforma .metadata td { padding: 3px 8px 3px 0; }
                            .fruit-proforma .summary th, .fruit-proforma .summary td { padding: 7px 6px; }
                            .fruit-proforma .annex { font-size: 9px; table-layout: fixed; width: 100%; }
                            .fruit-proforma .annex th, .fruit-proforma .annex td { padding: 5px 4px; overflow-wrap: break-word; }
                            .fruit-proforma thead { display: table-header-group; }
                            .fruit-proforma tr { page-break-inside: avoid; }
                        </style>
                        <div class="fruit-proforma">
                            <div class="row mb-2">
                                <div class="col-8"><h2 class="mb-1" t-if="doc.step_fruit_dte_code == '46'">PROFORMA FACTURA DE COMPRA ELECTRÓNICA</h2><h2 class="mb-1" t-else="">PROFORMA FACTURA ELECTRÓNICA</h2><h4>Compra mensual de fruta</h4></div>
                                <div class="col-4 text-end"><h3 t-field="doc.name"/>
                                    <div>Documento previsto: DTE <strong t-out="doc.step_fruit_dte_code"/></div>
                                    <div>Estado: <span t-field="doc.step_fruit_state"/></div>
                                </div>
                            </div>
                            <div class="notice">Documento de revisión sin efecto contable. No constituye una factura ni un DTE emitido.</div>
                            <div class="row mb-3">
                                <div class="col-6"><strong>Sucursal / comprador</strong>
                                    <div t-field="doc.company_id.partner_id" t-options="{'widget':'contact','fields':['name','address'],'no_marker':True}"/>
                                    <div t-if="doc.company_id.vat">RUT: <span t-field="doc.company_id.vat"/></div>
                                </div>
                                <div class="col-6"><strong>Productor / proveedor</strong>
                                    <div t-field="doc.partner_id" t-options="{'widget':'contact','fields':['name','address'],'no_marker':True}"/>
                                    <div t-if="doc.partner_id.vat">RUT: <span t-field="doc.partner_id.vat"/></div>
                                </div>
                            </div>
                            <table class="metadata w-100 mb-3"><tbody>
                                <tr><td><strong>Período</strong></td><td><span t-field="doc.step_fruit_period_start"/> al <span t-field="doc.step_fruit_period_end"/></td>
                                    <td><strong>Especie</strong></td><td><span t-field="doc.step_fruit_species_id"/></td></tr>
                                <tr><td><strong>Moneda</strong></td><td><span t-field="doc.currency_id.name"/></td>
                                    <td><strong>Contratos</strong></td><td t-out="', '.join(doc.step_fruit_contract_ids.mapped('name'))"/></tr>
                                <tr t-if="doc.step_fruit_withholding_tax_id"><td><strong>Retención</strong></td><td colspan="3"><span t-field="doc.step_fruit_withholding_tax_id"/></td></tr>
                            </tbody></table>
                            <h5>Resumen por especie y variedad</h5>
                            <table class="table table-sm summary">
                                <thead><tr><th>Especie</th><th>Variedad</th><th>Producto de compra</th><th class="text-end">Cantidad</th>
                                    <th>Unidad</th><th class="text-end">Precio unitario</th><th class="text-end">Neto</th></tr></thead>
                                <tbody><tr t-foreach="doc.order_line.filtered(lambda line: not line.display_type)" t-as="line">
                                    <td><span t-field="doc.step_fruit_species_id"/></td><td><span t-field="line.step_fruit_variety_id"/><span t-if="not line.step_fruit_variety_id">Sin variedad</span></td>
                                    <td><span t-field="line.product_id"/></td><td class="text-end" t-out="format_quantity(line.product_qty)"/>
                                    <td><span t-field="line.product_uom"/></td><td class="text-end" t-out="format_price(line.price_unit)"/>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                </tr></tbody>
                            </table>
                            <div class="row justify-content-end mb-3"><div class="col-5">
                                <table class="o_total_table table table-borderless">
                                    <t t-call="purchase.document_tax_totals"><t t-set="tax_totals" t-value="doc.tax_totals"/><t t-set="currency" t-value="doc.currency_id"/></t>
                                </table>
                            </div></div>
                            <div t-if="doc.step_fruit_guide_refs"><strong>Guías de recepción</strong><div style="white-space: pre-wrap" t-field="doc.step_fruit_guide_refs"/></div>
                            <div class="mt-3" t-if="doc.notes"><strong>Observaciones</strong><div t-field="doc.notes"/></div>
                            <div class="mt-3"><strong>Referencia de aprobación: </strong><span t-field="doc.step_fruit_approval_reference"/>
                                <span t-if="not doc.step_fruit_approval_reference">Pendiente</span></div>
                            <div t-if="doc.step_fruit_dte_code == '33'" class="mt-2"><strong>Factura del proveedor: </strong>
                                <span t-if="doc.step_fruit_supplier_invoice_received" t-field="doc.step_fruit_supplier_document_number"/>
                                <span t-else="">Pendiente de recepción</span></div>
                            <p class="mt-3">La factura de proveedor se prepara después de aprobar esta proforma. Este documento no realiza emisión fiscal.</p>
                            <div style="page-break-before: always;" t-if="annex_by_document.get(doc.id)">
                                <h3>Anexo de tarjas y guías</h3>
                                <div class="mb-2"><strong t-field="doc.name"/> · <span t-field="doc.partner_id"/> · <span t-field="doc.step_fruit_species_id"/></div>
                                <table class="table table-sm annex">
                                    <thead><tr><th style="width: 11%">Tarja</th><th style="width: 11%">OT</th><th style="width: 19%">Producto de tarja</th>
                                        <th style="width: 10%">Variedad</th><th class="text-end" style="width: 10%">Cantidad</th><th style="width: 7%">Unidad</th>
                                        <th class="text-end" style="width: 10%">Precio</th><th class="text-end" style="width: 10%">Neto</th><th style="width: 12%">Guías de recepción</th></tr></thead>
                                    <tbody><tr t-foreach="annex_by_document[doc.id]" t-as="row">
                                        <td t-out="row.get('tag_name') or '-'"/><td t-out="row.get('ot_name') or '-'"/>
                                        <td t-out="row.get('product_name') or '-'"/><td t-out="row.get('variety_name') or 'Sin variedad'"/>
                                        <td class="text-end" t-out="format_quantity(row.get('quantity'))"/><td t-out="row.get('uom_name') or ''"/>
                                        <td class="text-end" t-out="format_price(row.get('price_unit'))"/>
                                        <td class="text-end" t-out="format_money(row.get('amount'), doc.currency_id)"/>
                                        <td t-out="row['receipt_guides'] or '-'"/>
                                    </tr></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
