<odoo>
  <record id="sequence" model="ir.sequence"><field name="name">Provisión gastos embarques</field><field name="code">step.export.shipment.provision</field><field name="prefix">PGE/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/></record>
  <record id="shipment_analytic_form" model="ir.ui.view"><field name="name">shipment.provision.analytic</field><field name="model">step.export.export</field><field name="inherit_id" ref="step_export.view_step_export_export_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Provisión gastos"><field name="provision_analytic_account_id" domain="['|',('company_id','=',False),('company_id','=',company_id)]"/></group></xpath></field></record>
  <record id="provision_list" model="ir.ui.view"><field name="name">shipment.provision.list</field><field name="model">step.export.shipment.provision</field><field name="arch" type="xml"><list><field name="name"/><field name="date"/><field name="season_id"/><field name="program_id"/><field name="shipment_id"/><field name="receiver_id"/><field name="amount_clp" sum="CLP"/><field name="amount_usd" sum="USD"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="provision_form" model="ir.ui.view"><field name="name">shipment.provision.form</field><field name="model">step.export.shipment.provision</field><field name="arch" type="xml">
    <form string="Provisión gastos embarques"><header><button name="action_validate" type="object" string="Validar" class="btn-primary" invisible="state != 'created'"/><button name="action_cost" type="object" string="Costear" class="btn-primary" invisible="state != 'validated'"/><button name="action_account" type="object" string="Contabilizar" class="btn-primary" invisible="state != 'costed'" groups="account.group_account_user"/><field name="state" widget="statusbar" statusbar_visible="created,validated,costed,posted"/></header>
      <sheet><h1><field name="name"/></h1><group><group><field name="company_id" groups="base.group_multi_company" readonly="state != 'created'"/><field name="date" readonly="state != 'created'"/><field name="season_id" readonly="state != 'created'"/><field name="program_id" domain="[('season_id','=',season_id),('company_id','=',company_id)]" readonly="state != 'created'"/><field name="receiver_id"/><field name="species_id"/></group><group><field name="shipment_id" domain="[('sales_program_id','=',program_id),('season_id','=',season_id),('species_id','=',species_id),('receiver_id','=',receiver_id),('company_id','=',company_id)]" context="{'default_sales_program_id':program_id,'default_season_id':season_id,'default_species_id':species_id,'default_receiver_id':receiver_id,'default_company_id':company_id}" readonly="state != 'created'"/><field name="shipment_date"/><field name="transport_type"/><field name="journal_id" readonly="state != 'created'"/></group></group>
        <field name="currency_id" invisible="True"/><field name="clp_currency_id" invisible="True"/><field name="usd_currency_id" invisible="True"/>
        <notebook><page string="Detalle" name="expenses"><field name="line_ids" readonly="state != 'created'"><list editable="bottom"><field name="grower_item_id"/><field name="product_id"/><field name="vendor_id"/><field name="document_type_id"/><field name="document_number"/><field name="currency_id"/><field name="amount_currency"/><field name="amount_clp" sum="CLP"/><field name="amount_usd" sum="USD"/><field name="expense_account_id" optional="hide"/></list></field><group><field name="amount_clp"/><field name="amount_usd"/></group></page>
        <page string="Contabilidad" name="accounting"><group><field name="credit_account_id"/><field name="analytic_distribution" widget="analytic_distribution"/><field name="move_id"/></group></page></notebook>
      </sheet><chatter/>
    </form>
  </field></record>
  <record id="provision_search" model="ir.ui.view"><field name="name">shipment.provision.search</field><field name="model">step.export.shipment.provision</field><field name="arch" type="xml"><search><field name="name"/><field name="season_id"/><field name="shipment_id"/><field name="receiver_id"/><filter name="created" string="Creadas" domain="[('state','=','created')]"/><separator/><filter name="posted" string="Contabilizadas" domain="[('state','=','posted')]"/><group><filter name="season" string="Temporada" context="{'group_by':'season_id'}"/><filter name="shipment" string="Embarque" context="{'group_by':'shipment_id'}"/><filter name="state" string="Estado" context="{'group_by':'state'}"/></group></search></field></record>
  <record id="provision_action" model="ir.actions.act_window"><field name="name">Provisión gastos embarques</field><field name="res_model">step.export.shipment.provision</field><field name="view_mode">list,form</field></record>
  <menuitem id="provision_menu" name="Provisión gastos embarques" parent="step_export.menu_step_export_expenses" action="provision_action" sequence="15" groups="stock.group_stock_user,account.group_account_user"/>
</odoo>
