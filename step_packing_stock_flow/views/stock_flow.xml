<odoo>
  <record id="packing_company_form" model="ir.ui.view">
    <field name="name">company.packing.stock.configuration</field><field name="model">res.company</field>
    <field name="arch" type="xml">
      <form string="Bodega Packing" create="0" delete="0">
        <sheet><group><field name="name" readonly="1"/><field name="id" invisible="1"/>
          <field name="step_packing_warehouse_id" domain="[('company_id','=',id)]" options="{'no_create':True}"/>
          <field name="step_packing_fruit_location_id" domain="[('company_id','=',id),('usage','=','internal')]" options="{'no_create':True}"/>
          <field name="step_packing_material_location_id" domain="[('company_id','=',id),('usage','=','internal')]" options="{'no_create':True}"/>
        </group></sheet>
      </form>
    </field>
  </record>
  <record id="packing_company_list" model="ir.ui.view">
    <field name="name">company.packing.stock.list</field><field name="model">res.company</field>
    <field name="arch" type="xml"><list create="0" delete="0"><field name="name"/>
      <field name="step_packing_warehouse_id"/><field name="step_packing_fruit_location_id"/>
      <field name="step_packing_material_location_id"/></list></field>
  </record>
  <record id="packing_company_action" model="ir.actions.act_window">
    <field name="name">Bodega Packing</field><field name="res_model">res.company</field>
    <field name="view_mode">list,form</field><field name="domain">[('id','in',allowed_company_ids)]</field>
    <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('packing_company_list')}),(0,0,{'view_mode':'form','view_id':ref('packing_company_form')})]"/>
  </record>
  <menuitem id="packing_company_menu" name="Bodega Packing"
    parent="step_packing_operations.menu_packing_config_packing" action="packing_company_action"
    groups="stock.group_stock_manager" sequence="5"/>
  <record id="production_stock_flow" model="ir.ui.view">
    <field name="name">packing.production.stock.flow</field><field name="model">step.packing.production</field>
    <field name="inherit_id" ref="step_packing_operations.view_packing_production_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook[@name='fruit_details']" position="inside">
        <page string="Bodega y movimientos" name="packing_stock_flow">
          <group><field name="step_stock_warehouse_id"/><field name="step_stock_fruit_location_id"/>
            <field name="step_stock_material_location_id"/><field name="step_packing_transfer_id"/>
            <field name="input_picking_id"/><field name="material_picking_id"/><field name="output_picking_id"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
