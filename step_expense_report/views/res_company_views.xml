<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_step_expense" model="ir.ui.view">
        <field name="name">res.company.form.step.expense</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="step_expense" string="Rendiciones de gastos" groups="hr_expense.group_hr_expense_manager">
                    <group>
                        <field name="step_expense_vehicle_mode"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
