<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_step_expense_vehicle_line_employee" model="ir.rule">
        <field name="name">Uso de vehículo: propio del empleado</field>
        <field name="model_id" ref="model_step_expense_vehicle_line"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('sheet_id.employee_id.user_id', '=', user.id), ('sheet_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_step_expense_vehicle_line_approver" model="ir.rule">
        <field name="name">Uso de vehículo: aprobadores y gestores</field>
        <field name="model_id" ref="model_step_expense_vehicle_line"/>
        <field name="groups" eval="[(4, ref('hr_expense.group_hr_expense_team_approver')), (4, ref('hr_expense.group_hr_expense_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
