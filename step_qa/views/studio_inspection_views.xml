<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Internal inspections -->
    <record id="view_internal_inspection_list_step_qa" model="ir.ui.view">
        <field name="name">x.inspecciones.interna.list.step.qa</field>
        <field name="model">step.agriculture.inspection</field>
        <field name="arch" type="xml">
            <list string="Inspecciones internas" class="o_step_qa_list"
                  decoration-info="state == 'status2'"
                  decoration-success="state == 'status3'">
                <field name="name" string="Folio" optional="show"/>
                <field name="state" string="Estado" widget="badge" optional="show"
                       decoration-muted="state == 'status1'"
                       decoration-info="state == 'status2'"
                       decoration-success="state == 'status3'"/>
                <field name="date" string="Fecha registro" optional="show"/>
                <field name="fecha_a_ejecutar" string="Fecha ejecución" optional="show"/>
                <field name="fundo_id" optional="show"/>
                <field name="sector_riego_id" optional="show"/>
                <field name="cost_center_id" optional="show"/>
                <field name="responsable_id" optional="show"/>
                <field name="asignado_a_id" optional="show"/>
                <field name="instruccin" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_internal_inspection_form_step_qa" model="ir.ui.view">
        <field name="name">x.inspecciones.interna.form.step.qa</field>
        <field name="model">step.agriculture.inspection</field>
        <field name="arch" type="xml">
            <form string="Inspección interna" class="o_step_qa_studio_form">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="o_step_qa_record_intro">
                        <i class="fa fa-clipboard" title="Inspección interna"/>
                        <div><span>INSPECCIÓN EN TERRENO</span><strong>Ficha de inspección interna</strong><small>Planifique, asigne, documente hallazgos y apruebe la ejecución.</small></div>
                    </div>
                    <div class="oe_title"><label for="name" string="Folio"/><h1><field name="name" readonly="1" force_save="1" placeholder="Nuevo"/></h1></div>
                    <group>
                        <group string="Ubicación">
                            <field name="fundo_id"/>
                            <field name="sector_riego_id" options="{'create_name_field': 'name'}"/>
                            <field name="cost_center_id" domain="[('plan_id', 'in', [3])]"/>
                        </group>
                        <group string="Planificación">
                            <field name="date"/>
                            <field name="fecha_a_ejecutar"/>
                            <field name="responsable_id" domain="[('user_id', '!=', False)]"/>
                            <field name="asignado_a_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instrucciones" name="instructions"><group><field name="instruccin" placeholder="Indique qué se debe revisar y el criterio esperado."/></group></page>
                        <page string="Lista de revisión" name="checklist">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom"><field name="sequence" widget="handle"/><field name="name" string="Ítem de inspección" required="1"/></list>
                            </field>
                        </page>
                        <page string="Observaciones" name="observations"><group><field name="observaciones" placeholder="Registre hallazgos, desviaciones y acuerdos."/></group></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_internal_inspection_kanban_step_qa" model="ir.ui.view">
        <field name="name">x.inspecciones.interna.kanban.step.qa</field><field name="model">step.agriculture.inspection</field>
        <field name="arch" type="xml"><kanban string="Inspecciones internas" default_group_by="state" class="o_kanban_small_column">
            <field name="name"/><field name="state"/><field name="fundo_id"/><field name="sector_riego_id"/><field name="fecha_a_ejecutar"/><field name="asignado_a_id"/>
            <templates><t t-name="card"><div class="d-flex justify-content-between align-items-start gap-2"><strong class="fs-6"><field name="name"/></strong><field name="state" widget="badge"/></div><div class="text-muted mt-2"><i class="fa fa-map-marker me-1" title="Ubicación"/><field name="fundo_id"/><t t-if="record.sector_riego_id.raw_value"> · <field name="sector_riego_id"/></t></div><div class="d-flex justify-content-between mt-3 small"><span><i class="fa fa-user me-1" title="Responsable"/><field name="asignado_a_id"/></span><span><i class="fa fa-calendar me-1" title="Fecha"/><field name="fecha_a_ejecutar"/></span></div></t></templates>
        </kanban></field>
    </record>

    <record id="view_internal_inspection_calendar_step_qa" model="ir.ui.view">
        <field name="name">x.inspecciones.interna.calendar.step.qa</field><field name="model">step.agriculture.inspection</field>
        <field name="arch" type="xml"><calendar string="Calendario de inspecciones" date_start="fecha_a_ejecutar" color="responsable_id" mode="month" event_open_popup="true"><field name="name"/><field name="state"/><field name="fundo_id"/><field name="asignado_a_id"/></calendar></field>
    </record>

    <record id="view_internal_inspection_search_step_qa" model="ir.ui.view">
        <field name="name">x.inspecciones.interna.search.step.qa</field><field name="model">step.agriculture.inspection</field>
        <field name="arch" type="xml"><search string="Buscar inspecciones internas"><field name="name"/><field name="fundo_id"/><field name="sector_riego_id"/><field name="responsable_id"/><field name="asignado_a_id"/><field name="cost_center_id"/><separator/><filter name="created" string="Creadas" domain="[('state','=','status1')]"/><filter name="executed" string="Ejecutadas" domain="[('state','=','status2')]"/><filter name="approved" string="Aprobadas" domain="[('state','=','status3')]"/><filter name="execution_date" string="Fecha de ejecución" date="fecha_a_ejecutar"/><group expand="0" string="Agrupar por"><filter name="group_state" string="Estado" context="{'group_by':'state'}"/><filter name="group_farm" string="Fundo" context="{'group_by':'fundo_id'}"/><filter name="group_responsible" string="Responsable" context="{'group_by':'responsable_id'}"/><filter name="group_month" string="Mes" context="{'group_by':'fecha_a_ejecutar:month'}"/></group></search></field>
    </record>

    <record id="step_qa.inspecciones_interna_1723c8a9-8891-4311-9a5a-0a2ae007dae2" model="ir.actions.act_window">
        <field name="name">Inspecciones internas</field><field name="view_mode">kanban,list,calendar,form</field><field name="search_view_id" ref="step_qa.view_internal_inspection_search_step_qa"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Planifique la primera inspección interna.</p><p>Asigne un responsable, fecha, ubicación y lista de revisión para dejar evidencia de la ejecución.</p></field>
    </record>
    <record id="action_view_internal_inspection_kanban_step_qa" model="ir.actions.act_window.view"><field name="sequence">10</field><field name="view_mode">kanban</field><field name="view_id" ref="step_qa.view_internal_inspection_kanban_step_qa"/><field name="act_window_id" ref="step_qa.inspecciones_interna_1723c8a9-8891-4311-9a5a-0a2ae007dae2"/></record>
    <record id="action_view_internal_inspection_list_step_qa" model="ir.actions.act_window.view"><field name="sequence">20</field><field name="view_mode">list</field><field name="view_id" ref="step_qa.view_internal_inspection_list_step_qa"/><field name="act_window_id" ref="step_qa.inspecciones_interna_1723c8a9-8891-4311-9a5a-0a2ae007dae2"/></record>
    <record id="action_view_internal_inspection_calendar_step_qa" model="ir.actions.act_window.view"><field name="sequence">30</field><field name="view_mode">calendar</field><field name="view_id" ref="step_qa.view_internal_inspection_calendar_step_qa"/><field name="act_window_id" ref="step_qa.inspecciones_interna_1723c8a9-8891-4311-9a5a-0a2ae007dae2"/></record>
    <record id="action_view_internal_inspection_form_step_qa" model="ir.actions.act_window.view"><field name="sequence">40</field><field name="view_mode">form</field><field name="view_id" ref="step_qa.view_internal_inspection_form_step_qa"/><field name="act_window_id" ref="step_qa.inspecciones_interna_1723c8a9-8891-4311-9a5a-0a2ae007dae2"/></record>

    <!-- External advisory inspections -->
    <record id="view_external_advisor_list_step_qa" model="ir.ui.view">
        <field name="name">x.asesor.externo.list.step.qa</field><field name="model">step.agriculture.advisory</field>
        <field name="arch" type="xml"><list string="Asesorías externas" class="o_step_qa_list" decoration-info="state == 'status2'" decoration-success="state in ('status3', 'Revisada asesor')"><field name="name" string="Folio" optional="show"/><field name="state" string="Estado" widget="badge" optional="show"/><field name="date" optional="show"/><field name="fecha_a_ejecutar" string="Fecha ejecución" optional="show"/><field name="fundo_id" optional="show"/><field name="species_id" optional="show"/><field name="actividad_id" optional="show"/><field name="nombre_asesor_id" string="Asesor" optional="show"/><field name="responsable_de_ejecutar_id" string="Responsable" optional="show"/><field name="aprobador_id" optional="show"/><field name="cost_center_id" optional="hide"/></list></field>
    </record>

    <record id="view_external_advisor_form_step_qa" model="ir.ui.view">
        <field name="name">x.asesor.externo.form.step.qa</field><field name="model">step.agriculture.advisory</field>
        <field name="arch" type="xml"><form string="Asesoría externa" class="o_step_qa_studio_form"><header><field name="state" widget="statusbar" options="{'clickable':'1'}"/></header><sheet><field name="active" invisible="1"/><widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/><div class="o_step_qa_record_intro"><i class="fa fa-user-md" title="Asesoría externa"/><div><span>APOYO ESPECIALISTA</span><strong>Asesoría e inspección externa</strong><small>Coordine la recomendación técnica, ejecución en terreno y aprobación final.</small></div></div><div class="oe_title"><label for="name" string="Folio"/><h1><field name="name" placeholder="Nuevo"/></h1></div><group><group string="Antecedentes"><field name="date"/><field name="fundo_id"/><field name="species_id"/><field name="actividad_id"/><field name="cost_center_id"/></group><group string="Responsables"><field name="nombre_asesor_id"/><field name="fecha_a_ejecutar"/><field name="responsable_de_ejecutar_id"/><field name="aprobador_id"/></group></group><notebook><page string="Recomendación" name="recommendation"><group><field name="descripcin" placeholder="Describa el objetivo y recomendación de la asesoría."/></group></page><page string="Plan de trabajo" name="workplan"><field name="line_ids" nolabel="1"><list editable="bottom"><field name="sequence" widget="handle"/><field name="labor_tarea_id"/><field name="active_ingredient_id"/><field name="producto_agrcola_id"/><field name="dosis_por_ha"/><field name="name" string="Resultado esperado"/></list></field></page></notebook></sheet><chatter/></form></field>
    </record>

    <record id="view_external_advisor_kanban_step_qa" model="ir.ui.view">
        <field name="name">x.asesor.externo.kanban.step.qa</field><field name="model">step.agriculture.advisory</field><field name="arch" type="xml"><kanban string="Asesorías externas" default_group_by="state" class="o_kanban_small_column"><field name="name"/><field name="state"/><field name="fundo_id"/><field name="fecha_a_ejecutar"/><field name="nombre_asesor_id"/><field name="responsable_de_ejecutar_id"/><templates><t t-name="card"><div class="d-flex justify-content-between align-items-start gap-2"><strong class="fs-6"><field name="name"/></strong><field name="state" widget="badge"/></div><div class="text-muted mt-2"><i class="fa fa-map-marker me-1" title="Ubicación"/><field name="fundo_id"/></div><div class="mt-2"><i class="fa fa-user-md me-1" title="Asesor"/><field name="nombre_asesor_id"/></div><div class="d-flex justify-content-between mt-3 small"><span><i class="fa fa-user me-1" title="Responsable"/><field name="responsable_de_ejecutar_id"/></span><span><i class="fa fa-calendar me-1" title="Fecha"/><field name="fecha_a_ejecutar"/></span></div></t></templates></kanban></field>
    </record>

    <record id="view_external_advisor_calendar_step_qa" model="ir.ui.view"><field name="name">x.asesor.externo.calendar.step.qa</field><field name="model">step.agriculture.advisory</field><field name="arch" type="xml"><calendar string="Calendario de asesorías" date_start="fecha_a_ejecutar" color="nombre_asesor_id" mode="month" event_open_popup="true"><field name="name"/><field name="state"/><field name="fundo_id"/><field name="nombre_asesor_id"/><field name="responsable_de_ejecutar_id"/></calendar></field></record>

    <record id="view_external_advisor_search_step_qa" model="ir.ui.view"><field name="name">x.asesor.externo.search.step.qa</field><field name="model">step.agriculture.advisory</field><field name="arch" type="xml"><search string="Buscar asesorías externas"><field name="name"/><field name="fundo_id"/><field name="species_id"/><field name="actividad_id"/><field name="nombre_asesor_id"/><field name="responsable_de_ejecutar_id"/><field name="aprobador_id"/><separator/><filter name="created" string="Creadas" domain="[('state','=','status1')]"/><filter name="executed" string="Ejecutadas" domain="[('state','=','status2')]"/><filter name="approved" string="Aprobadas" domain="[('state','in',['status3','Revisada asesor'])]"/><filter name="execution_date" string="Fecha de ejecución" date="fecha_a_ejecutar"/><group expand="0" string="Agrupar por"><filter name="group_state" string="Estado" context="{'group_by':'state'}"/><filter name="group_farm" string="Fundo" context="{'group_by':'fundo_id'}"/><filter name="group_advisor" string="Asesor" context="{'group_by':'nombre_asesor_id'}"/><filter name="group_month" string="Mes" context="{'group_by':'fecha_a_ejecutar:month'}"/></group></search></field></record>

    <record id="step_qa.asesor_externo_79ae2b5a-8e06-4bf5-81d5-66da18c2b90f" model="ir.actions.act_window"><field name="name">Asesorías externas</field><field name="view_mode">kanban,list,calendar,form</field><field name="search_view_id" ref="step_qa.view_external_advisor_search_step_qa"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Registre la primera asesoría externa.</p><p>Documente la recomendación técnica, sus responsables y el plan de ejecución.</p></field></record>
    <record id="action_view_external_advisor_kanban_step_qa" model="ir.actions.act_window.view"><field name="sequence">10</field><field name="view_mode">kanban</field><field name="view_id" ref="step_qa.view_external_advisor_kanban_step_qa"/><field name="act_window_id" ref="step_qa.asesor_externo_79ae2b5a-8e06-4bf5-81d5-66da18c2b90f"/></record>
    <record id="action_view_external_advisor_list_step_qa" model="ir.actions.act_window.view"><field name="sequence">20</field><field name="view_mode">list</field><field name="view_id" ref="step_qa.view_external_advisor_list_step_qa"/><field name="act_window_id" ref="step_qa.asesor_externo_79ae2b5a-8e06-4bf5-81d5-66da18c2b90f"/></record>
    <record id="action_view_external_advisor_calendar_step_qa" model="ir.actions.act_window.view"><field name="sequence">30</field><field name="view_mode">calendar</field><field name="view_id" ref="step_qa.view_external_advisor_calendar_step_qa"/><field name="act_window_id" ref="step_qa.asesor_externo_79ae2b5a-8e06-4bf5-81d5-66da18c2b90f"/></record>
    <record id="action_view_external_advisor_form_step_qa" model="ir.actions.act_window.view"><field name="sequence">40</field><field name="view_mode">form</field><field name="view_id" ref="step_qa.view_external_advisor_form_step_qa"/><field name="act_window_id" ref="step_qa.asesor_externo_79ae2b5a-8e06-4bf5-81d5-66da18c2b90f"/></record>
</odoo>
