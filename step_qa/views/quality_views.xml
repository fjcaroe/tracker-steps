<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quality checks -->
    <record id="view_quality_check_list_step_qa" model="ir.ui.view">
        <field name="name">quality.check.list.step.qa</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <list string="Controles de calidad" class="o_step_qa_list"
                  decoration-success="quality_state == 'pass'"
                  decoration-danger="quality_state == 'fail'"
                  decoration-muted="quality_state == 'none'">
                <field name="control_date" string="Fecha" optional="show"/>
                <field name="name" string="Referencia" optional="show"/>
                <field name="title" string="Control" optional="show"/>
                <field name="quality_state" string="Resultado" widget="badge" optional="show"
                       decoration-success="quality_state == 'pass'"
                       decoration-danger="quality_state == 'fail'"
                       decoration-muted="quality_state == 'none'"/>
                <field name="product_id" optional="show"/>
                <field name="lot_id" optional="show" groups="stock.group_production_lot"/>
                <field name="point_id" string="Punto de control" optional="show"/>
                <field name="test_type_id" string="Tipo de prueba" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" string="Responsable" widget="many2one_avatar_user" optional="show"/>
                <field name="picking_id" string="Operación" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_quality_check_form_step_qa" model="ir.ui.view">
        <field name="name">quality.check.form.step.qa</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_step_qa_form" separator=" "/>
            </xpath>
            <xpath expr="//form/sheet/*[1]" position="before">
                <div class="o_step_qa_record_intro">
                    <i class="fa fa-check-square-o" title="Control de calidad"/>
                    <div><span>CONTROL OPERATIVO</span><strong>Evaluación de calidad</strong><small>Registre el resultado, evidencia, lote y responsable del control.</small></div>
                </div>
                <div class="oe_title">
                    <label for="title" string="Control"/>
                    <h1><field name="title" placeholder="Nombre del control"/></h1>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_quality_check_calendar_step_qa" model="ir.ui.view">
        <field name="name">quality.check.calendar.step.qa</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de controles" date_start="control_date" color="team_id" mode="month" event_open_popup="true">
                <field name="title"/>
                <field name="quality_state"/>
                <field name="product_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_quality_check_search_step_qa" model="ir.ui.view">
        <field name="name">quality.check.search.step.qa</field>
        <field name="model">quality.check</field>
        <field name="arch" type="xml">
            <search string="Buscar controles de calidad">
                <field name="name"/>
                <field name="title"/>
                <field name="product_id"/>
                <field name="lot_id" groups="stock.group_production_lot"/>
                <field name="point_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="pending" string="Pendientes" domain="[('quality_state', '=', 'none')]"/>
                <filter name="passed" string="Aprobados" domain="[('quality_state', '=', 'pass')]"/>
                <filter name="failed" string="Rechazados" domain="[('quality_state', '=', 'fail')]"/>
                <filter name="control_period" string="Fecha del control" date="control_date"/>
                <separator/>
                <filter name="my_checks" string="Mis controles" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Resultado" context="{'group_by': 'quality_state'}"/>
                    <filter name="group_team" string="Equipo" context="{'group_by': 'team_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_point" string="Punto de control" context="{'group_by': 'point_id'}"/>
                    <filter name="group_user" string="Responsable" context="{'group_by': 'user_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'control_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="step_qa.control_de_qa_b172c94c-5a8d-48d6-8779-b0ca0e1b0d8a" model="ir.actions.act_window">
        <field name="name">Controles de calidad</field>
        <field name="res_model">quality.check</field>
        <field name="view_mode">kanban,list,calendar,form,pivot,graph,activity</field>
        <field name="search_view_id" ref="step_qa.view_quality_check_search_step_qa"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Comience registrando o generando un control de calidad.</p><p>Los controles permiten aprobar, rechazar y levantar alertas con trazabilidad de producto, lote y responsable.</p></field>
    </record>
    <record id="action_view_quality_check_kanban_step_qa" model="ir.actions.act_window.view"><field name="sequence">10</field><field name="view_mode">kanban</field><field name="view_id" ref="quality_control.quality_check_view_kanban"/><field name="act_window_id" ref="step_qa.control_de_qa_b172c94c-5a8d-48d6-8779-b0ca0e1b0d8a"/></record>
    <record id="action_view_quality_check_list_step_qa" model="ir.actions.act_window.view"><field name="sequence">20</field><field name="view_mode">list</field><field name="view_id" ref="step_qa.view_quality_check_list_step_qa"/><field name="act_window_id" ref="step_qa.control_de_qa_b172c94c-5a8d-48d6-8779-b0ca0e1b0d8a"/></record>
    <record id="action_view_quality_check_calendar_step_qa" model="ir.actions.act_window.view"><field name="sequence">30</field><field name="view_mode">calendar</field><field name="view_id" ref="step_qa.view_quality_check_calendar_step_qa"/><field name="act_window_id" ref="step_qa.control_de_qa_b172c94c-5a8d-48d6-8779-b0ca0e1b0d8a"/></record>
    <record id="action_view_quality_check_form_step_qa" model="ir.actions.act_window.view"><field name="sequence">40</field><field name="view_mode">form</field><field name="view_id" ref="step_qa.view_quality_check_form_step_qa"/><field name="act_window_id" ref="step_qa.control_de_qa_b172c94c-5a8d-48d6-8779-b0ca0e1b0d8a"/></record>
    <record id="action_view_quality_check_pivot_step_qa" model="ir.actions.act_window.view"><field name="sequence">50</field><field name="view_mode">pivot</field><field name="view_id" ref="quality_control.quality_check_view_pivot"/><field name="act_window_id" ref="step_qa.control_de_qa_b172c94c-5a8d-48d6-8779-b0ca0e1b0d8a"/></record>
    <record id="action_view_quality_check_graph_step_qa" model="ir.actions.act_window.view"><field name="sequence">60</field><field name="view_mode">graph</field><field name="view_id" ref="quality_control.quality_check_view_graph"/><field name="act_window_id" ref="step_qa.control_de_qa_b172c94c-5a8d-48d6-8779-b0ca0e1b0d8a"/></record>
    <record id="action_view_quality_check_activity_step_qa" model="ir.actions.act_window.view"><field name="sequence">70</field><field name="view_mode">activity</field><field name="view_id" ref="quality.quality_check_view_activity"/><field name="act_window_id" ref="step_qa.control_de_qa_b172c94c-5a8d-48d6-8779-b0ca0e1b0d8a"/></record>

    <!-- Control points -->
    <record id="view_quality_point_list_step_qa" model="ir.ui.view">
        <field name="name">quality.point.list.step.qa</field>
        <field name="model">quality.point</field>
        <field name="arch" type="xml">
            <list string="Puntos de control" class="o_step_qa_list" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="title" string="Punto de control" optional="show"/>
                <field name="test_type_id" string="Tipo de prueba" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="product_ids" widget="many2many_tags" optional="show"/>
                <field name="product_category_ids" widget="many2many_tags" optional="hide"/>
                <field name="picking_type_ids" string="Operaciones" widget="many2many_tags" optional="show"/>
                <field name="user_id" string="Responsable" widget="many2one_avatar_user" optional="show"/>
                <field name="check_count" string="Controles" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_quality_point_form_step_qa" model="ir.ui.view">
        <field name="name">quality.point.form.step.qa</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="quality.quality_point_view_form"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes"><attribute name="class" add="o_step_qa_form" separator=" "/></xpath>
            <xpath expr="//form/sheet/*[1]" position="before">
                <div class="o_step_qa_record_intro"><i class="fa fa-crosshairs" title="Punto de control"/><div><span>PLAN DE CONTROL</span><strong>Punto de control</strong><small>Defina productos, operaciones, frecuencia, tipo de prueba y responsable.</small></div></div>
            </xpath>
        </field>
    </record>

    <record id="view_quality_point_search_step_qa" model="ir.ui.view">
        <field name="name">quality.point.search.step.qa</field><field name="model">quality.point</field>
        <field name="arch" type="xml"><search string="Buscar puntos de control">
            <field name="title"/><field name="product_ids"/><field name="product_category_ids"/><field name="picking_type_ids"/><field name="team_id"/><field name="user_id"/>
            <separator/><filter name="active" string="Activos" domain="[('active', '=', True)]"/><filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
            <group expand="0" string="Agrupar por"><filter name="group_team" string="Equipo" context="{'group_by':'team_id'}"/><filter name="group_test" string="Tipo de prueba" context="{'group_by':'test_type_id'}"/><filter name="group_user" string="Responsable" context="{'group_by':'user_id'}"/></group>
        </search></field>
    </record>

    <record id="step_qa.puntos_de_control_d607ccb0-74c4-46ba-84e7-7b7d8fa7c6b8" model="ir.actions.act_window">
        <field name="name">Puntos de control</field><field name="res_model">quality.point</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="step_qa.view_quality_point_search_step_qa"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Defina el primer punto de control.</p><p>Indique qué se debe revisar, en qué operación y quién será responsable.</p></field>
    </record>
    <record id="action_view_quality_point_kanban_step_qa" model="ir.actions.act_window.view"><field name="sequence">10</field><field name="view_mode">kanban</field><field name="view_id" ref="quality_control.view_quality_point_kanban"/><field name="act_window_id" ref="step_qa.puntos_de_control_d607ccb0-74c4-46ba-84e7-7b7d8fa7c6b8"/></record>
    <record id="action_view_quality_point_list_step_qa" model="ir.actions.act_window.view"><field name="sequence">20</field><field name="view_mode">list</field><field name="view_id" ref="step_qa.view_quality_point_list_step_qa"/><field name="act_window_id" ref="step_qa.puntos_de_control_d607ccb0-74c4-46ba-84e7-7b7d8fa7c6b8"/></record>
    <record id="action_view_quality_point_form_step_qa" model="ir.actions.act_window.view"><field name="sequence">30</field><field name="view_mode">form</field><field name="view_id" ref="step_qa.view_quality_point_form_step_qa"/><field name="act_window_id" ref="step_qa.puntos_de_control_d607ccb0-74c4-46ba-84e7-7b7d8fa7c6b8"/></record>

    <!-- Quality alerts -->
    <record id="view_quality_alert_list_step_qa" model="ir.ui.view">
        <field name="name">quality.alert.list.step.qa</field><field name="model">quality.alert</field>
        <field name="arch" type="xml"><list string="Alertas de calidad" class="o_step_qa_list" decoration-danger="priority == '3'" decoration-warning="priority == '2'">
            <field name="priority" widget="priority" optional="show"/><field name="name" string="Referencia" optional="show"/><field name="title" string="Alerta" optional="show"/><field name="stage_id" widget="badge" optional="show"/><field name="team_id" optional="show"/><field name="user_id" string="Responsable" widget="many2one_avatar_user" optional="show"/><field name="product_tmpl_id" string="Producto" optional="show"/><field name="lot_id" optional="show" groups="stock.group_production_lot"/><field name="reason_id" string="Causa" optional="show"/><field name="date_assign" string="Asignada" optional="show"/><field name="date_close" string="Cerrada" optional="hide"/><field name="company_id" optional="hide" groups="base.group_multi_company"/>
        </list></field>
    </record>

    <record id="view_quality_alert_form_step_qa" model="ir.ui.view">
        <field name="name">quality.alert.form.step.qa</field><field name="model">quality.alert</field><field name="inherit_id" ref="quality_control.quality_alert_view_form"/><field name="mode">primary</field><field name="priority">90</field>
        <field name="arch" type="xml"><xpath expr="//form" position="attributes"><attribute name="class" add="o_step_qa_form" separator=" "/></xpath><xpath expr="//form/sheet/*[1]" position="before"><div class="o_step_qa_record_intro"><i class="fa fa-exclamation-triangle" title="Alerta de calidad"/><div><span>NO CONFORMIDAD</span><strong>Alerta y plan de acción</strong><small>Documente el problema, su causa, responsable y acciones correctivas o preventivas.</small></div></div></xpath></field>
    </record>

    <record id="view_quality_alert_search_step_qa" model="ir.ui.view">
        <field name="name">quality.alert.search.step.qa</field><field name="model">quality.alert</field>
        <field name="arch" type="xml"><search string="Buscar alertas de calidad">
            <field name="name"/><field name="title"/><field name="product_tmpl_id"/><field name="lot_id" groups="stock.group_production_lot"/><field name="team_id"/><field name="user_id"/><field name="reason_id"/>
            <separator/><filter name="open" string="Abiertas" domain="[('stage_id.done', '=', False)]"/><filter name="closed" string="Cerradas" domain="[('stage_id.done', '=', True)]"/><filter name="critical" string="Prioridad crítica" domain="[('priority', '=', '3')]"/><filter name="my_alerts" string="Mis alertas" domain="[('user_id', '=', uid)]"/><filter name="assigned_period" string="Fecha de asignación" date="date_assign"/>
            <group expand="0" string="Agrupar por"><filter name="group_stage" string="Etapa" context="{'group_by':'stage_id'}"/><filter name="group_team" string="Equipo" context="{'group_by':'team_id'}"/><filter name="group_user" string="Responsable" context="{'group_by':'user_id'}"/><filter name="group_product" string="Producto" context="{'group_by':'product_tmpl_id'}"/><filter name="group_month" string="Mes" context="{'group_by':'date_assign:month'}"/></group>
        </search></field>
    </record>

    <record id="step_qa.alertas_de_calidad_460e6a18-5379-4351-9b36-fcb6bc0f8240" model="ir.actions.act_window">
        <field name="name">Alertas de calidad</field><field name="res_model">quality.alert</field><field name="view_mode">kanban,list,calendar,form,pivot,graph</field><field name="search_view_id" ref="step_qa.view_quality_alert_search_step_qa"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No hay alertas de calidad.</p><p>Cuando exista una no conformidad podrá asignar responsables, causas y planes de acción.</p></field>
    </record>
    <record id="action_view_quality_alert_kanban_step_qa" model="ir.actions.act_window.view"><field name="sequence">10</field><field name="view_mode">kanban</field><field name="view_id" ref="quality_control.quality_alert_view_kanban"/><field name="act_window_id" ref="step_qa.alertas_de_calidad_460e6a18-5379-4351-9b36-fcb6bc0f8240"/></record>
    <record id="action_view_quality_alert_list_step_qa" model="ir.actions.act_window.view"><field name="sequence">20</field><field name="view_mode">list</field><field name="view_id" ref="step_qa.view_quality_alert_list_step_qa"/><field name="act_window_id" ref="step_qa.alertas_de_calidad_460e6a18-5379-4351-9b36-fcb6bc0f8240"/></record>
    <record id="action_view_quality_alert_calendar_step_qa" model="ir.actions.act_window.view"><field name="sequence">30</field><field name="view_mode">calendar</field><field name="view_id" ref="quality_control.quality_alert_view_calendar"/><field name="act_window_id" ref="step_qa.alertas_de_calidad_460e6a18-5379-4351-9b36-fcb6bc0f8240"/></record>
    <record id="action_view_quality_alert_form_step_qa" model="ir.actions.act_window.view"><field name="sequence">40</field><field name="view_mode">form</field><field name="view_id" ref="step_qa.view_quality_alert_form_step_qa"/><field name="act_window_id" ref="step_qa.alertas_de_calidad_460e6a18-5379-4351-9b36-fcb6bc0f8240"/></record>
    <record id="action_view_quality_alert_pivot_step_qa" model="ir.actions.act_window.view"><field name="sequence">50</field><field name="view_mode">pivot</field><field name="view_id" ref="quality_control.quality_alert_view_pivot"/><field name="act_window_id" ref="step_qa.alertas_de_calidad_460e6a18-5379-4351-9b36-fcb6bc0f8240"/></record>
    <record id="action_view_quality_alert_graph_step_qa" model="ir.actions.act_window.view"><field name="sequence">60</field><field name="view_mode">graph</field><field name="view_id" ref="quality_control.quality_alert_view_graph"/><field name="act_window_id" ref="step_qa.alertas_de_calidad_460e6a18-5379-4351-9b36-fcb6bc0f8240"/></record>

    <record id="step_qa.equipo_de_alertas_qa_7ba3c107-1e6a-4cbd-ae6d-cfafb976e614" model="ir.actions.act_window">
        <field name="name">Equipos de calidad</field>
        <field name="res_model">quality.alert.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree el primer equipo de calidad.</p><p>Los equipos distribuyen controles y alertas entre sus responsables.</p></field>
    </record>
</odoo>
