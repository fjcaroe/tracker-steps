<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_app_mob_event_list" model="ir.ui.view">
        <field name="name">step.mobilization.passenger.event.list.steps.app</field>
        <field name="model">step.mobilization.passenger.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="state == 'void'">
                <field name="device_datetime"/>
                <field name="trip_id"/>
                <field name="passenger_id"/>
                <field name="event_type"/>
                <field name="method"/>
                <field name="app_person_id"/>
                <field name="state" widget="badge"/>
                <field name="void_reason"/>
            </list>
        </field>
    </record>
    <record id="view_step_app_mob_event_search" model="ir.ui.view">
        <field name="name">step.mobilization.passenger.event.search.steps.app</field>
        <field name="model">step.mobilization.passenger.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="trip_id"/>
                <field name="passenger_id"/>
                <field name="app_person_id"/>
                <filter name="from_app" string="Marcadas desde la app" domain="[('app_person_id', '!=', False)]"/>
                <filter name="void" string="Anuladas" domain="[('state', '=', 'void')]"/>
            </search>
        </field>
    </record>
    <record id="action_step_app_mob_event" model="ir.actions.act_window">
        <field name="name">Marcas desde la app</field>
        <field name="res_model">step.mobilization.passenger.event</field>
        <field name="view_mode">list</field>
        <field name="domain">[('app_person_id', '!=', False)]</field>
    </record>
    <record id="view_step_app_mob_incident_list" model="ir.ui.view">
        <field name="name">step.app.mobilization.incident.list</field>
        <field name="model">step.app.mobilization.incident</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="device_datetime"/>
                <field name="trip_id"/>
                <field name="category"/>
                <field name="text"/>
                <field name="person_id"/>
            </list>
        </field>
    </record>
    <record id="action_step_app_mob_incident" model="ir.actions.act_window">
        <field name="name">Incidencias desde la app</field>
        <field name="res_model">step.app.mobilization.incident</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_step_app_mob_events" name="Marcas desde la app" parent="step_mobilization.menu_step_mobilization_operation"
              action="action_step_app_mob_event" sequence="40" groups="step_mobilization.group_mobilization_user"/>
    <menuitem id="menu_step_app_mob_incidents" name="Incidencias desde la app" parent="step_mobilization.menu_step_mobilization_operation"
              action="action_step_app_mob_incident" sequence="41" groups="step_mobilization.group_mobilization_user"/>
</odoo>
