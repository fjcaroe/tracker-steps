<odoo>
    <record id="landscape" model="report.paperformat">
        <field name="name">Documentos de Packing A4</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
    </record>
    <record id="action_order_pdf" model="ir.actions.report">
        <field name="name">Orden de proceso Packing</field>
        <field name="model">step.packing.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">step_packing_producer_documents.order_report</field>
        <field name="binding_model_id" ref="step_packing_operations.model_step_packing_order"/>
        <field name="paperformat_id" ref="landscape"/>
    </record>
    <record id="action_producer_pdf" model="ir.actions.report">
        <field name="name">Informe para productor</field>
        <field name="model">step.packing.producer.document</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">step_packing_producer_documents.producer_report</field>
        <field name="paperformat_id" ref="landscape"/>
    </record>
    <template id="order_report">
        <t t-call="step_packing_producer_documents.document_report"/>
    </template>
    <template id="producer_report">
        <t t-call="step_packing_producer_documents.document_report"/>
    </template>
    <template id="document_report">
        <t t-call="web.html_container">
            <meta charset="utf-8"/>
            <div t-foreach="docs" t-as="doc" class="page" t-att-style="'page-break-before:always' if doc_index else ''">
                <t t-set="payload" t-value="doc._document_data()"/>
                <div t-att-class="'packing-spaced-header' if payload.get('spaced_header') else ''">
                    <style t-if="payload.get('spaced_header')" type="text/css">
                        .packing-spaced-header th { text-align: left; }
                        .packing-spaced-header th:nth-child(3) { padding-left: 20mm; }
                        .packing-spaced-header th, .packing-spaced-header td { vertical-align: top; }
                    </style>
                    <t t-call="step_packing_process_report.packing_report_heading">
                        <t t-set="heading" t-value="payload['title']"/>
                    </t>
                </div>
                <t t-foreach="payload['sections']" t-as="section">
                    <h4 t-out="section[0]" style="page-break-after:avoid;"/>
                    <table style="width:100%;font-size:10px;border-spacing:2px;">
                        <thead style="display:table-header-group;background:#e5eee8;">
                            <tr>
                                <th t-foreach="section[1]" t-as="column"
                                    t-att-style="'text-align:left' if payload.get('left_column_titles') else ('text-align:right' if column_index in payload.get('right_aligned_columns', ()) else '')"
                                    t-out="column"/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="footer" t-value="section[3]"/>
                            <tr t-foreach="section[2] + ([footer] if footer else [])" t-as="row"
                                t-att-style="'page-break-inside:avoid; font-weight:bold;' if payload.get('emphasize_totals') and footer and row_last else 'page-break-inside:avoid;'">
                                <td t-foreach="row" t-as="value"
                                    t-att-style="'text-align:right' if value_index in payload.get('right_aligned_columns', ()) else ''"
                                    t-out="doc._packing_report_display(value, section[1][value_index].startswith('%'))"/>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">step.packing.order.form.documents</field>
        <field name="model">step.packing.order</field>
        <field name="inherit_id" ref="step_packing_operations.view_packing_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_document_xlsx" type="object" string="Informe Excel"/>
            </xpath>
        </field>
    </record>
    <record id="view_producer_form" model="ir.ui.view">
        <field name="name">step.packing.producer.document.form</field>
        <field name="model">step.packing.producer.document</field>
        <field name="arch" type="xml">
            <form string="Informe para productor">
                <group>
                    <field name="kind" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="producer_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button type="object" name="action_document_pdf" string="PDF" class="btn-primary"/>
                    <button type="object" name="action_document_xlsx" string="Excel"/>
                    <button type="object" name="action_document_email" string="Enviar por correo"
                            confirm="¿Enviar el PDF y Excel al correo registrado del productor seleccionado?"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_reception" model="ir.actions.act_window">
        <field name="name">Informe recepción a productor</field>
        <field name="res_model">step.packing.producer.document</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_kind': 'reception'}</field>
    </record>
    <record id="action_process" model="ir.actions.act_window">
        <field name="name">Informe para productor</field>
        <field name="res_model">step.packing.producer.document</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_kind': 'process'}</field>
    </record>
    <menuitem id="menu_reception" name="Informe recepción a productor"
              parent="step_packing_operations.menu_packing_operations_receptions"
              action="action_reception" sequence="25" groups="stock.group_stock_user"/>
    <menuitem id="menu_process" name="Informe para productor"
              parent="step_packing_operations.menu_packing_operations_process"
              action="action_process" sequence="45" groups="stock.group_stock_user"/>
</odoo>
