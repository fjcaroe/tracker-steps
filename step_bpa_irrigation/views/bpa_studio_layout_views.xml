<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_irrigation_list" model="ir.ui.view">
        <field name="name">x.riego.fertilizacion.list.bpa</field><field name="model">step.agriculture.irrigation</field>
        <field name="arch" type="xml"><list class="o_step_bpa_list" decoration-info="slo_riego"><field name="name"/><field name="fecha_aplicacin"/><field name="fundo_id"/><field name="responsaable_id"/><field name="tipo_de_aplicacin_id" widget="badge"/><field name="hectreas_a_regar" sum="Hectáreas"/><field name="litros_mezcla" sum="Litros"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field>
    </record>
    <record id="view_irrigation_form" model="ir.ui.view">
        <field name="name">x.riego.fertilizacion.form.bpa</field><field name="model">step.agriculture.irrigation</field>
        <field name="arch" type="xml"><form class="o_step_bpa_form"><sheet><div class="o_step_bpa_record_intro"><i class="fa fa-tint" title="Fertirriego"/><div><span>GESTIÓN HÍDRICA Y NUTRICIONAL</span><strong>Riego y fertilización</strong><small>Planifique superficie, mezcla y responsables con trazabilidad.</small></div></div><group><group><field name="name"/><field name="ot_bpa"/><field name="fecha_aplicacin"/><field name="fundo_id"/></group><group><field name="responsaable_id"/><field name="tipo_de_aplicacin_id"/><field name="slo_riego"/><field name="company_id" groups="base.group_multi_company"/></group></group><group string="Plan de aplicación"><field name="hectreas_a_regar"/><field name="litros_mezcla"/></group><field name="notes"/></sheet><chatter/></form></field>
    </record>

    <record id="view_application_list" model="ir.ui.view">
        <field name="name">x.aplicacion.foliar.list.bpa</field><field name="model">step.agriculture.application</field>
        <field name="arch" type="xml"><list class="o_step_bpa_list"><field name="name"/><field name="fecha_hora_planificada"/><field name="fundo_id"/><field name="especie_1_id"/><field name="objetivo_aplicacin_id"/><field name="aprueba_id"/><field name="total_hectreas" sum="Hectáreas"/><field name="costo_total_aplicacin" sum="Costo"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field>
    </record>
    <record id="view_application_form" model="ir.ui.view">
        <field name="name">x.aplicacion.foliar.form.bpa</field><field name="model">step.agriculture.application</field>
        <field name="arch" type="xml"><form class="o_step_bpa_form"><header><field name="state" widget="statusbar" statusbar_visible="status1,status2,status3,Contabilizado"/></header><sheet><div class="o_step_bpa_record_intro"><i class="fa fa-leaf" title="Aplicación foliar"/><div><span>BUENAS PRÁCTICAS AGRÍCOLAS</span><strong>Aplicación foliar</strong><small>Planifique, ejecute y costee el tratamiento.</small></div></div><group><group><field name="name"/><field name="nmero_ot_bpa"/><field name="fecha_hora_planificada"/><field name="fundo_id"/><field name="especie_1_id"/></group><group><field name="objetivo_aplicacin_id"/><field name="aprueba_id"/><field name="total_hectreas"/><field name="company_id" groups="base.group_multi_company"/></group></group><group string="Costos"><field name="currency_id" invisible="1"/><field name="costo_de_productos"/><field name="costo_de_personal"/><field name="costo_maquinarias"/><field name="costo_total_aplicacin"/></group><field name="notes"/></sheet><chatter/></form></field>
    </record>

    <record id="view_monitoring_list" model="ir.ui.view">
        <field name="name">x.monitoreo.agricola.list.bpa</field><field name="model">step.agriculture.monitoring</field>
        <field name="arch" type="xml"><list class="o_step_bpa_list"><field name="name"/><field name="date"/><field name="fundo_id"/><field name="species_id"/><field name="estado_fenolgico_id"/><field name="responsable_id"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field>
    </record>
    <record id="view_monitoring_form" model="ir.ui.view">
        <field name="name">x.monitoreo.agricola.form.bpa</field><field name="model">step.agriculture.monitoring</field>
        <field name="arch" type="xml"><form class="o_step_bpa_form"><sheet><div class="o_step_bpa_record_intro"><i class="fa fa-binoculars" title="Monitoreo"/><div><span>OBSERVACIÓN EN TERRENO</span><strong>Monitoreo agrícola</strong><small>Registre condición fenológica, hallazgos y responsables.</small></div></div><group><group><field name="name"/><field name="nmero_ot"/><field name="date"/><field name="fundo_id"/></group><group><field name="species_id"/><field name="estado_fenolgico_id"/><field name="responsable_id"/><field name="company_id" groups="base.group_multi_company"/></group></group><field name="notes"/></sheet><chatter/></form></field>
    </record>

    <record id="view_sector_list" model="ir.ui.view">
        <field name="name">x.sector.riego.list.bpa</field><field name="model">step.agriculture.irrigation.sector</field>
        <field name="arch" type="xml"><list class="o_step_bpa_list"><field name="name"/><field name="fundo_id"/><field name="total_hs" sum="Hectáreas"/><field name="irrigation_system"/><field name="water_source"/><field name="soil_type"/><field name="company_id" groups="base.group_multi_company" optional="hide"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="view_sector_form" model="ir.ui.view">
        <field name="name">x.sector.riego.form.bpa</field><field name="model">step.agriculture.irrigation.sector</field>
        <field name="arch" type="xml"><form class="o_step_bpa_form"><sheet><div class="o_step_bpa_record_intro"><i class="fa fa-map-marker" title="Sector"/><div><span>MAESTRO TERRITORIAL</span><strong>Sector de riego</strong><small>Caracterice superficie, fuente de agua y sistema.</small></div></div><group><group><field name="name"/><field name="fundo_id"/><field name="total_hs"/></group><group><field name="irrigation_system"/><field name="water_source"/><field name="soil_type"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></group></sheet><chatter/></form></field>
    </record>
</odoo>
