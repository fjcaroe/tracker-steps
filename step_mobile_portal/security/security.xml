<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_step_app" model="ir.module.category">
        <field name="name">Steps App</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_step_app_user" model="res.groups">
        <field name="name">Consulta</field>
        <field name="category_id" ref="module_category_step_app"/>
    </record>

    <record id="group_step_app_manager" model="res.groups">
        <field name="name">Administrador de accesos</field>
        <field name="category_id" ref="module_category_step_app"/>
        <field name="implied_ids" eval="[(4, ref('group_step_app_user'))]"/>
        <field name="comment">Invita, aprueba, suspende y asigna módulos solo en las empresas que tiene permitidas.</field>
    </record>

    <!-- System administrators configure the portal in their existing allowed
         companies; ordinary internal users keep their current permissions. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('step_mobile_portal.group_step_app_manager'))]"/>
    </record>
</odoo>
