<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_app_module_list" model="ir.ui.view">
        <field name="name">step.app.module.list</field>
        <field name="model">step.app.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="contract_version"/>
                <field name="min_app_version"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_step_app_module_form" model="ir.ui.view">
        <field name="name">step.app.module.form</field>
        <field name="model">step.app.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="icon"/>
                        <field name="contract_version"/>
                        <field name="min_app_version"/>
                        <field name="active"/>
                    </group>
                    <field name="role_ids">
                        <list>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="permissions"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_app_module" model="ir.actions.act_window">
        <field name="name">Módulos de la app</field>
        <field name="res_model">step.app.module</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
