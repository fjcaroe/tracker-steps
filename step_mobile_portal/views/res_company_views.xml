<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_step_app" model="ir.ui.view">
        <field name="name">res.company.form.step.app</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Steps App" groups="step_mobile_portal.group_step_app_manager">
                    <group>
                        <field name="step_app_org_uid"/>
                        <field name="step_app_org_code"/>
                        <field name="step_app_offline_hours"/>
                    </group>
                    <button name="action_step_app_regenerate_code" type="object" string="Regenerar código de acceso"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
