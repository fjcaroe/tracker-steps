<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_app_person_list" model="ir.ui.view">
        <field name="name">step.app.person.list</field>
        <field name="model">step.app.person</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
                <field name="provider_summary"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_step_app_person_form" model="ir.ui.view">
        <field name="name">step.app.person.form</field>
        <field name="model">step.app.person</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_suspend" type="object" string="Suspender cuenta" invisible="state != 'active'" groups="base.group_system"/>
                    <button name="action_reactivate" type="object" string="Reactivar" invisible="state != 'suspended'" groups="base.group_system"/>
                    <button name="action_revoke_sessions" type="object" string="Cerrar todas las sesiones" groups="step_mobile_portal.group_step_app_manager" confirm="Se cerrará la sesión en todos sus dispositivos. ¿Continuar?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="deletion_requested_at" invisible="not deletion_requested_at"/>
                    </group>
                    <notebook>
                        <page string="Membresías">
                            <field name="membership_ids" readonly="1">
                                <list>
                                    <field name="company_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="partner_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Identidades">
                            <field name="identity_ids" readonly="1">
                                <list>
                                    <field name="provider"/>
                                    <field name="email"/>
                                    <field name="email_verified"/>
                                    <button name="action_issue_recovery_code" type="object" string="Código de recuperación" icon="fa-key" groups="base.group_system" invisible="provider != 'password'"/>
                                    <button name="action_mark_email_verified" type="object" string="Marcar correo verificado" icon="fa-check" groups="base.group_system" invisible="email_verified"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dispositivos">
                            <field name="device_ids" readonly="1">
                                <list>
                                    <field name="label"/>
                                    <field name="platform"/>
                                    <field name="app_version"/>
                                    <field name="last_seen_at"/>
                                    <field name="revoked_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_step_app_person_search" model="ir.ui.view">
        <field name="name">step.app.person.search</field>
        <field name="model">step.app.person</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <filter name="active" string="Activas" domain="[('state', '=', 'active')]"/>
                <filter name="suspended" string="Suspendidas" domain="[('state', '=', 'suspended')]"/>
                <filter name="deletion" string="Eliminación solicitada" domain="[('state', '=', 'deletion_requested')]"/>
                <filter name="no_org" string="Sin empresa" domain="[('membership_ids', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_step_app_device_list" model="ir.ui.view">
        <field name="name">step.app.device.list</field>
        <field name="model">step.app.device</field>
        <field name="arch" type="xml">
            <list decoration-muted="revoked_at">
                <field name="person_id"/>
                <field name="label"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="last_seen_at"/>
                <field name="revoked_at"/>
                <button name="action_revoke" type="object" string="Revocar" icon="fa-ban" invisible="revoked_at" groups="step_mobile_portal.group_step_app_manager" confirm="Se cerrarán sus sesiones. ¿Continuar?"/>
            </list>
        </field>
    </record>

    <record id="action_step_app_device" model="ir.actions.act_window">
        <field name="name">Dispositivos</field>
        <field name="res_model">step.app.device</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_step_app_session_list" model="ir.ui.view">
        <field name="name">step.app.session.list</field>
        <field name="model">step.app.session</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="revoked_at">
                <field name="person_id"/>
                <field name="device_id"/>
                <field name="create_date"/>
                <field name="last_used_at"/>
                <field name="refresh_expires_at"/>
                <field name="revoked_at"/>
                <field name="revoked_reason"/>
            </list>
        </field>
    </record>

    <record id="action_step_app_session" model="ir.actions.act_window">
        <field name="name">Sesiones</field>
        <field name="res_model">step.app.session</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_step_app_identity_list" model="ir.ui.view">
        <field name="name">step.app.identity.list</field>
        <field name="model">step.app.identity</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="person_id"/>
                <field name="provider"/>
                <field name="email"/>
                <field name="email_verified"/>
                <field name="failed_attempts"/>
                <field name="locked_until"/>
                <button name="action_issue_recovery_code" type="object" string="Código de recuperación" icon="fa-key" groups="base.group_system" invisible="provider != 'password'"/>
            </list>
        </field>
    </record>

    <record id="action_step_app_identity" model="ir.actions.act_window">
        <field name="name">Identidades vinculadas</field>
        <field name="res_model">step.app.identity</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_step_app_person" model="ir.actions.act_window">
        <field name="name">Personas registradas</field>
        <field name="res_model">step.app.person</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_step_app_audit_list" model="ir.ui.view">
        <field name="name">step.app.audit.list</field>
        <field name="model">step.app.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="action"/>
                <field name="person_id"/>
                <field name="company_id"/>
                <field name="user_id"/>
                <field name="detail"/>
            </list>
        </field>
    </record>

    <record id="action_step_app_audit" model="ir.actions.act_window">
        <field name="name">Auditoría de accesos</field>
        <field name="res_model">step.app.audit</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
