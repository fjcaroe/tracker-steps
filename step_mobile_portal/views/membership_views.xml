<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_app_membership_list" model="ir.ui.view">
        <field name="name">step.app.membership.list</field>
        <field name="model">step.app.membership</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'requested'" decoration-muted="state in ('revoked', 'suspended')">
                <field name="person_id"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
                <field name="partner_id"/>
                <field name="valid_to"/>
            </list>
        </field>
    </record>

    <record id="view_step_app_membership_form" model="ir.ui.view">
        <field name="name">step.app.membership.form</field>
        <field name="model">step.app.membership</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Aprobar / reactivar" class="btn-primary" invisible="state not in ('requested', 'invited', 'suspended')"/>
                    <button name="action_suspend" type="object" string="Suspender" invisible="state != 'active'"/>
                    <button name="action_revoke" type="object" string="Revocar" invisible="state in ('revoked',)" confirm="Se revocarán también todas sus concesiones. ¿Continuar?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="person_id"/>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="request_note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Módulos y roles">
                            <field name="grant_ids">
                                <list editable="bottom">
                                    <field name="module_id"/>
                                    <field name="role_id"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="revoked_at"/>
                                    <field name="active_now"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_step_app_membership" model="ir.actions.act_window">
        <field name="name">Membresías y accesos</field>
        <field name="res_model">step.app.membership</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_requested': 1}</field>
    </record>

    <record id="view_step_app_membership_search" model="ir.ui.view">
        <field name="name">step.app.membership.search</field>
        <field name="model">step.app.membership</field>
        <field name="arch" type="xml">
            <search>
                <field name="person_id"/>
                <field name="company_id"/>
                <filter name="requested" string="Solicitudes" domain="[('state', '=', 'requested')]"/>
                <filter name="active" string="Activas" domain="[('state', '=', 'active')]"/>
            </search>
        </field>
    </record>

    <record id="view_step_app_invitation_list" model="ir.ui.view">
        <field name="name">step.app.invitation.list</field>
        <field name="model">step.app.invitation</field>
        <field name="arch" type="xml">
            <list>
                <field name="email"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
                <field name="expires_at"/>
            </list>
        </field>
    </record>

    <record id="view_step_app_invitation_form" model="ir.ui.view">
        <field name="name">step.app.invitation.form</field>
        <field name="model">step.app.invitation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_issue_token" type="object" string="Emitir código" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="email"/>
                        <field name="company_id"/>
                        <field name="expires_at"/>
                        <field name="membership_id"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="role_id"/>
                            <field name="valid_to"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_app_invitation" model="ir.actions.act_window">
        <field name="name">Invitaciones</field>
        <field name="res_model">step.app.invitation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
