<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_app_grant_wizard_form" model="ir.ui.view">
        <field name="name">step.app.grant.wizard.form</field>
        <field name="model">step.app.grant.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="membership_id" invisible="1"/>
                    <field name="person_id"/>
                    <field name="company_id"/>
                    <field name="role_ids" widget="many2many_tags"/>
                    <field name="valid_from"/>
                    <field name="valid_to"/>
                    <field name="approve"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Asignar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
