<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="step_support_assistant.Bubble">
        <div class="steps-assistant-floating">
            <section t-if="state.mounted" t-att-class="'steps-assistant-panel ' + (state.open ? '' : 'd-none')" role="region" aria-label="Asistente Steps flotante" t-on-keydown="keydown">
                <div class="steps-assistant-panel-bar"><strong>Ayuda y consultas de Odoo</strong><button type="button" class="btn" aria-label="Cerrar asistente" t-on-click="close"><i class="fa fa-times" aria-hidden="true"/></button></div>
                <StepsAssistant/>
            </section>
            <button type="button" class="steps-assistant-bubble" t-ref="bubbleButton" aria-label="Abrir o cerrar Asistente Steps" t-att-aria-expanded="state.open ? 'true' : 'false'" t-on-click="toggle"><i t-att-class="state.open ? 'fa fa-times' : 'fa fa-comments-o'" aria-hidden="true"/><span>Ayuda</span></button>
        </div>
    </t>
    <t t-name="step_support_assistant.Launcher">
        <div class="o_systray_item"><button type="button" class="btn border-0" title="Ayuda Steps" aria-label="Consultar al asistente Steps" t-on-click="open"><i class="fa fa-comments-o" aria-hidden="true"/></button></div>
    </t>
    <t t-name="step_support_assistant.Chat">
        <div class="steps-assistant">
            <header class="steps-assistant-header">
                <div><span class="steps-assistant-eyebrow">AYUDA PARA NUESTRO ODOO</span><h1>Asistente Steps</h1><p>Resuelve tus dudas con las guías de nuestro ambiente.</p></div>
                <button type="button" class="btn btn-outline-secondary" t-on-click="newConversation" t-att-disabled="state.busy">Nueva consulta</button>
            </header>
            <div class="steps-assistant-layout">
                <section class="steps-assistant-conversation" aria-label="Conversación de ayuda">
                    <div t-if="state.loading" class="p-3" role="status">Cargando ayuda…</div>
                    <div t-if="!state.loading and !state.ready" class="alert alert-info m-3" role="status">Las consultas de datos y guías están disponibles. Las respuestas de ayuda con IA están pendientes de habilitación.</div>
                    <div class="steps-assistant-data p-3 border-bottom">
                        <button type="button" class="btn btn-outline-secondary" t-on-click="() => { state.dataOpen = !state.dataOpen; }" t-att-aria-expanded="state.dataOpen ? 'true' : 'false'">Consultar datos reales</button>
                        <form t-if="state.dataOpen" class="steps-assistant-data-form mt-2" t-on-submit.prevent="queryData">
                            <label>Aplicación<select class="form-select" t-model="state.app"><option t-foreach="state.catalog" t-as="app" t-key="app.key" t-att-value="app.key" t-esc="app.label"/></select></label>
                            <label>Referencia o código de cuenta<input class="form-control" type="text" maxlength="100" t-model="state.reference" placeholder="Ej. 110101 o INV/2026/001"/></label>
                            <div class="d-flex gap-2"><label>Desde<input class="form-control" type="date" t-model="state.dateFrom"/></label><label>Hasta<input class="form-control" type="date" t-model="state.dateTo"/></label></div>
                            <small>Solo tu compañía actual y tus permisos. El saldo usa asientos publicados; con fecha inicial muestra el movimiento neto del período.</small>
                            <button type="submit" class="btn btn-primary" t-att-disabled="state.busy or state.loading or !state.app">Consultar</button>
                            <p t-if="!state.catalog.length">No hay consultas disponibles con tus permisos.</p>
                        </form>
                    </div>
                    <div class="steps-assistant-transcript" t-ref="transcript" aria-live="polite" role="log" aria-label="Mensajes">
                        <div t-if="!state.messages.length" class="steps-assistant-welcome">
                            <i class="fa fa-comments-o" aria-hidden="true"/><h2>¿En qué necesitas ayuda?</h2>
                            <p>Cuéntame qué quieres hacer, en qué aplicación estás y qué mensaje aparece.</p>
                            <p class="text-muted">Las respuestas incluyen las fuentes utilizadas. Si falta información, te orientaré para consultar a soporte.</p>
                        </div>
                        <article t-foreach="state.messages" t-as="message" t-key="message.id" t-att-class="'steps-assistant-message ' + message.role">
                            <strong t-esc="message.role === 'user' ? 'Tú' : 'Asistente Steps'"/>
                            <p class="steps-assistant-text" t-esc="message.text"/>
                            <div t-if="message.records and message.records.length" class="table-responsive mt-2">
                                <table class="table table-sm"><thead><tr><th t-foreach="message.columns" t-as="column" t-key="column_index" t-esc="column"/><th>Registro</th></tr></thead><tbody><tr t-foreach="message.records" t-as="record" t-key="record.id"><td t-foreach="record.cells" t-as="cell" t-key="cell_index" t-esc="cell"/><td><button type="button" class="btn btn-link p-0" t-on-click="() => this.openRecord(record)">Abrir</button></td></tr></tbody></table>
                            </div>
                            <div t-if="message.sources.length" class="steps-assistant-sources">
                                <span>Fuentes de ayuda</span>
                                <div t-foreach="message.sources" t-as="source" t-key="source.id">
                                    <button type="button" class="btn btn-link text-start p-0" t-on-click="() => this.openArticle(source.id)"><i class="fa fa-file-text-o me-1" aria-hidden="true"/><t t-esc="source.title"/></button>
                                    <blockquote t-if="source.quote" t-esc="source.quote"/>
                                </div>
                            </div>
                        </article>
                        <p t-if="state.busy" class="steps-assistant-thinking" role="status"><i class="fa fa-spinner fa-spin me-2" aria-hidden="true"/>Revisando las fuentes de ayuda…</p>
                    </div>
                    <form class="steps-assistant-composer" t-on-submit.prevent="submit">
                        <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>
                        <div class="steps-assistant-input-row">
                            <textarea aria-label="Escribe tu consulta" t-ref="composer" t-model="state.question" t-on-keydown="onKeydown" rows="2" maxlength="2000" placeholder="Ej. últimos asientos o saldo cuenta 110101 hasta 2026-09-30" t-att-disabled="state.busy or state.loading"/>
                            <button type="submit" class="btn btn-primary" t-att-disabled="state.busy or state.loading or !state.question.trim()">Enviar</button>
                        </div>
                        <small class="steps-assistant-notice" t-esc="state.notice"/>
                    </form>
                </section>
                <aside class="steps-assistant-library" aria-label="Guías disponibles">
                    <h2 t-esc="state.guideProfile === 'accounting' ? 'Guías de contabilidad y tesorería' : 'Guías de este ambiente'"/>
                    <p>También puedes consultarlas directamente.</p>
                    <button t-foreach="state.articles" t-as="article" t-key="article.id" type="button" class="steps-assistant-article" t-on-click="() => this.openArticle(article.id)"><i class="fa fa-file-text-o" aria-hidden="true"/><span t-esc="article.title"/><i class="fa fa-angle-right" aria-hidden="true"/></button>
                    <p t-if="!state.loading and !state.articles.length">Aún no hay guías publicadas para tus permisos.</p>
                    <a href="https://soporte.stepsapp.cl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary mt-3">Contactar a soporte <i class="fa fa-external-link ms-1" aria-hidden="true"/></a>
                </aside>
            </div>
        </div>
    </t>
</templates>
