<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_article_list" model="ir.ui.view">
        <field name="name">step.assistant.article.list</field>
        <field name="model">step.assistant.article</field>
        <field name="arch" type="xml">
            <list string="Artículos de ayuda">
                <field name="name"/>
                <field name="published" widget="boolean_toggle" groups="step_support_assistant.group_assistant_manager"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="module_name" optional="hide"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_article_form" model="ir.ui.view">
        <field name="name">step.assistant.article.form</field>
        <field name="model">step.assistant.article</field>
        <field name="arch" type="xml">
            <form string="Fuente de ayuda">
                <sheet>
                    <div class="alert alert-info" role="status" groups="step_support_assistant.group_assistant_manager">
                        Publique solo instrucciones verificadas para usuarios de este ambiente.
                        Use compañía y grupos para restringir la audiencia. Evite datos personales,
                        contraseñas, respaldos y detalles internos del servidor.
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Título de la ayuda"/></h1></div>
                    <field name="content" placeholder="Pasos, condiciones y resolución de dudas..."/>
                    <group string="Publicación" groups="step_support_assistant.group_assistant_manager">
                        <group>
                            <field name="active"/>
                            <field name="published"/>
                            <field name="company_id"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="keywords"/>
                            <field name="module_name"/>
                            <field name="required_model"/>
                            <field name="provenance"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_articles" model="ir.actions.act_window">
        <field name="name">Artículos de ayuda</field>
        <field name="res_model">step.assistant.article</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Revise las instrucciones aprobadas para nuestro Odoo.</p></field>
    </record>
    <record id="view_usage_list" model="ir.ui.view">
        <field name="name">step.assistant.usage.list</field>
        <field name="model">step.assistant.usage</field>
        <field name="arch" type="xml">
            <list string="Consumo del asistente" create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="status"/>
                <field name="input_tokens" sum="Tokens de entrada"/>
                <field name="output_tokens" sum="Tokens de salida"/>
            </list>
        </field>
    </record>
    <record id="action_usage" model="ir.actions.act_window">
        <field name="name">Consumo del asistente</field>
        <field name="res_model">step.assistant.usage</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
