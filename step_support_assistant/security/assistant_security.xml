<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_assistant_manager" model="res.groups">
        <field name="name">Asistente Steps / Editor de ayuda</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('step_support_assistant.group_assistant_manager'))]"/>
    </record>
    <record id="rule_article_company" model="ir.rule">
        <field name="name">Ayuda: compañías autorizadas</field>
        <field name="model_id" ref="model_step_assistant_article"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_article_reader" model="ir.rule">
        <field name="name">Ayuda: fuentes publicadas para mis grupos</field>
        <field name="model_id" ref="model_step_assistant_article"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('published', '=', True), '|', ('group_ids', '=', False), ('group_ids', 'in', user.groups_id.ids)]</field>
    </record>
    <record id="rule_article_manager" model="ir.rule">
        <field name="name">Ayuda: edición de fuentes</field>
        <field name="model_id" ref="model_step_assistant_article"/>
        <field name="groups" eval="[(4, ref('group_assistant_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
