<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_agricultural_steps" model="ir.module.category">
        <field name="name">Agrícola Steps</field>
        <field name="description">Aplicaciones y funciones agrícolas habilitadas para el usuario.</field>
        <field name="sequence">18</field>
    </record>

    <record id="module_category_agricultural_apps" model="ir.module.category">
        <field name="name">Aplicaciones</field>
        <field name="description">Active únicamente las aplicaciones contratadas por cada cliente.</field>
        <field name="parent_id" ref="step_agricultural_access.module_category_agricultural_steps"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_app_activities" model="res.groups">
        <field name="name">Actividades</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_app_tracker" model="res.groups">
        <field name="name">Steps Tracker</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_app_machinery" model="res.groups">
        <field name="name">Maquinaria</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_app_harvest" model="res.groups">
        <field name="name">Cosecha</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_app_bpa_irrigation" model="res.groups">
        <field name="name">BPA y Riego</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_app_quality" model="res.groups">
        <field name="name">QA-Inspecciones</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_app_labor_protection" model="res.groups">
        <field name="name">Protección Laboral</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('step_labor_protection.group_labor_user'))]"/>
    </record>
    <record id="group_app_management_costs" model="res.groups">
        <field name="name">Gestión y Costos</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('step_management_costs.group_management_user'))]"/>
    </record>
    <record id="group_app_freight" model="res.groups">
        <field name="name">Fletes</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_app_mobilization" model="res.groups">
        <field name="name">Movilización</field>
        <field name="category_id" ref="step_agricultural_access.module_category_agricultural_apps"/>
        <field name="implied_ids" eval="[(4, ref('step_mobilization.group_mobilization_user'))]"/>
    </record>

    <!-- Functional permissions inside each agricultural application. -->
    <record id="category_activities" model="ir.module.category"><field name="name">Actividades</field><field name="parent_id" ref="module_category_agricultural_steps"/><field name="sequence">20</field></record>
    <record id="group_activities_own_staff" model="res.groups"><field name="name">Personal propio</field><field name="category_id" ref="category_activities"/><field name="implied_ids" eval="[(4, ref('group_app_activities'))]"/></record>
    <record id="group_activities_contractors" model="res.groups"><field name="name">Contratistas</field><field name="category_id" ref="category_activities"/><field name="implied_ids" eval="[(4, ref('group_app_activities'))]"/></record>
    <!-- Movilización dejó de ser una sección de Actividades (ver docs/movilizacion).
         Este grupo se conserva como puente de continuidad: cualquier usuario que ya
         lo tuviera asignado conserva acceso, ahora a la app Movilización completa,
         en vez de perder el acceso en el corte. Los perfiles nuevos deben asignarse
         directamente en category_mobilization más abajo. -->
    <record id="group_activities_transport" model="res.groups"><field name="name">Movilización (heredado)</field><field name="category_id" ref="category_activities"/><field name="implied_ids" eval="[(4, ref('group_app_mobilization'))]"/></record>
    <record id="group_activities_reports" model="res.groups"><field name="name">Informes</field><field name="category_id" ref="category_activities"/><field name="implied_ids" eval="[(4, ref('group_app_activities'))]"/></record>
    <record id="group_activities_masters" model="res.groups"><field name="name">Maestros</field><field name="category_id" ref="category_activities"/><field name="implied_ids" eval="[(4, ref('group_app_activities'))]"/></record>
    <record id="group_activities_configuration" model="res.groups"><field name="name">Configuración</field><field name="category_id" ref="category_activities"/><field name="implied_ids" eval="[(4, ref('group_app_activities'))]"/></record>

    <record id="category_tracker" model="ir.module.category"><field name="name">Steps Tracker</field><field name="parent_id" ref="module_category_agricultural_steps"/><field name="sequence">30</field></record>
    <record id="group_tracker_operation" model="res.groups"><field name="name">Operación</field><field name="category_id" ref="category_tracker"/><field name="implied_ids" eval="[(4, ref('group_app_tracker'))]"/></record>
    <record id="group_tracker_reports" model="res.groups"><field name="name">Reportes</field><field name="category_id" ref="category_tracker"/><field name="implied_ids" eval="[(4, ref('group_app_tracker'))]"/></record>
    <record id="group_tracker_masters" model="res.groups"><field name="name">Maestros</field><field name="category_id" ref="category_tracker"/><field name="implied_ids" eval="[(4, ref('group_app_tracker'))]"/></record>
    <record id="group_tracker_web_map" model="res.groups"><field name="name">Mapa Web Tracker</field><field name="category_id" ref="category_tracker"/><field name="implied_ids" eval="[(4, ref('group_app_tracker'))]"/></record>
    <record id="group_tracker_integration" model="res.groups"><field name="name">Integración</field><field name="category_id" ref="category_tracker"/><field name="implied_ids" eval="[(4, ref('group_app_tracker'))]"/></record>

    <record id="category_machinery" model="ir.module.category"><field name="name">Maquinaria</field><field name="parent_id" ref="module_category_agricultural_steps"/><field name="sequence">40</field></record>
    <record id="group_machinery_operation" model="res.groups"><field name="name">Maquinaria</field><field name="category_id" ref="category_machinery"/><field name="implied_ids" eval="[(4, ref('group_app_machinery'))]"/></record>
    <record id="group_machinery_auto_costs" model="res.groups"><field name="name">Costeo y contabilización</field><field name="category_id" ref="category_machinery"/><field name="implied_ids" eval="[(4, ref('group_app_machinery'))]"/></record>
