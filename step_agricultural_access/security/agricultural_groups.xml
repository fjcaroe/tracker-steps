    <record id="category_mobilization" model="ir.module.category"><field name="name">Movilización</field><field name="parent_id" ref="module_category_agricultural_steps"/><field name="sequence">45</field></record>
    <record id="group_mob_operation" model="res.groups"><field name="name">Operación</field><field name="category_id" ref="category_mobilization"/><field name="implied_ids" eval="[(4, ref('group_app_mobilization')), (4, ref('step_mobilization.group_mobilization_operator'))]"/></record>
    <record id="group_mob_contracts" model="res.groups"><field name="name">Contratos</field><field name="category_id" ref="category_mobilization"/><field name="implied_ids" eval="[(4, ref('group_app_mobilization')), (4, ref('step_mobilization.group_mobilization_contract_manager'))]"/></record>
    <record id="group_mob_prevention" model="res.groups"><field name="name">Prevención de riesgos</field><field name="category_id" ref="category_mobilization"/><field name="implied_ids" eval="[(4, ref('group_app_mobilization')), (4, ref('step_mobilization.group_mobilization_prevention'))]"/></record>
    <record id="group_mob_costing" model="res.groups"><field name="name">Costeo</field><field name="category_id" ref="category_mobilization"/><field name="implied_ids" eval="[(4, ref('group_app_mobilization')), (4, ref('step_mobilization.group_mobilization_costing'))]"/></record>
