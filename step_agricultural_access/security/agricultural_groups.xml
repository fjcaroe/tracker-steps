    <record id="group_machinery_reports" model="res.groups"><field name="name">Informes</field><field name="category_id" ref="category_machinery"/><field name="implied_ids" eval="[(4, ref('group_app_machinery'))]"/></record>
    <record id="group_machinery_configuration" model="res.groups"><field name="name">Configuración</field><field name="category_id" ref="category_machinery"/><field name="implied_ids" eval="[(4, ref('group_app_machinery'))]"/></record>

    <record id="category_harvest" model="ir.module.category"><field name="name">Cosecha</field><field name="parent_id" ref="module_category_agricultural_steps"/><field name="sequence">50</field></record>
