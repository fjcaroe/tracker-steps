    <record id="group_harvest_harvest" model="res.groups"><field name="name">Cosecha</field><field name="category_id" ref="category_harvest"/><field name="implied_ids" eval="[(4, ref('group_app_harvest'))]"/></record>
    <record id="group_harvest_post_harvest" model="res.groups"><field name="name">Post cosecha</field><field name="category_id" ref="category_harvest"/><field name="implied_ids" eval="[(4, ref('group_app_harvest'))]"/></record>
    <record id="group_harvest_own" model="res.groups"><field name="name">Cosecha propia</field><field name="category_id" ref="category_harvest"/><field name="implied_ids" eval="[(4, ref('group_app_harvest'))]"/></record>
    <record id="group_harvest_contractors" model="res.groups"><field name="name">Contratistas</field><field name="category_id" ref="category_harvest"/><field name="implied_ids" eval="[(4, ref('group_app_harvest'))]"/></record>
    <record id="group_harvest_reception" model="res.groups"><field name="name">Recepción</field><field name="category_id" ref="category_harvest"/><field name="implied_ids" eval="[(4, ref('group_app_harvest'))]"/></record>
    <record id="group_harvest_masters" model="res.groups"><field name="name">Maestros</field><field name="category_id" ref="category_harvest"/><field name="implied_ids" eval="[(4, ref('group_app_harvest'))]"/></record>
    <record id="group_harvest_configuration" model="res.groups"><field name="name">Configuración</field><field name="category_id" ref="category_harvest"/><field name="implied_ids" eval="[(4, ref('group_app_harvest'))]"/></record>

    <record id="category_bpa" model="ir.module.category"><field name="name">BPA y Riego</field><field name="parent_id" ref="module_category_agricultural_steps"/><field name="sequence">60</field></record>
    <record id="group_bpa_bpa" model="res.groups"><field name="name">BPA</field><field name="category_id" ref="category_bpa"/><field name="implied_ids" eval="[(4, ref('group_app_bpa_irrigation'))]"/></record>
    <record id="group_bpa_irrigation" model="res.groups"><field name="name">Riego y Fertilización</field><field name="category_id" ref="category_bpa"/><field name="implied_ids" eval="[(4, ref('group_app_bpa_irrigation'))]"/></record>
