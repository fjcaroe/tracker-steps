<odoo>
 <record id="paperformat" model="report.paperformat"><field name="name">Instructivo de despacho horizontal</field><field name="format">A3</field><field name="orientation">Landscape</field><field name="margin_top">40</field><field name="margin_bottom">18</field><field name="margin_left">10</field><field name="margin_right">10</field><field name="header_line" eval="False"/><field name="header_spacing">10</field><field name="dpi">90</field></record>
 <record id="instruction_report" model="ir.actions.report"><field name="name">Instructivo de despacho</field><field name="model">step.export.dispatch.order</field><field name="report_type">qweb-pdf</field><field name="report_name">step_packing_dispatch_improvements.instruction</field><field name="binding_model_id" ref="step_export.model_step_export_dispatch_order"/><field name="paperformat_id" ref="paperformat"/><field name="print_report_name">'Instructivo de despacho - %s' % object.name</field></record>
 <template id="instruction"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-set="o" t-value="doc"/><t t-call="web.external_layout"><div class="page" style="font-size:10pt">
  <h2>Instructivo de despacho</h2><table class="table table-sm" style="table-layout:fixed;width:100%"><tbody><tr t-foreach="doc._dispatch_report_header_rows()" t-as="items"><td t-foreach="items" t-as="item" style="width:16.666%;vertical-align:top;overflow-wrap:break-word;padding:5px"><strong style="font-size:8pt"><t t-out="item[0]"/></strong><br/><t t-out="item[1]"/></td><td t-if="len(items) &lt; 6" t-att-colspan="6 - len(items)"/></tr></tbody></table>
  <h3>Carga solicitada</h3><table class="table table-sm" style="font-size:8pt;table-layout:fixed;width:100%"><thead style="display:table-header-group"><tr><th t-foreach="doc._dispatch_report_columns()" t-as="column"><t t-out="column[1]"/></th></tr></thead><tbody><tr t-foreach="doc.load_line_ids" t-as="line" style="page-break-inside:avoid"><td t-foreach="doc._dispatch_report_columns()" t-as="column" style="overflow-wrap:break-word"><t t-out="line[column[0]].display_name if line._fields[column[0]].type == 'many2one' else line[column[0]] or ''"/></td></tr></tbody></table>
  <div style="padding-top:12mm;page-break-inside:avoid"><table class="table table-sm"><tbody><tr><th>Pallets por camión</th><td><span t-field="doc.pallets_per_truck"/></td><th>Cantidad camiones</th><td><span t-field="doc.truck_qty"/></td></tr><tr><th>Pallets</th><td><span t-field="doc.pallet_qty"/></td><th>Cajas</th><td><span t-field="doc.box_qty"/></td><th>Kilos</th><td><span t-field="doc.kg_qty"/></td></tr></tbody></table></div>
 </div></t></t></t></template>
</odoo>
