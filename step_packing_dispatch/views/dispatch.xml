<odoo>
 <record id="instruction_list" model="ir.ui.view"><field name="name">dispatch.instruction.list</field><field name="model">step.export.dispatch.order</field><field name="arch" type="xml"><list string="Instructivos de despacho"><field name="name"/><field name="date"/><field name="shipment_id"/><field name="season_id"/><field name="species_id"/><field name="pallet_qty" sum="Pallets"/><field name="truck_qty"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="instruction_form" model="ir.ui.view"><field name="name">dispatch.instruction.form</field><field name="model">step.export.dispatch.order</field><field name="arch" type="xml"><form string="Instructivo de despacho"><header><button name="action_import_shipment_load" type="object" string="Traer carga del embarque"/><button name="action_create_guide" type="object" string="Crear guía de despacho" class="oe_highlight"/></header><sheet>
  <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Número instructivo despacho"/></h1></div>
  <group><group><field name="shipment_id" required="1"/><field name="species_id"/><field name="vessel_id"/><field name="port_id"/></group><group><field name="date" required="1"/><field name="season_id"/><field name="transport_type"/><field name="receiver_id"/><field name="company_id" groups="base.group_multi_company"/><field name="user_id" optional="hide"/></group></group>
  <notebook><page string="Carga solicitada"><p>Los campos opcionales vacíos permiten cualquier valor. Producto, cajas y kilos por caja deben coincidir con la tarja vigente.</p><field name="load_line_ids"><list editable="bottom"><field name="product_id"/><field name="packaging_id" domain="[('product_id','=',product_id)]"/><field name="producer_id"/><field name="variety_id"/><field name="label"/><field name="caliber_id"/><field name="quality_id"/><field name="pallet_qty" sum="Pallets"/><field name="boxes_per_pallet"/><field name="kg_per_box"/><field name="box_qty" sum="Cajas"/><field name="kg_qty" sum="Kilos"/></list></field><group><group><field name="pallets_per_truck"/><field name="truck_qty"/></group><group><field name="pallet_qty"/><field name="box_qty"/><field name="kg_qty"/></group></group></page><page string="Guías de despacho"><field name="guide_ids" readonly="1"><list><field name="external_folio"/><field name="date"/><field name="truck_plate"/><field name="state"/></list></field></page></notebook>
 </sheet></form></field></record>
 <record id="instructions_action" model="ir.actions.act_window"><field name="name">Instructivos de despacho</field><field name="res_model">step.export.dispatch.order</field><field name="view_mode">list,form</field></record>
 <record id="instructions_list_action" model="ir.actions.act_window.view"><field name="act_window_id" ref="instructions_action"/><field name="view_mode">list</field><field name="view_id" ref="instruction_list"/><field name="sequence">1</field></record>
 <record id="instructions_form_action" model="ir.actions.act_window.view"><field name="act_window_id" ref="instructions_action"/><field name="view_mode">form</field><field name="view_id" ref="instruction_form"/><field name="sequence">2</field></record>
 <record id="guide_form" model="ir.ui.view"><field name="name">guide.dispatch.load</field><field name="model">step.dispatch.guide</field><field name="inherit_id" ref="step_export.view_dispatch_guide_form_export"/><field name="arch" type="xml">
  <field name="step_export_shipment_id" position="after"><field name="dispatch_instruction_id" readonly="state != 'draft'" domain="[('company_id','=',company_id)]" options="{'no_create': True}"/></field>
  <xpath expr="//header" position="inside"><button name="action_load_pallet_detail" type="object" string="Traer detalle de pallets" invisible="not dispatch_instruction_id or state != 'draft'"/><button name="action_create_packing_list" type="object" string="Packing list de la guía" invisible="not dispatch_instruction_id or state == 'cancelled'"/></xpath>
  <xpath expr="//notebook" position="inside"><page name="dispatch_pallets" string="Folio Pallet"><field name="available_load_tag_ids" invisible="1"/><field name="scan_code" placeholder="Escanee o escriba el folio; se admiten varios separados por coma" readonly="state != 'draft'"/><field name="load_tag_ids" domain="[('id','in',available_load_tag_ids)]" readonly="state != 'draft'" options="{'no_create': True}"><list><field name="name"/><field name="step_tag_state"/><field name="step_result_product_id"/><field name="step_packaging_id"/><field name="variedad_id"/><field name="label"/><field name="fruit_caliber_id"/><field name="fruit_quality_id"/><field name="box_count" sum="Cajas"/><field name="step_actual_kg" sum="Kilos"/></list></field></page></xpath>
 </field></record>
 <record id="packing_form" model="ir.ui.view"><field name="name">packing.list.guide.tags</field><field name="model">step.export.packing.list</field><field name="inherit_id" ref="step_export.view_export_packing_list_form"/><field name="arch" type="xml"><field name="tag_ids" position="attributes"><attribute name="readonly">guide_id and guide_has_dispatch_instruction</attribute></field><field name="guide_id" position="after"><field name="guide_has_dispatch_instruction" invisible="1"/></field></field></record>
 <record id="sag_action" model="ir.actions.act_window"><field name="name">Inspecciones SAG</field><field name="res_model">step.packing.inspection</field><field name="view_mode">list,form</field><field name="domain">[('kind','=','sag')]</field><field name="context">{'default_kind':'sag'}</field></record>
 <record id="internal_action" model="ir.actions.act_window"><field name="name">Inspecciones internas</field><field name="res_model">step.packing.inspection</field><field name="view_mode">list,form</field><field name="domain">[('kind','=','internal')]</field><field name="context">{'default_kind':'internal'}</field></record>
 <record id="step_packing_operations.menu_packing_inspection" model="ir.ui.menu"><field name="active" eval="False"/></record>
 <record id="step_packing_operations.menu_packing_dispatch_shipping_instruction" model="ir.ui.menu"><field name="active" eval="False"/></record>
 <record id="step_packing_operations.menu_packing_dispatch_order" model="ir.ui.menu"><field name="name">Instructivo de despacho</field><field name="action" ref="instructions_action"/><field name="sequence">10</field></record>
 <menuitem id="dispatch_menu" name="Despacho" parent="step_packing_operations.menu_packing_operations_dispatch" action="step_dispatch_guide.action_dispatch_guides" sequence="20"/>
 <record id="step_packing_batch.menu_packing_fruta_batch" model="ir.ui.menu"><field name="sequence">40</field></record>
 <menuitem id="inspections_menu" name="Inspecciones" parent="step_packing_operations.menu_packing_operations_root" sequence="45"/>
 <menuitem id="sag_menu" name="Inspecciones SAG" parent="inspections_menu" action="sag_action" sequence="10"/>
 <menuitem id="internal_menu" name="Inspecciones internas" parent="inspections_menu" action="internal_action" sequence="20"/>
</odoo>
