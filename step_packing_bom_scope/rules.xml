<odoo>
    <record id="mrp.mrp_bom_rule" model="ir.rule">
        <field name="domain_force">['|', ('company_id', 'in', company_ids), '&amp;', ('company_id', '=', False), '|', ('step_applicable_company_ids', '=', False), ('step_applicable_company_ids', 'in', company_ids)]</field>
    </record>
    <record id="write_mrp_bom_rule" model="ir.rule">
        <field name="name">Editar listas de materiales con todas sus compañías activas</field>
        <field name="model_id" ref="mrp.model_mrp_bom"/>
        <field name="domain_force">[('step_applicable_company_ids', 'not any', [('id', 'not in', company_ids)])]</field>
        <field name="perm_read" eval="False"/>
    </record>
