<odoo>
        <record id="report_step_by_process_form" model="ir.ui.view">
            <field name="name">report.by.process.wizard.form</field>
            <field name="model">report.by.process.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group invisible="file_name">
                        <group>
                            <field name="employee_ids" widget="many2many_tags" invisible="all_employees"/>
                            <field name="all_employees"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group string="Resultado" invisible="not file_name">
                        <field name="file_name" invisible="1"/>
                        <field name="file" filename="file_name" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Cancelar" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="report_step_by_process_action" model="ir.actions.act_window">
            <field name="name">Labores por trabajador Contratista</field>
            <field name="res_model">report.by.process.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_report_by_process_wizard" parent="step_hr.menu_step_informe_main" sequence="3" action="step_hr.report_step_by_process_action" name="Labores por trabajador Contratista"/>
</odoo>
