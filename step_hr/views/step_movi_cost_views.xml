<odoo>
    <record id="view_step_movi_cost_pivot" model="ir.ui.view">
        <field name="name">step.movi.cost.line.pivot</field>
        <field name="model">step.movi.cost.line</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Costeo Movilizacion" sample="1">
                <field name="date" interval="month" type="col"/>
                <field name="employee_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_step_movi_cost_graph" model="ir.ui.view">
        <field name="name">step.movi.cost.line.graph</field>
        <field name="model">step.movi.cost.line</field>
        <field name="arch" type="xml">
            <graph string="Análisis de Costeo Movilizacion" sample="1">
                <field name="employee_id" type="col"/>
                <field name="fundo_id" type="col"/>
                <field name="vehicle_id" type="col"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_step_movi_cost_list" model="ir.ui.view">
        <field name="name">step.movi.cost.line.list</field>
        <field name="model">step.movi.cost.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="parent_name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="responsable_id" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="cost_id" optional="show"/>
                <field name="recorrido_id" optional="show" />
                <field name="vehicle_id" optional="show"/>
                <field name="chofer_id" optional="show"/>
                <field name="pricelist_id" optional="show"/>
                <field name="cost_in" optional="show"/>
                <field name="cost_out" optional="show"/>
                <field name="cost_total" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_step_movi_cost_search" model="ir.ui.view">
            <field name="name">step.movi.cost.line.search</field>
            <field name="model">step.movi.cost.line</field>
            <field eval="3" name="priority"/>
            <field name="arch" type="xml">
                <search string="Costeo Moovilizacion">
                    <field name="parent_name" filter_domain="[('parent_name', 'ilike', self)]"/>
                    <field name="partner_id" filter_domain="[('partner_id', 'ilike', self)]"/>
                    <field name="fundo_id" filter_domain="[('fundo_id', 'ilike', self)]"/>
                    <filter string="Ingresado" name="in" domain="[('state','=','in')]"/>
                    <filter string="Aprobado" name="apro" domain="[('state','in',('apro'))]"/>
                    <filter string="Contabilizado" name="cont" domain="[('state','=','cont')]"/>
                    <filter string="Fecha" name="today" date="date"/>
                    <group expand="0" string="Group By">
                        <filter string="Contratista" name="partner_id" domain="[]"  context="{'group_by': 'partner_id'}"/>
                        <filter string="Fundo" name="groupby_fundo_id" domain="[]"  context="{'group_by': 'fundo_id'}"/>
                        <filter string="Vehiculo" name="groupby_vehicle_id" domain="[]" context="{'group_by': 'vehicle_id'}"/>
                        <filter string="Trabajador" name="groupby_employee_id" domain="[]" context="{'group_by': 'employee_id'}" groups="stock.group_stock_multi_locations"/>
                        <filter string="Estado" name="status" domain="[]" context="{'group_by': 'state'}"/>
                        <filter string="Fecha" name="groupby_date" domain="[]" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

    <record id="action_view_step_movi_cost" model="ir.actions.act_window">
        <field name="name">Análisis de Costeo Movilizacion</field>
        <field name="res_model">step.movi.cost.line</field>
        <field name="view_mode">pivot,graph,list,kanban</field>
        <field name="search_view_id" ref="step_hr.view_step_movi_cost_search"/>
    </record>

</odoo>
