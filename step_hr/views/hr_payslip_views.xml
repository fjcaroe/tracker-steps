<odoo>
    <record id="hr_payslip_step_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.inherit.hr.payroll.step</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='net_wage']" position="after">
                <field name="net_liquido" string="Alcance Liquido" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
