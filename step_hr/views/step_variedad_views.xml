<odoo>
    <record id="view_step_variedad_form" model="ir.ui.view">
        <field name="name">step.variedad.form</field>
        <field name="model">step.variedad</field>
        <field name="arch" type="xml">
            <form string="Variedad">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cod_variedad"/>
                            <field name="especie_id"/>
                            <field name="grupo_variedad_id"/>
                            <field name="date_init"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <field name="note"/>
                    <notebook colspan="4">
                        <page name='details' string="Detalles">
                            <field name="variedad_line">
                                <list editable="bottom">
                                    <field name="variedad_id" column_invisible="True"/>
                                    <field name="name" optional="show"/>
                                    <field name="labor_id" optional="show"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="uom_trato" optional="show"/>
                                    <field name="hec_rendimiento" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_step_variedad_list" model="ir.ui.view">
        <field name="name">step.variedad.list</field>
        <field name="model">step.variedad</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="cod_variedad" optional="show"/>
                <field name="especie_id" optional="show"/>
                <field name="grupo_variedad_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="date_init" optional="show"/>
                <field name="date_to" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_step_variedad" model="ir.actions.act_window">
        <field name="name">Variedad</field>
        <field name="res_model">step.variedad</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>