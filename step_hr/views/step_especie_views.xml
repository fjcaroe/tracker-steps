<odoo>
    <record id="view_step_especie_form" model="ir.ui.view">
        <field name="name">step.especie.form</field>
        <field name="model">step.especie</field>
        <field name="arch" type="xml">
            <form string="Especie">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cod_especie"/>
                            <field name="date_init"/>
                            <field name="date_end"/>
                            <field name="plan_id"/>
                            <field name="kg_caja"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="type_especie"/>
                            <field name="group_especie"/>
                            <field name="cost_id"/>
                            <field name="plu"/>
                        </group>
                    </group>
                    <field name="note"/>
                    <notebook colspan="4">
                        <page name='details' string="Detalles">
                            <field name="especie_line">
                                <list editable="bottom">
                                    <field name="especie_id" column_invisible="True"/>
                                    <field name="name" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_step_especie_list" model="ir.ui.view">
        <field name="name">step.especie.list</field>
        <field name="model">step.especie</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="cod_especie" optional="show"/>
                <field name="date_init" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="plan_id" optional="show"/>
                <field name="kg_caja" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="type_especie" optional="show"/>
                <field name="cost_id" optional="show"/>
                <field name="plu" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_step_especie" model="ir.actions.act_window">
        <field name="name">Especie</field>
        <field name="res_model">step.especie</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>