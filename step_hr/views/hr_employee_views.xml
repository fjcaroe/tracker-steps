<odoo>
    <record model="ir.ui.view" id="step_view_hr_employee_form">
        <field name="name">step.hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']" position="after">
                <page name='agri' string="Agricola">
                    <group>
                        <label for="step_work_schedule"/>
                        <field name="step_work_schedule"/>
                        <group string="Personal Propio">
                            <field name="is_propio"/>
                            <field name="is_super" invisible="is_propio == False"/>
                            <field name="costo_empresa" invisible="is_propio == False"/>
                            <field name="cost_currency_id" invisible="is_propio == False"/>
                        </group>
                        <group string="Personal de Contratistas">
                            <field name="is_contratista"/>
                            <field name="contratista_id" invisible="is_contratista == False" domain="[('step_contra', '=', True)]" />
                            <field name="is_super_contratista" invisible="is_contratista == False"/>
                            <field name="costo_contratista" invisible="is_contratista == False"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='hr_settings']/group[1]" position="after">
                <group>
                    <group name="movi_group" string="Movilización">
                        <field name="is_movi"/>
                        <field name="recorrido_id" options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
