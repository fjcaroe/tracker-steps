<odoo>
    <record id="view_step_actividad_form" model="ir.ui.view">
        <field name="name">step.actividad.form</field>
        <field name="model">step.actividad</field>
        <field name="arch" type="xml">
            <form string="Actividades">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="cod_actividad"/>
                        </group>
                        <group>
                            <field name="cost_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
<!--                    <notebook colspan="4">-->
<!--                        <page name='details' string="Detalles">-->
<!--                            <field name="actividad_line">-->
<!--                                <list editable="bottom">-->
<!--                                    <field name="actividad_id" column_invisible="True"/>-->
<!--                                    <field name="name" optional="show"/>-->
<!--                                    <field name="labor_id" optional="show"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
<!--                    </notebook>-->
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_step_actividad_list" model="ir.ui.view">
        <field name="name">step.actividad.list</field>
        <field name="model">step.actividad</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="cod_actividad" optional="show"/>
                <field name="company_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_step_actividad" model="ir.actions.act_window">
        <field name="name">Actividades</field>
        <field name="res_model">step.actividad</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>