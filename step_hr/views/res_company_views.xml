<odoo>
    <data>
        <record id="step_views_company_form" model="ir.ui.view">
            <field name="model">res.company</field>
            <field name="name">step.res.company.form</field>
            <field name="inherit_id" ref="base.view_company_form" />
            <field name="arch" type="xml">
                <xpath expr="//group[@name='social_media']" position="before">
                    <group string="Step Actividades" name="step" groups="base.group_no_one">
                        <field name="gratificacion_legal" style="width:15%" invisible="country_id != %(base.cl)d"/>
                        <field name="gratifica" style="width:15%"/>
                        <field name="sema_corrida_legal" invisible="country_code != 'CL'"/>
                        <field name="sema_corrida"/>
                        <field name="step_seguro"/>
                        <field name="step_feriado"/>
                        <field name="step_ias"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>