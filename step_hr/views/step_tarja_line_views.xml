<odoo>
    <record id="view_step_tarja_line_pivot" model="ir.ui.view">
        <field name="name">step.tarja.line.pivot</field>
        <field name="model">step.tarja.line</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Tareas Propias" sample="1">
                <field name="date" interval="month" type="col"/>
                <field name="employee_id" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="view_step_tarja_line_graph" model="ir.ui.view">
        <field name="name">step.tarja.line.graph</field>
        <field name="model">step.tarja.line</field>
        <field name="arch" type="xml">
            <graph string="Análisis de Tareas Propias" sample="1">
                <field name="employee_id" type="col"/>
                <field name="cost_id" type="col"/>
                <field name="fundo_id" type="col"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_step_tarja_line_list" model="ir.ui.view">
        <field name="name">step.tarja.line.list</field>
        <field name="model">step.tarja.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="parent_name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="folio" optional="show"/>
                <field name="super_id" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="contract_id" optional="show"/>
                <field name="cost_id" optional="show" />
                <field name="labor_id" optional="show"/>
                <field name="uom_id" optional="show"/>
                <field name="quantity" optional="show" sum="quantity"/>
                <field name="hrs" optional="show" sum="hrs"/>
                <field name="hrs_extra" optional="show" sum="hrs_extra"/>
                <field name="hrs_total" optional="show" sum="hrs_total"/>
                <field name="cant_minima" optional="show" sum="cant_minima"/>
                <field name="tarifa" optional="show" sum="tarifa"/>
                <field name="total_trato" optional="show" sum="total_trato"/>
                <field name="sueldo_base" optional="show" sum="sueldo_base"/>
                <field name="valor_hrs_extra" optional="show" sum="valor_hrs_extra"/>
                <field name="variable_trato" optional="show" sum="variable_trato"/>
                <field name="sem_corrida" optional="show" sum="sem_corrida"/>
                <field name="sab_dom" optional="show" sum="sab_dom"/>
                <field name="gratifica" optional="show" sum="gratifica"/>
                <field name="cost_sueldo" optional="show" sum="cost_sueldo"/>
                <field name="seguro" optional="show" sum="seguro"/>
                <field name="feriado" optional="show" sum="feriado"/>
                <field name="ias" optional="show" sum="ias"/>
                <field name="cost_empresa" optional="show" sum="cost_empresa"/>
            </list>
        </field>
    </record>

    <record id="view_step_tarja_line_search" model="ir.ui.view">
            <field name="name">step.tarja.line.search</field>
            <field name="model">step.tarja.line</field>
            <field eval="3" name="priority"/>
            <field name="arch" type="xml">
                <search string="Tareas Propias">
                    <field name="parent_name" filter_domain="[('parent_name', 'ilike', self)]"/>
                    <field name="partner_id" filter_domain="[('partner_id', 'ilike', self)]"/>
                    <field name="fundo_id" filter_domain="[('fundo_id', 'ilike', self)]"/>
                    <filter string="Nuevo" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="En progreso" name="progress" domain="[('state','in',('progress'))]"/>
                    <filter string="Listo" name="done" domain="[('state','=','done')]"/>
                    <filter string="Fecha" name="today" date="date"/>
                    <group expand="0" string="Group By">
                        <filter string="Contratista" name="partner_id" domain="[]"  context="{'group_by': 'partner_id'}"/>
                        <filter string="Fundo" name="groupby_fundo_id" domain="[]"  context="{'group_by': 'fundo_id'}"/>
                        <filter string="Supervisor" name="groupby_super_id" domain="[]" context="{'group_by': 'super_id'}"/>
                        <filter string="Trabajador" name="groupby_employee_id" domain="[]" context="{'group_by': 'employee_id'}" groups="stock.group_stock_multi_locations"/>
                        <filter string="Estado" name="status" domain="[]" context="{'group_by': 'state'}"/>
                        <filter string="Fecha" name="groupby_date" domain="[]" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

    <record id="action_view_step_tarja_line" model="ir.actions.act_window">
        <field name="name">Informes de Tareas Propias</field>
        <field name="res_model">step.tarja.line</field>
        <field name="view_mode">pivot,graph,list,kanban</field>
        <field name="domain">[('tarja_type', '=', 'propio')]</field>
        <field name="search_view_id" ref="step_hr.view_step_tarja_line_search"/>
    </record>

</odoo>
