<odoo>
    <record id="view_step_tarja_form" model="ir.ui.view">
        <field name="name">step.tarja.form</field>
        <field name="model">step.tarja</field>
        <field name="arch" type="xml">
            <form string="Tareas">
                <header>
                    <button name="action_in" string="Cambiar a Ingresado"
                            type="object" class="oe_highlight"
                            invisible="state != 'auto'"/>
                    <button name="action_auto" string="Autorizado"
                            type="object" class="oe_highlight"
                            invisible="state != 'in'"/>
                    <button name="action_costeo" string="A Costeo"
                            type="object" class="oe_highlight"
                            invisible="state != 'auto'"/>
                    <button name="action_conta" string="Contabilizar"
                            confirm="Esta Seguro de enviarlo a contabilidad?"
                            type="object" class="oe_highlight"
                            invisible="state != 'costo'"/>
                    <button name="action_to_costeo" string="Devolver a Autorizado"
                            type="object" class="oe_highlight"
                            invisible="state != 'costo'"/>
                    <button name="envio_nomina" string="Enviar a Remuneraciones"
                            type="object" class="oe_highlight"
                            confirm="Esta Seguro de enviar todos los registros a nomina?"
                            invisible="remunera != False or tarja_type == 'contratista'"/>
                    <field name="state" widget="statusbar" nolabel="1" readonly="1" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" invisible="1"/> <!--invisible="tarja_type == 'propio'" domain="[('step_contra', '=', True)]"-->
                            <field name="salary_id" invisible="tarja_type == 'contratista'" domain="[('group_type', '!=', 'contratista'), ('state', '=', 'progress')]"/>
                            <field name="salary_id_contrac" invisible="tarja_type == 'propio'" domain="[('group_type', '!=', 'propio'), ('state', '=', 'progress')]"/>
                            <field name="tarja_type" widget="radio" readonly="1" force_save="1"/>
                            <field name="folio" readonly="1" force_save="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="user_id" invisible="tarja_type == 'contratista'"/>
                            <field name="fundo_id"/>
                            <field name="super_id"/>
                            <field name="auto_id"/>
                            <field name="pricelist_id" domain="[('group_type', '=', tarja_type),('cosecha', '=', False)]"/> <!--invisible="tarja_type == 'propio'"-->
                            <field name="especie_id"/>
                            <field name="grupo_variedad_id_domain" widget="many2many_tags"/>
                            <field name="company_id"/>
                            <field name="gratificacion_legal" invisible="1"/>
                            <field name="sema_corrida_legal" invisible="1"/>
                            <field name="remunera" invisible="remunera == False"/>
                        </group>
                    </group>
                    <field name="note"/>
                    <notebook colspan="4">
                        <page name='tarja_registry' string="Registro" invisible="tarja_type == 'contratista'">
                            <field name="tarja_line">
                                <list editable="bottom">
                                    <field name="tarja_id" column_invisible="True"/>
                                    <field name="employee_id" optional="show"/>
                                    <field name="cost_id_domain" optional="show" widget="many2many_tags" column_invisible="True"/>
                                    <field name="cost_id" optional="show" domain="[('id', 'in', cost_id_domain)]"/>  <!--domain="[('id', 'in', cost_id_domain)]"-->
                                    <field name="labor_id" optional="show" domain="[('is_labor', '=', True)]"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="quantity" optional="show" sum="quantity"/>
                                    <field name="hrs" optional="show" sum="hrs"/>
                                    <field name="hrs_extra" optional="show" sum="hrs_extra"/>
                                    <field name="hrs_total" optional="show" sum="hrs_total"/>
                                </list>
                            </field>
                        </page>
                        <page name='tarja_line' string="Costo" invisible="tarja_type == 'contratista'">
                            <field name="tarja_line">
                                <list editable="bottom">
                                    <field name="tarja_id" column_invisible="True"/>
                                    <field name="employee_id" optional="show"/>
                                    <field name="contract_id" optional="show"/>
                                    <field name="cost_id_domain" optional="show" widget="many2many_tags" column_invisible="True"/>
                                    <field name="cost_id" optional="show" domain="[('id', 'in', cost_id_domain)]"/> <!--domain="[('id', 'in', cost_id_domain)]"-->
                                    <field name="labor_id" optional="show" domain="[('is_labor', '=', True)]"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="quantity" optional="show" sum="quantity"/>
                                    <field name="hrs" optional="show" sum="hrs"/>
                                    <field name="hrs_extra" optional="show" sum="hrs_extra"/>
                                    <field name="hrs_total" optional="show" sum="hrs_total"/>
                                    <field name="cant_minima" optional="show" sum="cant_minima"/>
                                    <field name="tarifa" optional="show" sum="tarifa"/>
                                    <field name="total_trato" optional="show" sum="total_trato"/>
                                    <field name="sueldo_base" optional="show" sum="sueldo_base"/>
                                    <field name="valor_hrs_extra" optional="show" sum="valor_hrs_extra"/>
                                    <field name="variable_trato" optional="show" sum="variable_trato"/>
                                    <field name="sem_corrida" optional="show" sum="sem_corrida" column_invisible="not parent.sema_corrida_legal"/>
                                    <field name="sab_dom" optional="show" sum="sab_dom"/>
                                    <field name="gratifica" optional="show" sum="gratifica" column_invisible="not parent.gratificacion_legal"/>
                                    <field name="cost_sueldo" optional="show" sum="cost_sueldo"/>
                                    <field name="seguro" optional="show" sum="seguro"/>
                                    <field name="feriado" optional="show" sum="feriado"/>
                                    <field name="ias" optional="show" sum="ias"/>
                                    <field name="cost_empresa" optional="show" sum="cost_empresa"/>
                                </list>
                            </field>
                        </page>
                        <page name='tarja_cost_line' string="Detalles" invisible="tarja_type == 'propio'">
                            <field name="tarja_cost_line" create="0">
                                <list editable="bottom">
                                    <field name="tarja_cost_id" column_invisible="True"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="employee_id_domain" optional="show" widget="many2many_tags" column_invisible="True"/>
                                    <field name="employee_id" optional="show" domain="[('id', 'in', employee_id_domain)]"/>
                                    <field name="cost_id_domain" optional="show" widget="many2many_tags" column_invisible="True"/>
                                    <field name="cost_id" optional="show" domain="[('id', 'in', cost_id_domain)]"/>
                                    <field name="labor_id" optional="show" domain="[('is_labor', '=', True)]"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="quantity" optional="show" sum="quantity"/>
                                    <field name="hrs" optional="show" sum="hrs"/>
                                    <field name="cant_minima" optional="show" sum="cant_minima"/>
                                    <field name="tarifa" optional="show" sum="tarifa"/>
                                    <field name="trato_total" optional="show" sum="trato_total"/>
                                </list>
                            </field>
                        </page>
                        <page name='Conta' string="Contabilización" invisible="state not in ['cost','conta']">
                            <group string="Contabilización">
                                <field name="invoice_id" readonly="1" force_save="1"/>
                                <field name="purchase_id" readonly="1" force_save="1" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_step_tarja_list" model="ir.ui.view">
        <field name="name">step.tarja.list</field>
        <field name="model">step.tarja</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="salary_id" optional="show"/>
                <field name="tarja_type" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="folio" optional="show"/>
                <field name="date" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="fundo_id" optional="show"/>
                <field name="super_id" optional="show"/>
                <field name="auto_id" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_step_tarja" model="ir.actions.act_window">
        <field name="name">Registro Tareas</field>
        <field name="res_model">step.tarja</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'step_default_propio':1}</field>
        <field name="domain">[('tarja_type', 'in', ['propio'])]</field>
    </record>

    <record id="action_step_tarja_contratista" model="ir.actions.act_window">
        <field name="name">Registro Tareas Contratistas</field>
        <field name="res_model">step.tarja</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'step_default_contratista':1}</field>
        <field name="domain">[('tarja_type', 'in', ['contratista'])]</field>
    </record>

    <record id="action_step_tarja_costo" model="ir.actions.act_window">
        <field name="name">Costeo de Tarjas</field>
        <field name="res_model">step.tarja</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('tarja_type', 'in', ['propio'])]</field>
    </record>

    <record id="action_step_tarja_cost_contratista" model="ir.actions.act_window">
        <field name="name">Costeo contratista</field>
        <field name="res_model">step.tarja</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('tarja_type', 'in', ['contratista'])]</field>
    </record>

</odoo>
