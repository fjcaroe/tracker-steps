<odoo>
<record id="packaging_native_form" model="ir.ui.view"><field name="name">product.packaging.harvest.native_form</field><field name="model">product.packaging</field><field name="inherit_id" ref="product.product_packaging_form_view"/><field name="arch" type="xml"><xpath expr="//field[@name='barcode']" position="after"><field name="step_packaging_group"/></xpath></field></record>
<record id="packaging_native_list" model="ir.ui.view"><field name="name">product.packaging.harvest.native_list</field><field name="model">product.packaging</field><field name="inherit_id" ref="product.product_packaging_tree_view"/><field name="arch" type="xml"><xpath expr="//field[@name='qty']" position="after"><field name="step_packaging_group"/></xpath></field></record>
<record id="packaging_export_form" model="ir.ui.view"><field name="name">product.packaging.harvest.export_form</field><field name="model">product.packaging</field><field name="inherit_id" ref="step_export.view_step_export_packaging_form"/><field name="arch" type="xml"><xpath expr="//field[@name='qty']" position="after"><field name="step_packaging_group"/></xpath></field></record>
<record id="packaging_export_list" model="ir.ui.view"><field name="name">product.packaging.harvest.export_list</field><field name="model">product.packaging</field><field name="inherit_id" ref="step_export.view_step_export_packaging_list"/><field name="arch" type="xml"><xpath expr="//field[@name='qty']" position="after"><field name="step_packaging_group"/></xpath></field></record>
<record id="packaging_search" model="ir.ui.view"><field name="name">product.packaging.harvest.search</field><field name="model">product.packaging</field><field name="inherit_id" ref="product.product_packaging_search_view"/><field name="arch" type="xml"><xpath expr="//search" position="inside"><field name="step_packaging_group"/><filter name="group_packaging" string="Grupo embalaje" context="{'group_by':'step_packaging_group'}"/></xpath></field></record>
</odoo>