<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_tracker_cost_wizard_form" model="ir.ui.view">
        <field name="name">step.tracker.cost.wizard.form</field>
        <field name="model">step.tracker.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Costos Tracker">
                <field name="state" invisible="1"/>
                <field name="scope" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group invisible="state != 'setup'">
                    <group>
                        <field name="vehicle_id" invisible="scope != 'vehicle'" readonly="1"/>
                        <field name="center_id" invisible="scope != 'center'" readonly="1"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="hourly_metric" invisible="scope != 'vehicle'"/>
                        <field name="refresh_tracker" invisible="scope != 'vehicle'"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="state != 'setup'">
                    Solo lectura: no contabiliza ni modifica gastos. El costo real sale de apuntes publicados; lo pendiente
                    se muestra aparte y lo que no se puede atribuir queda como «información incompleta».
                </div>
                <div invisible="state != 'result'">
                    <group>
                        <group>
                            <field name="vehicle_id" invisible="scope != 'vehicle'" readonly="1"/>
                            <field name="center_id" invisible="scope != 'center'" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not message">
                        <field name="message" readonly="1" nolabel="1"/>
                    </div>
                    <field name="line_ids" readonly="1">
                        <list default_order="sequence" decoration-muted="status == 'info'"
                              decoration-warning="status == 'incomplete'" decoration-danger="status == 'unavailable'">
                            <field name="sequence" column_invisible="1"/>
                            <field name="section"/>
                            <field name="label"/>
                            <field name="value"/>
                            <field name="status" widget="badge" decoration-success="status == 'ok'"
                                   decoration-warning="status == 'incomplete'" decoration-danger="status == 'unavailable'"/>
                            <field name="note"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_compute" type="object" string="Calcular" class="btn-primary" invisible="state != 'setup'"/>
                    <button name="action_back" type="object" string="Cambiar parámetros" invisible="state != 'result'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
