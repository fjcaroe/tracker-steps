<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_colaciones" model="ir.module.category">
        <field name="name">Colaciones</field>
        <field name="description">Registro, planificación y control de colaciones.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_colaciones_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="step_colaciones.module_category_colaciones"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_colaciones_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="step_colaciones.module_category_colaciones"/>
        <field name="implied_ids" eval="[(4, ref('step_colaciones.group_colaciones_user'))]"/>
    </record>

    <record id="rule_colacion_registration_company" model="ir.rule">
        <field name="name">Colaciones: registros por empresa</field>
        <field name="model_id" ref="model_step_colacion_registration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_colaciones.group_colaciones_user'))]"/>
    </record>

    <record id="rule_colacion_totem_company" model="ir.rule">
        <field name="name">Colaciones: tótems por empresa</field>
        <field name="model_id" ref="model_step_colacion_totem"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_colaciones.group_colaciones_user'))]"/>
    </record>

    <record id="rule_colacion_tariff_company" model="ir.rule">
        <field name="name">Colaciones: tarifas por empresa</field>
        <field name="model_id" ref="model_step_colacion_tariff"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_colaciones.group_colaciones_user'))]"/>
    </record>

    <record id="rule_colacion_tariff_line_company" model="ir.rule">
        <field name="name">Colaciones: líneas de tarifa por empresa</field>
        <field name="model_id" ref="model_step_colacion_tariff_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_colaciones.group_colaciones_user'))]"/>
    </record>

    <record id="rule_colacion_plan_company" model="ir.rule">
        <field name="name">Colaciones: planes por empresa</field>
        <field name="model_id" ref="model_step_colacion_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_colaciones.group_colaciones_user'))]"/>
    </record>

    <record id="rule_colacion_plan_line_company" model="ir.rule">
        <field name="name">Colaciones: líneas de plan por empresa</field>
        <field name="model_id" ref="model_step_colacion_plan_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('step_colaciones.group_colaciones_user'))]"/>
    </record>
</odoo>

