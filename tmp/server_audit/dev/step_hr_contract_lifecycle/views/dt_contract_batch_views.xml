<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_dt_batch_list" model="ir.ui.view">
        <field name="name">hr.contract.dt.batch.list</field>
        <field name="model">hr.contract.dt.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_id"/>
                <field name="cae_code"/>
                <field name="contract_count"/>
                <field name="state" widget="badge"/>
                <field name="dt_result" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hr_contract_dt_batch_form" model="ir.ui.view">
        <field name="name">hr.contract.dt.batch.form</field>
        <field name="model">hr.contract.dt.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Prevalidar" invisible="state != 'draft'"/>
                    <button name="action_generate_csv" type="object" string="Generar CSV" class="oe_highlight" invisible="state != 'validated'"/>
                    <button name="action_mark_submitted" type="object" string="Marcar como presentado" invisible="state != 'generated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,generated,submitted,result_recorded"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="job_id"/>
                            <field name="cae_code"/>
                            <field name="contract_count"/>
                        </group>
                        <group>
                            <field name="csv_attachment_id" widget="binary" filename="name" readonly="1"/>
                            <field name="csv_hash" readonly="1"/>
                            <field name="submitted_by" readonly="1"/>
                            <field name="submitted_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Resultado informado por el usuario" invisible="state not in ('submitted','result_recorded')">
                        <field name="dt_result"/>
                        <field name="dt_result_notes"/>
                        <field name="dt_result_attachment_id" widget="binary" filename="dt_result_notes"/>
                    </group>
                    <button name="action_record_result" type="object" string="Registrar resultado"
                            invisible="state != 'submitted'" class="oe_highlight"/>
                    <field name="error_report" readonly="1" invisible="not error_report" widget="text"/>
                    <field name="contract_ids" readonly="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="labor_modality"/>
                            <field name="date_start"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_contract_dt_batch" model="ir.actions.act_window">
        <field name="name">Lotes DT de contratos</field>
        <field name="res_model">hr.contract.dt.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hr_contract_dt_export_wizard_form" model="ir.ui.view">
        <field name="name">hr.contract.dt.export.wizard.form</field>
        <field name="model">hr.contract.dt.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="company_id"/>
                        <field name="fundo_id"/>
                        <field name="department_id"/>
                    </group>
                    <group>
                        <field name="job_id"/>
                        <field name="contract_type_id"/>
                        <field name="labor_modality"/>
                        <field name="state"/>
                    </group>
                </group>
                <field name="matched_contract_ids" readonly="1" invisible="not matched_contract_ids">
                    <list>
                        <field name="employee_id"/>
                        <field name="job_id"/>
                        <field name="labor_modality"/>
                    </list>
                </field>
                <footer>
                    <button name="action_search" type="object" string="Buscar" class="oe_highlight"/>
                    <button name="action_create_batches" type="object" string="Crear lotes DT (agrupados por Cargo+CAE)" class="oe_highlight"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_contract_dt_export_wizard" model="ir.actions.act_window">
        <field name="name">Emisión masiva DT — Contratos</field>
        <field name="res_model">hr.contract.dt.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
