<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_labor_template_list" model="ir.ui.view">
        <field name="name">hr.labor.template.list</field>
        <field name="model">hr.labor.template</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'obsolete'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="modality"/>
                <field name="version"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hr_labor_template_form" model="ir.ui.view">
        <field name="name">hr.labor.template.form</field>
        <field name="model">hr.labor.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check_variables" type="object" string="Validar variables"/>
                    <button name="action_preview" type="object" string="Vista previa" class="oe_highlight"/>
                    <button name="action_validate" type="object" string="Validar plantilla" invisible="state != 'draft'"/>
                    <button name="action_new_version" type="object" string="Nueva versión"/>
                    <button name="action_obsolete" type="object" string="Marcar obsoleta" invisible="state == 'obsolete'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: Contrato de temporada"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="modality" invisible="document_type != 'contract'"/>
                            <field name="company_id"/>
                            <field name="version" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="lang"/>
                            <field name="approval_responsible_id"/>
                            <field name="sequence_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cuerpo del documento">
                            <field name="body_html"/>
                        </page>
                        <page string="Notas legales">
                            <field name="legal_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_labor_template_preview_form" model="ir.ui.view">
        <field name="name">hr.labor.template.preview.form</field>
        <field name="model">hr.labor.template.preview</field>
        <field name="arch" type="xml">
            <form>
                <field name="template_id" readonly="1" invisible="1"/>
                <field name="preview_html" readonly="1"/>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_labor_template" model="ir.actions.act_window">
        <field name="name">Plantillas laborales</field>
        <field name="res_model">hr.labor.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hr_labor_document_list" model="ir.ui.view">
        <field name="name">hr.labor.document.list</field>
        <field name="model">hr.labor.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="document_type"/>
                <field name="employee_id"/>
                <field name="template_id"/>
                <field name="template_version"/>
                <field name="generated_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hr_labor_document_form" model="ir.ui.view">
        <field name="name">hr.labor.document.form</field>
        <field name="model">hr.labor.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_to_sign" type="object" string="Enviar a firma" invisible="state != 'generated'"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="employee_id"/>
                            <field name="contract_id"/>
                        </group>
                        <group>
                            <field name="template_id" readonly="1"/>
                            <field name="template_version" readonly="1"/>
                            <field name="generated_by" readonly="1"/>
                            <field name="generated_date" readonly="1"/>
                            <field name="pdf_hash" readonly="1"/>
                        </group>
                    </group>
                    <field name="pdf_attachment_id" widget="binary" filename="name" readonly="1"/>
                    <group string="Cancelación" invisible="state != 'cancelled'">
                        <field name="cancel_reason"/>
                    </group>
                    <notebook>
                        <page string="Contenido">
                            <field name="rendered_body_html" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_labor_document" model="ir.actions.act_window">
        <field name="name">Documentos generados</field>
        <field name="res_model">hr.labor.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
