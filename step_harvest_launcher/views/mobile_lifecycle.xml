<odoo>
    <record id="view_harvest_lifecycle" model="ir.ui.view">
        <field name="name">step.cosecha.registry.harvest.lifecycle</field>
        <field name="model">step.cosecha.registry</field>
        <field name="inherit_id" ref="step_cosecha.view_step_cosecha_registry_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='folio']" position="after">
                <field name="mobile_work_order" readonly="1" invisible="not mobile_work_order"/>
                <field name="mobile_status" readonly="1" invisible="not mobile_work_order and not mobile_state_date"/>
                <field name="mobile_approver_id" domain="[('active','=',True),('share','=',False),('company_ids','in',[company_id])]" readonly="mobile_status in ('reviewed','sent')"/>
                <field name="mobile_approved_by_id" invisible="not mobile_approved_by_id"/>
                <field name="mobile_approved_at" invisible="not mobile_approved_at"/>
                <field name="mobile_state_date" invisible="not mobile_state_date"/>
                <field name="mobile_state_user_id" invisible="not mobile_state_user_id"/>
            </xpath>
        </field>
    </record>
</odoo>
