<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="packaging_tare_form" model="ir.ui.view">
    <field name="name">packing.packaging.tare.form</field>
    <field name="model">product.packaging</field>
    <field name="inherit_id" ref="step_export.view_step_export_packaging_form"/>
    <field name="arch" type="xml">
      <field name="step_export_kg_per_box" position="after">
        <field name="step_tare_weight"/>
      </field>
    </field>
  </record>
  <record id="pallet_tare_form" model="ir.ui.view">
    <field name="name">packing.pallet.tare.form</field>
    <field name="model">stock.package.type</field>
    <field name="inherit_id" ref="step_export.view_step_export_package_type_form"/>
    <field name="arch" type="xml">
      <field name="step_export_boxes_per_pallet" position="after">
        <field name="base_weight" string="Tara de pallet"/>
        <field name="weight_uom_name" invisible="1"/>
      </field>
    </field>
  </record>
</odoo>
