<odoo>
 <record id="rules_list" model="ir.ui.view"><field name="name">packing.analytic.rules</field><field name="model">step.packing.analytic.rule</field>
  <field name="arch" type="xml"><list editable="bottom"><field name="company_id" groups="base.group_multi_company"/>
   <field name="plan_id" options="{'no_create':True}"/><field name="apply"/><field name="origin" required="apply"/></list></field></record>
 <record id="rules_action" model="ir.actions.act_window"><field name="name">Planes analíticos de Packing</field>
  <field name="res_model">step.packing.analytic.rule</field><field name="view_mode">list</field>
  <field name="domain">[('company_id','in',allowed_company_ids)]</field></record>
 <menuitem id="rules_menu" name="Planes analíticos" parent="step_packing_operations.menu_packing_config_packing"
  action="rules_action" groups="account.group_account_manager" sequence="6"/>
 <record id="ot_analytics" model="ir.ui.view"><field name="name">packing.ot.analytic.accounting</field><field name="model">step.packing.production</field>
  <field name="inherit_id" ref="step_packing_operations.view_packing_production_form"/><field name="arch" type="xml">
   <xpath expr="//header" position="inside"><button name="action_apply_packing_analytics" type="object" string="Revisar contabilización y analítica"
    groups="account.group_account_user" invisible="state not in ('closed','costed','accounted')"/></xpath>
   <xpath expr="//notebook[@name='fruit_details']" position="inside"><page name="packing_analytics" string="Contabilización y analítica">
    <group><field name="step_analytic_season_id" readonly="state != 'created'" options="{'no_create':True}"/>
     <field name="step_effective_season_id"/><field name="step_analytic_message"/></group>
    <field name="step_analytic_summary" readonly="1"/>
    <field name="step_analytic_reclassification_ids" readonly="1"><list><field name="name"/><field name="ref"/><field name="date"/><field name="state"/></list></field>
   </page></xpath>
  </field></record>
</odoo>
