<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- T51: con step_hr, el centro de costo de Gestión y Costos se administra
         con el mismo formulario/listado de Actividades / Configuración /
         Centro de Costo (pestañas Rendimientos, Datos Agrícolas, Cuarteles). -->
    <record id="step_management_costs.action_cost_center" model="ir.actions.act_window">
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
    <record id="cost_center_list_binding" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="step_management_costs.action_cost_center"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="step_agriculture_core.step_view_account_analytic_account_list"/>
    </record>
    <record id="cost_center_form_binding" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="step_management_costs.action_cost_center"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="step_agriculture_core.step_view_account_analytic_account_form"/>
    </record>
</odoo>
