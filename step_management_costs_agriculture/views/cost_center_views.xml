<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- T51: con step_hr, el centro de costo de Gestión y Costos se administra
         con el mismo formulario/listado de Actividades / Configuración /
         Centro de Costo (pestañas Rendimientos, Datos Agrícolas, Cuarteles). -->
    <record id="step_management_costs.action_cost_center" model="ir.actions.act_window">
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('step_hr.step_view_account_analytic_account_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('step_hr.step_view_account_analytic_account_form')})]"/>
    </record>
    <record id="view_cost_center_form_agriculture" model="ir.ui.view">
        <field name="name">account.analytic.account.form.management.agriculture</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="step_hr.step_view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='datos']" position="inside">
                <group string="Gestión y Costos" name="management_costs">
                    <group>
                        <field name="cost_type"/>
                        <field name="plot"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
