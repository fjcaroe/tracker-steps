<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="step_mobilization_view_fleet_vehicle_form">
        <field name="name">step.mobilization.fleet.vehicle.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_model']" position="inside">
                <group>
                    <group string="Movilización de personal">
                        <field name="step_mobilization_enabled"/>
                        <field name="step_min_pass"/>
                        <field name="step_max_pass"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_step_mobilization_fleet_vehicle" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('step_mobilization_enabled', '=', True)]</field>
        <field name="context">{'default_step_mobilization_enabled': True}</field>
    </record>
</odoo>
