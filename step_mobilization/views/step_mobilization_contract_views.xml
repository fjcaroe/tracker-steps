<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_mobilization_contract_template_list" model="ir.ui.view">
        <field name="name">step.mobilization.contract.template.list</field>
        <field name="model">step.mobilization.contract.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="version"/>
                <field name="is_validated"/>
            </list>
        </field>
    </record>

    <record id="view_step_mobilization_contract_template_form" model="ir.ui.view">
        <field name="name">step.mobilization.contract.template.form</field>
        <field name="model">step.mobilization.contract.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" string="Marcar como revisada" type="object"
                            class="oe_highlight" invisible="is_validated"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="version"/>
                        <field name="is_validated" readonly="1"/>
                        <field name="validated_by_id" readonly="1"/>
                        <field name="validated_date" readonly="1"/>
                    </group>
                    <field name="body"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_step_mobilization_contract_template" model="ir.actions.act_window">
        <field name="name">Plantillas de contrato</field>
        <field name="res_model">step.mobilization.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_step_mobilization_contract_form" model="ir.ui.view">
        <field name="name">step.mobilization.contract.form</field>
        <field name="model">step.mobilization.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Enviar a revisión" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprobar" type="object" class="oe_highlight"
                            invisible="state != 'review'"/>
                    <button name="action_activate" string="Marcar vigente" type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_generate_pdf" string="Emitir PDF" type="object" class="oe_highlight"
                            invisible="state not in ('approved', 'active')"/>
                    <button name="action_terminate" string="Terminar" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('cancelled', 'terminated')"/>
                    <field name="state" widget="statusbar" nolabel="1" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                            <field name="city"/>
                            <field name="contract_date"/>
                            <field name="season_label"/>
                            <field name="service_name"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="responsible_user_id"/>
                            <field name="inspector_name"/>
                            <field name="arbitrator_name"/>
                            <field name="pdf_generated" readonly="1"/>
                        </group>
                    </group>
                    <group string="Representantes">
                        <group>
                            <field name="company_representative_name"/>
                            <field name="company_representative_id_number"/>
                            <field name="company_representative_role"/>
                        </group>
                        <group>
                            <field name="transporter_representative_name"/>
                            <field name="transporter_representative_id_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Alcance">
                            <field name="route_ids" widget="many2many_tags"/>
                            <field name="vehicle_ids" widget="many2many_tags"/>
                            <field name="driver_partner_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Tarifas congeladas" invisible="not pdf_generated">
                            <field name="rate_snapshot_ids" readonly="1">
                                <list>
                                    <field name="route_name"/>
                                    <field name="direction"/>
                                    <field name="min_passengers"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_step_mobilization_contract_list" model="ir.ui.view">
        <field name="name">step.mobilization.contract.list</field>
        <field name="model">step.mobilization.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_step_mobilization_contract" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">step.mobilization.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
