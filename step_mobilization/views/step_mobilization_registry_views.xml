<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_movi_registry_form" model="ir.ui.view">
        <field name="name">step.movi.registry.form</field>
        <field name="model">step.movi.registry</field>
        <field name="arch" type="xml">
            <form string="Viaje de movilización">
                <header>
                    <button name="action_open" string="Abrir" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Cerrar" type="object" class="oe_highlight"
                            invisible="state != 'open'"/>
                    <button name="action_validate" string="Validar" type="object" class="oe_highlight"
                            invisible="state != 'closed'"/>
                    <button name="action_costeo" string="Costear" type="object" class="oe_highlight"
                            invisible="state != 'validated'"/>
                    <button name="action_to_costeo" string="Devolver a validado" type="object"
                            invisible="state != 'costed'"/>
                    <button name="action_conta" string="Contabilizar" type="object" class="oe_highlight"
                            invisible="state != 'costed'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('cancelled', 'accounted')"/>
                    <field name="state" widget="statusbar" nolabel="1" readonly="1"
                           statusbar_visible="draft,open,closed,validated,costed,accounted"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not overcapacity">
                        Sobrecupo: <field name="aboard_count" readonly="1"/> a bordo de
                        <field name="capacity" readonly="1"/> asientos.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" force_save="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="recorrido_id"/>
                            <field name="direction"/>
                            <field name="partner_id" domain="[('step_trans_person', '=', True)]"/>
                            <field name="chofer_id" domain="[('transpor_id', '=', partner_id)]"/>
                            <field name="vehicle_id" domain="[('step_mobilization_enabled', '=', True)]"/>
                        </group>
                        <group>
                            <field name="responsable_id"/>
                            <field name="pricelist_id"/>
                            <field name="company_id"/>
                            <field name="origin" readonly="1"/>
                            <field name="uuid" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group invisible="state != 'cancelled'">
                        <field name="cancel_reason"/>
                        <field name="correction_user_id" readonly="1"/>
                    </group>
                    <group string="Seguimiento en línea">
                        <field name="boarded_count" readonly="1"/>
                        <field name="aboard_count" readonly="1"/>
                        <field name="alighted_count" readonly="1"/>
                        <field name="last_gps_at" readonly="1"/>
                        <field name="last_latitude" readonly="1"/>
                        <field name="last_longitude" readonly="1"/>
                    </group>
                    <field name="note"/>
                    <notebook colspan="4">
                        <page name="detail_custom" string="Pasajeros">
                            <field name="movi_line">
                                <list editable="bottom">
                                    <field name="movi_id" column_invisible="True"/>
                                    <field name="employee_id" optional="show"
                                           domain="[('is_movi', '=', True)]" options="{'no_create': True}"/>
                                    <field name="cod_nip" optional="show"/>
                                    <field name="operacion"/>
                                    <field name="hr_in" optional="show"/>
                                    <field name="hr_out" optional="show"/>
                                    <field name="passenger_event_id" optional="hide" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page name="movi_cost_line" string="Costeo" invisible="state not in ['costed','accounted']">
                            <field name="movi_cost_line" readonly="1" force_save="1">
                                <list editable="bottom">
                                    <field name="movi_id" column_invisible="True"/>
                                    <field name="employee_id" optional="show"/>
                                    <field name="cod_nip" optional="show"/>
                                    <field name="cost_id" optional="hide"/>
                                    <field name="labor_id" optional="hide"/>
                                    <field name="recorrido_ent" optional="show"/>
                                    <field name="recorrido_sal" optional="show"/>
                                    <field name="cost_in" optional="show" sum="cost_in"/>
                                    <field name="cost_out" optional="show" sum="cost_out"/>
                                    <field name="cost_total" optional="show" sum="cost_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="movi_cont_line" string="Contabilización" invisible="state not in ['costed','accounted']">
                            <group string="Contabilización">
                                <field name="invoice_id" readonly="1" force_save="1"/>
                                <field name="accounted_once" readonly="1"/>
                            </group>
                        </page>
                        <page name="gps" string="GPS">
                            <field name="gps_point_ids" readonly="1">
                                <list>
                                    <field name="device_datetime"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="accuracy"/>
                                    <field name="speed"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_step_movi_registry_list" model="ir.ui.view">
        <field name="name">step.movi.registry.list</field>
        <field name="model">step.movi.registry</field>
        <field name="arch" type="xml">
            <list decoration-danger="overcapacity">
                <field name="name" optional="show"/>
                <field name="date" optional="show"/>
                <field name="recorrido_id" optional="show"/>
                <field name="direction" optional="show"/>
                <field name="vehicle_id" optional="show"/>
                <field name="chofer_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="aboard_count" optional="show"/>
                <field name="overcapacity" optional="hide"/>
                <field name="company_id" optional="show"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_step_movi_registry_search" model="ir.ui.view">
        <field name="name">step.movi.registry.search</field>
        <field name="model">step.movi.registry</field>
        <field name="arch" type="xml">
            <search string="Viajes de movilización">
                <field name="name"/>
                <field name="recorrido_id"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="chofer_id"/>
                <filter string="Abiertos" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Sobrecupo" name="overcapacity" domain="[('overcapacity', '=', True)]"/>
                <filter string="Hoy" name="today" date="date"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Recorrido" name="groupby_route" context="{'group_by': 'recorrido_id'}"/>
                    <filter string="Transportista" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Fecha" name="groupby_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_step_movi_registry" model="ir.actions.act_window">
        <field name="name">Viajes / Registro de Movilización</field>
        <field name="res_model">step.movi.registry</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_step_movi_registry_search"/>
    </record>

    <record id="action_step_movi_registry_costeo" model="ir.actions.act_window">
        <field name="name">Costeo Movilización</field>
        <field name="res_model">step.movi.registry</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('state', 'in', ['validated', 'costed'])]</field>
    </record>

    <record id="action_step_movi_registry_open" model="ir.actions.act_window">
        <field name="name">Seguimiento en línea</field>
        <field name="res_model">step.movi.registry</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('state', '=', 'open')]</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
