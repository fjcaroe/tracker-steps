<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_mobilization_driver_device_form" model="ir.ui.view">
        <field name="name">step.mobilization.driver.device.form</field>
        <field name="model">step.mobilization.driver.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_pairing_code" string="Generar código de emparejamiento"
                            type="object" class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_revoke" string="Revocar" type="object"
                            invisible="state == 'revoked'"/>
                    <field name="state" widget="statusbar" nolabel="1" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="chofer_id"/>
                        <field name="company_id"/>
                        <field name="device_uuid" readonly="1"/>
                        <field name="last_seen" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_step_mobilization_driver_device_list" model="ir.ui.view">
        <field name="name">step.mobilization.driver.device.list</field>
        <field name="model">step.mobilization.driver.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="chofer_id"/><field name="device_label"/><field name="state"/><field name="last_seen"/>
            </list>
        </field>
    </record>
    <record id="action_step_mobilization_driver_device" model="ir.actions.act_window">
        <field name="name">Dispositivos móviles</field>
        <field name="res_model">step.mobilization.driver.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
