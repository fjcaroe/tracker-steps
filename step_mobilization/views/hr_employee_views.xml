<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="step_mobilization_view_hr_employee_form">
        <field name="name">step.mobilization.hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='hr_settings']/group[1]" position="after">
                <group>
                    <group name="movi_group" string="Movilización">
                        <field name="is_movi"/>
                        <field name="recorrido_id" options="{'no_create': True}"/>
                        <field name="mobile_credential_uuid" readonly="1" groups="base.group_no_one"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
