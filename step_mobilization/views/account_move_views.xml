<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="step_mobilization_view_account_move_form">
        <field name="name">step.mobilization.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="checked" position="after">
                <field name="moviliza"/>
            </field>
        </field>
    </record>

    <record id="action_step_movi_in_invoice" model="ir.actions.act_window">
        <field name="name">Contabilización Movilización</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('moviliza', '=', True)]</field>
        <field name="context">{'default_move_type': 'entry', 'view_no_maturity': True}</field>
    </record>
</odoo>
