<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_mobilization_document_type_list" model="ir.ui.view">
        <field name="name">step.mobilization.document.type.list</field>
        <field name="model">step.mobilization.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="scope"/>
                <field name="is_blocking"/>
                <field name="reminder_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_step_mobilization_document_type" model="ir.actions.act_window">
        <field name="name">Tipos de documento</field>
        <field name="res_model">step.mobilization.document.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_step_mobilization_document_form" model="ir.ui.view">
        <field name="name">step.mobilization.document.form</field>
        <field name="model">step.mobilization.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="type_id"/>
                            <field name="scope" readonly="1"/>
                            <field name="transporter_id" invisible="scope != 'transportista'"/>
                            <field name="chofer_id" invisible="scope != 'chofer'"/>
                            <field name="vehicle_id" invisible="scope != 'vehiculo'"/>
                            <field name="contract_id" invisible="scope != 'contrato'"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="review_state"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <field name="attachment" filename="attachment_filename"/>
                    <field name="observations"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_step_mobilization_document_list" model="ir.ui.view">
        <field name="name">step.mobilization.document.list</field>
        <field name="model">step.mobilization.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="expiry_date and expiry_date &lt; context_today().strftime('%Y-%m-%d')">
                <field name="type_id"/>
                <field name="scope"/>
                <field name="transporter_id"/>
                <field name="chofer_id"/>
                <field name="vehicle_id"/>
                <field name="expiry_date"/>
                <field name="review_state"/>
            </list>
        </field>
    </record>
    <record id="action_step_mobilization_document" model="ir.actions.act_window">
        <field name="name">Documentos</field>
        <field name="res_model">step.mobilization.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
