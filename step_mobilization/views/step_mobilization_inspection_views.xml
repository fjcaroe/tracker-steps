<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_mobilization_inspection_template_form" model="ir.ui.view">
        <field name="name">step.mobilization.inspection.template.form</field>
        <field name="model">step.mobilization.inspection.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="version"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="category"/>
                            <field name="label"/>
                            <field name="is_critical"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_step_mobilization_inspection_template_list" model="ir.ui.view">
        <field name="name">step.mobilization.inspection.template.list</field>
        <field name="model">step.mobilization.inspection.template</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="version"/></list>
        </field>
    </record>
    <record id="action_step_mobilization_inspection_template" model="ir.actions.act_window">
        <field name="name">Plantillas de inspección</field>
        <field name="res_model">step.mobilization.inspection.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_step_mobilization_inspection_form" model="ir.ui.view">
        <field name="name">step.mobilization.inspection.form</field>
        <field name="model">step.mobilization.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" string="Cerrar inspección" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" nolabel="1" readonly="1"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not has_critical_failure">
                        Falla crítica detectada: bloquea la apertura de viajes con este vehículo.
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="vehicle_id"/>
                            <field name="chofer_id"/>
                            <field name="inspector_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="odometer"/>
                            <field name="location"/>
                            <field name="template_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="category"/>
                            <field name="label"/>
                            <field name="result"/>
                            <field name="is_critical" optional="hide"/>
                            <field name="observation"/>
                        </list>
                    </field>
                    <field name="signature" widget="image"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_step_mobilization_inspection_list" model="ir.ui.view">
        <field name="name">step.mobilization.inspection.list</field>
        <field name="model">step.mobilization.inspection</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'" decoration-warning="state == 'approved_observations'">
                <field name="vehicle_id"/><field name="date"/><field name="inspector_id"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_step_mobilization_inspection" model="ir.actions.act_window">
        <field name="name">Inspecciones de vehículos</field>
        <field name="res_model">step.mobilization.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
