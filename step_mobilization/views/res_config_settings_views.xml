<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_step_mobilization" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.step.mobilization</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="76"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="step_mobilization" string="Movilización" name="step_mobilization">
                    <block title="Contabilidad" name="step_mobilization_contable">
                        <setting id="step_movi_journal_id" help="Diario contable usado al contabilizar viajes de movilización">
                            <field name="step_movi_journal_id" class="o_light_label" options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                        <setting id="step_movi_document_type_id" help="Tipo de documento tributario para la contabilización de movilización">
                            <field name="step_movi_document_type_id" class="o_light_label" options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                    </block>
                    <block title="Aplicación móvil/GPS" name="step_mobilization_mobile">
                        <setting id="step_mobilization_auto_close_session"
                                 help="Si está desactivado, la app sólo ofrece cerrar y el chofer debe confirmar">
                            <field name="step_mobilization_auto_close_session"/>
                        </setting>
                        <setting id="step_mobilization_offline_gps_retention_days"
                                 help="Días que se conservan los puntos GPS crudos antes de purgarse">
                            <field name="step_mobilization_offline_gps_retention_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
