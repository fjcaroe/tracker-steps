<odoo>
    <record id="group_tracker_viewer" model="res.groups">
        <field name="name">Tracker: consultar flota</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_tracker_operator" model="res.groups">
        <field name="name">Tracker: atender incidentes</field>
        <field name="implied_ids" eval="[(4, ref('group_tracker_viewer'))]"/>
    </record>
    <record id="group_tracker_manager" model="res.groups">
        <field name="name">Tracker: administrar protección</field>
        <field name="implied_ids" eval="[(4, ref('group_tracker_operator'))]"/>
    </record>
    <record id="rule_protection_company" model="ir.rule">
        <field name="name">Protección: compañías permitidas</field>
        <field name="model_id" ref="model_step_tracker_protection_summary"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="rule_sync_company" model="ir.rule">
        <field name="name">Sincronización Protección: compañías permitidas</field>
        <field name="model_id" ref="model_step_tracker_protection_sync"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
</odoo>
