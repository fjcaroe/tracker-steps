<odoo>
    <record id="view_move_form_dte_history" model="ir.ui.view">
        <field name="name">account.move.form.steps.dte.history</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="has_documents" invisible="1"/>
                <button name="action_view_documents_account_move" type="object" class="oe_stat_button"
                        icon="fa-file-text-o" string="Documents" invisible="not has_documents"/>
            </xpath>
            <xpath expr="//sheet//field[@name='invoice_date']" position="after">
                <field name="l10n_cl_dte_status" readonly="1" invisible="not l10n_cl_dte_status"/>
                <field name="l10n_cl_dte_file" readonly="1" invisible="not l10n_cl_dte_file" groups="base.group_system"/>
            </xpath>
        </field>
    </record>
</odoo>
