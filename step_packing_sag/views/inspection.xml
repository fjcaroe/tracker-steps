<odoo>
    <record id="sag_list" model="ir.ui.view">
        <field name="name">packing.inspection.sag.prototype.list</field>
        <field name="model">step.packing.inspection</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-warning="state == 'draft' and sag_phase == 'pending'">
                <field name="name"/><field name="production_id"/><field name="sag_country_id"/>
                <field name="date"/><field name="inspector_id"/><field name="sag_phase" column_invisible="True"/><field name="sag_status"/>
                <field name="sag_request_reference" optional="show"/><field name="state" widget="badge"/>
                <field name="certificate_reference" optional="hide"/>
                <field name="sag_prototype" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="sag_form" model="ir.ui.view">
        <field name="name">packing.inspection.sag.prototype.form</field>
        <field name="model">step.packing.inspection</field>
        <field name="arch" type="xml">
            <form string="Inspección SAG">
                <header>
                    <button name="action_sag_ready" type="object" string="Validar preparación" class="btn-primary" invisible="state != 'draft' or not sag_prototype"/>
                    <button name="action_sag_requested" type="object" string="Registrar solicitud externa" invisible="state != 'draft' or not sag_prototype"/>
                    <button name="action_sag_pending" type="object" string="Dejar pendiente de laboratorio" invisible="state != 'draft' or not sag_prototype"/>
                    <button name="action_approve" type="object" string="Registrar aprobación externa" groups="stock.group_stock_manager" invisible="state != 'draft'" confirm="Registre únicamente un resultado ya comunicado por SAG y respaldado en esta inspección. Esta acción no emite un certificado oficial."/>
                    <button name="action_reject" type="object" string="Registrar rechazo externo" groups="stock.group_stock_manager" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Prototipo para QA · Programa Origen SAG</strong><br/>
                        Preparación interna y registro del resultado externo, por un país y un conjunto de tarjas de una OT.
                        El agendamiento, la inspección oficial y la emisión del certificado fitosanitario se realizan ante SAG.
                        Referencia: Manual para Externos v04, 10-07-2024, capítulos 6.3 a 6.5 y 6.10; anexos 2 y 7.
                        Confirme los requisitos vigentes del país antes de cada servicio.
                    </div>
                    <div class="alert alert-warning" invisible="sag_prototype or not id">Registro histórico conservado. Los controles del prototipo se aplican a las nuevas inspecciones SAG.</div>
                    <div class="oe_title"><h1><field name="name" placeholder="Referencia de inspección / lote" readonly="state != 'draft'"/></h1></div>
                    <group>
                        <group string="Lote y trazabilidad">
                            <field name="kind" invisible="1"/><field name="sag_prototype" invisible="1"/>
                            <field name="output_package_ids" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="production_id" readonly="state != 'draft'"/>
                            <field name="sag_packing_id"/><field name="sag_species_id"/><field name="sag_grower_id"/>
                            <field name="package_ids" widget="many2many_tags" domain="[('id','in',output_package_ids)]" readonly="state != 'draft'"/>
                            <label for="package_ids" string="Las tarjas conservan sus productores, lotes y cantidades originales."/>
                        </group>
                        <group string="Destino y servicio">
                            <field name="sag_country_id" readonly="state != 'draft'"/>
                            <field name="sag_counterpart_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="inspector_id" readonly="state != 'draft'"/>
                            <field name="sag_phase" invisible="1"/><field name="sag_status"/>
                            <field name="sag_request_reference" readonly="state != 'draft'"/>
                            <field name="sag_scheduled_at" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preparación documental" name="sag_preparation">
                            <group string="Requisitos específicos del destino">
                                <field name="sag_requirements" placeholder="Fuente, protocolo aplicable, requisitos y fecha de consulta. PFI, carta de responsabilidad, orgánico o reexportación, cuando corresponda." readonly="state != 'draft'"/>
                            </group>
                            <group string="Control interno previo · No constituye una aprobación SAG">
                                <field name="sag_initial" readonly="state != 'draft'"/>
                                <field name="sag_documents" readonly="state != 'draft'"/>
                                <field name="sag_traceability" readonly="state != 'draft'"/>
                                <field name="sag_presentation" readonly="state != 'draft'"/>
                                <field name="sag_packaging" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Muestreo y laboratorio" name="sag_sampling">
                            <p>Registre el muestreo efectuado por el inspector y su criterio según Anexo 7 / requisito del destino. El prototipo no calcula tolerancias ni determina la aceptación sanitaria.</p>
                            <group>
                                <field name="sag_sampling_basis" readonly="state != 'draft'"/>
                                <field name="sag_sample_count" readonly="state != 'draft'"/>
                                <field name="sag_sample_findings" readonly="state != 'draft'"/>
                                <field name="sag_laboratory_reference" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Tratamientos y resguardo" name="sag_treatments">
                            <p>Aplicar solo lo requerido por el destino y autorizado por SAG. Conservar el respaldo del tratamiento, identificación del lote y condiciones de resguardo. Este registro no prescribe dosis, tiempos ni tratamientos.</p>
                            <group><field name="sag_treatment" readonly="state != 'draft'"/>
                                <field name="sag_treatment_detail" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Resultado y respaldos" name="sag_result">
                            <group>
                                <field name="sag_sif_reference" readonly="state != 'draft'"/>
                                <field name="certificate_reference" string="Folio del respaldo externo SAG" readonly="state != 'draft'"/>
                                <field name="observations" readonly="state != 'draft'"/>
                                <field name="sag_evidence_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                                <field name="reviewed_by"/><field name="reviewed_at"/>
                            </group>
                            <p>La aprobación o el rechazo se transcriben desde la SIF y su respaldo. Pendiente de laboratorio conserva el estado borrador y bloquea el despacho para ese destino. Una reevaluación se registra como una nueva inspección.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sag_search" model="ir.ui.view">
        <field name="name">packing.inspection.sag.prototype.search</field><field name="model">step.packing.inspection</field>
        <field name="arch" type="xml"><search>
            <field name="name"/><field name="production_id"/><field name="sag_country_id"/><field name="sag_request_reference"/>
            <filter name="preparation" string="En preparación" domain="[('state','=','draft'),('sag_phase','!=','pending')]"/>
            <filter name="pending_lab" string="Pendiente de laboratorio" domain="[('state','=','draft'),('sag_phase','=','pending')]"/>
            <filter name="approved" string="Aprobadas" domain="[('state','=','approved')]"/>
            <filter name="rejected" string="Rechazadas" domain="[('state','=','rejected')]"/>
            <group><filter name="by_country" string="País" context="{'group_by':'sag_country_id'}"/>
                <filter name="by_state" string="Resultado" context="{'group_by':'state'}"/>
            </group>
        </search></field>
    </record>
    <record id="step_packing_dispatch.sag_action" model="ir.actions.act_window">
        <field name="name">Inspección SAG</field><field name="view_id" ref="sag_list"/>
        <field name="search_view_id" ref="sag_search"/>
    </record>
    <record id="sag_action_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="sag_list"/>
        <field name="act_window_id" ref="step_packing_dispatch.sag_action"/>
    </record>
    <record id="sag_action_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="sag_form"/>
        <field name="act_window_id" ref="step_packing_dispatch.sag_action"/>
    </record>
    <record id="step_packing_dispatch.sag_menu" model="ir.ui.menu"><field name="name">Inspección SAG</field></record>
</odoo>
