<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_step_hr_termination_cause_list" model="ir.ui.view">
        <field name="name">step.hr.termination.cause.list</field>
        <field name="model">step.hr.termination.cause</field>
        <field name="arch" type="xml">
            <list>
                <field name="dt_code"/>
                <field name="articulo"/>
                <field name="name"/>
                <field name="applies_ias_anual" widget="boolean_toggle"/>
                <field name="applies_ias_mensual" widget="boolean_toggle"/>
                <field name="applies_mes_aviso" widget="boolean_toggle"/>
                <field name="requires_certificate" widget="boolean_toggle"/>
                <field name="origin_model"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_step_hr_termination_cause_form" model="ir.ui.view">
        <field name="name">step.hr.termination.cause.form</field>
        <field name="model">step.hr.termination.cause</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="articulo"/>
                            <field name="dt_code"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                            <field name="requires_certificate"/>
                            <field name="notice_deadline_days"/>
                        </group>
                    </group>
                    <group string="Conceptos de finiquito que aplica">
                        <field name="applies_ias_anual"/>
                        <field name="applies_ias_mensual"/>
                        <field name="applies_mes_aviso"/>
                    </group>
                    <group string="Origen (si fue migrada)" invisible="not origin_model">
                        <field name="origin_model" readonly="1"/>
                        <field name="origin_id" readonly="1"/>
                    </group>
                    <field name="description_legal" placeholder="Descripción legal / notas..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_step_hr_termination_cause" model="ir.actions.act_window">
        <field name="name">Causales de término</field>
        <field name="res_model">step.hr.termination.cause</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
