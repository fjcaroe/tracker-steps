<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_operational_budget" model="ir.sequence">
        <field name="name">Presupuesto operacional</field><field name="code">step.management.operational.budget</field>
        <field name="prefix">PPO/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
    <record id="seq_management_plan" model="ir.sequence">
        <field name="name">Plan operacional</field><field name="code">step.management.plan</field>
        <field name="prefix">PLAN/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
    <record id="seq_budget_import" model="ir.sequence">
        <field name="name">Carga de presupuesto Excel</field><field name="code">step.management.budget.import</field>
        <field name="prefix">IMP/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
    <record id="seq_estimation" model="ir.sequence">
        <field name="name">Documento de estimación de cosecha</field><field name="code">step.management.estimation</field>
