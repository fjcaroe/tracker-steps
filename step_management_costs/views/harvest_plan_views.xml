<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_harvest_plan_list" model="ir.ui.view">
        <field name="name">step.management.harvest.plan.list</field>
        <field name="model">step.management.harvest.plan</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'superseded'">
                <field name="name"/>
                <field name="estimation_id"/>
                <field name="season"/>
                <field name="center_count"/>
                <field name="total_kg" sum="Total kg"/>
                <field name="total_containers" sum="Total envases"/>
                <field name="revision"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_harvest_plan_form" model="ir.ui.view">
        <field name="name">step.management.harvest.plan.form</field>
        <field name="model">step.management.harvest.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generar"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirmar"
                            class="btn-primary" invisible="state != 'draft' or not line_ids"/>
                    <button name="action_new_revision" type="object" string="Nueva revisión"
                            invisible="state != 'confirmed'"
                            groups="step_management_costs.group_management_approver"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reabrir" invisible="state != 'confirmed'"
                            groups="step_management_costs.group_management_approver"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Confirmado" bg_color="text-bg-success"
                            invisible="state != 'confirmed'"/>
                    <widget name="web_ribbon" title="Reemplazado" bg_color="text-bg-secondary"
                            invisible="state != 'superseded'"/>
                    <div class="oe_title">
                        <span class="text-uppercase text-muted small fw-bold">Plan de cosecha</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="estimation_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="season" readonly="1"/>
                            <field name="date"/>
                            <field name="revision"/>
                            <field name="revision_of_id" invisible="not revision_of_id"/>
                            <field name="superseded_by_id" invisible="not superseded_by_id"/>
                        </group>
                        <group>
                            <field name="container_unit_id" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="round_up_containers" readonly="state != 'draft'"/>
                            <field name="center_count"/>
                            <field name="total_kg"/>
                            <field name="total_containers"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Centro / semana" name="lines">
                            <field name="line_ids" readonly="1">
                                <list default_order="center_id, week_number, id">
                                    <field name="center_id"/>
                                    <field name="species" optional="show"/>
                                    <field name="variety" optional="show"/>
                                    <field name="week_number"/>
                                    <field name="week_label"/>
                                    <field name="kg" sum="Total kg"/>
                                    <field name="containers" sum="Total envases"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Recursos" name="resources">
                            <field name="resource_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="resource_key"/>
                                    <field name="label"/>
                                    <field name="source_type"/>
                                    <field name="source_resource_id"
                                           column_invisible="parent.state != 'draft'"
                                           invisible="source_type != 'resource'"/>
                                    <field name="factor"/>
                                    <field name="rounding_policy"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="is_reusable_container"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="coverage_multiplier"
                                           invisible="not is_reusable_container"/>
                                    <field name="weekly_max_value"
                                           invisible="not is_reusable_container"/>
                                    <field name="target_inventory"
                                           invisible="not is_reusable_container"/>
                                    <field name="on_hand_quantity"
                                           invisible="not is_reusable_container"/>
                                    <field name="inventory_gap"
                                           invisible="not is_reusable_container"
                                           decoration-danger="inventory_gap > 0"/>
                                </list>
                            </field>
                        </page>
                        <page string="Confirmación" name="confirmation" invisible="state == 'draft'">
                            <group>
                                <field name="confirmed_by_id"/>
                                <field name="confirmed_at"/>
                                <field name="confirmation_hash"/>
                                <field name="reopen_reason" invisible="not reopen_reason"/>
                            </group>
                        </page>
                    </notebook>
                    <field name="notes" placeholder="Supuestos del plan de cosecha…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_harvest_plan_search" model="ir.ui.view">
        <field name="name">step.management.harvest.plan.search</field>
        <field name="model">step.management.harvest.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="estimation_id"/>
                <field name="season"/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmados" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Temporada" name="season_g" context="{'group_by': 'season'}"/>
                    <filter string="Estado" name="state_g" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_harvest_plan" model="ir.actions.act_window">
        <field name="name">Plan de cosecha</field>
        <field name="res_model">step.management.harvest.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_harvest_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Genere el plan de cosecha semanal desde una estimación validada.</p>
            <p>Los kilos por centro y semana concilian con el total de la estimación; los
               recursos (envases, personal, maquinaria) se calculan con factores
               configurables por plan (D08).</p>
        </field>
    </record>
</odoo>
