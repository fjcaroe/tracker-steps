<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_operational_budget_list" model="ir.ui.view"><field name="name">step.management.operational.budget.list</field><field name="model">step.management.operational.budget</field><field name="arch" type="xml">
        <list decoration-info="state == 'calculated'" decoration-success="state == 'approved'" decoration-muted="state in ('closed','cancelled')"><field name="name"/><field name="description"/><field name="season"/><field name="date"/><field name="template_id"/><field name="total_hectares" sum="Hectáreas"/><field name="total_amount" sum="Presupuesto"/><field name="cost_per_ha"/><field name="currency_id" column_invisible="True"/><field name="responsible_id" widget="many2one_avatar_user" optional="show"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list>
    </field></record>
    <record id="view_operational_budget_kanban" model="ir.ui.view"><field name="name">step.management.operational.budget.kanban</field><field name="model">step.management.operational.budget</field><field name="arch" type="xml">
        <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false"><field name="name"/><field name="description"/><field name="season"/><field name="template_id"/><field name="total_hectares"/><field name="total_amount"/><field name="currency_id"/><field name="responsible_id"/><field name="state"/><templates><t t-name="card"><div class="d-flex justify-content-between"><strong><field name="name"/></strong><field name="responsible_id" widget="many2one_avatar_user"/></div><div class="fs-5 fw-semibold mt-2"><field name="description"/></div><div class="text-muted"><field name="season"/> · <field name="template_id"/></div><div class="d-flex justify-content-between mt-3"><span><field name="total_hectares"/> ha</span><strong><field name="total_amount" widget="monetary" options="{'currency_field':'currency_id'}"/></strong></div></t></templates></kanban>
    </field></record>
    <record id="view_operational_budget_form" model="ir.ui.view"><field name="name">step.management.operational.budget.form</field><field name="model">step.management.operational.budget</field><field name="arch" type="xml">
        <form string="Presupuesto operacional" delete="false"><header><button name="action_generate_lines" type="object" string="Calcular desde plantilla" class="btn-primary" invisible="state not in ('draft','calculated')"/><button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'calculated'"/><button name="action_close" type="object" string="Cerrar" invisible="state != 'approved'"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ('closed','cancelled')"/><button name="action_set_draft" type="object" string="Volver a borrador" invisible="state not in ('calculated','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,calculated,approved,closed"/></header><sheet>
        <div class="oe_title"><label for="description"/><h1><field name="description" placeholder="Ej.: Presupuesto arándanos temporada 2026/27"/></h1><h2><field name="name"/></h2></div>
        <div class="row g-3 mb-3"><div class="col-lg-4"><div class="card border-0 bg-light h-100 p-3"><span class="text-muted text-uppercase small fw-bold">Superficie</span><span class="fs-2 fw-bold"><field name="total_hectares" readonly="1"/> ha</span></div></div><div class="col-lg-4"><div class="card border-0 bg-light h-100 p-3"><span class="text-muted text-uppercase small fw-bold">Presupuesto total</span><span class="fs-2 fw-bold"><field name="total_amount" widget="monetary" readonly="1"/></span></div></div><div class="col-lg-4"><div class="card border-0 bg-light h-100 p-3"><span class="text-muted text-uppercase small fw-bold">Costo promedio / ha</span><span class="fs-2 fw-bold"><field name="cost_per_ha" widget="monetary" readonly="1"/></span></div></div></div>
        <group><group string="Definición"><field name="template_id" options="{'no_create': True}" readonly="state not in ('draft','calculated')"/><field name="season"/><field name="date"/><field name="currency_id" options="{'no_create': True}"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Responsabilidad"><field name="responsible_id" widget="many2one_avatar_user"/><field name="line_count" readonly="1"/><field name="active" invisible="1"/></group></group>
        <div class="alert alert-info" role="alert" invisible="state not in ('draft','calculated')"><strong>Cómo funciona:</strong> agregue uno o varios centros de costo. Las hectáreas se completan desde cada centro y pueden ajustarse. Luego pulse <em>Calcular desde plantilla</em>.</div>
        <notebook><page string="1. Centros de costo" name="centers"><field name="allocation_ids" readonly="state not in ('draft','calculated')"><list editable="bottom"><field name="center_id"/><field name="registered_hectares" readonly="1"/><field name="hectares" sum="Total hectáreas"/><field name="notes" optional="show"/></list></field></page>
        <page string="2. Detalle extrapolado" name="detail"><field name="line_ids" readonly="state not in ('draft','calculated')"><list create="false" delete="false" decoration-muted="quantity == 0"><field name="center_id"/><field name="category" widget="badge"/><field name="group_id"/><field name="indicator"/><field name="activity" optional="hide"/><field name="product_id" optional="hide"/><field name="uom_id"/><field name="hectares"/><field name="quantity_per_ha"/><field name="quantity" sum="Cantidad total"/><field name="unit_price"/><field name="amount" sum="Presupuesto total"/><field name="currency_id" column_invisible="True"/></list><form><sheet><group><group><field name="center_id"/><field name="category"/><field name="group_id"/><field name="indicator"/><field name="activity"/></group><group><field name="hectares"/><field name="quantity_per_ha"/><field name="quantity"/><field name="uom_id"/><field name="unit_price"/><field name="amount" readonly="1"/><field name="currency_id" invisible="1"/></group></group><separator string="Distribución mensual"/><field name="month_ids"><list editable="bottom"><field name="month"/><field name="quantity"/><field name="unit_price"/><field name="amount" sum="Total" readonly="1"/><field name="currency_id" column_invisible="True"/></list></field></sheet></form></field></page>
        <page string="Notas" name="notes"><field name="notes"/></page></notebook>
        </sheet><chatter/></form>
    </field></record>
    <record id="view_operational_budget_search" model="ir.ui.view"><field name="name">step.management.operational.budget.search</field><field name="model">step.management.operational.budget</field><field name="arch" type="xml"><search><field name="name"/><field name="description"/><field name="season"/><field name="template_id"/><field name="responsible_id"/><filter string="Por aprobar" name="to_approve" domain="[('state','=','calculated')]"/><filter string="Aprobados" name="approved" domain="[('state','=','approved')]"/><filter string="Fecha" name="date" date="date"/><group expand="0" string="Agrupar por"><filter string="Estado" name="state" context="{'group_by':'state'}"/><filter string="Temporada" name="season" context="{'group_by':'season'}"/><filter string="Plantilla" name="template" context="{'group_by':'template_id'}"/></group></search></field></record>
    <record id="action_operational_budget" model="ir.actions.act_window"><field name="name">Presupuestos operacionales</field><field name="res_model">step.management.operational.budget</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_operational_budget_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree un presupuesto desde una plantilla y extrapólelo a uno o varios centros de costo.</p></field></record>
    <record id="action_operational_budget_create" model="ir.actions.act_window"><field name="name">Crear desde plantilla</field><field name="res_model">step.management.operational.budget</field><field name="view_mode">form</field><field name="target">current</field></record>

    <record id="view_budget_line_pivot" model="ir.ui.view"><field name="name">step.management.budget.line.pivot</field><field name="model">step.management.budget.line</field><field name="arch" type="xml"><pivot string="Análisis presupuestario"><field name="center_id" type="row"/><field name="group_id" type="row"/><field name="category" type="col"/><field name="amount" type="measure"/><field name="quantity" type="measure"/><field name="hectares" type="measure"/></pivot></field></record>
    <record id="view_budget_line_graph" model="ir.ui.view"><field name="name">step.management.budget.line.graph</field><field name="model">step.management.budget.line</field><field name="arch" type="xml"><graph string="Presupuesto por grupo" type="bar"><field name="group_id"/><field name="amount" type="measure"/></graph></field></record>
    <record id="view_budget_line_list" model="ir.ui.view"><field name="name">step.management.budget.line.list</field><field name="model">step.management.budget.line</field><field name="arch" type="xml"><list create="false"><field name="budget_id"/><field name="center_id"/><field name="group_id"/><field name="category" widget="badge"/><field name="indicator"/><field name="hectares"/><field name="quantity" sum="Cantidad"/><field name="unit_price"/><field name="amount" sum="Total"/><field name="currency_id" column_invisible="True"/></list></field></record>
    <record id="view_budget_line_search" model="ir.ui.view"><field name="name">step.management.budget.line.search</field><field name="model">step.management.budget.line</field><field name="arch" type="xml"><search><field name="budget_id"/><field name="center_id"/><field name="group_id"/><field name="indicator"/><group expand="0" string="Agrupar por"><filter string="Presupuesto" name="budget" context="{'group_by':'budget_id'}"/><filter string="Centro" name="center" context="{'group_by':'center_id'}"/><filter string="Grupo" name="group" context="{'group_by':'group_id'}"/><filter string="Categoría" name="category" context="{'group_by':'category'}"/></group></search></field></record>
    <record id="action_budget_analysis" model="ir.actions.act_window"><field name="name">Análisis de presupuesto</field><field name="res_model">step.management.budget.line</field><field name="view_mode">pivot,graph,list</field><field name="search_view_id" ref="view_budget_line_search"/></record>

    <record id="view_budget_month_pivot" model="ir.ui.view"><field name="name">step.management.budget.month.pivot</field><field name="model">step.management.budget.month</field><field name="arch" type="xml"><pivot string="Presupuesto mensual"><field name="center_id" type="row"/><field name="group_id" type="row"/><field name="month" type="col"/><field name="amount" type="measure"/><field name="quantity" type="measure"/></pivot></field></record>
    <record id="view_budget_month_graph" model="ir.ui.view"><field name="name">step.management.budget.month.graph</field><field name="model">step.management.budget.month</field><field name="arch" type="xml"><graph string="Presupuesto mensual" type="bar" stacked="1"><field name="month"/><field name="group_id"/><field name="amount" type="measure"/></graph></field></record>
    <record id="action_budget_month_analysis" model="ir.actions.act_window"><field name="name">Distribución mensual</field><field name="res_model">step.management.budget.month</field><field name="view_mode">pivot,graph</field></record>
</odoo>
