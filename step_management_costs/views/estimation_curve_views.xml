<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estimation_curve_list" model="ir.ui.view">
        <field name="name">step.management.estimation.curve.list</field>
        <field name="model">step.management.estimation.curve</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'validated'" decoration-warning="not distribution_complete">
                <field name="code"/>
                <field name="name"/>
                <field name="curve_type" widget="badge"/>
                <field name="total_percentage" sum="Total"/>
                <field name="distribution_complete" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_estimation_curve_form" model="ir.ui.view">
        <field name="name">step.management.estimation.curve.form</field>
        <field name="model">step.management.estimation.curve</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validar 100%"
                            class="btn-primary" invisible="state != 'draft'"
                            groups="step_management_costs.group_management_manager"/>
                    <button name="action_set_draft" type="object" string="Volver a borrador"
                            invisible="state != 'validated'"
                            groups="step_management_costs.group_management_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Validada" bg_color="text-bg-success"
                            invisible="state != 'validated'"/>
                    <div class="oe_title">
                        <span class="text-uppercase text-muted small fw-bold">Curva de estimación</span>
                        <h1><field name="name" placeholder="Ej. Cosecha temprana"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="curve_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="total_percentage" readonly="1"/>
                            <field name="distribution_complete" readonly="1"/>
                            <field name="validated_by_id" invisible="state != 'validated'"/>
                            <field name="validated_at" invisible="state != 'validated'"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="distribution_complete or not line_ids">
                        La distribución todavía no suma 100 %. Puede guardarla como borrador,
                        pero no validarla.
                    </div>
                    <field name="line_ids" readonly="state == 'validated'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="curve_type" column_invisible="True"/>
                            <field name="week_number" string="Semana"
                                   column_invisible="parent.curve_type != 'week'"/>
                            <field name="caliber_group_id"
                                   column_invisible="parent.curve_type != 'caliber'"
                                   options="{'no_create': True}"/>
                            <field name="fruit_class_id"
                                   column_invisible="parent.curve_type != 'class'"
                                   options="{'no_create': True}"/>
                            <field name="dimension_name" readonly="1" optional="hide"/>
                            <field name="percentage" sum="Total %"/>
                        </list>
                    </field>
                    <field name="notes" placeholder="Supuestos y origen de esta curva…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_estimation_curve_search" model="ir.ui.view">
        <field name="name">step.management.estimation.curve.search</field>
        <field name="model">step.management.estimation.curve</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Semanas" name="week" domain="[('curve_type','=','week')]"/>
                <filter string="Calibres" name="caliber" domain="[('curve_type','=','caliber')]"/>
                <filter string="Clases" name="class" domain="[('curve_type','=','class')]"/>
                <filter string="Validadas" name="validated" domain="[('state','=','validated')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo" name="group_type" context="{'group_by':'curve_type'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_estimation_curve" model="ir.actions.act_window">
        <field name="name">Curvas de estimación</field>
        <field name="res_model">step.management.estimation.curve</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_estimation_curve_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Defina una curva de semanas, calibres o clases.</p>
            <p>Cada curva debe sumar exactamente 100 % antes de validarse.</p>
        </field>
    </record>

    <record id="view_estimation_unit_list" model="ir.ui.view">
        <field name="name">step.management.estimation.unit.list</field>
        <field name="model">step.management.estimation.unit</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="code"/><field name="name"/><field name="kg_factor"/><field name="company_id" groups="base.group_multi_company" optional="hide"/><field name="active" optional="hide"/></list>
        </field>
    </record>
    <record id="action_estimation_unit" model="ir.actions.act_window">
        <field name="name">Unidades de estimación</field><field name="res_model">step.management.estimation.unit</field><field name="view_mode">list</field>
    </record>

    <record id="view_fruit_category_list" model="ir.ui.view">
        <field name="name">step.management.fruit.category.list</field><field name="model">step.management.fruit.category</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company" optional="hide"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="action_fruit_category" model="ir.actions.act_window">
        <field name="name">Categorías de fruta</field><field name="res_model">step.management.fruit.category</field><field name="view_mode">list</field>
    </record>

    <record id="view_fruit_class_list" model="ir.ui.view">
        <field name="name">step.management.fruit.class.list</field><field name="model">step.management.fruit.class</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="category_id"/><field name="use_harvest"/><field name="use_packing"/><field name="company_id" groups="base.group_multi_company" optional="hide"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="action_fruit_class" model="ir.actions.act_window">
        <field name="name">Clases de fruta</field><field name="res_model">step.management.fruit.class</field><field name="view_mode">list</field>
    </record>

    <record id="view_caliber_group_list" model="ir.ui.view">
        <field name="name">step.management.caliber.group.list</field><field name="model">step.management.caliber.group</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company" optional="hide"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="action_caliber_group" model="ir.actions.act_window">
        <field name="name">Grupos de calibre</field><field name="res_model">step.management.caliber.group</field><field name="view_mode">list</field>
    </record>

    <record id="view_fruit_caliber_list" model="ir.ui.view">
        <field name="name">step.management.fruit.caliber.list</field><field name="model">step.management.fruit.caliber</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="group_id"/><field name="company_id" groups="base.group_multi_company" optional="hide"/><field name="active" optional="hide"/></list></field>
    </record>
    <record id="action_fruit_caliber" model="ir.actions.act_window">
        <field name="name">Calibres de fruta</field><field name="res_model">step.management.fruit.caliber</field><field name="view_mode">list</field>
    </record>
</odoo>
