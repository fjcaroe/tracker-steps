<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_management_plan_list" model="ir.ui.view"><field name="name">step.management.plan.list</field><field name="model">step.management.plan</field><field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-info="state == 'in_progress'"><field name="name"/><field name="description"/><field name="date_start"/><field name="date_end"/><field name="week_reference"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="budget_id" optional="show"/><field name="progress" widget="progressbar"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_management_plan_calendar" model="ir.ui.view"><field name="name">step.management.plan.calendar</field><field name="model">step.management.plan</field><field name="arch" type="xml"><calendar string="Planificación operacional" date_start="date_start" date_stop="date_end" color="responsible_id" mode="month"><field name="description"/><field name="responsible_id"/><field name="state"/></calendar></field></record>
    <record id="view_management_plan_kanban" model="ir.ui.view"><field name="name">step.management.plan.kanban</field><field name="model">step.management.plan</field><field name="arch" type="xml"><kanban default_group_by="state" quick_create="false" class="o_kanban_small_column"><field name="name"/><field name="description"/><field name="date_start"/><field name="date_end"/><field name="progress"/><field name="responsible_id"/><templates><t t-name="card"><strong><field name="description"/></strong><div class="text-muted"><field name="name"/> · <field name="date_start"/> — <field name="date_end"/></div><div class="mt-2"><field name="progress" widget="progressbar"/></div><footer><field name="responsible_id" widget="many2one_avatar_user"/></footer></t></templates></kanban></field></record>
    <record id="view_management_plan_form" model="ir.ui.view"><field name="name">step.management.plan.form</field><field name="model">step.management.plan</field><field name="arch" type="xml"><form><header><button name="action_plan" type="object" string="Confirmar planificación" class="btn-primary" invisible="state != 'draft'"/><button name="action_start" type="object" string="Iniciar" class="btn-primary" invisible="state != 'planned'"/><button name="action_done" type="object" string="Finalizar" class="btn-primary" invisible="state != 'in_progress'"/><button name="action_cancel" type="object" string="Cancelar" invisible="state in ('done','cancelled')"/><button name="action_set_draft" type="object" string="Volver a borrador" invisible="state != 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,done"/></header><sheet><div class="oe_title"><label for="description"/><h1><field name="description"/></h1><h2><field name="name"/></h2></div><group><group><field name="date_start"/><field name="date_end"/><field name="week_reference"/><field name="responsible_id" widget="many2one_avatar_user"/></group><group><field name="budget_id"/><field name="center_ids" widget="many2many_tags"/><field name="company_id" groups="base.group_multi_company"/><field name="progress" widget="progressbar"/></group></group><notebook><page string="Tareas"><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="date"/><field name="center_id"/><field name="indicator"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="quantity"/><field name="uom_id"/><field name="state" widget="badge"/><field name="notes" optional="show"/></list></field></page><page string="Notas"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_management_plan_search" model="ir.ui.view"><field name="name">step.management.plan.search</field><field name="model">step.management.plan</field><field name="arch" type="xml"><search><field name="description"/><field name="responsible_id"/><field name="center_ids"/><filter string="Abiertos" name="open" domain="[('state','not in',('done','cancelled'))]"/><filter string="Inicio" name="date" date="date_start"/><group expand="0" string="Agrupar por"><filter string="Estado" name="state" context="{'group_by':'state'}"/><filter string="Responsable" name="responsible" context="{'group_by':'responsible_id'}"/></group></search></field></record>
    <record id="action_management_plan" model="ir.actions.act_window"><field name="name">Planificación operacional</field><field name="res_model">step.management.plan</field><field name="view_mode">kanban,list,calendar,form</field><field name="search_view_id" ref="view_management_plan_search"/><field name="context">{'search_default_open':1}</field></record>
</odoo>
