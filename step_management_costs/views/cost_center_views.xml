<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cost_center_list" model="ir.ui.view"><field name="name">step.management.cost.center.list</field><field name="model">step.management.cost.center</field><field name="arch" type="xml">
        <list decoration-muted="not active"><field name="code"/><field name="name"/><field name="cost_type" widget="badge"/><field name="hectares" sum="Total hectáreas"/><field name="farm"/><field name="plot"/><field name="species"/><field name="variety"/><field name="responsible_id" widget="many2one_avatar_user" optional="show"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list>
    </field></record>
    <record id="view_cost_center_form" model="ir.ui.view"><field name="name">step.management.cost.center.form</field><field name="model">step.management.cost.center</field><field name="arch" type="xml">
        <form><sheet><div class="oe_button_box" name="button_box"/><widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/><div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Ej.: Arándano Crunch 2016"/></h1><h2><field name="code" placeholder="Código del centro"/></h2></div>
        <group><group string="Superficie y clasificación"><field name="cost_type"/><field name="hectares"/><field name="company_id" groups="base.group_multi_company"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="active" invisible="1"/></group><group string="Ubicación productiva"><field name="farm"/><field name="plot"/><field name="species"/><field name="variety"/><field name="analytic_account_id"/></group></group><separator string="Notas"/><field name="notes"/></sheet><chatter/></form>
    </field></record>
    <record id="view_cost_center_search" model="ir.ui.view"><field name="name">step.management.cost.center.search</field><field name="model">step.management.cost.center</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="farm"/><field name="species"/><filter string="Productivos" name="productive" domain="[('cost_type','=','crop')]"/><filter string="Con hectáreas" name="with_hectares" domain="[('hectares','&gt;',0)]"/><group expand="0" string="Agrupar por"><filter string="Tipo" name="type" context="{'group_by':'cost_type'}"/><filter string="Fundo" name="farm_group" context="{'group_by':'farm'}"/><filter string="Especie" name="species_group" context="{'group_by':'species'}"/></group></search></field></record>
    <record id="action_cost_center" model="ir.actions.act_window"><field name="name">Centros de costo</field><field name="res_model">step.management.cost.center</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_cost_center_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree centros de costo y registre su superficie para extrapolar presupuestos.</p></field></record>
</odoo>
