<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- T51: el centro de costo de Gestión y Costos es la cuenta analítica
         (account.analytic.account). Se agregan sus campos de gestión al
         formulario y al buscador estándar. -->
    <record id="view_cost_center_form" model="ir.ui.view">
        <field name="name">account.analytic.account.form.management</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="management_costs" string="Gestión y Costos">
                    <group>
                        <field name="cost_type"/>
                        <field name="hectares"/>
                        <field name="plants"/>
                    </group>
                    <group>
                        <field name="farm"/>
                        <field name="plot"/>
                        <field name="species"/>
                        <field name="variety"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_cost_center_search" model="ir.ui.view">
        <field name="name">account.analytic.account.search.management</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Productivos" name="productive" domain="[('cost_type','=','crop')]"/>
                <filter string="Con hectáreas" name="with_hectares" domain="[('hectares','&gt;',0)]"/>
                <group expand="0" string="Agrupar por (Gestión y Costos)">
                    <filter string="Tipo de costo" name="cost_type_group" context="{'group_by':'cost_type'}"/>
                    <filter string="Fundo" name="farm_group" context="{'group_by':'farm'}"/>
                    <filter string="Especie" name="species_group" context="{'group_by':'species'}"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="action_cost_center" model="ir.actions.act_window">
        <field name="name">Centros de costo</field>
        <field name="res_model">account.analytic.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree centros de costo (cuentas analíticas) y registre su superficie para extrapolar presupuestos.</p></field>
    </record>
</odoo>
