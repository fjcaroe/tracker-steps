<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_template_list" model="ir.ui.view"><field name="name">step.management.budget.template.list</field><field name="model">step.management.budget.template</field><field name="arch" type="xml">
        <list decoration-success="state == 'active'" decoration-muted="state == 'archived'"><field name="name"/><field name="version"/><field name="species"/><field name="base_hectares"/><field name="line_count"/><field name="total_per_ha" sum="Costo/ha"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list>
    </field></record>
    <record id="view_budget_template_kanban" model="ir.ui.view"><field name="name">step.management.budget.template.kanban</field><field name="model">step.management.budget.template</field><field name="arch" type="xml">
        <kanban class="o_kanban_small_column" sample="1"><field name="name"/><field name="version"/><field name="species"/><field name="line_count"/><field name="total_per_ha"/><field name="currency_id"/><field name="state"/><templates><t t-name="card"><div class="d-flex justify-content-between"><strong class="fs-5"><field name="name"/></strong><field name="state" widget="label_selection"/></div><div class="text-muted mt-2"><field name="species"/> · Versión <field name="version"/></div><div class="d-flex justify-content-between mt-3"><span><field name="line_count"/> indicadores</span><strong><field name="total_per_ha" widget="monetary" options="{'currency_field':'currency_id'}"/> / ha</strong></div></t></templates></kanban>
    </field></record>
    <record id="view_budget_template_form" model="ir.ui.view"><field name="name">step.management.budget.template.form</field><field name="model">step.management.budget.template</field><field name="arch" type="xml">
        <form string="Plantilla de presupuesto"><header><button name="action_activate" type="object" string="Publicar plantilla" class="btn-primary" invisible="state != 'draft'"/><button name="action_set_draft" type="object" string="Volver a borrador" invisible="state != 'active'"/><button name="action_archive_template" type="object" string="Archivar" invisible="state == 'archived'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/></header><sheet>
        <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Ej.: Arándanos estándar temporada 2026/27"/></h1></div>
        <group><group string="Identificación"><field name="version"/><field name="species"/><field name="company_id" groups="base.group_multi_company"/><field name="currency_id"/></group><group string="Base de cálculo"><field name="base_hectares"/><field name="expected_yield_kg_ha"/><field name="line_count" readonly="1"/><field name="total_per_ha" readonly="1"/></group></group>
        <div class="alert alert-info" role="alert"><strong>Plantilla por hectárea.</strong> Las cantidades se multiplicarán por las hectáreas de cada centro de costo seleccionado al crear el presupuesto.</div>
        <notebook><page string="Indicadores y costos" name="indicators"><field name="line_ids" context="{'default_template_id': id}"><list editable="bottom"><field name="sequence" widget="handle"/><field name="category" widget="badge"/><field name="group_id"/><field name="indicator"/><field name="activity" optional="show"/><field name="product_id" optional="hide"/><field name="uom_id"/><field name="base_quantity"/><field name="quantity_per_ha" readonly="1"/><field name="unit_price"/><field name="cost_per_ha" sum="Total por ha" readonly="1"/><field name="currency_id" column_invisible="True"/></list><form><sheet><group><group><field name="category"/><field name="group_id"/><field name="indicator"/><field name="activity"/><field name="product_id"/><field name="uom_id"/></group><group><field name="base_quantity"/><field name="quantity_per_ha" readonly="1"/><field name="unit_price"/><field name="cost_per_ha" readonly="1"/><field name="currency_id" invisible="1"/></group></group><separator string="Distribución mensual por hectárea"/><group col="12"><field name="may"/><field name="jun"/><field name="jul"/><field name="aug"/><field name="sep"/><field name="oct"/><field name="nov"/><field name="dec"/><field name="jan"/><field name="feb"/><field name="mar"/><field name="apr"/></group><field name="notes"/></sheet></form></field></page><page string="Supuestos" name="notes"><field name="notes"/></page></notebook>
        </sheet><chatter/></form>
    </field></record>
    <record id="view_budget_template_search" model="ir.ui.view"><field name="name">step.management.budget.template.search</field><field name="model">step.management.budget.template</field><field name="arch" type="xml"><search><field name="name"/><field name="species"/><filter string="Vigentes" name="active_templates" domain="[('state','=','active')]"/><group expand="0" string="Agrupar por"><filter string="Estado" name="state" context="{'group_by':'state'}"/><filter string="Especie/uso" name="species" context="{'group_by':'species'}"/></group></search></field></record>
    <record id="action_budget_template" model="ir.actions.act_window"><field name="name">Plantillas de presupuesto</field><field name="res_model">step.management.budget.template</field><field name="view_mode">kanban,list,form</field><field name="search_view_id" ref="view_budget_template_search"/><field name="context">{'search_default_active_templates':1}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Cree una plantilla reutilizable con indicadores y costos por hectárea.</p></field></record>
</odoo>
