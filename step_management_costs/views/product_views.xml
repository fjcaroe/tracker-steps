<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_form_management" model="ir.ui.view">
        <field name="name">product.category.form.management.budget.group</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="management_budget_group_id"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_form_management" model="ir.ui.view">
        <field name="name">product.template.form.management.budget.group</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="management_budget_group_id"
                       groups="step_management_costs.group_management_user"/>
            </field>
        </field>
    </record>
</odoo>
