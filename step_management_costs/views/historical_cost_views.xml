<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_historical_cost_list" model="ir.ui.view"><field name="name">step.management.historical.cost.list</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><list decoration-danger="variance &gt; 0" decoration-success="variance &lt;= 0"><field name="date"/><field name="center_id"/><field name="group_id"/><field name="indicator"/><field name="origin" widget="badge" optional="show"/><field name="dataset_kind" widget="badge" optional="show"/><field name="season" optional="hide"/><field name="locked" optional="hide"/><field name="quantity"/><field name="budget_amount" sum="Presupuestado"/><field name="actual_amount" sum="Real"/><field name="variance" sum="Desviación"/><field name="variance_percent" widget="percentage"/><field name="currency_id" column_invisible="True"/><field name="budget_amount_converted" optional="show"/><field name="actual_amount_converted" optional="show"/><field name="variance_converted" optional="show"/><field name="conversion_currency_id" optional="show"/><field name="conversion_rate_type" optional="show"/></list></field></record>
    <record id="view_historical_cost_form" model="ir.ui.view"><field name="name">step.management.historical.cost.form</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="date"/><field name="center_id"/><field name="group_id"/><field name="indicator"/><field name="quantity"/><field name="origin"/><field name="source_reference"/><field name="source_file" filename="source_filename"/><field name="source_filename" invisible="1"/><field name="locked"/></group><group string="Valores originales"><field name="currency_id"/><field name="budget_amount"/><field name="actual_amount"/><field name="variance" readonly="1"/><field name="variance_percent" widget="percentage" readonly="1"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Conversión monetaria"><field name="conversion_currency_id" options="{'no_create': True}"/><field name="conversion_rate_type"/><field name="conversion_target_value" readonly="1"/><field name="conversion_factor" readonly="1"/><field name="budget_amount_converted" readonly="1"/><field name="actual_amount_converted" readonly="1"/><field name="variance_converted" readonly="1"/><field name="conversion_available" invisible="1"/></group></group><div class="alert alert-warning" role="alert" invisible="conversion_available or not conversion_currency_id"><strong>Falta tipo de cambio estimado.</strong> Regístrelo en Maestros o use la tasa real Odoo.</div><group string="Hecho histórico normalizado (V2 B)" invisible="not dataset_kind"><group><field name="dataset_kind" readonly="1"/><field name="import_batch_id" readonly="1"/><field name="season" readonly="1"/><field name="year" readonly="1"/><field name="month" readonly="1"/><field name="farm" readonly="1"/><field name="species" readonly="1"/><field name="variety" readonly="1"/></group><group><field name="record_type_label" readonly="1" invisible="not record_type_label"/><field name="budget_version" readonly="1" invisible="not budget_version"/><field name="cost_center_type_label" readonly="1"/><field name="origin_label" readonly="1"/><field name="budget_group_label" readonly="1"/><field name="activity_label" readonly="1"/><field name="product_label" readonly="1"/><field name="uom_label" readonly="1"/><field name="source_amount" readonly="1"/><field name="source_exchange_rate" readonly="1"/><field name="source_amount_usd" readonly="1"/></group></group><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="view_historical_cost_pivot" model="ir.ui.view"><field name="name">step.management.historical.cost.pivot</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><pivot string="Presupuesto versus real"><field name="center_id" type="row"/><field name="group_id" type="row"/><field name="date" interval="month" type="col"/><field name="budget_amount" type="measure"/><field name="actual_amount" type="measure"/><field name="variance" type="measure"/></pivot></field></record>
    <record id="view_historical_cost_graph" model="ir.ui.view"><field name="name">step.management.historical.cost.graph</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><graph string="Presupuesto versus real" type="bar"><field name="date" interval="month"/><field name="budget_amount" type="measure"/><field name="actual_amount" type="measure"/></graph></field></record>
    <record id="view_historical_cost_search" model="ir.ui.view"><field name="name">step.management.historical.cost.search</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><search><field name="name"/><field name="center_id"/><field name="group_id"/><filter string="Sobrecosto" name="over" domain="[('variance','&gt;',0)]"/><filter string="Fecha" name="date" date="date"/><group expand="0" string="Agrupar por"><filter string="Centro" name="center" context="{'group_by':'center_id'}"/><filter string="Grupo" name="group" context="{'group_by':'group_id'}"/><filter string="Mes" name="month" context="{'group_by':'date:month'}"/></group></search></field></record>
    <record id="action_historical_cost" model="ir.actions.act_window"><field name="name">Costos históricos</field><field name="res_model">step.management.historical.cost</field><field name="view_mode">list,pivot,graph,form</field><field name="search_view_id" ref="view_historical_cost_search"/></record>
</odoo>
