<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_historical_cost_list" model="ir.ui.view"><field name="name">step.management.historical.cost.list</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><list decoration-danger="variance &gt; 0" decoration-success="variance &lt;= 0"><field name="date"/><field name="center_id"/><field name="group_id"/><field name="indicator"/><field name="quantity"/><field name="budget_amount" sum="Presupuestado"/><field name="actual_amount" sum="Real"/><field name="variance" sum="Desviación"/><field name="variance_percent" widget="percentage"/><field name="currency_id" column_invisible="True"/></list></field></record>
    <record id="view_historical_cost_form" model="ir.ui.view"><field name="name">step.management.historical.cost.form</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="date"/><field name="center_id"/><field name="group_id"/><field name="indicator"/><field name="quantity"/></group><group><field name="currency_id"/><field name="budget_amount"/><field name="actual_amount"/><field name="variance" readonly="1"/><field name="variance_percent" widget="percentage" readonly="1"/><field name="company_id" groups="base.group_multi_company"/></group></group><field name="notes"/></sheet><chatter/></form></field></record>
    <record id="view_historical_cost_pivot" model="ir.ui.view"><field name="name">step.management.historical.cost.pivot</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><pivot string="Presupuesto versus real"><field name="center_id" type="row"/><field name="group_id" type="row"/><field name="date" interval="month" type="col"/><field name="budget_amount" type="measure"/><field name="actual_amount" type="measure"/><field name="variance" type="measure"/></pivot></field></record>
    <record id="view_historical_cost_graph" model="ir.ui.view"><field name="name">step.management.historical.cost.graph</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><graph string="Presupuesto versus real" type="bar"><field name="date" interval="month"/><field name="budget_amount" type="measure"/><field name="actual_amount" type="measure"/></graph></field></record>
    <record id="view_historical_cost_search" model="ir.ui.view"><field name="name">step.management.historical.cost.search</field><field name="model">step.management.historical.cost</field><field name="arch" type="xml"><search><field name="name"/><field name="center_id"/><field name="group_id"/><filter string="Sobrecosto" name="over" domain="[('variance','&gt;',0)]"/><filter string="Fecha" name="date" date="date"/><group expand="0" string="Agrupar por"><filter string="Centro" name="center" context="{'group_by':'center_id'}"/><filter string="Grupo" name="group" context="{'group_by':'group_id'}"/><filter string="Mes" name="month" context="{'group_by':'date:month'}"/></group></search></field></record>
    <record id="action_historical_cost" model="ir.actions.act_window"><field name="name">Costos históricos</field><field name="res_model">step.management.historical.cost</field><field name="view_mode">list,pivot,graph,form</field><field name="search_view_id" ref="view_historical_cost_search"/></record>
</odoo>
