    <record id="module_category_management_costs" model="ir.module.category">
        <field name="name">Gestión y Costos</field><field name="sequence">32</field>
    </record>

    <!-- Perfiles encadenados: consulta ⊂ usuario ⊂ aprobador ⊂ administrador.
         Se conservan los XML IDs group_management_user / group_management_manager. -->
    <record id="group_management_readonly" model="res.groups">
        <field name="name">Consulta de gestión y costos</field>
        <field name="category_id" ref="step_management_costs.module_category_management_costs"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_management_user" model="res.groups">
        <field name="name">Usuario de gestión y costos</field>
        <field name="category_id" ref="step_management_costs.module_category_management_costs"/>
        <field name="implied_ids" eval="[(4, ref('step_management_costs.group_management_readonly'))]"/>
    </record>
    <record id="group_management_approver" model="res.groups">
        <field name="name">Aprobador / Control de gestión y costos</field>
        <field name="category_id" ref="step_management_costs.module_category_management_costs"/>
        <field name="implied_ids" eval="[(4, ref('step_management_costs.group_management_user'))]"/>
    </record>
    <record id="group_management_manager" model="res.groups">
        <field name="name">Administrador de gestión y costos</field>
        <field name="category_id" ref="step_management_costs.module_category_management_costs"/>
        <field name="implied_ids" eval="[(4, ref('step_management_costs.group_management_approver'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('step_management_costs.group_management_manager'))]"/>
    </record>

