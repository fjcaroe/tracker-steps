<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="step_management_costs.Dashboard"><main class="o_step_management_dashboard">
    <div t-if="state.loading" class="o_mgmt_loading"><i class="fa fa-circle-o-notch fa-spin"/> Cargando gestión y costos…</div>
    <div t-elif="state.error" class="o_mgmt_loading"><strong t-esc="state.error"/><button class="btn btn-primary" t-on-click="() => this.loadDashboard()">Reintentar</button></div>
    <t t-else=""><section class="o_mgmt_hero"><div><span>PLANIFICACIÓN Y CONTROL AGRÍCOLA</span><h1>Centro de Gestión y Costos</h1><p>Presupueste por hectárea, planifique operaciones y controle desviaciones.</p></div><div class="o_mgmt_period"><button t-att-class="state.days === 30 ? 'active':''" t-on-click="() => this.loadDashboard(30)">30 días</button><button t-att-class="state.days === 90 ? 'active':''" t-on-click="() => this.loadDashboard(90)">90 días</button><button t-att-class="state.days === 365 ? 'active':''" t-on-click="() => this.loadDashboard(365)">1 año</button><button t-att-class="state.days === 0 ? 'active':''" t-on-click="() => this.loadDashboard(0)">Todo</button></div></section>
    <section class="o_mgmt_actions"><button class="btn btn-primary" t-on-click="() => this.openAction('step_management_costs.action_operational_budget_create')"><i class="fa fa-magic"/> Crear presupuesto desde plantilla</button><button class="btn btn-light" t-on-click="() => this.openAction('step_management_costs.action_budget_template')"><i class="fa fa-copy"/> Plantillas</button><button class="btn btn-light" t-on-click="() => this.openAction('step_management_costs.action_management_plan')"><i class="fa fa-calendar-check-o"/> Planificación</button><button class="btn btn-light" t-on-click="() => this.openAction('step_management_costs.action_historical_cost')"><i class="fa fa-line-chart"/> Presupuesto vs. real</button></section>
    <section class="o_mgmt_kpis"><button class="o_mgmt_kpi o_mgmt_kpi--main" t-on-click="() => this.openAction('step_management_costs.action_operational_budget')"><span>Presupuestos</span><strong t-esc="number(state.data.budgets.total)"/><small><b t-esc="number(state.data.budgets.draft)"/> borradores</small></button><article class="o_mgmt_kpi o_mgmt_kpi--money"><span>Monto presupuestado</span><strong t-esc="money(state.data.budgets.amount)"/><small>período seleccionado</small></article><article class="o_mgmt_kpi"><span>Hectáreas presupuestadas</span><strong><t t-esc="number(state.data.budgets.hectares,1)"/> ha</strong><small><t t-esc="number(state.data.centers.hectares,1)"/> ha registradas</small></article><button class="o_mgmt_kpi o_mgmt_kpi--purple" t-on-click="() => this.openAction('step_management_costs.action_budget_template')"><span>Plantillas vigentes</span><strong t-esc="number(state.data.templates)"/><small>reutilizables</small></button><button class="o_mgmt_kpi o_mgmt_kpi--orange" t-on-click="() => this.openAction('step_management_costs.action_management_plan')"><span>Planes abiertos</span><strong t-esc="number(state.data.plans.open)"/><small><t t-esc="number(state.data.plans.total)"/> planes en el período</small></button></section>
    <section class="o_mgmt_grid"><article class="o_mgmt_panel o_mgmt_panel--wide"><header><div><span>PRESUPUESTOS RECIENTES</span><h2>Seguimiento operacional</h2></div><button t-on-click="() => this.openAction('step_management_costs.action_operational_budget')">Ver todos</button></header><div t-if="!state.data.recent.length" class="o_mgmt_empty">Aún no hay presupuestos. Use una plantilla para crear el primero.</div><button t-foreach="state.data.recent" t-as="budget" t-key="budget.id" class="o_mgmt_row" t-on-click="() => this.openRecord(budget.id)"><span t-attf-class="o_mgmt_state o_mgmt_state--{{budget.state}}" t-esc="stateLabel(budget.state)"/><span class="o_mgmt_row_main"><strong t-esc="budget.description"/><small><t t-esc="budget.name"/> · <t t-esc="budget.season"/> · <t t-esc="number(budget.hectares,1)"/> ha</small></span><b t-esc="money(budget.amount)"/></button></article>
    <aside class="o_mgmt_panel"><header><div><span>FLUJO RECOMENDADO</span><h2>Presupuesto en 4 pasos</h2></div></header><ol><li><b>Defina la plantilla</b><small>Indicadores, cantidades mensuales y tarifa por hectárea.</small></li><li><b>Seleccione centros</b><small>Puede incluir tantos centros de costo como necesite.</small></li><li><b>Extrapole</b><small>Odoo multiplica automáticamente por las hectáreas de cada centro.</small></li><li><b>Apruebe y controle</b><small>Compare posteriormente el presupuesto con los costos reales.</small></li></ol></aside>
    <article class="o_mgmt_panel o_mgmt_panel--wide o_mgmt_compare"><header><div><span>CONTROL</span><h2>Presupuesto versus real</h2></div></header><div><span>Presupuestado<strong t-esc="money(state.data.costs.budget)"/></span><span>Real<strong t-esc="money(state.data.costs.actual)"/></span><span t-att-class="state.data.costs.variance &gt; 0 ? 'danger':''">Desviación<strong t-esc="money(state.data.costs.variance)"/></span></div></article>
    <aside class="o_mgmt_panel o_mgmt_shortcuts"><header><div><span>MAESTROS</span><h2>Configuración rápida</h2></div></header><button t-on-click="() => this.openAction('step_management_costs.action_cost_center')"><i class="fa fa-map-marker"/><span><b>Centros de costo</b><small><t t-esc="number(state.data.centers.total)"/> configurados</small></span></button><button t-on-click="() => this.openAction('step_management_costs.action_budget_group')"><i class="fa fa-sitemap"/><span><b>Grupos presupuestarios</b><small>Mano de obra, insumos y servicios</small></span></button><button t-on-click="() => this.openAction('step_management_costs.action_budget_analysis')"><i class="fa fa-bar-chart"/><span><b>Análisis por indicador</b><small>Centros, grupos y categorías</small></span></button></aside></section></t>
</main></t></templates>
