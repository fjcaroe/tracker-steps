<odoo>
    <record id="view_caf_custody_list" model="ir.ui.view">
        <field name="name">l10n_cl.dte.caf.custody.list</field>
        <field name="model">l10n_cl.dte.caf</field>
        <field name="arch" type="xml">
            <list string="Custodia CAF" edit="0" delete="0">
                <field name="filename"/><field name="company_id"/>
                <field name="l10n_latam_document_type_id"/><field name="start_nb"/>
                <field name="final_nb"/><field name="issued_date"/><field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_caf_custody_form" model="ir.ui.view">
        <field name="name">l10n_cl.dte.caf.custody.form</field>
        <field name="model">l10n_cl.dte.caf</field>
        <field name="arch" type="xml">
            <form string="Custodia CAF" edit="0" delete="0">
                <header><button name="step_custody_download" type="object" string="Descargar original" invisible="not id"/></header>
                <sheet>
                    <div class="alert alert-info" role="alert">Guarda y recupera el archivo CAF original. La custodia no habilita folios ni emisión al SII.</div>
                    <group>
                        <field name="filename" required="not id"/><field name="caf_file" filename="filename" required="not id"/>
                        <field name="company_id"/><field name="l10n_latam_document_type_id"/>
                        <field name="start_nb" readonly="1"/><field name="final_nb" readonly="1"/>
                        <field name="issued_date" readonly="1"/><field name="status" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_caf_custody" model="ir.actions.act_window">
        <field name="name">Custodia CAF</field><field name="res_model">l10n_cl.dte.caf</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_caf_custody" name="Custodia CAF" action="action_caf_custody"
              groups="account.group_account_manager,stock.group_stock_manager" sequence="95"/>
</odoo>
