<odoo>
 <record id="payment_invoices" model="ir.ui.view">
  <field name="name">payment.treasury.invoice.selection</field><field name="model">account.payment</field>
  <field name="inherit_id" ref="account.view_account_payment_form"/>
  <field name="arch" type="xml">
   <xpath expr="//sheet" position="inside">
    <group string="Facturas a pagar o recaudar" name="step_invoice_selection" groups="account.group_account_invoice"
     invisible="not ((partner_type == 'customer' and payment_type == 'inbound') or (partner_type == 'supplier' and payment_type == 'outbound'))">
     <button name="action_step_select_invoices" type="object" string="Seleccionar facturas pendientes" class="btn-secondary"
      invisible="state != 'draft' or not partner_id"/>
     <label for="step_invoice_allocation_ids" string="Indique cuánto aplicar a cada factura. El importe del pago será la suma de las líneas."/>
     <field name="step_invoice_allocation_ids" nolabel="1" readonly="state != 'draft'" colspan="2">
      <list editable="bottom" create="0">
       <field name="company_id" column_invisible="True"/><field name="currency_id" column_invisible="True"/>
       <field name="invoice_currency_id" column_invisible="True"/>
       <field name="invoice_id" readonly="1"/><field name="invoice_date"/><field name="due_date"/>
       <field name="residual"/><field name="available_amount"/><field name="amount" sum="Total aplicado"/>
      </list>
     </field>
     <field name="step_invoice_amount" readonly="1"/>
    </group>
   </xpath>
  </field>
 </record>
 <record id="invoice_selection_form" model="ir.ui.view">
  <field name="name">treasury.payment.invoice.select</field><field name="model">step.treasury.payment.invoice.select</field>
  <field name="arch" type="xml"><form string="Seleccionar facturas pendientes">
   <field name="payment_id" invisible="1"/><field name="available_invoice_ids" invisible="1"/>
   <field name="invoice_ids" domain="[('id','in',available_invoice_ids)]" options="{'no_create':True}">
    <list><field name="name"/><field name="partner_id"/><field name="invoice_date"/><field name="invoice_date_due"/>
     <field name="currency_id"/><field name="amount_residual"/></list>
   </field>
   <footer><button name="action_apply" string="Agregar al pago" type="object" class="btn-primary"/>
    <button string="Cancelar" special="cancel" class="btn-secondary"/></footer>
  </form></field>
 </record>
 <record id="move_line_invoice" model="ir.ui.view">
  <field name="name">journal.items.treasury.invoice</field><field name="model">account.move.line</field>
  <field name="inherit_id" ref="account.view_move_line_tree"/>
  <field name="arch" type="xml"><field name="name" position="after">
   <field name="step_treasury_invoice_id" optional="hide"/>
  </field></field>
 </record>
</odoo>
