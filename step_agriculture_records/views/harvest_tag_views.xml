<odoo>
    <record id="view_harvest_tag_canonical_list" model="ir.ui.view">
        <field name="name">harvest.tag.canonical.list</field>
        <field name="model">step.agriculture.harvest.tag</field>
        <field name="inherit_id" ref="view_harvest_tag_list"/>
        <field name="arch" type="xml">
            <field name="tag_state_id" position="before"><field name="packing_tag_state_id" optional="show" options="{'no_create': True}"/></field>
            <field name="tag_state_id" position="attributes"><attribute name="optional">hide</attribute><attribute name="readonly">1</attribute></field>
        </field>
    </record>
    <record id="view_harvest_tag_canonical_form" model="ir.ui.view">
        <field name="name">harvest.tag.canonical.form</field>
        <field name="model">step.agriculture.harvest.tag</field>
        <field name="inherit_id" ref="view_harvest_tag_form"/>
        <field name="arch" type="xml">
            <field name="tag_state_id" position="before"><field name="packing_tag_state_id" options="{'no_create': True}"/></field>
        </field>
    </record>
    <record id="view_harvest_record_canonical_tags" model="ir.ui.view">
        <field name="name">harvest.record.canonical.tags</field>
        <field name="model">step.agriculture.harvest.record</field>
        <field name="inherit_id" ref="view_harvest_record_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']/list/field[@name='tag_state_id']" position="before"><field name="packing_tag_state_id" options="{'no_create': True}"/></xpath>
            <xpath expr="//field[@name='tag_ids']/list/field[@name='tag_state_id']" position="attributes"><attribute name="optional">hide</attribute><attribute name="readonly">1</attribute></xpath>
        </field>
    </record>
</odoo>
