<odoo>
    <record id="harvest_pricelist_form" model="ir.ui.view">
        <field name="name">product.pricelist.harvest.form</field>
        <field name="model">product.pricelist</field>
        <field name="mode">primary</field>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <form string="Tarifas de cosecha" class="o_step_harvest_tariffs">
                <sheet>
                    <field name="cosecha" invisible="True"/>
                    <div class="o_step_harvest_tariff_header">
                        <span>STEPS · COSECHA</span>
                        <h2>Tarifas de trato</h2>
                        <p>Defina la vigencia, los centros de costo y el precio de cada labor de cosecha.</p>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Nombre de la tarifa"/></h1></div>
                    <group><group>
                        <field name="currency_id"/>
                        <field name="group_type" widget="radio" readonly="True" force_save="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_init"/>
                        <field name="date_end"/>
                        <field name="escalonado"/>
                        <field name="cost_ids" widget="many2many_tags" options="{'no_create': True}"
                            domain="[('root_plan_id.name', 'in', ['Centro de costos', 'Centro Costos', 'Centro de Costos']), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                    </group><group>
                        <field name="country_group_ids" widget="many2many_tags"/>
                        <field name="create_uid" readonly="True"/>
                        <field name="user_id"/>
                        <field name="partner_ids" widget="many2many_tags" domain="[('step_contra', '=', True)]" invisible="group_type != 'contratista'"/>
                        <field name="especie_id" options="{'no_create': True}"/>
                        <field name="grupo_variedad_id_domain" widget="many2many_tags" domain="[('especie_id', '=', especie_id)]"/>
                        <field name="active"/>
                    </group></group>
                    <notebook><page name="pricelist_rules" string="Reglas de precio">
                        <field name="item_ids" context="{'default_applied_on': '1_product', 'default_base': 'list_price'}">
                            <list>
                                <field name="labor_id"/>
                                <field name="uom_id"/>
                                <field name="name" optional="hide"/>
                                <field name="price"/>
                                <field name="min_quantity"/>
                                <field name="can_std"/>
                                <field name="can_max"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </list>
                            <form string="Regla de tarifa de cosecha"><sheet>
                                <group><group>
                                    <field name="labor_id" domain="[('cosecha', '=', True)]" required="True"/>
                                    <field name="uom_id" required="True"/>
                                    <field name="applied_on"/>
                                    <field name="categ_id" invisible="applied_on != '2_product_category'"/>
                                    <field name="product_tmpl_id" domain="[('cosecha', '=', True)]"
                                        invisible="applied_on not in ('1_product', '0_product_variant')"
                                        required="applied_on in ('1_product', '0_product_variant')"/>
                                    <field name="product_id" invisible="applied_on != '0_product_variant'"
                                        required="applied_on == '0_product_variant'"/>
                                </group><group>
                                    <field name="compute_price"/>
                                    <field name="fixed_price" invisible="compute_price != 'fixed'"/>
                                    <field name="percent_price" invisible="compute_price != 'percentage'"/>
                                    <field name="min_quantity"/>
                                    <field name="can_std"/>
                                    <field name="can_max"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </group></group>
                                <group string="Fórmula" invisible="compute_price != 'formula'">
                                    <field name="base"/>
                                    <field name="base_pricelist_id" invisible="base != 'pricelist'"/>
                                    <field name="price_discount"/>
                                    <field name="price_round"/>
                                    <field name="price_surcharge"/>
                                    <field name="price_min_margin"/>
                                    <field name="price_max_margin"/>
                                </group>
                            </sheet></form>
                        </field>
                    </page></notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="harvest_own_tariff_form" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="harvest_pricelist_form"/>
        <field name="act_window_id" ref="step_cosecha.step_pricelist_action_propio_cosecha"/>
    </record>
    <record id="harvest_contractor_tariff_form" model="ir.actions.act_window.view">
        <field name="sequence">20</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="harvest_pricelist_form"/>
        <field name="act_window_id" ref="step_cosecha.step_pricelist_action_contratista_cosecha"/>
    </record>
</odoo>
