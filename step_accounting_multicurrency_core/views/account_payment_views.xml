<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_operational_currency" model="ir.ui.view">
        <field name="name">account.payment.form.operational.currency</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']/field[@name='journal_id']" position="before">
                <field name="operational_currency_id" invisible="1"/>
                <field name="observed_exchange_rate" readonly="1"
                       invisible="not operational_currency_id"/>
                <field name="conversion_currency_id" invisible="1"/>
                <field name="conversion_amount" readonly="1"
                       invisible="not operational_currency_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_register_operational_currency" model="ir.ui.view">
        <field name="name">account.payment.register.operational.currency</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_date']" position="after">
                <field name="operational_currency_id" invisible="1"/>
                <field name="observed_exchange_rate" readonly="1"
                       invisible="not operational_currency_id"/>
                <field name="conversion_currency_id" invisible="1"/>
                <field name="conversion_amount" readonly="1"
                       invisible="not operational_currency_id"/>
            </xpath>
        </field>
    </record>
</odoo>
