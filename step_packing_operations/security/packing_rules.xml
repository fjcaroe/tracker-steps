<odoo>
    <record id="rule_inspection_company" model="ir.rule"><field name="name">Inspecciones por empresa</field>
        <field name="model_id" ref="model_step_packing_inspection"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_instruction_company" model="ir.rule"><field name="name">Instructivos por empresa</field>
        <field name="model_id" ref="model_step_packing_instruction"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="rule_material_consumption_company" model="ir.rule">
        <field name="name">Consumos por empresa</field><field name="model_id" ref="model_step_packing_material_consumption"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_downtime_company" model="ir.rule">
        <field name="name">Detenciones por empresa</field><field name="model_id" ref="model_step_packing_downtime"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_packing_order_company" model="ir.rule">
        <field name="name">Packing OP por empresa</field>
        <field name="model_id" ref="model_step_packing_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="rule_packing_production_company" model="ir.rule">
        <field name="name">Packing OT por empresa</field>
        <field name="model_id" ref="model_step_packing_production"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="rule_packing_repack_company" model="ir.rule">
        <field name="name">Repaletizado por empresa</field>
        <field name="model_id" ref="model_step_packing_repack"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>
