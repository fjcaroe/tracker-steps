<odoo>
    <record id="rule_packing_order_company" model="ir.rule">
        <field name="name">Packing OP por empresa</field>
        <field name="model_id" ref="model_step_packing_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="rule_packing_repack_company" model="ir.rule">
        <field name="name">Repaletizado por empresa</field>
        <field name="model_id" ref="model_step_packing_repack"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
</odoo>
