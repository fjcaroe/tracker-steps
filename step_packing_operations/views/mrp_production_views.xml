<odoo>
    <record id="view_mrp_production_form_packing_process" model="ir.ui.view">
        <field name="name">mrp.production.form.packing.process</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="step_packing.view_mrp_production_form_packing_fruit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='step_packing_fruit']" position="inside">
                <group string="Orden de proceso">
                    <field name="step_packing_order_id"/>
                    <field name="step_packing_line_id"/>
                    <field name="step_packing_state" widget="statusbar"/>
                    <button name="action_step_packing_validate" type="object" string="Validar cuadratura" class="btn-primary"
                        invisible="not step_packing_order_id or step_packing_state != 'created'"/>
                    <button name="action_step_packing_close" type="object" string="Cerrar Packing"
                        invisible="step_packing_state != 'validated' or state != 'done'"/>
                </group>
                <group string="Tarjas a proceso"><field name="step_packing_input_tag_ids" widget="many2many_tags"
                    domain="[('step_tag_kind','=','C'),('step_tag_state','=','validated')]"/></group>
                <group string="Tarjas resultantes"><field name="step_packing_output_tag_ids" widget="many2many_tags"
                    domain="[('step_tag_kind','in',['E','N']),('step_tag_state','=','created')]"/></group>
                <group string="Cuadratura"><group><field name="step_packing_input_kg"/>
                    <field name="step_packing_export_kg"/><field name="step_packing_commercial_kg"/></group>
                    <group><field name="step_packing_precaliber_kg"/><field name="step_packing_waste_kg"/>
                        <field name="step_packing_loss_kg"/></group></group>
            </xpath>
        </field>
    </record>
    <record id="view_package_form_packing_result" model="ir.ui.view">
        <field name="name">stock.quant.package.form.packing.result</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="step_inventory_fruit_tag.view_quant_package_form_fruit_tag"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_fruit_tag']" position="after">
                <field name="step_packing_result" invisible="not is_fruit_tag or step_tag_kind == 'C'"/>
            </xpath>
        </field>
    </record>
    <record id="view_process_type_form_category" model="ir.ui.view">
        <field name="name">step.packing.process.type.form.category</field>
        <field name="model">step.packing.process.type</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_process_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after"><field name="step_category"/></xpath>
        </field>
    </record>
</odoo>
