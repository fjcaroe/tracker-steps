<odoo>
    <!-- Banner de contexto para los catálogos simples de Packing, hoy formularios
         "pelados" (solo name/company_id/sequence/tag_ids) heredados de step_packing
         (puerto desde Studio, tickets 33/34). No cambia comportamiento ni datos,
         solo da el mismo tratamiento visual que el resto de las apps Steps. -->

    <record id="view_packing_process_type_form_banner" model="ir.ui.view">
        <field name="name">step.packing.process.type.form.banner</field>
        <field name="model">step.packing.process.type</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_process_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="o_packing_master_intro"><i class="fa fa-cogs"/><div>
                    <span>CONFIGURACIÓN PACKING</span><strong>Tipo de proceso</strong>
                    <small>Clasifica las OT de Packing: embalaje o corrección (repaletizado).</small>
                </div></div>
            </xpath>
        </field>
    </record>

    <record id="view_packing_tag_type_form_banner" model="ir.ui.view">
        <field name="name">step.packing.tag.type.form.banner</field>
        <field name="model">step.packing.tag.type</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_tag_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="o_packing_master_intro"><i class="fa fa-tags"/><div>
                    <span>CONFIGURACIÓN PACKING</span><strong>Tipo de tarja</strong>
                    <small>Los tipos C (cosecha), E (exportación) y N (nacional) que identifican cada pallet.</small>
                </div></div>
            </xpath>
        </field>
    </record>

    <record id="view_packing_tag_state_form_banner" model="ir.ui.view">
        <field name="name">step.packing.tag.state.form.banner</field>
        <field name="model">step.packing.tag.state</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_tag_state_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="o_packing_master_intro"><i class="fa fa-flag"/><div>
                    <span>CONFIGURACIÓN PACKING</span><strong>Estado de tarja</strong>
                    <small>Ciclo de vida de una tarja: creada, validada, procesada, repaletizada, despachada, liquidada o nula.</small>
                </div></div>
            </xpath>
        </field>
    </record>

    <record id="view_packing_stop_reason_form_banner" model="ir.ui.view">
        <field name="name">step.packing.stop.reason.form.banner</field>
        <field name="model">step.packing.stop.reason</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_stop_reason_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="o_packing_master_intro"><i class="fa fa-exclamation-triangle"/><div>
                    <span>CONFIGURACIÓN PACKING</span><strong>Causas de detención de líneas</strong>
                    <small>Motivos registrados cuando una línea de proceso se detiene (corte de luz, falla mecánica, etc.).</small>
                </div></div>
            </xpath>
        </field>
    </record>

    <record id="view_packing_caliber_group_form_banner" model="ir.ui.view">
        <field name="name">step.packing.caliber.group.form.banner</field>
        <field name="model">step.packing.caliber.group</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_caliber_group_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="o_packing_master_intro"><i class="fa fa-object-group"/><div>
                    <span>CONFIGURACIÓN PACKING</span><strong>Grupo de calibre</strong>
                    <small>Agrupa calibres de fruta por especie para facilitar la selección en tarjas y OT.</small>
                </div></div>
            </xpath>
        </field>
    </record>

    <record id="view_packing_fruit_caliber_form_banner" model="ir.ui.view">
        <field name="name">step.packing.fruit.caliber.form.banner</field>
        <field name="model">step.packing.fruit.caliber</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_fruit_caliber_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="o_packing_master_intro"><i class="fa fa-balance-scale"/><div>
                    <span>CONFIGURACIÓN PACKING</span><strong>Calibre de fruta</strong>
                    <small>Los calibres (2J, 3J, 4J, XL...) usados para clasificar la fruta embalada.</small>
                </div></div>
            </xpath>
        </field>
    </record>

    <record id="view_packing_fruit_category_form_banner" model="ir.ui.view">
        <field name="name">step.packing.fruit.category.form.banner</field>
        <field name="model">step.packing.fruit.category</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_fruit_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="o_packing_master_intro"><i class="fa fa-star"/><div>
                    <span>CONFIGURACIÓN PACKING</span><strong>Categoría de fruta</strong>
                    <small>Categorías comerciales (Cat 1, Cat 2...) usadas en tarjas y cuadratura.</small>
                </div></div>
            </xpath>
        </field>
    </record>

    <record id="view_packing_line_form_banner" model="ir.ui.view">
        <field name="name">step.packing.line.form.banner</field>
        <field name="model">step.packing.line</field>
        <field name="inherit_id" ref="step_packing.view_step_packing_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <div class="o_packing_master_intro"><i class="fa fa-sitemap"/><div>
                    <span>CONFIGURACIÓN PACKING</span><strong>Líneas de proceso</strong>
                    <small>Las líneas físicas de embalaje a las que se asignan las órdenes de trabajo.</small>
                </div></div>
            </xpath>
        </field>
    </record>
</odoo>
