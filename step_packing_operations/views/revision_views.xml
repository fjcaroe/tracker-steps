<odoo>
    <record id="view_fruit_tag_revision" model="ir.ui.view">
        <field name="name">fruit.tag.packing.revision</field><field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="step_inventory_packing.view_quant_package_form_steps_fruit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='step_tag_kind']" position="after">
                <field name="step_packing_result" readonly="step_tag_state != 'created'"/>
                <field name="step_packaging_id" readonly="step_tag_state != 'created'"/>
                <field name="step_packing_line_id" readonly="step_tag_state != 'created'"/>
                <field name="step_reserved_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
            <field name="process_type" position="replace"><field name="step_process_type_id" options="{'no_create': True}"/></field>
            <field name="packing_plant" position="replace"><field name="step_packing_partner_id" options="{'no_create': True}"/></field>
            <field name="process_line" position="replace"><field name="step_packing_line_id" options="{'no_create': True}" readonly="step_tag_state != 'created'"/></field>
            <field name="op_folio" position="replace"><field name="step_process_order_id" options="{'no_create': True}"/></field>
            <field name="ot_proceso" position="replace"><field name="step_packing_production_id" string="OT Proceso" options="{'no_create': True}" readonly="id and step_packing_production_id" domain="[('company_id','=',step_document_company_id),('state','=','created')]"/></field>
            <xpath expr="//field[@name='quant_ids']" position="before">
                <group string="Producción histórica" invisible="not (process_type or packing_plant or process_line or op_folio or ot_proceso)">
                    <field name="process_type" readonly="1"/><field name="packing_plant" readonly="1"/>
                    <field name="process_line" readonly="1"/><field name="op_folio" readonly="1"/><field name="ot_proceso" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='step_tag_line_ids']/list/field[@name='producer_id']" position="before">
                <field name="source_package_id" readonly="1" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
