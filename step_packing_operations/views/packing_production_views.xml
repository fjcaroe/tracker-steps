<odoo>
    <record id="view_packing_production_list" model="ir.ui.view">
        <field name="name">step.packing.production.list</field>
        <field name="model">step.packing.production</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="step_packing_order_id"/><field name="raw_product_id"/>
                <field name="fruit_grower_id"/><field name="fruit_variety_id"/>
                <field name="step_packing_input_kg"/><field name="step_packing_export_kg"/>
                <field name="state"/></list>
        </field>
    </record>
    <record id="view_packing_production_form" model="ir.ui.view">
        <field name="name">step.packing.production.form</field>
        <field name="model">step.packing.production</field>
        <field name="arch" type="xml">
            <form string="Orden de Trabajo de Packing">
                <header>
                    <button name="action_step_packing_validate" type="object" string="Validar cuadratura"
                        class="btn-primary" invisible="state != 'created'"/>
                    <button name="action_step_packing_close" type="object" string="Cerrar Packing"
                        invisible="state != 'validated'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="created,validated,closed,costed,accounted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="step_packing_order_id"/>
                            <field name="step_packing_line_id"/>
                            <field name="raw_product_id" readonly="state != 'created'"/>
                            <field name="bom_id" invisible="1"/>
                            <field name="instruction_id" domain="[('order_id','=',step_packing_order_id),('state','=','approved')]"/>
                            <field name="sales_program_id"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group>
                            <field name="fruit_grower_id" readonly="state != 'created'"/>
                            <field name="fruit_fundo_id"/>
                            <field name="fruit_species_id"/>
                            <field name="fruit_variety_id" readonly="state != 'created'"/>
                        </group>
                    </group>
                    <notebook name="fruit_details">
                        <page string="Productos resultantes" name="outputs">
                            <button name="action_create_export_tag" type="object" string="Crear tarja exportación" class="btn-primary" invisible="state != 'created'"/>
                            <button name="action_create_national_tag" type="object" string="Crear tarja nacional" invisible="state != 'created'"/>
                            <field name="step_packing_output_tag_ids" readonly="state != 'created'"
                                domain="[('step_tag_kind','in',['E','N']),('step_tag_state','=','created'),('step_packing_production_id','in',[False,id])]" options="{'no_create': True}">
                                <list create="0"><field name="name"/><field name="step_tag_kind"/><field name="step_result_product_id"/>
                                    <field name="step_packaging_id"/><field name="package_type_id"/><field name="fruit_category_id"/>
                                    <field name="label"/><field name="fruit_caliber_id"/><field name="variedad_id"/>
                                    <field name="box_count" sum="Cajas"/><field name="step_actual_kg" sum="Kilos"/>
                                    <field name="step_packing_result"/><field name="step_tag_state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Materia prima — lotes a procesar" name="inputs">
                            <field name="step_packing_input_tag_ids" readonly="state != 'created'" options="{'no_create': True}"
                                domain="[('step_tag_kind','=','C'),('step_tag_state','=','validated'),('step_tag_line_ids.product_id','=?',raw_product_id),('step_producer_id','=?',fruit_grower_id),('variedad_id','=?',fruit_variety_id),('fundo_id','=?',fruit_fundo_id)]">
                                <list create="0"><field name="name"/><field name="received_at"/><field name="step_producer_id"/>
                                    <field name="variedad_id"/><field name="box_count" sum="Cajas"/><field name="step_actual_kg" sum="Kilos"/>
                                    <field name="fruit_quality_id"/><field name="harvest_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Cuadratura">
                        <group>
                            <field name="step_packing_input_kg"/>
                            <field name="step_packing_export_kg"/>
                            <field name="step_packing_commercial_kg"/>
                        </group>
                        <group>
                            <field name="step_packing_precaliber_kg"/>
                            <field name="step_packing_waste_kg"/>
                            <field name="step_packing_loss_kg"/>
                        </group>
                    </group>
                    <group string="Movimientos de Inventario" invisible="state == 'created'">
                        <field name="input_picking_id" readonly="1"/>
                        <field name="material_picking_id" readonly="1"/>
                        <field name="output_picking_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_packing_production" model="ir.actions.act_window">
        <field name="name">Órdenes de trabajo</field>
        <field name="res_model">step.packing.production</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Informe de procesos: resumen (anexo 1, hoja "Inf Pk" / PROC fila 87-91). -->
    <record id="view_packing_production_summary_search" model="ir.ui.view">
        <field name="name">step.packing.production.summary.search</field>
        <field name="model">step.packing.production</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="step_packing_order_id"/>
                <field name="fruit_grower_id"/>
                <field name="fruit_variety_id"/>
                <filter name="filter_created" string="Creadas" domain="[('state','=','created')]"/>
                <filter name="filter_validated" string="Validadas" domain="[('state','=','validated')]"/>
                <filter name="filter_closed" string="Cerradas" domain="[('state','in',('closed','costed','accounted'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_order" string="Orden de proceso" context="{'group_by':'step_packing_order_id'}"/>
                    <filter name="group_grower" string="Productor" context="{'group_by':'fruit_grower_id'}"/>
                    <filter name="group_variety" string="Variedad" context="{'group_by':'fruit_variety_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_packing_production_summary_list" model="ir.ui.view">
        <field name="name">step.packing.production.summary.list</field>
        <field name="model">step.packing.production</field>
        <field name="arch" type="xml">
            <list string="Resumen de procesos">
                <field name="name"/>
                <field name="step_packing_order_id"/>
                <field name="fruit_grower_id"/>
                <field name="fruit_variety_id"/>
                <field name="state"/>
                <field name="step_packing_input_kg" sum="Total a proceso"/>
                <field name="step_packing_export_kg" sum="Total exportación"/>
                <field name="step_packing_commercial_kg" sum="Total comercial"/>
                <field name="step_packing_precaliber_kg" sum="Total precalibre"/>
                <field name="step_packing_waste_kg" sum="Total desecho"/>
                <field name="step_packing_loss_kg" sum="Total merma"/>
            </list>
        </field>
    </record>
    <record id="action_packing_production_summary" model="ir.actions.act_window">
        <field name="name">Resumen de procesos</field>
        <field name="res_model">step.packing.production</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_packing_production_summary_search"/>
        <field name="context">{'search_default_group_order': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_packing_production_summary_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_packing_production_form')})]"/>
    </record>
</odoo>
