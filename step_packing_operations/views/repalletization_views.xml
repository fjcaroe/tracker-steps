<odoo>
    <record id="view_packing_repack_list" model="ir.ui.view">
        <field name="name">step.packing.repack.list</field>
        <field name="model">step.packing.repack</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="boxes_total"/>
            <field name="kilos_total"/><field name="picking_id"/><field name="state"/></list></field>
    </record>
    <record id="view_packing_repack_form" model="ir.ui.view">
        <field name="name">step.packing.repack.form</field>
        <field name="model">step.packing.repack</field>
        <field name="arch" type="xml">
            <form string="Repaletizado">
                <header><button name="action_validate" type="object" string="Validar y mover stock"
                    class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/></header>
                <sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group><field name="company_id" groups="base.group_multi_company"/>
                        <field name="date" readonly="state == 'done'"/><field name="process_type_id" readonly="state == 'done'"/>
                        <field name="packing_partner_id" readonly="state == 'done'"/><field name="packing_line_id" readonly="state == 'done'"/>
                        <field name="picking_id"/><field name="boxes_total"/><field name="kilos_total"/></group>
                    <notebook><page string="Tarjas que salen">
                        <field name="selected_source_ids" readonly="state == 'done' or line_ids" options="{'no_create': True}"
                            domain="[('is_fruit_tag','=',True),('step_tag_state','=','validated')]">
                            <list create="0"><field name="name"/><field name="step_producer_id"/><field name="step_tag_kind"/>
                                <field name="step_result_product_id"/><field name="fruit_caliber_id"/>
                                <field name="box_count" sum="Cajas"/><field name="step_actual_kg" sum="Kilos"/></list>
                        </field>
                        <button name="action_prepare_distribution" type="object" string="Crear tarja de destino y distribución"
                            class="btn-primary" invisible="state != 'draft' or line_ids"/>
                        <field name="source_tag_ids" readonly="1"><list><field name="name"/><field name="step_producer_id"/>
                            <field name="step_result_product_id"/><field name="step_packaging_id"/><field name="package_type_id"/>
                            <field name="fruit_category_id"/><field name="label"/><field name="fruit_caliber_id"/><field name="variedad_id"/>
                            <field name="box_count" sum="Cajas"/><field name="step_actual_kg" sum="Kilos"/><field name="step_tag_state"/></list></field>
                    </page><page string="Tarjas que entran"><field name="target_tag_ids" readonly="1"><list>
                        <field name="name"/><field name="step_composition"/><field name="step_result_product_id"/>
                        <field name="step_packaging_id"/><field name="fruit_caliber_id"/><field name="variedad_id"/>
                        <field name="box_count" sum="Cajas"/><field name="step_actual_kg" sum="Kilos"/><field name="step_tag_state"/>
                    </list></field></page><page string="Distribución y trazabilidad">
                    <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom"><field name="source_package_id" domain="[('step_tag_state','=','validated')]"/>
                            <field name="target_package_id" domain="[('step_tag_state','=','created')]"/>
                            <field name="producer_id"/><field name="product_id"/>
                            <field name="quantity"/><field name="boxes"/><field name="kilos"/></list>
                    </field>
                    </page></notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="action_packing_repack" model="ir.actions.act_window">
        <field name="name">Repaletizado</field>
        <field name="res_model">step.packing.repack</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
