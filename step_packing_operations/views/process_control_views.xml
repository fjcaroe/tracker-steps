<odoo>
    <record id="view_fruit_tag_output_lot" model="ir.ui.view">
        <field name="name">fruit.tag.packing.lot</field><field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="step_inventory_packing.view_quant_package_form_steps_fruit"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='step_tag_line_ids']/list/field[@name='product_id']" position="after">
            <field name="lot_id" domain="[('product_id','=',product_id)]" optional="hide"/>
        </xpath><xpath expr="//field[@name='step_actual_kg']" position="after">
            <field name="harvest_date"/><field name="received_at"/>
        </xpath></field>
    </record>
    <record id="view_packing_production_control" model="ir.ui.view">
        <field name="name">packing.production.controls</field>
        <field name="model">step.packing.production</field>
        <field name="inherit_id" ref="view_packing_production_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_reopen_quadrature" type="object" string="Corregir cuadratura"
                        invisible="state != 'validated' or material_review_state == 'approved'"/>
                <button name="action_return_national_fruit" type="object" string="Devolver fruta nacional"
                        invisible="state != 'closed' or return_picking_id"/>
                <button name="action_prepare_materials" type="object" string="Preparar materiales"
                        invisible="state not in ('created','validated') or material_review_state == 'approved'"/>
                <button name="action_approve_materials" type="object" string="Aprobar materiales"
                        groups="stock.group_stock_manager" invisible="state not in ('created','validated') or material_review_state != 'review'"/>
                <button name="action_reopen_materials" type="object" string="Reabrir materiales"
                        invisible="state not in ('created','validated') or material_review_state != 'approved'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Devolución al productor"><field name="return_picking_id" readonly="1"/>
                        <p>La fruta comercial, precalibre y desecho conserva al productor como propietario. La devolución mueve sus tarjas a la ubicación de cliente.</p>
                    </page>
                    <page string="Materiales por tarja">
                        <group><field name="material_review_state" readonly="1"/>
                            <field name="material_approved_by"/><field name="material_approved_at"/></group>
                        <field name="material_line_ids" readonly="state not in ('created','validated') or material_review_state == 'approved'">
                            <list editable="bottom" create="0" delete="0">
                                <field name="package_id" readonly="1"/><field name="product_id" readonly="1"/>
                                <field name="planned_qty"/><field name="quantity"/><field name="uom_id"/>
                                <field name="reason"/>
                            </list>
                        </field>
                    </page>
                    <page string="Operación y rendimiento">
                        <group><group><field name="date"/><field name="process_type_id"/>
                            <field name="packing_partner_id"/><field name="customer_id"/><field name="shift"/>
                            <field name="workers"/></group>
                            <group><field name="started_at"/><field name="finished_at"/>
                                <field name="standard_kg_hour"/><field name="total_hours"/>
                                <field name="effective_hours"/><field name="idle_percent"/>
                                <field name="kg_hour"/><field name="kg_worker"/><field name="kg_worker_hour"/></group></group>
                        <group string="Fruta"><field name="fruit_type"/><field name="average_harvest_box_kg"/>
                            <field name="harvest_age_days"/><field name="storage_days"/><field name="caliber_2j_percent"/></group>
                        <field name="caliber_breakdown" widget="html"/>
                        <field name="downtime_ids" readonly="state not in ('created','validated')">
                            <list editable="bottom"><field name="reason_id"/><field name="started_at"/>
                                <field name="finished_at"/><field name="hours"/><field name="comment"/></list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="view_packing_summary_control" model="ir.ui.view">
        <field name="name">packing.summary.controls</field><field name="model">step.packing.production</field>
        <field name="inherit_id" ref="view_packing_production_summary_list"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='state']" position="after">
            <field name="date"/><field name="material_review_state"/>
            <field name="effective_hours" optional="hide"/><field name="kg_hour" optional="hide"/>
            <field name="kg_worker_hour" optional="hide"/>
        </xpath></field>
    </record>
    <template id="report_packing_controls" inherit_id="report_packing_process">
        <xpath expr="//t[@t-call='web.html_container']/t[@t-foreach='docs']" position="before">
            <div class="page" t-if="len(docs) &gt; 1">
                <h2>Consolidado de procesos de Packing</h2>
                <table class="table table-sm"><thead><tr><th>OT</th><th>Productor</th><th>A proceso kg</th><th>Exportación kg</th><th>Nacional kg</th><th>Merma kg</th></tr></thead>
                    <tbody><tr t-foreach="docs" t-as="record"><td><span t-field="record.name"/></td>
                        <td><span t-field="record.fruit_grower_id"/></td><td><span t-field="record.step_packing_input_kg"/></td>
                        <td><span t-field="record.step_packing_export_kg"/></td>
                        <td><t t-esc="record.step_packing_commercial_kg + record.step_packing_precaliber_kg + record.step_packing_waste_kg"/></td>
                        <td><span t-field="record.step_packing_loss_kg"/></td></tr></tbody>
                    <tfoot><tr><th colspan="2">Total</th><td><t t-esc="sum(docs.mapped('step_packing_input_kg'))"/></td>
                        <td><t t-esc="sum(docs.mapped('step_packing_export_kg'))"/></td><td><t t-esc="sum(docs.mapped('step_packing_commercial_kg')) + sum(docs.mapped('step_packing_precaliber_kg')) + sum(docs.mapped('step_packing_waste_kg'))"/></td>
                        <td><t t-esc="sum(docs.mapped('step_packing_loss_kg'))"/></td></tr></tfoot>
                </table>
            </div>
        </xpath>
        <xpath expr="//th[.='Resultado']" position="after"><th>Calibre</th></xpath>
        <xpath expr="//tr[@t-foreach='doc.step_packing_output_tag_ids']/td[3]" position="after">
            <td><span t-field="tag.fruit_caliber_id"/></td>
        </xpath>
        <xpath expr="//div[@class='page']" position="inside">
            <h3>Materiales revisados por tarja</h3>
            <p>Revisión: <span t-field="doc.material_review_state"/> — <span t-field="doc.material_approved_by"/></p>
            <table class="table table-sm"><thead><tr><th>Tarja</th><th>Material</th><th>Calculado</th><th>Revisado</th><th>Motivo</th></tr></thead>
                <tbody><tr t-foreach="doc.material_line_ids" t-as="line">
                    <td><span t-field="line.package_id"/></td><td><span t-field="line.product_id"/></td>
                    <td><span t-field="line.planned_qty"/></td><td><span t-field="line.quantity"/></td><td><span t-field="line.reason"/></td>
                </tr></tbody></table>
            <h3>Rendimiento</h3>
            <div t-field="doc.caliber_breakdown"/>
            <p>Horas efectivas: <span t-field="doc.effective_hours"/>; kg/h: <span t-field="doc.kg_hour"/>;
                kg/hora-hombre: <span t-field="doc.kg_worker_hour"/>; tiempo ocioso %: <span t-field="doc.idle_percent"/>.</p>
        </xpath>
    </template>
</odoo>
