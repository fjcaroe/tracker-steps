<odoo>
    <record id="library_list" model="ir.ui.view">
        <field name="name">Biblioteca documental</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="type" string="Tipo"/>
                <field name="company_id"/>
                <field name="user_permission" string="Mi permiso"/>
                <button name="action_open" string="Abrir" type="object"/>
            </list>
        </field>
    </record>
    <record id="library_form" model="ir.ui.view">
        <field name="name">Elemento de biblioteca</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open" string="Abrir" type="object" class="btn-primary"/>
                    <button name="action_manage_access" string="Gestionar permiso" type="object" invisible="not may_manage_access"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="type" string="Tipo"/>
                        <field name="folder_id" options="{'no_open': True}"/>
                        <field name="company_id"/>
                        <field name="owner_id"/>
                        <field name="user_permission" string="Mi permiso"/>
                        <field name="may_manage_access" invisible="1"/>
                    </group>
                    <field name="access_ids" readonly="1">
                        <list create="0" edit="0" delete="0"><field name="partner_id"/><field name="role"/><field name="expiration_date"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="permission_form" model="ir.ui.view">
        <field name="name">Gestionar permiso de archivo</field>
        <field name="model">step.document.library.permission</field>
        <field name="arch" type="xml">
            <form>
                <group><field name="document_id" force_save="1"/><field name="user_id" options="{'no_create': True}"/><field name="role"/></group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_library" model="ir.actions.act_window">
        <field name="name">Biblioteca documental</field>
        <field name="res_model">documents.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('folder_id', '=', False)]</field>
    </record>
    <record id="action_library_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">list</field>
        <field name="view_id" ref="library_list"/><field name="act_window_id" ref="action_library"/>
    </record>
    <record id="action_library_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">form</field>
        <field name="view_id" ref="library_form"/><field name="act_window_id" ref="action_library"/>
    </record>
    <function model="documents.document" name="_adopt_dashboard"/>
</odoo>
