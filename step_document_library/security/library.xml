<odoo>
    <record id="document_read_scope" model="ir.rule">
        <field name="name">Biblioteca: permiso de lectura original</field>
        <field name="model_id" ref="model_documents_document"/>
        <field name="domain_force">[('user_permission', '!=', 'none')]</field>
    </record>
    <record id="grant_read_scope" model="ir.rule">
        <field name="name">Biblioteca: permisos de documentos visibles</field>
        <field name="model_id" ref="model_documents_access"/>
        <field name="domain_force">[('document_id.user_permission', '!=', 'none')]</field>
    </record>
</odoo>
